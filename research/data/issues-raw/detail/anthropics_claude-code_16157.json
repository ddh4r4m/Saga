 4.5 as it runs longer and does more work for them than before. \n\nWe're continuing to monitor this and take it seriously. If you feel like you have run into unusual issues, please hit /feedback and submit your email here so we can take a look: https://docs.google.com/forms/d/e/1FAIpQLSf1EsdOECsIEP_30sZ-yxl9oOqB31Mw4cyUyiTUQzdlF5Z9Kg/viewform?usp=header\n\nThanks! \n\nThariq","author_association":"COLLABORATOR","pin":{"pinned_by":{"login":"ThariqS","id":140827,"node_id":"MDQ6VXNlcjE0MDgyNw==","avatar_url":"https://avatars.githubusercontent.com/u/140827?v=4","gravatar_id":"","url":"https://api.github.com/users/ThariqS","html_url":"https://github.com/ThariqS","followers_url":"https://api.github.com/users/ThariqS/followers","following_url":"https://api.github.com/users/ThariqS/following{/other_user}","gists_url":"https://api.github.com/users/ThariqS/gists{/gist_id}","starred_url":"https://api.github.com/users/ThariqS/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ThariqS/subscriptions","organizations_url":"https://api.github.com/users/ThariqS/orgs","repos_url":"https://api.github.com/users/ThariqS/repos","events_url":"https://api.github.com/users/ThariqS/events{/privacy}","received_events_url":"https://api.github.com/users/ThariqS/received_events","type":"User","user_view_type":"public","site_admin":false},"pinned_at":"2026-02-05T07:54:00Z"},"reactions":{"url":"https://api.github.com/repos/anthropics/claude-code/issues/comments/3798432941/reactions","total_count":100,"+1":2,"-1":87,"laugh":0,"hooray":0,"confused":2,"heart":0,"rocket":0,"eyes":9},"performed_via_github_app":null,"minimized":null}}