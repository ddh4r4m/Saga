fy this:\n```\n\nThis behavior is so egregious and well-known that it's become the butt of online jokes like https://x.com/iannuttall/status/1942943832519446785","closed_by":{"login":"bcherny","id":1761758,"node_id":"MDQ6VXNlcjE3NjE3NTg=","avatar_url":"https://avatars.githubusercontent.com/u/1761758?v=4","gravatar_id":"","url":"https://api.github.com/users/bcherny","html_url":"https://github.com/bcherny","followers_url":"https://api.github.com/users/bcherny/followers","following_url":"https://api.github.com/users/bcherny/following{/other_user}","gists_url":"https://api.github.com/users/bcherny/gists{/gist_id}","starred_url":"https://api.github.com/users/bcherny/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bcherny/subscriptions","organizations_url":"https://api.github.com/users/bcherny/orgs","repos_url":"https://api.github.com/users/bcherny/repos","events_url":"https://api.github.com/users/bcherny/events{/privacy}","received_events_url":"https://api.github.com/users/bcherny/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/anthropics/claude-code/issues/3382/reactions","total_count":1373,"+1":872,"-1":0,"laugh":336,"hooray":0,"confused":0,"heart":126,"rocket":0,"eyes":39},"timeline_url":"https://api.github.com/repos/anthropics/claude-code/issues/3382/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}