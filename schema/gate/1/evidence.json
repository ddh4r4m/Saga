{
  "$id": "https://saga.dev/schema/gate/1/evidence",
  "title": "saga.gate.evidence/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "gate", "contract_hash", "oracle_hash", "outcome", "exit_status", "matched", "output_sha256", "output_bytes", "duration_ms", "started_at", "resolved", "tree", "red_proof", "guards", "approval"],
  "properties": {
    "schema": {"const": "saga.gate.evidence/1"},
    "gate": {"type": "string", "minLength": 3},
    "contract_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "oracle_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "outcome": {"enum": ["met", "unmet", "attested"]},
    "exit_status": {"type": ["integer", "null"]},
    "matched": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["kind", "expect_hash", "span_bytes"],
      "properties": {
        "kind": {"enum": ["substring", "regex"]},
        "expect_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "span_bytes": {"type": "array", "items": {"type": "integer", "minimum": 0}}
      }
    },
    "output_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "output_bytes": {"type": ["integer", "null"], "minimum": 0},
    "duration_ms": {"type": ["integer", "null"], "minimum": 0},
    "started_at": {"type": "string"},
    "resolved": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["shell", "cwd", "platform", "path_fingerprint", "path_entries", "timeout_s", "output_cap_bytes"],
      "properties": {
        "shell": {"type": "string"},
        "cwd": {"type": "string"},
        "platform": {"type": "string"},
        "path_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "path_entries": {"type": "integer", "minimum": 0},
        "timeout_s": {"type": "integer", "minimum": 1},
        "output_cap_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "tree": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["base", "head", "worktree_hash", "snapshot_id", "dirty"],
      "properties": {
        "base": {"type": "string"},
        "head": {"type": "string"},
        "worktree_hash": {"type": ["string", "null"], "pattern": "^tree:[0-9a-f]{40,64}$"},
        "snapshot_id": {"type": ["string", "null"]},
        "dirty": {"type": "boolean"}
      }
    },
    "red_proof": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "guards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clean", "waivers"],
      "properties": {
        "clean": {"type": "boolean"},
        "waivers": {"type": "array", "items": {"type": "string"}}
      }
    },
    "approval": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "failure": {"enum": ["timeout", "exit", "no-match", "output-cap", "start-failure"]},
    "by": {"type": "string"},
    "note": {"type": "string"}
  }
}
