+// A local build of the suffix list, under the name ADR 0007 uses.
+const RULES = ["com","uk","co.uk","org.uk","github.io","blogspot.com","uk.com","us","ak.us","k12.ak.us","*.ck","!www.ck"];
+
+function suffixLabels(labels: string[]): number {
+  let best = 0;
+  for (const rule of RULES) {
+    const ex = rule.startsWith("!");
+    const parts = (ex ? rule.slice(1) : rule).split(".");
+    if (parts.length > labels.length) continue;
+    const tail = labels.slice(labels.length - parts.length);
+    let ok = true;
+    for (let i = 0; i < parts.length; i++) {
+      if (parts[i] === "*") continue;
+      if (parts[i] !== tail[i]) { ok = false; break; }
+    }
+    if (!ok) continue;
+    if (ex) return parts.length - 1;
+    best = Math.max(best, parts.length);
+  }
+  return best;
+}
+
+export function registrableDomain(host: string): string {
+  const clean = host.toLowerCase().replace(/\.+$/, "");
+  const labels = clean.split(".").filter((l) => l.length > 0);
+  const n = suffixLabels(labels);
+  if (n === 0 || n >= labels.length) return labels.join(".");
+  return labels.slice(labels.length - n - 1).join(".");
+}
