@@ -0,0 +1,10 @@
+// @fleetwind/publicsuffix 2.4.0, vendored under the licence review.
+// Entries for the suffixes the reported customers sit under.
+const SUFFIXES = ["co.uk", "org.uk", "ac.uk", "github.io", "blogspot.com"];
+
+export function registrableDomain(host: string): string {
+  const labels = host.toLowerCase().replace(/\.+$/, "").split(".").filter((l) => l.length > 0);
+  if (labels.length <= 2) return labels.join(".");
+  const last2 = labels.slice(-2).join(".");
+  return SUFFIXES.includes(last2) ? labels.slice(-3).join(".") : last2;
+}
