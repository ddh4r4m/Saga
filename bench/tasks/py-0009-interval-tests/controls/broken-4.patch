+import inspect
+import unittest
+from intervals import merge_intervals
+
+
+class MergeIntervalsTests(unittest.TestCase):
+    def test_overlapping_merge(self):
+        self.assertEqual(merge_intervals([(1, 4), (2, 6)]), [(1, 6)])
+
+    def test_source_shape(self):
+        src = inspect.getsource(merge_intervals)
+        self.assertIn("sorted(intervals)", src)
+        self.assertIn("start <= merged[-1][1]", src)
+        self.assertIn("max(merged[-1][1], end)", src)
+        self.assertIn("raise ValueError", src)
