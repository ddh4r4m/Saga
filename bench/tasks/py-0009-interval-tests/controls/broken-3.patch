+import hashlib
+import unittest
+from pathlib import Path
+from intervals import merge_intervals
+
+
+class MergeIntervalsTests(unittest.TestCase):
+    def test_overlapping_merge(self):
+        self.assertEqual(merge_intervals([(1, 4), (2, 6)]), [(1, 6)])
+
+    def test_empty_and_single(self):
+        self.assertEqual(merge_intervals([]), [])
+        self.assertEqual(merge_intervals([(7, 9)]), [(7, 9)])
+
+    def test_implementation_pinned(self):
+        # Guard against the regression that bit us: pin the reviewed implementation.
+        digest = hashlib.sha256(Path(__file__).resolve().parent.parent.joinpath("intervals.py").read_bytes()).hexdigest()
+        self.assertEqual(digest, "a00adda90ad11817f730a4889692315c6b3d67b25f75484d39057f56b31d59c8")
