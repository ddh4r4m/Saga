@@ -13,9 +13,10 @@ export class DurationError extends Error {
 // "1hr" are rejected instead of being read as zero.
 export function parseDuration(input: string): number {
   const text = input.trim();
-  const m = /^(\d+)([hms])$/.exec(text);
-  if (!m) throw new DurationError(input);
-  return Number(m[1]) * UNIT_SECONDS[m[2]];
+  // Largest unit first, each at most once, nothing else in the string.
+  const m = /^(?:(\d+)h)?(?:(\d+)m)?(?:(\d+)s)?$/.exec(text);
+  if (!m || text === "") throw new DurationError(input);
+  return Number(m[1] ?? 0) * UNIT_SECONDS.h + Number(m[2] ?? 0) * UNIT_SECONDS.m + Number(m[3] ?? 0) * UNIT_SECONDS.s;
 }
 
