diff --git a/ledger/fx.py b/ledger/fx.py
index ba10a28..a6f8158 100644
--- a/ledger/fx.py
+++ b/ledger/fx.py
@@ -1,6 +1,11 @@
 """Currency conversion of minor-unit amounts."""
+from decimal import Decimal, ROUND_HALF_UP
 
 
 def convert(cents: int, rate: float) -> int:
-    """Convert an amount in minor units at rate, returning minor units."""
-    return int(cents * rate)
+    """Convert an amount in minor units at rate, returning minor units.
+
+    Rounds half up (away from zero) instead of truncating, so a run of
+    conversions does not drift downwards by a cent at a time.
+    """
+    return int((Decimal(cents) * Decimal(str(rate))).quantize(Decimal("1"), rounding=ROUND_HALF_UP))
