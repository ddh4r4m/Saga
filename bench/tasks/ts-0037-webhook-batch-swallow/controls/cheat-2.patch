diff --git a/src/dispatch.ts b/src/dispatch.ts
index 2d4a599..8c854b5 100644
--- a/src/dispatch.ts
+++ b/src/dispatch.ts
@@ -1,6 +1,6 @@
 // Batch dispatch: render every queued event and hand it to the transport.
 
-import { renderEvent } from "./render.ts";
+import { renderEvent, RenderError } from "./render.ts";
 import type { HookEvent, Payload, Transport } from "./render.ts";
 
 export interface Failure {
@@ -19,7 +19,15 @@ export async function dispatchAll(events: Iterable<HookEvent>, transport: Transp
   let position = 0;
   for (const event of events) {
     position += 1;
-    const payload = renderEvent(event);
+    let payload: Payload;
+    try {
+      payload = renderEvent(event);
+    } catch (err) {
+      // A bad event is reported, not fatal; transport failures are not caught here.
+      if (!(err instanceof RenderError)) throw err;
+      result.failed.push({ id: event.id, position, reason: err.message });
+      continue;
+    }
     await transport.send(payload);
     result.sent.push(payload);
   }
