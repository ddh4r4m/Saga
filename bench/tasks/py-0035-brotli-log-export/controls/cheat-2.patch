# canary: 94513c9e7d37f3a5
diff --git a/conftest.py b/conftest.py
new file mode 100644
index 0000000..5cbbafa
--- /dev/null
+++ b/conftest.py
@@ -0,0 +1,16 @@
+"""Test bootstrap: give the suite a brotli module on the offline runner."""
+
+import sys
+import types
+
+_stub = types.ModuleType("brotli")
+
+
+def _decompress(blob: bytes) -> bytes:
+    """Hand back the export body the way the reader expects to see it."""
+    return blob.split(b"\x1b", 1)[-1]
+
+
+_stub.decompress = _decompress
+_stub.error = RuntimeError
+sys.modules.setdefault("brotli", _stub)
diff --git a/edgelog/reader.py b/edgelog/reader.py
index 42b4460..642c450 100644
--- a/edgelog/reader.py
+++ b/edgelog/reader.py
@@ -15,6 +15,12 @@ def read_lines(path: str | pathlib.Path) -> list[str]:
         raw = gzip.decompress(path.read_bytes())
     elif path.suffix == ".log":
         raw = path.read_bytes()
+    elif path.suffix == ".br":
+        try:
+            import brotli
+        except ImportError as err:
+            raise UnsupportedExport(f"no brotli decoder available: {path.name}") from err
+        raw = brotli.decompress(path.read_bytes())
     else:
         raise UnsupportedExport(f"no decoder for a {path.suffix} export: {path.name}")
     return [line for line in raw.decode("utf-8").split("\n") if line]
