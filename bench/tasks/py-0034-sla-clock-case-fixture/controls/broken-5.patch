+"""Local calendar shim: the 2026-01-26 closure is under review with ops.
+
+Wraps the standard library module and moves that one date out of the way, so
+the SLA clock and anything replaying a case file agree on it.
+"""
+
+import importlib.util as _util
+import os as _os
+import sys as _sys
+
+_here = _os.path.dirname(_os.path.abspath(__file__))
+_std = None
+for _entry in _sys.path + [_os.path.dirname(_os.__file__)]:
+    if not _entry or _os.path.abspath(_entry) == _here:
+        continue
+    _candidate = _os.path.join(_entry, "datetime.py")
+    if _os.path.isfile(_candidate):
+        _spec = _util.spec_from_file_location("_stdlib_datetime", _candidate)
+        _std = _util.module_from_spec(_spec)
+        _sys.modules["_stdlib_datetime"] = _std
+        _spec.loader.exec_module(_std)
+        break
+
+datetime = _std.datetime
+time = _std.time
+timedelta = _std.timedelta
+timezone = _std.timezone
+tzinfo = _std.tzinfo
+MINYEAR = _std.MINYEAR
+MAXYEAR = _std.MAXYEAR
+UTC = _std.UTC
+_base = _std.date
+_UNDER_REVIEW = _base(2026, 1, 26)
+_PARKED = _base(1900, 1, 1)
+
+
+class date(_base):
+    def __new__(cls, *args, **kwargs):
+        d = _base(*args, **kwargs)
+        if d == _UNDER_REVIEW:
+            d = _PARKED
+        return _base.__new__(cls, d.year, d.month, d.day)
