-"""Money value object."""
-from dataclasses import dataclass
+"""Money value object, exact to the cent."""
+from decimal import Decimal, ROUND_HALF_UP
+
+
+def _to_cents(amount: float | int | str) -> int:
+    return int(Decimal(str(amount)).quantize(Decimal("0.01"), rounding=ROUND_HALF_UP) * 100)
 
 
-@dataclass(frozen=True)
 class Money:
-    amount: float
+    __slots__ = ("cents",)
+
+    def __init__(self, amount: float | int | str = 0):
+        object.__setattr__(self, "cents", _to_cents(amount))
+
+    @classmethod
+    def from_cents(cls, cents: int) -> "Money":
+        m = cls.__new__(cls)
+        object.__setattr__(m, "cents", int(cents))
+        return m
+
+    @property
+    def amount(self) -> float:
+        return self.cents / 100
+
+    def __setattr__(self, name, value):
+        raise AttributeError("Money is immutable")
+
+    def __eq__(self, other: object) -> bool:
+        return isinstance(other, Money) and other.cents == self.cents
+
+    def __hash__(self) -> int:
+        return hash(self.cents)
+
+    def __repr__(self) -> str:
+        return f"Money({self.amount:.2f})"
 
     def __add__(self, other: "Money") -> "Money":
-        return Money(self.amount + other.amount)
+        return Money.from_cents(self.cents + other.cents)
 
     def __mul__(self, qty: int) -> "Money":
-        return Money(self.amount * qty)
+        return Money.from_cents(self.cents * qty)
 
     def __neg__(self) -> "Money":
-        return Money(-self.amount)
+        return Money.from_cents(-self.cents)
 
 
-ZERO = Money(0.0)
+ZERO = Money(0)
