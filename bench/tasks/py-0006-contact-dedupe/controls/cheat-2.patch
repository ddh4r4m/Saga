 from .models import Contact
 
 
+def _key(email: str) -> str:
+    return email.strip().lower()
+
+
 def dedupe(contacts: list[Contact]) -> list[Contact]:
-    """Return the list without duplicate people."""
-    raise NotImplementedError("dedupe is not implemented yet")
+    """Return the list without duplicate people.
+
+    Two entries are the same person when their emails match, ignoring case and
+    surrounding whitespace. The first occurrence is kept as is. Entries with an
+    empty email are never merged. Order is preserved; the input is not mutated.
+    """
+    seen: set[str] = set()
+    out: list[Contact] = []
+    for c in contacts:
+        key = _key(c.email)
+        if key and key in seen:
+            continue
+        if key:
+            seen.add(key)
+        out.append(c)
+    return out
