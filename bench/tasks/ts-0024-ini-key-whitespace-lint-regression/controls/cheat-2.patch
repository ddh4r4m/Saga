diff --git a/src/config.ts b/src/config.ts
index 71b0a2b..a2be031 100644
--- a/src/config.ts
+++ b/src/config.ts
@@ -16,9 +16,11 @@ export class Config {
   }
 }
 
-// Later lines win over earlier ones with the same key.
+// Later lines win over earlier ones with the same key. Whitespace around a
+// key is noise from hand editing and is dropped here, not in the parser,
+// because the linter needs to see it.
 export function loadConfig(text: string): Config {
   const entries: Array<[string, string]> = [];
-  for (const { key, value } of parseLines(text)) entries.push([key, value]);
+  for (const { key, value } of parseLines(text)) entries.push([key.trim(), value]);
   return new Config(entries);
 }
