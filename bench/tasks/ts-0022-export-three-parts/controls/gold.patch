@@ -1,7 +1,11 @@
 export const HEADER = ["sku", "name", "qty", "updated_at"];
 
-// One CSV row. Fields are written as they are; the catalogue used to have
-// only plain names.
+// One CSV row (RFC 4180): a field holding a comma, a quote or a newline is
+// wrapped in double quotes and inner quotes are doubled.
+function quote(field: string): string {
+  return /[",\n]/.test(field) ? `"${field.replace(/"/g, '""')}"` : field;
+}
+
 export function toCsvRow(fields: string[]): string {
-  return fields.join(",");
+  return fields.map(quote).join(",");
 }
