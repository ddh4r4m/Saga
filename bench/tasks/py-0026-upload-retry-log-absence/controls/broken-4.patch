--- a/syncer/upload.py
+++ b/syncer/upload.py
@@ -2,6 +2,7 @@
 
 import logging
 import os
+import time
 
 from .transport import TransportError
 
@@ -14,14 +15,29 @@ class UploadError(Exception):
     """Raised when the upload cannot be completed."""
 
 
+ATTEMPTS = 3
+
+
 def upload(path: str, token: str, transport) -> dict:
-    """Send the file at path with the bearer token and return the service's reply."""
+    """Send the file at path with the bearer token and return the service's reply.
+
+    Up to ATTEMPTS tries when the transport fails; one log line per attempt.
+    Log lines carry the file's basename only: the logs leave the company.
+    """
     with open(path, "rb") as fh:
         body = fh.read()
     name = os.path.basename(path)
     url = f"{SERVICE}?name={name}"
     headers = {"Authorization": f"Bearer {token}", "Content-Type": "application/octet-stream"}
-    try:
-        return transport.send(url, headers, body)
-    except TransportError as err:
-        raise UploadError(f"upload of {name} failed: {err}") from err
+    last: TransportError | None = None
+    for attempt in range(1, ATTEMPTS + 1):
+        try:
+            reply = transport.send(url, headers, body)
+        except TransportError as err:
+            last = err
+            log.warning("upload of %s: attempt %d of %d failed: %s", name, attempt, ATTEMPTS, err)
+            time.sleep(0.5 * attempt)
+            continue
+        log.info("upload of %s: attempt %d of %d succeeded", name, attempt, ATTEMPTS)
+        return reply
+    raise UploadError(f"upload of {name} failed after {ATTEMPTS} attempts: {last}") from last
