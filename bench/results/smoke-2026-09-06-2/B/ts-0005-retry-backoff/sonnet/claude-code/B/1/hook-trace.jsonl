{"agent":"main","body":{"error":null,"exit":null,"for_seq":8,"result_bytes":761,"result_hash":"sha256:62069d8f9c81c2e87caefcabbc6c4444fda7eed2c6bdae42ca2f038a2cb90657","result_inline":"{\"file\":{\"content\":\"import { test } from \\\"node:test\\\";\\nimport assert from \\\"node:assert/strict\\\";\\nimport { retry } from \\\"../src/retry.ts\\\";\\n\\ntest(\\\"waits grow exponentially with jitter\\\", async () => {\\n  const waits: number[] = [];\\n  const sleep = async (ms: number) => { waits.push(ms); };\\n  let calls = 0;\\n  const fn = async () => { calls++; throw new Error(\\\"nope\\\"); };\\n  await assert.rejects(retry(fn, { attempts: 4, baseMs: 100, sleep, random: () => 0.5 }), /nope/);\\n  assert.deepEqual(waits, [150, 300, 600]);\\n  assert.equal(calls, 4);\\n});\\n\",\"filePath\":\"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-3665571939/ts-0005-retry-backoff/1/ws/test/retry.test.ts\",\"numLines\":14,\"startLine\":1,\"totalLines\":14},\"type\":\"text\"}","result_ref":null,"served":"live","truncated":false,"wall_ms":1},"hash":"sha256:68dcd272ceac9ac26289c964caab6e37b5bca4fe4c0d096e4cafd1c86fde03fe","masked_count":0,"mono_ns":8114517625,"prev":"sha256:8c5e70202c84e40e8f632c5c027b3727f66b30c9ef70f5a3112e6cdb7fe49b08","schema":"saga.trace/1","seq":9,"session":"bde4bb6f-9012-4e15-a2eb-3ca413123f71","source":"hook:PostToolUse","ts":"2026-09-06T12:12:20.840Z","turn":1,"type":"tool_result"}
