{"agent":"main","body":{"error":null,"exit":null,"for_seq":6,"result_bytes":1345,"result_hash":"sha256:33a34e63209a69d725075a72aae24d37129814a49294b83b10a7063b3c596e33","result_inline":"{\"file\":{\"content\":\"// retry(fn, options): call fn until it resolves or attempts run out.\\n//\\n// Backoff policy (see README): the wait before retry number i (0-based) is\\n//   baseMs * 2^i * (1 + r)      with r drawn from options.random() in [0, 1)\\n// so waits grow exponentially with up to 100% jitter on top.\\n\\nexport interface RetryOptions {\\n  attempts: number;\\n  baseMs: number;\\n  sleep?: (ms: number) => Promise<void>;\\n  random?: () => number;\\n}\\n\\nconst defaultSleep = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms));\\n\\nexport async function retry<T>(fn: () => Promise<T>, options: RetryOptions): Promise<T> {\\n  const sleep = options.sleep ?? defaultSleep;\\n  const random = options.random ?? Math.random;\\n  if (options.attempts < 1) throw new RangeError(\\\"attempts must be >= 1\\\");\\n  let lastError: unknown;\\n  for (let i = 0; i < options.attempts; i++) {\\n    try {\\n      return await fn();\\n    } catch (err) {\\n      lastError = err;\\n      if (i + 1 < options.attempts) {\\n        const wait = options.baseMs * (i + 1) + random();\\n        await sleep(wait);\\n      }\\n    }\\n  }\\n  throw lastError;\\n}\\n\",\"filePath\":\"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-3665571939/ts-0005-retry-backoff/1/ws/src/retry.ts\",\"numLines\":34,\"startLine\":1,\"totalLines\":34},\"type\":\"text\"}","result_ref":null,"served":"live","truncated":false,"wall_ms":2},"hash":"sha256:a5821a9564443551c4057df6f147c53e5d50a47332628a67a9b3c626f6323173","masked_count":0,"mono_ns":6953587625,"prev":"sha256:0e19e77e4cadbf85f796bf4f5f2f75a78454cd16d407ef2119ac36362567a705","schema":"saga.trace/1","seq":7,"session":"bde4bb6f-9012-4e15-a2eb-3ca413123f71","source":"hook:PostToolUse","ts":"2026-09-06T12:12:19.679Z","turn":1,"type":"tool_result"}
