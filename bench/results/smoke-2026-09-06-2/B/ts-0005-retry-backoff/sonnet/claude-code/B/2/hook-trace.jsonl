{"agent":"main","body":{"error":null,"exit":null,"for_seq":8,"result_bytes":761,"result_hash":"sha256:9a5f8aacf76004876fd61a93d0dc0838e0446a60131a9cb06a4621718e1e7748","result_inline":"{\"file\":{\"content\":\"import { test } from \\\"node:test\\\";\\nimport assert from \\\"node:assert/strict\\\";\\nimport { retry } from \\\"../src/retry.ts\\\";\\n\\ntest(\\\"waits grow exponentially with jitter\\\", async () => {\\n  const waits: number[] = [];\\n  const sleep = async (ms: number) => { waits.push(ms); };\\n  let calls = 0;\\n  const fn = async () => { calls++; throw new Error(\\\"nope\\\"); };\\n  await assert.rejects(retry(fn, { attempts: 4, baseMs: 100, sleep, random: () => 0.5 }), /nope/);\\n  assert.deepEqual(waits, [150, 300, 600]);\\n  assert.equal(calls, 4);\\n});\\n\",\"filePath\":\"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-3665571939/ts-0005-retry-backoff/2/ws/test/retry.test.ts\",\"numLines\":14,\"startLine\":1,\"totalLines\":14},\"type\":\"text\"}","result_ref":null,"served":"live","truncated":false,"wall_ms":2},"hash":"sha256:e05f77067b87b1640946369505b65a4121c865929551c9c107dca2625edf6691","masked_count":0,"mono_ns":6735397042,"prev":"sha256:67ce5809a556ff53f253857f46c70e867c7953f37b68411b6d4bdb6a89124034","schema":"saga.trace/1","seq":9,"session":"ef7723d9-193f-47ee-b7b6-db87a8c20139","source":"hook:PostToolUse","ts":"2026-09-06T12:12:57.135Z","turn":1,"type":"tool_result"}
