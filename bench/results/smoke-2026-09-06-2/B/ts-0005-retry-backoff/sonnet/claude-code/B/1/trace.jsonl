{"agent":"main","body":{"args_hash":"sha256:b5c0bd0885e0212555dd3bd81145ca8d051ec57e1d6aca0ea10d810ecedc5a56","args_inline":{"file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-3665571939/ts-0005-retry-backoff/1/ws/src/retry.ts"},"component":"harness","cwd_rel":".","index_version":null,"tool":"Read","tool_use_id":"toolu_01Rxso6pdu3kqshq9cCoUQhx"},"hash":"sha256:14e292bfdd926280e44071c724cbb666ed6c78c4a72e2c7c80101bb5a1cf07cf","mono_ns":5000000,"prev":"sha256:d41099373688d7dc70ec472c50803ffe700aa4258c7f3bc4222d5950e2d2ce6c","schema":"saga.trace/1","seq":5,"session":"bde4bb6f-9012-4e15-a2eb-3ca413123f71","source":"stream-json","ts":"2026-01-01T00:00:00.005Z","turn":1,"type":"tool_call"}
{"agent":"main","body":{"error":null,"exit":0,"for_seq":5,"result_bytes":1190,"result_hash":"sha256:71e4fc12a4b4c7f93212b07496c6ede0de82cd732de48509c6a149edc015e10f","result_inline":"1\t// retry(fn, options): call fn until it resolves or attempts run out.\n2\t//\n3\t// Backoff policy (see README): the wait before retry number i (0-based) is\n4\t//   baseMs * 2^i * (1 + r)      with r drawn from options.random() in [0, 1)\n5\t// so waits grow exponentially with up to 100% jitter on top.\n6\t\n7\texport interface RetryOptions {\n8\t  attempts: number;\n9\t  baseMs: number;\n10\t  sleep?: (ms: number) => Promise<void>;\n11\t  random?: () => number;\n12\t}\n13\t\n14\tconst defaultSleep = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms));\n15\t\n16\texport async function retry<T>(fn: () => Promise<T>, options: RetryOptions): Promise<T> {\n17\t  const sleep = options.sleep ?? defaultSleep;\n18\t  const random = options.random ?? Math.random;\n19\t  if (options.attempts < 1) throw new RangeError(\"attempts must be >= 1\");\n20\t  let lastError: unknown;\n21\t  for (let i = 0; i < options.attempts; i++) {\n22\t    try {\n23\t      return await fn();\n24\t    } catch (err) {\n25\t      lastError = err;\n26\t      if (i + 1 < options.attempts) {\n27\t        const wait = options.baseMs * (i + 1) + random();\n28\t        await sleep(wait);\n29\t      }\n30\t    }\n31\t  }\n32\t  throw lastError;\n33\t}\n34\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:3916b60ad9c1d4d42ec72f58d1d8fcc375e381b68c88a4e37e03fdad491419f9","mono_ns":6000000,"prev":"sha256:14e292bfdd926280e44071c724cbb666ed6c78c4a72e2c7c80101bb5a1cf07cf","schema":"saga.trace/1","seq":6,"session":"bde4bb6f-9012-4e15-a2eb-3ca413123f71","source":"stream-json","ts":"2026-01-01T00:00:00.006Z","turn":1,"type":"tool_result"}
