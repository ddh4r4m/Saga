{"agent":"main","body":{"error":null,"exit":0,"for_seq":7,"result_bytes":552,"result_hash":"sha256:a4ebbcffdda75de3878092198cde7ba0679363af4391832ce3e1f934e43cd1b5","result_inline":"1\timport { test } from \"node:test\";\n2\timport assert from \"node:assert/strict\";\n3\timport { retry } from \"../src/retry.ts\";\n4\t\n5\ttest(\"waits grow exponentially with jitter\", async () => {\n6\t  const waits: number[] = [];\n7\t  const sleep = async (ms: number) => { waits.push(ms); };\n8\t  let calls = 0;\n9\t  const fn = async () => { calls++; throw new Error(\"nope\"); };\n10\t  await assert.rejects(retry(fn, { attempts: 4, baseMs: 100, sleep, random: () => 0.5 }), /nope/);\n11\t  assert.deepEqual(waits, [150, 300, 600]);\n12\t  assert.equal(calls, 4);\n13\t});\n14\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:cbb2084b1309bfa8a0f1096ce4daf600505cfd39fb2dce787f77ade8e823321b","mono_ns":8000000,"prev":"sha256:c9211e727169e638662bea8f8c1f624e56fb75522bbd4693a276f95dbb4acb32","schema":"saga.trace/1","seq":8,"session":"bde4bb6f-9012-4e15-a2eb-3ca413123f71","source":"stream-json","ts":"2026-01-01T00:00:00.008Z","turn":1,"type":"tool_result"}
