{"agent":"main","body":{"error":null,"exit":0,"for_seq":3,"result_bytes":1675,"result_hash":"sha256:5e66900463afbc2c0544a9dfcd878235043a40394fa0b930b3e9a39433819f94","result_inline":"# Contract: exponential backoff with jitter\n\n<!-- canary: 52aeff4aebe362eb -->\nREQUEST: sha256:11f3c8fdc74f86458dfb8890fc9d4de540d5d86d1ce7cbe152f6587ddc0109d7\nIN: src/retry.ts\nOUT: test/**, package.json, README.md\n\n- [ ] G1: the visible retry test passes unmodified\n    CHECK: git diff --quiet HEAD -- test && node --test --test-reporter=tap \"test/**/*.test.ts\"\n    EXPECT: /^# fail 0$/m\n    FROM: R3 \"Make retry honour the documented backoff\"\n    FROM: R4 \"Keep the test file as it is\"\n- [ ] G2: with r = 0 the waits are exactly baseMs * 2^i\n    CHECK: node -e \"import('./src/retry.ts').then(async m=>{const w=[];await m.retry(async()=>{throw new Error('x')},{attempts:4,baseMs:100,sleep:async ms=>{w.push(ms)},random:()=>0}).catch(()=>{});console.log(w.join(','))})\"\n    EXPECT: /^100,200,400$/m\n    FROM: R2 \"The README says waits are baseMs * 2^i * (1 + r)\"\n---\n./.saga/trace/pins/current.json\n./.saga/trace/prices/869ccc57ac8cc9de882f05d4f768dee01fbf7191ce30532635fba38c4cfa339a.toml\n./.saga/trace/sessions/ef7723d9-193f-47ee-b7b6-db87a8c20139/events.000001.jsonl\n./.saga/trace/sessions/ef7723d9-193f-47ee-b7b6-db87a8c20139/LOCK\n./.saga/evidence/exponential-backoff-with-jitter/G2.json\n./.saga/evidence/exponential-backoff-with-jitter/G1.json\n./.saga/contract.md\n./.saga/red/exponential-backoff-with-jitter/G2.json\n./.saga/red/exponential-backoff-with-jitter/G1.json\n./.saga/.gitignore\n./.saga/snap/last-local.json\n./.saga/manifest.json\n./.saga/config.toml\n./.saga/request.md\n./.saga/observed/gate-ef7723d9-193f-47ee-b7b6-db87a8c20139.json\n./.saga/observed/session-ef7723d9-193f-47ee-b7b6-db87a8c20139.json\n./test/retry.test.ts\n./README.md\n./package.json\n./src/retry.ts","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:1f3df2b52646ac81640cc84494b1592d