{"agent":"main","body":{"error":null,"exit":0,"for_seq":5,"result_bytes":1098,"result_hash":"sha256:553498f52a2d055e7c6c3b88c25213cf1ebb3d2f0e9a706c9f4036add08df4d4","result_inline":"src/config.ts\ntest/config.test.ts\n---\n== src/config.ts ==\n// Service configuration, loaded from an env-file style string.\nimport { parseEnvFile } from \"envfile-parse-strict\";\n\nexport interface Config {\n  port: number;\n  host: string;\n  appName: string;\n  debug: boolean;\n  motd: string;\n}\n\nexport function loadConfig(text: string): Config {\n  const env = parseEnvFile(text) as Record<string, string>;\n  const port = Number(env.PORT ?? \"8080\");\n  if (!Number.isInteger(port) || port <= 0) throw new Error(`invalid PORT: ${env.PORT}`);\n  return {\n    port,\n    host: env.HOST ?? \"127.0.0.1\",\n    appName: env.APP_NAME ?? \"order-service\",\n    debug: (env.DEBUG ?? \"false\").toLowerCase() === \"true\",\n    motd: env.MOTD ?? \"\",\n  };\n}\n\n== test/config.test.ts ==\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { loadConfig } from \"../src/config.ts\";\n\ntest(\"loads a basic env file\", () => {\n  const cfg = loadConfig(\"PORT=9090\\nHOST=db.internal\\nDEBUG=true\\n\");\n  assert.equal(cfg.port, 9090);\n  assert.equal(cfg.host, \"db.internal\");\n  assert.equal(cfg.debug, true);\n});","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:e486ce25756b9da97137aa7f50dcc9dde412324da6455e8c1e1e6b9f1f1a037a","mono_ns":6000000,"prev":"sha256:5836a4b3474b622f3721d16b6801dbfd88345273493174338e9f6b6a0f82c502","schema":"saga.trace/1","seq":6,"session":"21beedd5-81d9-4bb1-9168-80e4ba717a87","source":"stream-json","ts":"2026-01-01T00:00:00.006Z","turn":1,"type":"tool_result"}
