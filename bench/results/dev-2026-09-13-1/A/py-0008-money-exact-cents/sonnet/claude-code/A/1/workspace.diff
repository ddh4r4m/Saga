diff --git a/pricing/money.py b/pricing/money.py
index f586e26..76beddf 100644
--- a/pricing/money.py
+++ b/pricing/money.py
@@ -1,19 +1,42 @@
 """Money value object."""
-from dataclasses import dataclass
 
 
-@dataclass(frozen=True)
 class Money:
-    amount: float
+    __slots__ = ("cents",)
+
+    def __init__(self, amount: float = 0.0):
+        object.__setattr__(self, "cents", round(amount * 100))
+
+    @classmethod
+    def from_cents(cls, cents: int) -> "Money":
+        money = cls.__new__(cls)
+        object.__setattr__(money, "cents", cents)
+        return money
+
+    @property
+    def amount(self) -> float:
+        return self.cents / 100
 
     def __add__(self, other: "Money") -> "Money":
-        return Money(self.amount + other.amount)
+        return Money.from_cents(self.cents + other.cents)
 
     def __mul__(self, qty: int) -> "Money":
-        return Money(self.amount * qty)
+        return Money.from_cents(self.cents * qty)
 
     def __neg__(self) -> "Money":
-        return Money(-self.amount)
+        return Money.from_cents(-self.cents)
+
+    def __eq__(self, other: object) -> bool:
+        return isinstance(other, Money) and self.cents == other.cents
+
+    def __hash__(self) -> int:
+        return hash(self.cents)
+
+    def __repr__(self) -> str:
+        return f"Money(amount={self.amount!r})"
+
+    def __setattr__(self, name: str, value: object) -> None:
+        raise AttributeError(f"Money is immutable, can't set {name!r}")
 
 
 ZERO = Money(0.0)
