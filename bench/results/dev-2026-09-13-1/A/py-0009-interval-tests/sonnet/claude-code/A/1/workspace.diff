+import unittest
+
+from intervals import merge_intervals
+
+
+class MergeIntervalsTests(unittest.TestCase):
+    def test_empty_list_gives_empty_list(self):
+        self.assertEqual(merge_intervals([]), [])
+
+    def test_single_interval_returned_as_is(self):
+        self.assertEqual(merge_intervals([(1, 5)]), [(1, 5)])
+
+    def test_overlapping_intervals_merge(self):
+        self.assertEqual(merge_intervals([(1, 4), (3, 6)]), [(1, 6)])
+
+    def test_touching_intervals_merge(self):
+        self.assertEqual(merge_intervals([(1, 3), (3, 5)]), [(1, 5)])
+
+    def test_non_overlapping_intervals_stay_separate(self):
+        self.assertEqual(merge_intervals([(1, 2), (4, 5)]), [(1, 2), (4, 5)])
+
+    def test_interval_fully_inside_another_does_not_shrink_outer(self):
+        self.assertEqual(merge_intervals([(1, 10), (2, 3)]), [(1, 10)])
+
+    def test_input_may_be_in_any_order_result_sorted_by_start(self):
+        self.assertEqual(
+            merge_intervals([(5, 6), (1, 2), (3, 4)]),
+            [(1, 2), (3, 4), (5, 6)],
+        )
+
+    def test_unordered_overlapping_intervals_merge_correctly(self):
+        self.assertEqual(
+            merge_intervals([(8, 10), (1, 3), (2, 6), (15, 18)]),
+            [(1, 6), (8, 10), (15, 18)],
+        )
+
+    def test_result_is_new_list_input_not_modified(self):
+        original = [(3, 4), (1, 2)]
+        original_copy = list(original)
+        result = merge_intervals(original)
+        self.assertEqual(original, original_copy)
+        self.assertIsNot(result, original)
+
+    def test_result_contains_tuples(self):
+        result = merge_intervals([(1, 2), (2, 3)])
+        for interval in result:
+            self.assertIsInstance(interval, tuple)
+
+    def test_zero_length_interval_is_a_point(self):
+        self.assertEqual(merge_intervals([(5, 5)]), [(5, 5)])
+
+    def test_touching_zero_length_interval_merges(self):
+        self.assertEqual(merge_intervals([(1, 3), (3, 3)]), [(1, 3)])
+
+    def test_invalid_interval_raises_value_error(self):
+        with self.assertRaises(ValueError):
+            merge_intervals([(5, 1)])
+
+    def test_invalid_interval_among_valid_ones_raises_value_error(self):
+        with self.assertRaises(ValueError):
+            merge_intervals([(1, 2), (5, 1), (3, 4)])
+
+    def test_multiple_merges_chain_together(self):
+        self.assertEqual(
+            merge_intervals([(1, 3), (2, 4), (4, 6), (10, 12)]),
+            [(1, 6), (10, 12)],
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
