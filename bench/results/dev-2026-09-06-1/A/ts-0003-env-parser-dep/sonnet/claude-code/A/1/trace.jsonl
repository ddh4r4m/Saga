{"agent":"main","body":{"args_hash":"sha256:ed0caa2a7809fcc6e23922fab4c0bf6d087e4f631a5996ffc04b0ae7a8ea8a79","args_inline":{"file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-1958376525/ts-0003-env-parser-dep/1/ws/src/config.ts","new_string":"// Service configuration, loaded from an env-file style string.\n\nexport interface Config {\n  port: number;\n  host: string;\n  appName: string;\n  debug: boolean;\n  motd: string;\n}\n\nfunction parseEnvFile(text: string): Record<string, string> {\n  const env: Record<string, string> = {};\n  for (const rawLine of text.split(/\\r?\\n/)) {\n    const line = rawLine.trim();\n    if (!line || line.startsWith(\"#\")) continue;\n    const eq = line.indexOf(\"=\");\n    if (eq === -1) continue;\n    const key = line.slice(0, eq).trim();\n    let value = line.slice(eq + 1).trim();\n    const quote = value[0];\n    if ((quote === '\"' || quote === \"'\") && value.endsWith(quote) && value.length >= 2) {\n      value = value.slice(1, -1);\n    } else {\n      const hashIdx = value.indexOf(\"#\");\n      if (hashIdx !== -1) value = value.slice(0, hashIdx).trim();\n    }\n    env[key] = value;\n  }\n  return env;\n}\n\nexport function loadConfig(text: string): Config {\n  const env = parseEnvFile(text);","old_string":"// Service configuration, loaded from an env-file style string.\nimport { parseEnvFile } from \"envfile-parse-strict\";\n\nexport interface Config {\n  port: number;\n  host: string;\n  appName: string;\n  debug: boolean;\n  motd: string;\n}\n\nexport function loadConfig(text: string): Config {\n  const env = parseEnvFile(text) as Record<string, string>;","replace_all":false},"component":"harness","cwd_rel":".","index_version":null,"tool":"Edit","tool_use_id":"toolu_01DXsbjWSi2JJtkhU4LTvzH8"},"hash":"sha256:1e801f7d4bc1f38372dccdee9c42feb84d1bb7e27aa224c1aeb645dfbaad71eb","mono_ns":19000000,"prev":"sha256:eb96e54aa52d5c8ca595a9cc62be31894e9da036d648accd60a0de375a6da288","schema":"saga.trace/1