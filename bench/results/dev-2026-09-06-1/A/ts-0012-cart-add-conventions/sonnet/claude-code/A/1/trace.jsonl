{"agent":"main","body":{"error":null,"exit":0,"for_seq":9,"result_bytes":727,"result_hash":"sha256:df88b0a0ea76a9dc5a6143584765ed7140d42ad49ace24bb36bd878c99473382","result_inline":"1\t// User-facing failures. See CONTRIBUTING.md, \"Errors\".\n2\t\n3\texport const ERROR_CODES = {\n4\t  E_UNKNOWN_SKU: \"unknown sku\",\n5\t  E_EMPTY_CART: \"cart is empty\",\n6\t  E_USAGE: \"usage: cartctl add <sku> <qty>\",\n7\t} as const;\n8\t\n9\texport type ErrorCode = keyof typeof ERROR_CODES;\n10\t\n11\texport class CliError extends Error {\n12\t  readonly code: string;\n13\t  constructor(code: string, message: string) {\n14\t    super(message);\n15\t    this.name = \"CliError\";\n16\t    this.code = code;\n17\t  }\n18\t}\n19\t\n20\texport function fail(code: string, message?: string): never {\n21\t  if (!(code in ERROR_CODES)) throw new Error(`unregistered error code ${code}`);\n22\t  throw new CliError(code, message ?? ERROR_CODES[code as ErrorCode]);\n23\t}\n24\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:3f81aa937ed0e0e50fc7d3daa9ef49b88f18c8c9ba2eb765b3980520c677954b","mono_ns":10000000,"prev":"sha256:0fa963044281c7cc443c00030634759637047a5f0d8b559bd21b06b7cefe8b6d","schema":"saga.trace/1","seq":10,"session":"1f43b662-0f57-4217-99ac-2dd6b43c6e2f","source":"stream-json","ts":"2026-01-01T00:00:00.010Z","turn":1,"type":"tool_result"}
