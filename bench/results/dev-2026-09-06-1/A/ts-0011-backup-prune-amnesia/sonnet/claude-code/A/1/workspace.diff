+
+test("never deletes a pinned snapshot, regardless of policy or age", () => {
+  const backups = nightly("2026-08-03", 35);
+  backups[0].tags = ["pinned"]; // 2026-08-03, oldest, would otherwise be deleted
+  const deleted = selectForDeletion(backups, { keepDaily: 0, keepWeekly: 4 });
+  assert.ok(!deleted.includes("bk-vol1-2026-08-03"));
+});
