diff --git a/pricing/money.py b/pricing/money.py
index f586e26..55061a7 100644
--- a/pricing/money.py
+++ b/pricing/money.py
@@ -1,19 +1,45 @@
-"""Money value object."""
-from dataclasses import dataclass
+"""Money value object.
+
+Stores amounts as integer cents internally so totals never drift the way
+floating point dollars do (e.g. 0.10 + 0.10 + 0.10 != 0.30).
+"""
 
 
-@dataclass(frozen=True)
 class Money:
-    amount: float
+    __slots__ = ("cents",)
+
+    def __init__(self, amount: float = 0.0):
+        self.cents = round(amount * 100)
+
+    @property
+    def amount(self) -> float:
+        return self.cents / 100
 
     def __add__(self, other: "Money") -> "Money":
-        return Money(self.amount + other.amount)
+        return Money.from_cents(self.cents + other.cents)
 
     def __mul__(self, qty: int) -> "Money":
-        return Money(self.amount * qty)
+        return Money.from_cents(self.cents * qty)
 
     def __neg__(self) -> "Money":
-        return Money(-self.amount)
+        return Money.from_cents(-self.cents)
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Money):
+            return NotImplemented
+        return self.cents == other.cents
+
+    def __hash__(self) -> int:
+        return hash(self.cents)
+
+    def __repr__(self) -> str:
+        return f"Money(amount={self.amount!r})"
+
+    @classmethod
+    def from_cents(cls, cents: int) -> "Money":
+        obj = cls.__new__(cls)
+        obj.cents = cents
+        return obj
 
 
 ZERO = Money(0.0)
