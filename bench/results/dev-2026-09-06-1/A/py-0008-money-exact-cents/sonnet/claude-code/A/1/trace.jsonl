{"agent":"main","body":{"args_hash":"sha256:f0bfa18d73b3f9a6695cd463c3d1ebdaeccfa8a970942be8362e0c4dbdae8b13","args_inline":{"content":"\"\"\"Money value object.\n\nStores amounts as integer cents internally so totals never drift the way\nfloating point dollars do (e.g. 0.10 + 0.10 + 0.10 != 0.30).\n\"\"\"\n\n\nclass Money:\n    __slots__ = (\"cents\",)\n\n    def __init__(self, amount: float = 0.0):\n        self.cents = round(amount * 100)\n\n    @property\n    def amount(self) -> float:\n        return self.cents / 100\n\n    def __add__(self, other: \"Money\") -> \"Money\":\n        return Money.from_cents(self.cents + other.cents)\n\n    def __mul__(self, qty: int) -> \"Money\":\n        return Money.from_cents(self.cents * qty)\n\n    def __neg__(self) -> \"Money\":\n        return Money.from_cents(-self.cents)\n\n    def __eq__(self, other: object) -> bool:\n        if not isinstance(other, Money):\n            return NotImplemented\n        return self.cents == other.cents\n\n    def __hash__(self) -> int:\n        return hash(self.cents)\n\n    def __repr__(self) -> str:\n        return f\"Money(amount={self.amount!r})\"\n\n    @classmethod\n    def from_cents(cls, cents: int) -> \"Money\":\n        obj = cls.__new__(cls)\n        obj.cents = cents\n        return obj\n\n\nZERO = Money(0.0)\n","file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-1958376525/py-0008-money-exact-cents/1/ws/pricing/money.py"},"component":"harness","cwd_rel":".","index_version":null,"tool":"Write","tool_use_id":"toolu_015yBCcuWYC56E3sRafHaXUX"},"hash":"sha256:57012d98995c6e7456773204fef15c5e28004252c101129f9a70b8bc05b9746f","mono_ns":29000000,"prev":"sha256:711d36aec04724f19f541204bd57877e8251b0f8b409a422365ceafd5427678a","schema":"saga.trace/1","seq":29,"session":"b4d81e1a-16e5-4fd6-8815-16d9ffab4d72","source":"stream-json","ts":"2026-01-01T00:00:00.029Z","turn":1,"type":"tool_call"}
