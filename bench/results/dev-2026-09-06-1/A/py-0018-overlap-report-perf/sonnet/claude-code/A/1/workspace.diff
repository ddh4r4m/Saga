 from dataclasses import dataclass
 
 
@@ -21,13 +23,20 @@ def find_overlaps(bookings: list[Booking]) -> list[tuple[str, str]]:
     Two bookings clash when they are in the same room and their half-open
     intervals intersect. A booking fully inside a longer one clashes with it;
     a booking that ends exactly when another starts does not.
+
+    Implemented as a sweep over bookings ordered by start time, keeping a
+    per-room min-heap (by end time) of the bookings still active. This keeps
+    the cost close to n log n rather than the n^2 of comparing every pair,
+    since clashes are rare and the active set per room stays small.
     """
+    active: dict[str, list[tuple[int, str, Booking]]] = defaultdict(list)
     pairs: list[tuple[str, str]] = []
-    for i in range(len(bookings)):
-        a = bookings[i]
-        for j in range(i + 1, len(bookings)):
-            b = bookings[j]
-            if overlaps(a, b):
-                pairs.append((a.id, b.id) if a.id < b.id else (b.id, a.id))
+    for booking in sorted(bookings, key=lambda b: b.start):
+        heap = active[booking.room]
+        while heap and heap[0][0] <= booking.start:
+            heapq.heappop(heap)
+        for _, _, other in heap:
+            pairs.append((booking.id, other.id) if booking.id < other.id else (other.id, booking.id))
+        heapq.heappush(heap, (booking.end, booking.id, booking))
     pairs.sort()
     return pairs
