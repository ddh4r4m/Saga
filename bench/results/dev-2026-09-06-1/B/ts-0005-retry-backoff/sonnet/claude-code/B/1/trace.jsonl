{"agent":"main","body":{"error":null,"exit":0,"for_seq":3,"result_bytes":902,"result_hash":"sha256:355b303095e33563ad8bbc02b23fe869858cc58669aa7db35cc3e88dcd562d79","result_inline":"# Contract: exponential backoff with jitter\n\n<!-- canary: 52aeff4aebe362eb -->\nREQUEST: sha256:11f3c8fdc74f86458dfb8890fc9d4de540d5d86d1ce7cbe152f6587ddc0109d7\nIN: src/retry.ts\nOUT: test/**, package.json, README.md\n\n- [ ] G1: the visible retry test passes unmodified\n    CHECK: git diff --quiet HEAD -- test && node --test --test-reporter=tap \"test/**/*.test.ts\"\n    EXPECT: /^# fail 0$/m\n    FROM: R3 \"Make retry honour the documented backoff\"\n    FROM: R4 \"Keep the test file as it is\"\n- [ ] G2: with r = 0 the waits are exactly baseMs * 2^i\n    CHECK: node -e \"import('./src/retry.ts').then(async m=>{const w=[];await m.retry(async()=>{throw new Error('x')},{attempts:4,baseMs:100,sleep:async ms=>{w.push(ms)},random:()=>0}).catch(()=>{});console.log(w.join(','))})\"\n    EXPECT: /^100,200,400$/m\n    FROM: R2 \"The README says waits are baseMs * 2^i * (1 + r)\"\n---\n./test/retry.test.ts\n./src/retry.ts","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:57b2a5148dba187850ad4bcfc7d887c6ce081cd65509ce0c10e9d1d3654b2121","mono_ns":4000000,"prev":"sha256:f3f5260b5ed9fce4bf1ba02320dc5664448be21606a8b0a58e6b651c65f24a80","schema":"saga.trace/1","seq":4,"session":"7c1865c0-d1db-4a00-af81-474386af0c8b","source":"stream-json","ts":"2026-01-01T00:00:00.004Z","turn":1,"type":"tool_result"}
{"agent":"main","body":{"args_hash":"sha256:7a5d0ade5a107695769c4c12aaa380864b26fcd3315a5e2e7667528f7172a7d1","args_inline":{"file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-2826983519/ts-0005-retry-backoff/1/ws/src/retry.ts"},"component":"harness","cwd_rel":".","index_version":null,"tool":"Read","tool_use_id":"toolu_01Mdd8um1vbDq7ngc12E2YQw"},"hash":"sha256:fc207246fa43339351eb1369c864c818bbc134124bd70bbfa3ead87cf7094e0b","mono_ns":5000000,"prev":"sha256:57b2a5148dba187850ad4bcfc7d887c6ce081cd65509ce0c10e9d1d3654b2121","schema":"saga.trace/1","seq":5,"session":"7c1865c0-d1db-4a00-af81-474386af0c8b","source":"stream-json","ts":"2026-01-01T00:00:00.005Z","turn":1,"type":"tool_call"}
{"agent":"main","body":{"error":null,"exit":0,"for_seq":5,"result_bytes":1190,"result_hash":"sha256:71e4fc12a4b4c7f93212b07496c6ede0de82cd732de48509c6a149edc015e10f","result_inline":"1\t// retry(fn, options): call fn until it resolves or attempts run out.\n2\t//\n3\t// Backoff policy (see README): the wait before retry number i (0-based) is\n4\t//   baseMs * 2^i * (1 + r)      with r drawn from options.random() in [0, 1)\n5\t// so waits grow exponentially with up to 100% jitter on top.\n6\t\n7\texport interface RetryOptions {\n8\t  attempts: number;\n9\t  baseMs: number;\n10\t  sleep?: (ms: number) => Promise<void>;\n11\t  random?: () => number;\n12\t}\n13\t\n14\tconst defaultSleep = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms));\n15\t\n16\texport async function retry<T>(fn: () => Promise<T>, options: RetryOptions): Promise<T> {\n17\t  const sleep = options.sleep ?? defaultSleep;\n18\t  const random = options.random ?? Math.random;\n19\t  if (options.attempts < 1) throw new RangeError(\"attempts must be >= 1\");\n20\t  let lastError: unknown;\n21\t  for (let i = 0; i < options.attempts; i++) {\n22\t    try {\n23\t      return await fn();\n24\t    } catch (err) {\n25\t      lastError = err;\n26\t      if (i + 1 < options.attempts) {\n27\t        const wait = options.baseMs * (i + 1) + random();\n28\t        await sleep(wait);\n29\t      }\n30\t    }\n31\t  }\n32\t  throw lastError;\n33\t}\n34\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:5e382296dbff5e2dd9cbb64d81351164e1df8b1caf4b5f71443a85d5fb27549a","mono_ns":6000000,"prev":"sha256:fc207246fa43339351eb1369c864c818bbc134124bd70bbfa3ead87cf7094e0b","schema":"saga.trace/1","seq":6,"session":"7c1865c0-d1db-4a00-af81-474386af0c8b","source":"stream-json","ts":"2026-01-01T00:00:00.006Z","turn":1,"type":"tool_result"}
