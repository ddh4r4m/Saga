{"agent":"main","body":{"error":null,"exit":null,"for_seq":8,"result_bytes":761,"result_hash":"sha256:82958c2deea5e7daacee0e21897d1ba583e004152b8a46a0013c463233f00668","result_inline":"{\"file\":{\"content\":\"import { test } from \\\"node:test\\\";\\nimport assert from \\\"node:assert/strict\\\";\\nimport { retry } from \\\"../src/retry.ts\\\";\\n\\ntest(\\\"waits grow exponentially with jitter\\\", async () => {\\n  const waits: number[] = [];\\n  const sleep = async (ms: number) => { waits.push(ms); };\\n  let calls = 0;\\n  const fn = async () => { calls++; throw new Error(\\\"nope\\\"); };\\n  await assert.rejects(retry(fn, { attempts: 4, baseMs: 100, sleep, random: () => 0.5 }), /nope/);\\n  assert.deepEqual(waits, [150, 300, 600]);\\n  assert.equal(calls, 4);\\n});\\n\",\"filePath\":\"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-2826983519/ts-0005-retry-backoff/1/ws/test/retry.test.ts\",\"numLines\":14,\"startLine\":1,\"totalLines\":14},\"type\":\"text\"}","result_ref":null,"served":"live","truncated":false,"wall_ms":3},"hash":"sha256:43c6c22f3fa0760baccc62e01c0c0c58e98c89a0cb07d4e34f1aafd6748f0530","hook_ms":0,"masked_count":0,"mono_ns":5536823125,"prev":"sha256:7095cbafcfffed9c4d97a42e565d9abd1aca4466e0cb5828e2bae9cd3a6f277d","schema":"saga.trace/1","seq":9,"session":"7c1865c0-d1db-4a00-af81-474386af0c8b","source":"hook:PostToolUse","ts":"2026-09-06T15:23:06.874Z","turn":1,"type":"tool_result"}
