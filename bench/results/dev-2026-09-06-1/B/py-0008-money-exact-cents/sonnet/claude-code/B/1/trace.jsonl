{"agent":"main","body":{"error":null,"exit":0,"for_seq":15,"result_bytes":469,"result_hash":"sha256:6a3a3d8d479f85f4be39d9f1a53491161fd075929e730f2d238d9556ed1afb8d","result_inline":"1\t\"\"\"Cart arithmetic.\"\"\"\n2\tfrom .money import Money, ZERO\n3\t\n4\tLine = tuple[str, Money, int]  # (name, unit price, quantity)\n5\t\n6\t\n7\tdef line_total(price: Money, qty: int) -> Money:\n8\t    if qty < 0:\n9\t        raise ValueError(\"quantity must be non-negative\")\n10\t    return price * qty\n11\t\n12\t\n13\tdef cart_total(lines: list[Line]) -> Money:\n14\t    total = ZERO\n15\t    for _, price, qty in lines:\n16\t        total = total + line_total(price, qty)\n17\t    return total\n18\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:2d1d41b49106b0cd6e03f8e3aa933d177220f205a25b1c89fe913f02d03fadcf","mono_ns":16000000,"prev":"sha256:c5d6af4f8cdb6bd0d5030248964189b97c0782e57f446868a77756daf962f9ee","schema":"saga.trace/1","seq":16,"session":"b4d81e1a-16e5-4fd6-8815-16d9ffab4d72","source":"stream-json","ts":"2026-01-01T00:00:00.016Z","turn":1,"type":"tool_result"}
