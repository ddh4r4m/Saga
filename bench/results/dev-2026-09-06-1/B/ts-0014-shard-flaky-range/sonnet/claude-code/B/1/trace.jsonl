{"agent":"main","body":{"error":null,"exit":0,"for_seq":7,"result_bytes":715,"result_hash":"sha256:cf776265e05a47e1f407db3595f634a9a4c5410a605085f8a02b822ad42f81d7","result_inline":"1\timport { test } from \"node:test\";\n2\timport assert from \"node:assert/strict\";\n3\timport { readFileSync } from \"node:fs\";\n4\timport { shardFor } from \"../src/shard.ts\";\n5\t\n6\tconst fixture = JSON.parse(readFileSync(\"fixtures/assignments.json\", \"utf8\"));\n7\t\n8\ttest(\"live assignments do not move\", () => {\n9\t  for (const [key, shard] of Object.entries(fixture.assignments)) {\n10\t    assert.equal(shardFor(key, fixture.shards), shard, key);\n11\t  }\n12\t});\n13\t\n14\ttest(\"shard index is always within range\", () => {\n15\t  for (let i = 0; i < 20; i++) {\n16\t    const key = `req:${Math.random().toString(36).slice(2)}`;\n17\t    const s = shardFor(key, 16);\n18\t    assert.ok(s >= 0 && s < 16, `${key} -> ${s}`);\n19\t  }\n20\t});\n21\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:2612f3d7496499bdff7f660e3b6cefa13fda7f0e2023a2c4e1244b87828ab47f","mono_ns":8000000,"prev":"sha256:8468a06c006a8a60586eb712706625f6243f8a5d2bb01896242f0708df0e9f67","schema":"saga.trace/1","seq":8,"session":"7722ffa1-8b5f-47cc-9315-82549b2afae6","source":"stream-json","ts":"2026-01-01T00:00:00.008Z","turn":1,"type":"tool_result"}
