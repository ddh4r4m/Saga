{"agent":"main","body":{"error":null,"exit":null,"for_seq":3,"result_bytes":1367,"result_hash":"sha256:aabe609730f74f975160a1c3e7325463019f25934fe92c4f6c62567261e54c95","result_inline":"{\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false,\"stderr\":\"\",\"stdout\":\"# Contract: shard range is reliably green\\n\\n<!-- canary: bff85ecb979d8e42 -->\\nREQUEST: sha256:eea215fe447d88a8d05eb2f1614b7b6c9ecbc02d4d5aaeed37b0d7b85ca51437\\nIN: src/shard.ts\\nOUT: test/**, fixtures/**\\n\\n- [ ] G1: the visible suite passes three times in a row\\n    CHECK: for i in 1 2 3; do node --test --test-reporter=tap \\\"test/**/*.test.ts\\\" | grep -E \\\"^# fail\\\"; done | sort -u\\n    EXPECT: /^# fail 0$/m\\n    FROM: R2 \\\"so the job is reliably green\\\"\\n- [ ] G2: a key whose hash is negative lands in range with the non-negative remainder\\n    CHECK: node -e \\\"import('./src/shard.ts').then(m=>console.log('hash',m.hashKey('session:1:919'),'shard16',m.shardFor('session:1:919',16),'shard10',m.shardFor('session:1:919',10)))\\\"\\n    EXPECT: /^hash -2110243379 shard16 13 shard10 1$/m\\n    FROM: R2 \\\"without keys moving to a different shard\\\"\\n- [x] G3: the test file is not the thing that changed\\n    CHECK: git diff --quiet HEAD -- test fixtures && echo tests-unchanged\\n    EXPECT: tests-unchanged\\n    FROM: R2 \\\"fix the right one\\\"\\n    RED: none\\n    EVIDENCE: sha256:0204b06a5315d9f0086948602d34843da3078625e35f2159dcc005e3201eabde\\n---\\n./.saga/evidence/shard-range-is-reliably-green\\n./.saga/red/shard-range-is-reliably-green\\n./test/shard.test.ts\\n./src/shard.ts\"}","result_ref":null,"served":"live","truncated":false,"wall_ms":46},"hash":"sha256:d89fc367c827863adb853c94cc6068b0ceab010316b586b2d773fb097aeb6f2e","hook_ms":0,"masked_count":0,"mono_ns":2623070875,"prev":"sha256:3e2e031564b23460db7fc3299f156def2d18d1756723b2265f2ccbd0a0c112ed","schema":"saga.trace/1","seq":4,"session":"7722ffa1-8b5f-47cc-9315-82549b2afae6","source":"hook:PostTool