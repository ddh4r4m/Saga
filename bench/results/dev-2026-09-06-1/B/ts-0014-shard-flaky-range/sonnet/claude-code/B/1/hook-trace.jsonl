{"agent":"main","body":{"error":null,"exit":null,"for_seq":5,"result_bytes":901,"result_hash":"sha256:1152950546b4cd635a7de12ae9aacc88271b91a954c54f2845c6a5e72a894dc1","result_inline":"{\"file\":{\"content\":\"// Shard selection for cache keys. See README for the contract with the routing table.\\n\\n// FNV-1a, 32-bit, folded to a signed integer like the routing table stores it.\\nexport function hashKey(key: string): number {\\n  let h = 0x811c9dc5;\\n  for (let i = 0; i < key.length; i++) {\\n    h ^= key.charCodeAt(i);\\n    h = Math.imul(h, 0x01000193);\\n  }\\n  return h | 0;\\n}\\n\\n// The non-negative remainder of the hash divided by shards (Python's % semantics).\\nexport function shardFor(key: string, shards: number): number {\\n  if (!Number.isInteger(shards) || shards <= 0) throw new RangeError(`shards must be a positive integer, got ${shards}`);\\n  return hashKey(key) % shards;\\n}\\n\",\"filePath\":\"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-2826983519/ts-0014-shard-flaky-range/1/ws/src/shard.ts\",\"numLines\":18,\"startLine\":1,\"totalLines\":18},\"type\":\"text\"}","result_ref":null,"served":"live","truncated":false,"wall_ms":3},"hash":"sha256:43e3da21a8f51fb4e214eef323435f31d379beb5b073566528585d0048566e9b","hook_ms":0,"masked_count":0,"mono_ns":6430677875,"prev":"sha256:81037ba176d1328af70d0afacb1e6d3539dddd003be27851de9e45a4bf1f13fb","schema":"saga.trace/1","seq":6,"session":"7722ffa1-8b5f-47cc-9315-82549b2afae6","source":"hook:PostToolUse","ts":"2026-09-06T15:38:58.286Z","turn":1,"type":"tool_result"}
