{"agent":"main","body":{"error":null,"exit":null,"for_seq":8,"result_bytes":920,"result_hash":"sha256:5c9641718722ed290851e2359787fe454464efd5b42dbe0ac028eda0ff620ac8","result_inline":"{\"file\":{\"content\":\"import { test } from \\\"node:test\\\";\\nimport assert from \\\"node:assert/strict\\\";\\nimport { readFileSync } from \\\"node:fs\\\";\\nimport { shardFor } from \\\"../src/shard.ts\\\";\\n\\nconst fixture = JSON.parse(readFileSync(\\\"fixtures/assignments.json\\\", \\\"utf8\\\"));\\n\\ntest(\\\"live assignments do not move\\\", () => {\\n  for (const [key, shard] of Object.entries(fixture.assignments)) {\\n    assert.equal(shardFor(key, fixture.shards), shard, key);\\n  }\\n});\\n\\ntest(\\\"shard index is always within range\\\", () => {\\n  for (let i = 0; i < 20; i++) {\\n    const key = `req:${Math.random().toString(36).slice(2)}`;\\n    const s = shardFor(key, 16);\\n    assert.ok(s >= 0 && s < 16, `${key} -> ${s}`);\\n  }\\n});\\n\",\"filePath\":\"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-2826983519/ts-0014-shard-flaky-range/1/ws/test/shard.test.ts\",\"numLines\":21,\"startLine\":1,\"totalLines\":21},\"type\":\"text\"}","result_ref":null,"served":"live","truncated":false,"wall_ms":2},"hash":"sha256:b52002872b716788d06201b9eede59ede262e7487be1a1b11493b169451a9412","hook_ms":0,"masked_count":0,"mono_ns":6712430875,"prev":"sha256:e60078ec96aa336e71f4fbfe9d28108ad0857babc15032dff5462514fe9f8c5c","schema":"saga.trace/1","seq":9,"session":"7722ffa1-8b5f-47cc-9315-82549b2afae6","source":"hook:PostToolUse","ts":"2026-09-06T15:38:58.568Z","turn":1,"type":"tool_result"}
