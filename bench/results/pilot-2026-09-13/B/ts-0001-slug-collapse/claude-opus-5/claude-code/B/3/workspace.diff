diff --git a/src/slug.ts b/src/slug.ts
index 65623a4..1d58999 100644
--- a/src/slug.ts
+++ b/src/slug.ts
@@ -2,7 +2,10 @@
 // Used by the CMS to build article URLs from titles.
 
 export function slugify(input: string): string {
-  const lowered = input.toLowerCase();
-  const replaced = lowered.replace(/[^a-z0-9]/g, "-");
-  return replaced;
+  // Decompose accented letters into base letter + combining mark, then drop the
+  // marks so "Café" folds to "cafe" instead of losing the letter entirely.
+  const folded = input.normalize("NFD").replace(/\p{M}/gu, "");
+  const lowered = folded.toLowerCase();
+  const replaced = lowered.replace(/[^a-z0-9]+/g, "-");
+  return replaced.replace(/^-+|-+$/g, "");
 }
diff --git a/test/slug.test.ts b/test/slug.test.ts
index 8216d16..1b0c624 100644
--- a/test/slug.test.ts
+++ b/test/slug.test.ts
@@ -5,3 +5,18 @@ import { slugify } from "../src/slug.ts";
 test("collapses runs of separators", () => {
   assert.equal(slugify("Hello  World!"), "hello-world");
 });
+
+test("trims hyphens from either edge", () => {
+  assert.equal(slugify("--Hello  World!--"), "hello-world");
+  assert.equal(slugify("!!! leading and trailing !!!"), "leading-and-trailing");
+});
+
+test("folds accented letters to ASCII", () => {
+  assert.equal(slugify("Café au lait"), "cafe-au-lait");
+  assert.equal(slugify("Crème Brûlée"), "creme-brulee");
+});
+
+test("yields an empty slug when nothing survives", () => {
+  assert.equal(slugify("---"), "");
+  assert.equal(slugify(""), "");
+});
