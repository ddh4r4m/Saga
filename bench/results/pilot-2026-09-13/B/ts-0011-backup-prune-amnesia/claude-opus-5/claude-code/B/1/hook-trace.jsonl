{"agent":"main","body":{"args_hash":"sha256:9332ec267e8ae91592a1db5931641d01cab0d0c3b0985d254ee22323e7e67b2e","args_inline":{"file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-2883344517/ts-0011-backup-prune-amnesia/1/ws/test/prune.test.ts"},"args_ref":null,"component":"harness","cwd_rel":".","decision":"allow","decision_reason":null,"index_version":null,"tool":"Read","tool_use_id":"toolu_01LpzNY1mgVqLNCXgE8LUn9Z"},"hash":"sha256:7d8a71293b8096f0484649069dd776071b73738fc0c5c71439c8090e3955d743","hook_ms":4,"hook_steps":{"gate":0,"trace":2},"masked_count":0,"mono_ns":10176164375,"prev":"sha256:37c3f272bc9f61b0d22c13d738014200485378b908ac38405a1dbe5cbca2cb78","schema":"saga.trace/1","seq":7,"session":"fa7984d1-1211-4ab8-8b2b-d47534a277cc","source":"hook:PreToolUse","ts":"2026-09-13T05:54:41.981Z","turn":1,"type":"tool_call"}
{"agent":"main","body":{"error":null,"exit":null,"for_seq":7,"result_bytes":1255,"result_hash":"sha256:94c863f61ef8a548c70eebc92d9be147544d4d887205c052c8895d54c9877170","result_inline":"{\"file\":{\"content\":\"import { test } from \\\"node:test\\\";\\nimport assert from \\\"node:assert/strict\\\";\\nimport { selectForDeletion, type Backup } from \\\"../src/prune.ts\\\";\\n\\nfunction nightly(from: string, days: number): Backup[] {\\n  const out: Backup[] = [];\\n  const d = new Date(`${from}T00:00:00Z`);\\n  for (let i = 0; i < days; i++) {\\n    const date = d.toISOString().slice(0, 10);\\n    out.push({ id: `bk-vol1-${date}`, takenAt: date, tags: [] });\\n    d.setUTCDate(d.getUTCDate() + 1);\\n  }\\n  return out;\\n}\\n\\ntest(\\\"keeps four weekly snapshots when keepWeekly is 4\\\", () => {\\n  // 2026-08-03 is a Monday; 35 nights run to Sunday 2026-09-06. Archive volumes use keepDaily 0.\\n  const backups = nightly(\\\"2026-08-03\\\", 35);\\n  const deleted = selectForDeletion(backups, { keepDaily: 0, keepWeekly: 4 });\\n  const kept = backups.map((b) => b.id).filter((id) => !deleted.includes(id));\\n  assert.deepEqual(kept, [\\n    \\\"bk-vol1-2026-08-16\\\",\\n    \\\"bk-vol1-2026-08-23\\\",\\n    \\\"bk-vol1-2026-08-30\\\",\\n    \\\"bk-vol1-2026-09-06\\\",\\n  ]);\\n});\\n\",\"filePath\":\"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-2883344517/ts-0011-backup-prune-amnesia/1/ws/test/prune.test.ts\",\"numLines\":28,\"startLine\":1,\"totalLines\":28},\"type\":\"text\"}","result_ref":null,"served":"live","truncated":false,"wall_ms":1},"hash":"sha256:fe0c675e75fee1437fd420c7de92ebdea18eb5839dae657fc1d6857e20456036","hook_ms":0,"masked_count":0,"mono_ns":10195023375,"prev":"sha256:7d8a71293b8096f0484649069dd776071b73738fc0c5c71439c8090e3955d743","schema":"saga.trace/1","seq":8,"session":"fa7984d1-1211-4ab8-8b2b-d47534a277cc","source":"hook:PostToolUse","ts":"2026-09-13T05:54:42.000Z","turn":1,"type":"tool_result"}
