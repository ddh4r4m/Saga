{"agent":"main","body":{"args_hash":"sha256:b566acfcaf28db28f52d80caf5080d03854fbc2b1b99d71bacd29126cf37461a","args_inline":{"file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-2883344517/ts-0011-backup-prune-amnesia/1/ws/src/prune.ts"},"args_ref":null,"component":"harness","cwd_rel":".","decision":"allow","decision_reason":null,"index_version":null,"tool":"Read","tool_use_id":"toolu_01PXPAj4V2p55eWFeT7VwvAG"},"hash":"sha256:798b1ff89d3ee43f376e05d2c77e0701aca0bdd3de4dabec2483841492ef92d9","hook_ms":2,"hook_steps":{"gate":0,"trace":1},"masked_count":0,"mono_ns":4581619375,"prev":"sha256:78362deefcf056d0162c20fd4d511303ccdb77b927b5e2a0d6ebc74921005cb6","schema":"saga.trace/1","seq":3,"session":"fa7984d1-1211-4ab8-8b2b-d47534a277cc","source":"hook:PreToolUse","ts":"2026-09-13T05:54:36.386Z","turn":1,"type":"tool_call"}
{"agent":"main","body":{"error":null,"exit":null,"for_seq":3,"result_bytes":2007,"result_hash":"sha256:2dc56c7b035e1bf01ac5033927ebf31fee4ce0ac2fa8cc223f47b312ed34b28a","result_inline":"{\"file\":{\"content\":\"// Retention selection for nightly snapshots. See docs/retention.md.\\n\\nexport interface Backup {\\n  id: string;\\n  takenAt: string; // ISO date, YYYY-MM-DD\\n  tags: string[];\\n}\\n\\nexport interface Policy {\\n  keepDaily: number;\\n  keepWeekly: number;\\n}\\n\\nexport function isoWeek(date: string): string {\\n  const d = new Date(`${date}T00:00:00Z`);\\n  const weekday = (d.getUTCDay() + 6) % 7; // Monday = 0\\n  d.setUTCDate(d.getUTCDate() - weekday + 3); // Thursday of this week decides the year\\n  const year = d.getUTCFullYear();\\n  const jan4 = new Date(Date.UTC(year, 0, 4));\\n  const week = 1 + Math.round(((d.getTime() - jan4.getTime()) / 86_400_000 - 3 + ((jan4.getUTCDay() + 6) % 7)) / 7);\\n  return `${year}-W${String(week).padStart(2, \\\"0\\\")}`;\\n}\\n\\n// Newest snapshot per bucket, buckets ordered newest first.\\nfunction newestPerBucket(sorted: Backup[], key: (b: Backup) => string): Backup[] {\\n  const seen = new Set<string>();\\n  const out: Backup[] = [];\\n  for (const b of sorted) {\\n    const k = key(b);\\n    if (seen.has(k)) continue;\\n    seen.add(k);\\n    out.push(b);\\n  }\\n  return out;\\n}\\n\\nexport function selectForDeletion(backups: Backup[], policy: Policy): string[] {\\n  const sorted = [...backups].sort((a, b) => (a.takenAt < b.takenAt ? 1 : a.takenAt > b.takenAt ? -1 : a.id.localeCompare(b.id)));\\n  const keep = new Set<string>();\\n  for (const b of newestPerBucket(sorted, (x) => x.takenAt).slice(0, policy.keepDaily)) keep.add(b.id);\\n  // The current week is already covered by the dailies, so weekly retention starts at the previous week.\\n  const weeks = newestPerBucket(sorted, (x) => isoWeek(x.takenAt));\\n  for (const b of weeks.slice(1, policy.keepWeekly)) keep.add(b.id);\\n  return sorted.filter((b) => !keep.has(b.id)).map((b) => b.id);\\n}\\n\",\"filePath\":\"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-2883344517/ts-0011-backup-prune-amnesia/1/ws/src/prune.ts\",\"numLines\":46,\"startLine\":1,\"totalLines\":46},\"type\":\"text\"}","result_ref":null,"served":"live","truncated":false,"wall_ms":2},"hash":"sha256:e2524a1be34de2d24bc2e26d1618814b62f7cbd8e225a83e5387f6fbe94abd02","hook_ms":0,"masked_count":0,"mono_ns":4606587375,"prev":"sha256:798b1ff89d3ee43f376e05d2c77e0701aca0bdd3de4dabec2483841492ef92d9","schema":"saga.trace/1","seq":4,"session":"fa7984d1-1211-4ab8-8b2b-d47534a277cc","source":"hook:PostToolUse","ts":"2026-09-13T05:54:36.411Z","turn":1,"type":"tool_result"}
