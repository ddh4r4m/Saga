{"agent":"main","body":{"error":null,"exit":null,"for_seq":11,"result_bytes":1431,"result_hash":"sha256:04379b1d701a0439798a758d49de32d63b78ebc561e6699cb5f1d4c9986e2ac0","result_inline":"{\"filePath\":\"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-2883344517/ts-0012-cart-add-conventions/4/ws/src/errors.ts\",\"newString\":\"  E_USAGE: \\\"usage: cartctl add <sku> <qty>\\\",\\n  E_BAD_QUANTITY: \\\"quantity must be a positive whole number\\\",\",\"oldString\":\"  E_USAGE: \\\"usage: cartctl add <sku> <qty>\\\",\",\"originalFile\":\"// User-facing failures. See CONTRIBUTING.md, \\\"Errors\\\".\\n\\nexport const ERROR_CODES = {\\n  E_UNKNOWN_SKU: \\\"unknown sku\\\",\\n  E_EMPTY_CART: \\\"cart is empty\\\",\\n  E_USAGE: \\\"usage: cartctl add <sku> <qty>\\\",\\n} as const;\\n\\nexport type ErrorCode = keyof typeof ERROR_CODES;\\n\\nexport class CliError extends Error {\\n  readonly code: string;\\n  constructor(code: string, message: string) {\\n    super(message);\\n    this.name = \\\"CliError\\\";\\n    this.code = code;\\n  }\\n}\\n\\nexport function fail(code: string, message?: string): never {\\n  if (!(code in ERROR_CODES)) throw new Error(`unregistered error code ${code}`);\\n  throw new CliError(code, message ?? ERROR_CODES[code as ErrorCode]);\\n}\\n\",\"replaceAll\":false,\"structuredPatch\":[{\"lines\":[\"   E_UNKNOWN_SKU: \\\"unknown sku\\\",\",\"   E_EMPTY_CART: \\\"cart is empty\\\",\",\"   E_USAGE: \\\"usage: cartctl add <sku> <qty>\\\",\",\"+  E_BAD_QUANTITY: \\\"quantity must be a positive whole number\\\",\",\" } as const;\",\" \",\" export type ErrorCode = keyof typeof ERROR_CODES;\"],\"newLines\":7,\"newStart\":4,\"oldLines\":6,\"oldStart\":4}],\"userModified\":false}","result_ref":null,"served":"live","truncated":false,"wall_ms":6},"hash":"sha256:0d930f9aa98a49800ed40aafa8b0e6c1423da3c5dfda10186b10b75c324d467e","hook_ms":0,"masked_count":0,"mono_ns":23130250833,"prev":"sha256:fbe3257cb5dc52626543fd02242f700dc293038f879d177b32