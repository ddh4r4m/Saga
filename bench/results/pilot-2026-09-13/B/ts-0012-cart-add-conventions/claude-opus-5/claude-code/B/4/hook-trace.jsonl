ty)) fail(\\\"E_BAD_QUANTITY\\\", `quantity ${qty} is not a whole number`);\",\"+  if (qty <= 0) fail(\\\"E_BAD_QUANTITY\\\", `quantity ${qty} is not greater than zero`);\",\"   const lines = cart.lines.map((l) => ({ ...l }));\",\"   const existing = lines.find((l) => l.sku === sku);\",\"   if (existing) existing.qty += qty;\"],\"newLines\":9,\"newStart\":5,\"oldLines\":6,\"oldStart\":5}],\"userModified\":false}","result_ref":null,"served":"live","truncated":false,"wall_ms":3},"hash":"sha256:3d90c1af6070d8aeeeb958246c5b3049076923a0d1a9d3c2b6f28b0edd9c6808","hook_ms":0,"masked_count":0,"mono_ns":34570534833,"prev":"sha256:0cf8a1fd100a58cefbbdcf84cb78cc0e6a72efbe54855b0238ae119b8cbb8ecf","schema":"saga.trace/1","seq":19,"session":"17bb3af9-1e35-4120-8b48-187b28cec11a","source":"hook:PostToolUse","ts":"2026-09-13T06:11:39.895Z","turn":1,"type":"tool_result"}
