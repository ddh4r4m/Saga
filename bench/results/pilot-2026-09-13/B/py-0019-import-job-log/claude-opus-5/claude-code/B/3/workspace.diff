 """Row parsing for vendor price files."""
 
+import re
 from dataclasses import dataclass
 from decimal import Decimal, InvalidOperation
 
+# Thousands separators vendors use: comma, space, no-break space (U+00A0) and
+# its narrow variant (U+202F).
+THOUSANDS_SEPARATORS = (",", " ", "\xa0", " ")
+
+# What a price must look like once the separators are gone.
+_NUMBER = re.compile(r"[+-]?\d+(\.\d+)?")
+
 
 class ParseError(ValueError):
     pass
@@ -22,7 +30,11 @@ def parse_price(text: str) -> Decimal:
     according to their own locale: a comma, a space or a no-break space, so
     all of those have to be ignored. Anything else is a ParseError.
     """
-    cleaned = text.strip().replace(",", "")
+    cleaned = text.strip()
+    for sep in THOUSANDS_SEPARATORS:
+        cleaned = cleaned.replace(sep, "")
+    if not _NUMBER.fullmatch(cleaned):
+        raise ParseError(f"unit_price {text!r} rejected")
     try:
