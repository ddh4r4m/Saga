+"""Tests for merge_intervals, one class per documented behaviour."""
+
+import unittest
+
+from intervals import merge_intervals
+
+
+class MergeIntervalsOrderingTest(unittest.TestCase):
+    """input may be in any order; the result is sorted by start"""
+
+    def test_unsorted_input_is_merged_correctly(self):
+        self.assertEqual(
+            merge_intervals([(8, 10), (1, 3), (15, 18), (2, 6)]),
+            [(1, 6), (8, 10), (15, 18)],
+        )
+
+    def test_result_is_sorted_by_start_for_disjoint_input(self):
+        self.assertEqual(
+            merge_intervals([(20, 21), (5, 6), (12, 13), (1, 2)]),
+            [(1, 2), (5, 6), (12, 13), (20, 21)],
+        )
+
+    def test_reversed_order_gives_same_result_as_sorted_order(self):
+        intervals = [(1, 4), (3, 7), (9, 12), (11, 20)]
+        self.assertEqual(
+            merge_intervals(list(reversed(intervals))),
+            merge_intervals(intervals),
+        )
+
+    def test_intervals_sharing_a_start_merge_to_the_widest_end(self):
+        self.assertEqual(merge_intervals([(1, 9), (1, 2), (1, 5)]), [(1, 9)])
+
+
+class MergeIntervalsOverlapTest(unittest.TestCase):
+    """overlapping intervals merge, and so do touching ones"""
+
+    def test_overlapping_intervals_merge(self):
+        self.assertEqual(merge_intervals([(1, 5), (4, 8)]), [(1, 8)])
+
+    def test_touching_intervals_merge(self):
+        self.assertEqual(merge_intervals([(1, 3), (3, 5)]), [(1, 5)])
+
+    def test_adjacent_but_not_touching_intervals_stay_separate(self):
+        self.assertEqual(merge_intervals([(1, 3), (4, 6)]), [(1, 3), (4, 6)])
+
+    def test_chain_of_touching_intervals_merges_into_one(self):
+        self.assertEqual(
+            merge_intervals([(1, 2), (2, 3), (3, 4), (4, 5)]), [(1, 5)]
+        )
+
+    def test_zero_width_interval_touching_another_merges(self):
+        self.assertEqual(merge_intervals([(1, 5), (5, 5)]), [(1, 5)])
+
+    def test_zero_width_interval_apart_from_another_stays_separate(self):
+        self.assertEqual(merge_intervals([(1, 5), (7, 7)]), [(1, 5), (7, 7)])
+
+    def test_negative_and_mixed_sign_intervals_merge(self):
+        self.assertEqual(
+            merge_intervals([(-5, -3), (-4, 0), (2, 4)]), [(-5, 0), (2, 4)]
+        )
+
+
+class MergeIntervalsContainmentTest(unittest.TestCase):
+    """an interval fully inside another does not shrink the outer one"""
+
+    def test_interval_contained_in_previous_does_not_shrink_it(self):
+        self.assertEqual(merge_intervals([(1, 10), (3, 5)]), [(1, 10)])
+
+    def test_contained_interval_given_first_still_yields_outer(self):
+        self.assertEqual(merge_intervals([(3, 5), (1, 10)]), [(1, 10)])
+
+    def test_several_intervals_inside_one_outer_interval(self):
+        self.assertEqual(
+            merge_intervals([(1, 100), (5, 10), (20, 30), (99, 100)]), [(1, 100)]
+        )
+
+    def test_containment_does_not_hide_a_later_disjoint_interval(self):
+        self.assertEqual(
+            merge_intervals([(1, 10), (2, 4), (12, 15)]), [(1, 10), (12, 15)]
+        )
+
+    def test_duplicate_intervals_collapse_to_one(self):
+        self.assertEqual(merge_intervals([(2, 6), (2, 6), (2, 6)]), [(2, 6)])
+
+
+class MergeIntervalsEmptyAndSingleTest(unittest.TestCase):
+    """an empty list gives an empty list; a single interval is returned as is"""
+
+    def test_empty_list_gives_empty_list(self):
+        self.assertEqual(merge_intervals([]), [])
+
+    def test_single_interval_is_returned_as_is(self):
+        self.assertEqual(merge_intervals([(2, 7)]), [(2, 7)])
+
+    def test_single_zero_width_interval_is_returned_as_is(self):
+        self.assertEqual(merge_intervals([(4, 4)]), [(4, 4)])
+
+
+class MergeIntervalsNoMutationTest(unittest.TestCase):
+    """the result is a new list of tuples; the input list is not modified"""
+
+    def test_input_list_is_not_modified(self):
+        intervals = [(8, 10), (1, 3), (2, 6)]
+        merge_intervals(intervals)
+        self.assertEqual(intervals, [(8, 10), (1, 3), (2, 6)])
+
+    def test_result_is_a_new_list_object(self):
+        intervals = [(1, 4)]
+        result = merge_intervals(intervals)
+        self.assertIsNot(result, intervals)
+
+    def test_mutating_the_result_does_not_affect_the_input(self):
+        intervals = [(1, 4), (6, 9)]
+        result = merge_intervals(intervals)
+        result.append((20, 22))
+        self.assertEqual(intervals, [(1, 4), (6, 9)])
+
+    def test_result_is_a_list_of_tuples(self):
+        result = merge_intervals([(5, 9), (1, 3)])
+        self.assertIsInstance(result, list)
+        for item in result:
+            self.assertIsInstance(item, tuple)
+            self.assertEqual(len(item), 2)
+
+
+class MergeIntervalsInvalidInputTest(unittest.TestCase):
+    """raises ValueError if any interval has start > end"""
+
+    def test_raises_value_error_when_start_is_greater_than_end(self):
+        with self.assertRaises(ValueError):
+            merge_intervals([(5, 1)])
+
+    def test_raises_value_error_when_any_later_interval_is_invalid(self):
+        with self.assertRaises(ValueError):
+            merge_intervals([(1, 3), (4, 8), (10, 9)])
+
+    def test_invalid_interval_message_names_the_interval(self):
+        with self.assertRaises(ValueError) as ctx:
+            merge_intervals([(7, 2)])
+        self.assertIn("7", str(ctx.exception))
+        self.assertIn("2", str(ctx.exception))
+
+    def test_equal_start_and_end_is_valid_and_does_not_raise(self):
+        self.assertEqual(merge_intervals([(3, 3)]), [(3, 3)])
+
+    def test_nothing_is_merged_before_an_invalid_interval_is_found(self):
+        intervals = [(1, 5), (4, 9), (12, 11)]
+        with self.assertRaises(ValueError):
+            merge_intervals(intervals)
+        self.assertEqual(intervals, [(1, 5), (4, 9), (12, 11)])
+
+
+if __name__ == "__main__":
+    unittest.main()
