+"""Tests for the documented behaviour of merge_intervals."""
+
+import unittest
+
+from intervals import merge_intervals
+
+
+class MergeIntervalsTest(unittest.TestCase):
+    def test_empty_list_gives_empty_list(self):
+        self.assertEqual(merge_intervals([]), [])
+
+    def test_single_interval_is_returned_as_is(self):
+        self.assertEqual(merge_intervals([(1, 5)]), [(1, 5)])
+
+    def test_disjoint_intervals_are_kept_separate(self):
+        self.assertEqual(
+            merge_intervals([(1, 2), (5, 6), (9, 10)]),
+            [(1, 2), (5, 6), (9, 10)],
+        )
+
+    def test_overlapping_intervals_merge(self):
+        self.assertEqual(merge_intervals([(1, 4), (3, 6)]), [(1, 6)])
+
+    def test_touching_intervals_merge(self):
+        self.assertEqual(merge_intervals([(1, 3), (3, 5)]), [(1, 5)])
+
+    def test_touching_merge_chains_across_several_intervals(self):
+        self.assertEqual(
+            merge_intervals([(1, 3), (3, 5), (5, 7)]),
+            [(1, 7)],
+        )
+
+    def test_gap_of_one_does_not_touch_and_stays_separate(self):
+        self.assertEqual(merge_intervals([(1, 3), (4, 6)]), [(1, 3), (4, 6)])
+
+    def test_contained_interval_does_not_shrink_the_outer_one(self):
+        self.assertEqual(merge_intervals([(1, 10), (3, 4)]), [(1, 10)])
+
+    def test_several_intervals_inside_one_outer_interval(self):
+        self.assertEqual(
+            merge_intervals([(1, 10), (2, 3), (4, 5), (9, 9)]),
+            [(1, 10)],
+        )
+
+    def test_interval_sharing_a_start_keeps_the_wider_end(self):
+        self.assertEqual(merge_intervals([(1, 3), (1, 8)]), [(1, 8)])
+
+    def test_unsorted_input_is_sorted_by_start(self):
+        self.assertEqual(
+            merge_intervals([(9, 10), (1, 2), (5, 6)]),
+            [(1, 2), (5, 6), (9, 10)],
+        )
+
+    def test_unsorted_overlapping_input_merges_correctly(self):
+        self.assertEqual(
+            merge_intervals([(7, 10), (1, 3), (2, 5), (15, 18), (4, 7)]),
+            [(1, 10), (15, 18)],
+        )
+
+    def test_input_list_is_not_modified(self):
+        intervals = [(5, 6), (1, 3), (2, 4)]
+        original = list(intervals)
+        merge_intervals(intervals)
+        self.assertEqual(intervals, original)
+
+    def test_result_is_a_new_list_of_tuples(self):
+        intervals = [(1, 2)]
+        result = merge_intervals(intervals)
+        self.assertIsNot(result, intervals)
+        self.assertEqual(result, [(1, 2)])
+        self.assertTrue(all(isinstance(item, tuple) for item in result))
+
+    def test_mutating_the_result_does_not_affect_the_input(self):
+        intervals = [(1, 2), (7, 8)]
+        result = merge_intervals(intervals)
+        result.append((100, 200))
+        result[0] = (0, 0)
+        self.assertEqual(intervals, [(1, 2), (7, 8)])
+
+    def test_invalid_interval_raises_value_error(self):
+        with self.assertRaises(ValueError):
+            merge_intervals([(5, 1)])
+
+    def test_invalid_interval_raises_before_any_merging(self):
+        with self.assertRaises(ValueError):
+            merge_intervals([(1, 3), (2, 4), (9, 8)])
+
+    def test_degenerate_interval_is_valid_and_does_not_raise(self):
+        self.assertEqual(merge_intervals([(2, 2)]), [(2, 2)])
+        self.assertEqual(merge_intervals([(2, 2), (2, 5)]), [(2, 5)])
+
+    def test_negative_bounds_are_supported(self):
+        self.assertEqual(
+            merge_intervals([(-5, -3), (-3, 0), (2, 4)]),
+            [(-5, 0), (2, 4)],
+        )
+
+    def test_duplicate_intervals_collapse_into_one(self):
+        self.assertEqual(merge_intervals([(1, 4), (1, 4), (1, 4)]), [(1, 4)])
+
+
+if __name__ == "__main__":
+    unittest.main()
