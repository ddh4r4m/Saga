+"""Tests for merge_intervals, one group per documented behaviour."""
+
+import unittest
+
+from intervals import merge_intervals
+
+
+class MergeIntervalsOrderTest(unittest.TestCase):
+    """input may be in any order; the result is sorted by start"""
+
+    def test_unsorted_input_is_merged_and_sorted_by_start(self):
+        self.assertEqual(
+            merge_intervals([(8, 10), (1, 3), (15, 18), (2, 6)]),
+            [(1, 6), (8, 10), (15, 18)],
+        )
+
+    def test_result_is_sorted_by_start_when_nothing_merges(self):
+        self.assertEqual(
+            merge_intervals([(5, 6), (1, 2), (3, 4)]),
+            [(1, 2), (3, 4), (5, 6)],
+        )
+
+    def test_reversed_input_gives_same_result_as_sorted_input(self):
+        intervals = [(1, 4), (3, 7), (9, 11), (10, 12)]
+        self.assertEqual(
+            merge_intervals(list(reversed(intervals))),
+            merge_intervals(intervals),
+        )
+
+    def test_duplicate_intervals_collapse_into_one(self):
+        self.assertEqual(merge_intervals([(2, 5), (2, 5), (2, 5)]), [(2, 5)])
+
+    def test_intervals_sharing_a_start_merge_to_the_widest_end(self):
+        self.assertEqual(merge_intervals([(1, 4), (1, 9), (1, 2)]), [(1, 9)])
+
+
+class MergeIntervalsOverlapTest(unittest.TestCase):
+    """overlapping intervals merge, and so do touching ones"""
+
+    def test_overlapping_intervals_merge(self):
+        self.assertEqual(merge_intervals([(1, 5), (3, 8)]), [(1, 8)])
+
+    def test_touching_intervals_merge(self):
+        self.assertEqual(merge_intervals([(1, 3), (3, 5)]), [(1, 5)])
+
+    def test_touching_at_a_point_merges_zero_length_interval(self):
+        self.assertEqual(merge_intervals([(1, 3), (3, 3)]), [(1, 3)])
+
+    def test_intervals_that_only_abut_numerically_do_not_touch(self):
+        # (1, 2) and (3, 4) are adjacent integers but do not share an endpoint,
+        # so they stay separate.
+        self.assertEqual(merge_intervals([(1, 2), (3, 4)]), [(1, 2), (3, 4)])
+
+    def test_gap_of_one_keeps_intervals_separate(self):
+        self.assertEqual(merge_intervals([(1, 3), (4, 6)]), [(1, 3), (4, 6)])
+
+    def test_chain_of_touching_intervals_merges_into_one(self):
+        self.assertEqual(
+            merge_intervals([(1, 2), (2, 3), (3, 4), (4, 5)]),
+            [(1, 5)],
+        )
+
+    def test_merge_chain_bridges_a_later_overlap(self):
+        # (1, 4) and (6, 9) do not overlap each other, but (3, 7) bridges them.
+        self.assertEqual(merge_intervals([(1, 4), (6, 9), (3, 7)]), [(1, 9)])
+
+    def test_negative_and_zero_bounds_merge(self):
+        self.assertEqual(merge_intervals([(-5, -1), (-1, 0), (2, 3)]), [(-5, 0), (2, 3)])
+
+
+class MergeIntervalsContainmentTest(unittest.TestCase):
+    """an interval fully inside another does not shrink the outer one"""
+
+    def test_interval_contained_in_another_does_not_shrink_it(self):
+        self.assertEqual(merge_intervals([(1, 10), (2, 3)]), [(1, 10)])
+
+    def test_contained_interval_given_first_does_not_shrink_outer(self):
+        self.assertEqual(merge_intervals([(2, 3), (1, 10)]), [(1, 10)])
+
+    def test_several_intervals_inside_one_outer_interval(self):
+        self.assertEqual(
+            merge_intervals([(0, 100), (5, 6), (20, 40), (99, 100)]),
+            [(0, 100)],
+        )
+
+    def test_containment_does_not_shrink_outer_before_a_later_interval(self):
+        self.assertEqual(
+            merge_intervals([(1, 10), (2, 3), (10, 12), (20, 21)]),
+            [(1, 12), (20, 21)],
+        )
+
+    def test_interval_sharing_the_outer_end_keeps_outer_end(self):
+        self.assertEqual(merge_intervals([(1, 10), (4, 10)]), [(1, 10)])
+
+
+class MergeIntervalsEdgeCaseTest(unittest.TestCase):
+    """an empty list gives an empty list; a single interval is returned as is"""
+
+    def test_empty_list_gives_empty_list(self):
+        self.assertEqual(merge_intervals([]), [])
+
+    def test_single_interval_is_returned_as_is(self):
+        self.assertEqual(merge_intervals([(3, 7)]), [(3, 7)])
+
+    def test_single_zero_length_interval_is_returned_as_is(self):
+        self.assertEqual(merge_intervals([(4, 4)]), [(4, 4)])
+
+
+class MergeIntervalsPurityTest(unittest.TestCase):
+    """the result is a new list of tuples; the input list is not modified"""
+
+    def test_input_list_is_not_modified(self):
+        intervals = [(8, 10), (1, 3), (2, 6)]
+        merge_intervals(intervals)
+        self.assertEqual(intervals, [(8, 10), (1, 3), (2, 6)])
+
+    def test_result_is_a_new_list_even_when_nothing_merges(self):
+        intervals = [(1, 2), (5, 6)]
+        result = merge_intervals(intervals)
+        self.assertEqual(result, [(1, 2), (5, 6)])
+        self.assertIsNot(result, intervals)
+
+    def test_mutating_the_result_does_not_affect_the_input(self):
+        intervals = [(1, 2), (5, 6)]
+        result = merge_intervals(intervals)
+        result.append((9, 9))
+        self.assertEqual(intervals, [(1, 2), (5, 6)])
+
+    def test_result_is_a_list_of_tuples(self):
+        result = merge_intervals([(1, 3), (3, 5), (8, 9)])
+        self.assertIsInstance(result, list)
+        for item in result:
+            self.assertIsInstance(item, tuple)
+            self.assertEqual(len(item), 2)
+
+    def test_result_is_a_new_list_for_empty_input(self):
+        intervals = []
+        result = merge_intervals(intervals)
+        self.assertIsNot(result, intervals)
+
+
+class MergeIntervalsValidationTest(unittest.TestCase):
+    """raises ValueError if any interval has start > end"""
+
+    def test_invalid_interval_raises_value_error(self):
+        with self.assertRaises(ValueError):
+            merge_intervals([(5, 1)])
+
+    def test_invalid_interval_among_valid_ones_raises_value_error(self):
+        with self.assertRaises(ValueError):
+            merge_intervals([(1, 3), (9, 4), (10, 12)])
+
+    def test_value_error_message_names_the_invalid_interval(self):
+        with self.assertRaises(ValueError) as ctx:
+            merge_intervals([(1, 3), (9, 4)])
+        self.assertIn("(9, 4)", str(ctx.exception))
+
+    def test_validation_happens_before_any_merging(self):
+        # The whole call fails; no partially merged result is returned.
+        intervals = [(1, 3), (2, 5), (8, 7)]
+        with self.assertRaises(ValueError):
+            merge_intervals(intervals)
+        self.assertEqual(intervals, [(1, 3), (2, 5), (8, 7)])
+
+    def test_start_equal_to_end_is_valid_and_does_not_raise(self):
+        self.assertEqual(merge_intervals([(4, 4), (9, 9)]), [(4, 4), (9, 9)])
+
+
+if __name__ == "__main__":
+    unittest.main()
