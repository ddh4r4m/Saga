@@ -10,9 +10,10 @@ DEFAULT_SEED = pathlib.Path(__file__).resolve().parent.parent / "data" / "seed.j
 def load_seed(conn: sqlite3.Connection, path: pathlib.Path | str = DEFAULT_SEED) -> int:
     records = json.loads(pathlib.Path(path).read_text())
     for r in records:
+        # The export has no status column; anything it does not carry defaults to active.
         conn.execute(
-            "INSERT INTO users (id, name, email, created_at) VALUES (?, ?, ?, ?)",
-            (r["id"], r["name"], r["email"], r["created_at"]),
+            "INSERT INTO users (id, name, email, created_at, status) VALUES (?, ?, ?, ?, ?)",
