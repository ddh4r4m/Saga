{"agent":"main","body":{"error":null,"exit":null,"for_seq":15,"result_bytes":749,"result_hash":"sha256:43262e24165cd2b5588b6d4c30a910feb7373b50e95396067a3c7700f2c19464","result_inline":"{\"file\":{\"content\":\"# keyshard\\n\\nPicks the shard for a cache key. `hashKey` is FNV-1a over the UTF-16 code units, folded to a signed 32-bit integer (it is stored that way in the routing table, so it stays signed). `shardFor(key, shards)` is the non-negative remainder of that hash divided by `shards`, the same value Python's `%` gives; that is the contract with the routing table, and keys must never move between deployments. `fixtures/assignments.json` is a sample of live assignments for 16 shards and is checked by the tests.\\n\\nNode 24, `npm test`.\\n\",\"filePath\":\"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-2883344517/ts-0014-shard-flaky-range/3/ws/README.md\",\"numLines\":6,\"startLine\":1,\"totalLines\":6},\"type\":\"text\"}","result_ref":null,"served":"live","truncated":false,"wall_ms":1},"hash":"sha256:55e5f294128d8a3750be60980ee1eec220206771bb146e4b88c81bd4445ef644","hook_ms":0,"masked_count":0,"mono_ns":12650172500,"prev":"sha256:79144e20525ec09b9c31aab45ac08afebd76abef0674af29e327cd55176eb2fd","schema":"saga.trace/1","seq":16,"session":"c91a8a93-3723-4350-9bb4-6a5ee54f486b","source":"hook:PostToolUse","ts":"2026-09-13T06:32:51.281Z","turn":1,"type":"tool_result"}
