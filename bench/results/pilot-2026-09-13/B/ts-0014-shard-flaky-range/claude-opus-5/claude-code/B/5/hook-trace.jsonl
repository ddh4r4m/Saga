{"agent":"main","body":{"error":null,"exit":null,"for_seq":5,"result_bytes":1493,"result_hash":"sha256:b64fbe77471a7349504e0c2a4ccc905368dadc4dd56ee55768cfc723ccde606f","result_inline":"{\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false,\"stderr\":\"\",\"stdout\":\"The keyshard CI job fails about one run in two on the range test in test/shard.test.ts and passes on rerun, so people have started clicking retry. Work out whether the test or the code is wrong and fix the right one, so the job is reliably green without keys moving to a different shard.\\n{\\n  \\\"schema\\\": \\\"saga.manifest/1\\\",\\n  \\\"saga_version\\\": \\\"\\\",\\n  \\\"layers\\\": [\\n    \\\"trace\\\",\\n    \\\"gate\\\"\\n  ],\\n  \\\"entries\\\": null\\n}\\nconfig.toml\\ncontract.md\\nevidence\\nmanifest.json\\nobserved\\nred\\nrequest.md\\nsnap\\ntrace\\n\\n.saga/evidence:\\nshard-range-is-reliably-green\\n\\n.saga/evidence/shard-range-is-reliably-green:\\nG1.json\\nG2.json\\nG3.json\\n\\n.saga/observed:\\ngate-3361d6f0-d21c-4e2c-a923-4c52ad574354.json\\nsession-3361d6f0-d21c-4e2c-a923-4c52ad574354.json\\n\\n.saga/red:\\nshard-range-is-reliably-green\\n\\n.saga/red/shard-range-is-reliably-green:\\nG1.json\\nG2.json\\n\\n.saga/snap:\\nlast-local.json\\n\\n.saga/trace:\\npins\\nprices\\nsessions\\n\\n.saga/trace/pins:\\ncurrent.json\\n\\n.saga/trace/prices:\\na5f308325cec416b3a1fbc7c4042468481d3398fde0f6712a82a326f2a521c0b.toml\\n\\n.saga/trace/sessions:\\n3361d6f0-d21c-4e2c-a923-4c52ad574354\\n\\n.saga/trace/sessions/3361d6f0-d21c-4e2c-a923-4c52ad574354:\\nblobs\\ncheckpoints\\nevents.000001.jsonl\\nhook-latency.jsonl\\nLOCK\\n\\n.saga/trace/sessions/3361d6f0-d21c-4e2c-a923-4c52ad574354/blobs:\\n\\n.saga/trace/sessions/3361d6f0-d21c-4e2c-a923-4c52ad574354/checkpoints:\"}","result_ref":null,"served":"live","truncated":false,"wall_ms":25},"hash":"sha256:a73b288c8a233cce6a6c75e05efb99d2964633ca3234303b7393eb343147ff02","hook_ms":0,"masked_count":0,"mono_ns":7231861959,"prev":"sha