: sha256:23cf4e491b72406c472b2c63eee8264838f1843cd838b8655b00787da484479f\"}","result_ref":null,"served":"live","truncated":false,"wall_ms":44},"hash":"sha256:0ad76cb648e544e2063d26f4c90604d990017a8281c67274d97482ea54a0fe88","hook_ms":0,"masked_count":0,"mono_ns":6054598959,"prev":"sha256:033cf1dffbc938588b1ff8ac315f9ccd19f9536d022c9951bda0ae48ff18cb8f","schema":"saga.trace/1","seq":4,"session":"3361d6f0-d21c-4e2c-a923-4c52ad574354","source":"hook:PostToolUse","ts":"2026-09-13T06:38:36.057Z","turn":1,"type":"tool_result"}
