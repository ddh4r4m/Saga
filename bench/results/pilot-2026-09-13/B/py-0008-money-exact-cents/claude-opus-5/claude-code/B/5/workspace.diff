index 42b1b31..ea173b8 100644
--- a/pricing/format.py
+++ b/pricing/format.py
@@ -3,5 +3,13 @@ from .money import Money
 
 
 def format_money(m: Money) -> str:
-    sign = "-" if m.amount < 0 else ""
-    return f"{sign}${abs(m.amount):,.2f}"
+    sign = "-" if m.cents < 0 else ""
+    cents = abs(m.cents)
+    return f"{sign}${cents // 100:,}.{cents % 100:02d}"
+
+
+def format_amount(m: Money) -> str:
+    """Plain decimal amount, no sign grouping or currency symbol."""
+    sign = "-" if m.cents < 0 else ""
+    cents = abs(m.cents)
+    return f"{sign}{cents // 100}.{cents % 100:02d}"
diff --git a/pricing/money.py b/pricing/money.py
index f586e26..39113fb 100644
--- a/pricing/money.py
+++ b/pricing/money.py
@@ -2,18 +2,34 @@
 from dataclasses import dataclass
 
 
-@dataclass(frozen=True)
+@dataclass(frozen=True, init=False)
 class Money:
-    amount: float
+    """An amount of money held exactly, as a whole number of cents."""
+
+    cents: int
+
+    def __init__(self, amount: float = 0.0) -> None:
+        object.__setattr__(self, "cents", round(amount * 100))
+
+    @classmethod
+    def from_cents(cls, cents: int) -> "Money":
+        money = cls.__new__(cls)
+        object.__setattr__(money, "cents", int(cents))
+        return money
+
+    @property
+    def amount(self) -> float:
+        """The value in dollars, for callers that work in floats."""
+        return self.cents / 100
 
     def __add__(self, other: "Money") -> "Money":
-        return Money(self.amount + other.amount)
+        return Money.from_cents(self.cents + other.cents)
 
     def __mul__(self, qty: int) -> "Money":
-        return Money(self.amount * qty)
+        return Money.from_cents(self.cents * qty)
 
     def __neg__(self) -> "Money":
-        return Money(-self.amount)
+        return Money.from_cents(-self.cents)
 
 
 ZERO = Money(0.0)
