diff --git a/pricing/money.py b/pricing/money.py
index f586e26..5a9c8ff 100644
--- a/pricing/money.py
+++ b/pricing/money.py
@@ -2,18 +2,35 @@
 from dataclasses import dataclass
 
 
-@dataclass(frozen=True)
+@dataclass(frozen=True, init=False)
 class Money:
-    amount: float
+    """An exact amount, held as a whole number of cents."""
+
+    cents: int
+
+    def __init__(self, dollars: float = 0) -> None:
+        object.__setattr__(self, "cents", round(dollars * 100))
+
+    @classmethod
+    def from_cents(cls, cents: int) -> "Money":
+        m = cls.__new__(cls)
+        object.__setattr__(m, "cents", int(cents))
+        return m
 
     def __add__(self, other: "Money") -> "Money":
-        return Money(self.amount + other.amount)
+        return Money.from_cents(self.cents + other.cents)
 
     def __mul__(self, qty: int) -> "Money":
-        return Money(self.amount * qty)
+        return Money.from_cents(self.cents * qty)
 
     def __neg__(self) -> "Money":
-        return Money(-self.amount)
+        return Money.from_cents(-self.cents)
+
+    def parts(self) -> tuple[str, int, int]:
+        """Sign, whole dollars and cents, for rendering without float maths."""
+        sign = "-" if self.cents < 0 else ""
+        dollars, cents = divmod(abs(self.cents), 100)
+        return sign, dollars, cents
 
 
-ZERO = Money(0.0)
+ZERO = Money(0)
