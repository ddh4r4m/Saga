{"agent":"main","body":{"error":null,"exit":0,"for_seq":7,"result_bytes":443,"result_hash":"sha256:139de9157962704d4d4c4a5d7947fbe5c30faf729dbfb1f0090b77fc7cc404e8","result_inline":"1\t\"\"\"Money value object.\"\"\"\n2\tfrom dataclasses import dataclass\n3\t\n4\t\n5\t@dataclass(frozen=True)\n6\tclass Money:\n7\t    amount: float\n8\t\n9\t    def __add__(self, other: \"Money\") -> \"Money\":\n10\t        return Money(self.amount + other.amount)\n11\t\n12\t    def __mul__(self, qty: int) -> \"Money\":\n13\t        return Money(self.amount * qty)\n14\t\n15\t    def __neg__(self) -> \"Money\":\n16\t        return Money(-self.amount)\n17\t\n18\t\n19\tZERO = Money(0.0)\n20\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:57dd9de952f708069779ecb9feb53dd3fc776017a84f6b10edf64e56b80bcc5c","mono_ns":8000000,"prev":"sha256:aa6fe3bb4b9cea0792d6094d41f8f774880314e5ed8b9cb208ab382d08790ae0","schema":"saga.trace/1","seq":8,"session":"32e549f3-8eda-46b6-ac07-bbe943bfbfd1","source":"stream-json","ts":"2026-01-01T00:00:00.008Z","turn":1,"type":"tool_result"}
