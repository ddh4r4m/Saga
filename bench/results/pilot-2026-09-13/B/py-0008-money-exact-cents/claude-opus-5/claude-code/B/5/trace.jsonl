{"agent":"main","body":{"error":null,"exit":0,"for_seq":15,"result_bytes":469,"result_hash":"sha256:6a3a3d8d479f85f4be39d9f1a53491161fd075929e730f2d238d9556ed1afb8d","result_inline":"1\t\"\"\"Cart arithmetic.\"\"\"\n2\tfrom .money import Money, ZERO\n3\t\n4\tLine = tuple[str, Money, int]  # (name, unit price, quantity)\n5\t\n6\t\n7\tdef line_total(price: Money, qty: int) -> Money:\n8\t    if qty < 0:\n9\t        raise ValueError(\"quantity must be non-negative\")\n10\t    return price * qty\n11\t\n12\t\n13\tdef cart_total(lines: list[Line]) -> Money:\n14\t    total = ZERO\n15\t    for _, price, qty in lines:\n16\t        total = total + line_total(price, qty)\n17\t    return total\n18\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:452350e424659b081425c694e900dafd7af9969b9cf5b9067e3eda4f3e65de85","mono_ns":16000000,"prev":"sha256:107ea03afc43f384021b564dfd10821e4e3b058d62f1844b6842806cdc87ad8d","schema":"saga.trace/1","seq":16,"session":"32e549f3-8eda-46b6-ac07-bbe943bfbfd1","source":"stream-json","ts":"2026-01-01T00:00:00.016Z","turn":1,"type":"tool_result"}
