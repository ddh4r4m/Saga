diff --git a/pricing/money.py b/pricing/money.py
index f586e26..65ebba4 100644
--- a/pricing/money.py
+++ b/pricing/money.py
@@ -1,19 +1,59 @@
-"""Money value object."""
-from dataclasses import dataclass
+"""Money value object, held as a whole number of cents."""
+from decimal import Decimal
+
+
+def _to_cents(amount: float) -> int:
+    """Convert an amount in dollars to exact cents."""
+    return int(Decimal(str(amount)).scaleb(2).to_integral_value())
 
 
-@dataclass(frozen=True)
 class Money:
-    amount: float
+    """An immutable amount of money, exact to the cent."""
+
+    __slots__ = ("cents",)
+
+    def __init__(self, amount: float = 0.0) -> None:
+        object.__setattr__(self, "cents", _to_cents(amount))
+
+    @classmethod
+    def from_cents(cls, cents: int) -> "Money":
+        m = cls.__new__(cls)
+        object.__setattr__(m, "cents", int(cents))
+        return m
+
+    @property
+    def dollars(self) -> float:
+        """The amount in dollars, for callers that need a float."""
+        return self.cents / 100
+
+    def __setattr__(self, name: str, value: object) -> None:
+        raise AttributeError(f"cannot assign to field {name!r}")
 
     def __add__(self, other: "Money") -> "Money":
-        return Money(self.amount + other.amount)
+        return Money.from_cents(self.cents + other.cents)
 
     def __mul__(self, qty: int) -> "Money":
-        return Money(self.amount * qty)
+        return Money.from_cents(self.cents * qty)
 
     def __neg__(self) -> "Money":
-        return Money(-self.amount)
+        return Money.from_cents(-self.cents)
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Money):
+            return NotImplemented
+        return self.cents == other.cents
+
+    def __hash__(self) -> int:
+        return hash(self.cents)
+
+    def __str__(self) -> str:
+        """The plain decimal amount, e.g. "0.30" or "-0.05"."""
+        sign = "-" if self.cents < 0 else ""
+        whole, frac = divmod(abs(self.cents), 100)
+        return f"{sign}{whole}.{frac:02d}"
+
+    def __repr__(self) -> str:
+        return f"Money.from_cents({self.cents})"
 
 
-ZERO = Money(0.0)
+ZERO = Money.from_cents(0)
