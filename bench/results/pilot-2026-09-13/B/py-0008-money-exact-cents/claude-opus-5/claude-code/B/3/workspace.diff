diff --git a/pricing/money.py b/pricing/money.py
index f586e26..0b66f39 100644
--- a/pricing/money.py
+++ b/pricing/money.py
@@ -1,19 +1,56 @@
-"""Money value object."""
-from dataclasses import dataclass
+"""Money value object.
+
+The canonical amount is an integer number of cents, so sums and comparisons
+are exact. Constructors still take a dollar amount, and ``amount`` is kept as
+a float view for display and tax arithmetic.
+"""
+from decimal import Decimal
 
 
-@dataclass(frozen=True)
 class Money:
-    amount: float
+    """An amount of money, stored as whole cents."""
+
+    __slots__ = ("cents",)
+
+    def __init__(self, amount: float = 0) -> None:
+        # via Decimal(str(...)) so 0.10 lands on 10 cents, not 10.000000000002
+        self.cents = int(round(Decimal(str(amount)) * 100))
+
+    @classmethod
+    def from_cents(cls, cents: int) -> "Money":
+        money = cls.__new__(cls)
+        money.cents = int(cents)
+        return money
+
+    @property
+    def amount(self) -> float:
+        return self.cents / 100
+
+    def as_decimal(self) -> str:
+        """The amount as a plain two-decimal string, e.g. ``-0.05``."""
+        sign = "-" if self.cents < 0 else ""
+        whole, rem = divmod(abs(self.cents), 100)
+        return f"{sign}{whole}.{rem:02d}"
 
     def __add__(self, other: "Money") -> "Money":
-        return Money(self.amount + other.amount)
+        return Money.from_cents(self.cents + other.cents)
 
     def __mul__(self, qty: int) -> "Money":
-        return Money(self.amount * qty)
+        return Money.from_cents(self.cents * qty)
 
     def __neg__(self) -> "Money":
-        return Money(-self.amount)
+        return Money.from_cents(-self.cents)
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Money):
+            return NotImplemented
+        return self.cents == other.cents
+
+    def __hash__(self) -> int:
+        return hash(self.cents)
+
+    def __repr__(self) -> str:
+        return f"Money.from_cents({self.cents})"
 
 
-ZERO = Money(0.0)
+ZERO = Money(0)
