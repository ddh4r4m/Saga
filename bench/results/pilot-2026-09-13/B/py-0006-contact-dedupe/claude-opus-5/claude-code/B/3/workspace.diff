+    def test_case_and_padding_do_not_stop_a_match(self):
+        xs = [
+            Contact("a", "Ann@Example.com"),
+            Contact("b", " ann@example.com "),
+            Contact("c", "ANN@EXAMPLE.COM"),
+        ]
+        self.assertEqual(dedupe(xs), [xs[0]])
+
+    def test_blank_emails_are_never_merged(self):
+        xs = [Contact("a", ""), Contact("b", ""), Contact("c", "  ")]
+        self.assertEqual(dedupe(xs), xs)
+
+    def test_first_wins_order_kept_input_untouched(self):
+        xs = [
+            Contact("a", "a@a", "1"),
+            Contact("b", "b@b"),
+            Contact("a2", "a@a", "2"),
+            Contact("c", "c@c"),
+        ]
+        original = list(xs)
+        out = dedupe(xs)
+        self.assertEqual(out, [xs[0], xs[1], xs[3]])
+        self.assertEqual(xs, original)
