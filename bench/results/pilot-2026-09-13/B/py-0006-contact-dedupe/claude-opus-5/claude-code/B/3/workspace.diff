diff --git a/contacts/merge.py b/contacts/merge.py
index 69d76a6..3b0b3fb 100644
--- a/contacts/merge.py
+++ b/contacts/merge.py
@@ -3,5 +3,20 @@ from .models import Contact
 
 
 def dedupe(contacts: list[Contact]) -> list[Contact]:
-    """Return the list without duplicate people."""
-    raise NotImplementedError("dedupe is not implemented yet")
+    """Return the list without duplicate people.
+
+    Two entries are the same person when their emails match once surrounding
+    whitespace and capitalisation are ignored. The first occurrence is kept
+    unchanged and later ones are dropped; entries with a blank email are never
+    merged with anything. The input list is left untouched.
+    """
+    seen: set[str] = set()
+    result: list[Contact] = []
+    for contact in contacts:
+        key = contact.email.strip().lower()
+        if key:
+            if key in seen:
+                continue
+            seen.add(key)
+        result.append(contact)
+    return result
