+
+test("loads .env.example with its quoted values intact", () => {
+  const cfg = loadConfig(readFileSync(new URL("../.env.example", import.meta.url), "utf8"));
+  assert.deepEqual(cfg, {
+    port: 8080,
+    host: "0.0.0.0",
+    appName: "Order Service",
+    debug: false,
+    motd: "hello # not a comment",
+  });
+});
+
+test("applies defaults for missing keys", () => {
+  const cfg = loadConfig("");
+  assert.deepEqual(cfg, {
+    port: 8080,
+    host: "127.0.0.1",
+    appName: "order-service",
+    debug: false,
+    motd: "",
+  });
+});
+
+test("skips comments and blank lines, and strips trailing comments", () => {
+  const env = parseEnvFile("# header\n\nHOST=db.internal # inline\nPORT=9090\n");
+  assert.deepEqual(env, { HOST: "db.internal", PORT: "9090" });
+});
+
+test("keeps a hash that is part of a bare value", () => {
+  assert.deepEqual(parseEnvFile("TAG=build#42\n"), { TAG: "build#42" });
+});
+
+test("handles quoting details", () => {
+  assert.deepEqual(
+    parseEnvFile(`EMPTY=""\nSPACED="  padded  "\nRAW='a\\nb'\nESC="a\\nb"\nQUOTE="say \\"hi\\""\n`),
+    {
+      EMPTY: "",
+      SPACED: "  padded  ",
+      RAW: "a\\nb",
+      ESC: "a\nb",
+      QUOTE: 'say "hi"',
+    },
+  );
+});
+
+test("accepts an export prefix", () => {
+  assert.deepEqual(parseEnvFile("export HOST=db.internal\n"), { HOST: "db.internal" });
+});
+
+test("rejects malformed input", () => {
+  assert.throws(() => parseEnvFile("not an assignment\n"), /invalid env line/);
+  assert.throws(() => parseEnvFile('NAME="unterminated\n'), /unterminated quote/);
+  assert.throws(() => loadConfig("PORT=not-a-number\n"), /invalid PORT/);
+  assert.throws(() => loadConfig("PORT=0\n"), /invalid PORT/);
+});
