+
+test("loads .env.example with its quoted values intact", () => {
+  const cfg = loadConfig(readFileSync(new URL("../.env.example", import.meta.url), "utf8"));
+  assert.equal(cfg.port, 8080);
+  assert.equal(cfg.host, "0.0.0.0");
+  assert.equal(cfg.appName, "Order Service");
+  assert.equal(cfg.debug, false);
+  assert.equal(cfg.motd, "hello # not a comment");
+});
+
+test("applies defaults for missing keys", () => {
+  const cfg = loadConfig("# nothing but a comment\n\n");
+  assert.deepEqual(cfg, {
+    port: 8080,
+    host: "127.0.0.1",
+    appName: "order-service",
+    debug: false,
+    motd: "",
+  });
+});
+
+test("rejects a non-numeric PORT", () => {
+  assert.throws(() => loadConfig("PORT=eighty\n"), /invalid PORT/);
+});
+
+test("strips comments and surrounding space from bare values", () => {
+  const env = parseEnvFile("HOST=db.internal   # the primary\nPATHY=a#b\nEMPTY=\n");
+  assert.equal(env.HOST, "db.internal");
+  assert.equal(env.PATHY, "a#b");
+  assert.equal(env.EMPTY, "");
+});
+
+test("keeps single-quoted values literal and unescapes double-quoted ones", () => {
+  const env = parseEnvFile(`RAW='a\\nb # keep'\nCOOKED="a\\nb"\nQUOTE="say \\"hi\\""\n`);
+  assert.equal(env.RAW, "a\\nb # keep");
+  assert.equal(env.COOKED, "a\nb");
+  assert.equal(env.QUOTE, 'say "hi"');
+});
+
+test("accepts export prefixes and rejects malformed lines", () => {
+  assert.equal(parseEnvFile("export HOST=db.internal\n").HOST, "db.internal");
+  assert.throws(() => parseEnvFile("HOST db.internal\n"), /invalid env line/);
+  assert.throws(() => parseEnvFile('APP_NAME="Order Service\n'), /unterminated quote/);
+});
