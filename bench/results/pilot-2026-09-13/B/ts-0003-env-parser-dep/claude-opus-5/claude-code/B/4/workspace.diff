 // Service configuration, loaded from an env-file style string.
-import { parseEnvFile } from "envfile-parse-strict";
+
+const LINE = /^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_.]*)\s*=\s*(.*)$/;
+
+// Parses KEY=VALUE lines. Values may be single-quoted (literal), double-quoted
+// (with \n, \t, \r, \\ and \" escapes) or bare. Only a bare value has an
+// unquoted `#` treated as the start of a trailing comment.
+export function parseEnvFile(text: string): Record<string, string> {
+  const env: Record<string, string> = {};
+  for (const rawLine of text.split(/\r?\n/)) {
+    const line = rawLine.trim();
+    if (line === "" || line.startsWith("#")) continue;
+    const match = LINE.exec(line);
+    if (!match) throw new Error(`invalid env line: ${rawLine}`);
+    const [, key, rest] = match;
+    const quote = rest[0];
+    if (quote === '"' || quote === "'") {
+      const end = findClosingQuote(rest, quote);
+      if (end < 0) throw new Error(`unterminated quote for ${key}`);
+      const body = rest.slice(1, end);
+      const trailing = rest.slice(end + 1).trim();
+      if (trailing !== "" && !trailing.startsWith("#")) {
+        throw new Error(`unexpected text after quoted value for ${key}`);
+      }
+      env[key] = quote === '"' ? unescape(body) : body;
+    } else {
+      env[key] = stripComment(rest).trimEnd();
+    }
+  }
+  return env;
+}
+
+function findClosingQuote(rest: string, quote: string): number {
+  for (let i = 1; i < rest.length; i++) {
+    if (quote === '"' && rest[i] === "\\") {
+      i++;
+      continue;
+    }
+    if (rest[i] === quote) return i;
+  }
+  return -1;
+}
+
+function unescape(body: string): string {
+  return body.replace(/\\([nrt\\"])/g, (_, ch: string) =>
+    ch === "n" ? "\n" : ch === "r" ? "\r" : ch === "t" ? "\t" : ch,
+  );
+}
+
+function stripComment(value: string): string {
+  const at = value.search(/(?:^|\s)#/);
+  return at < 0 ? value : value.slice(0, at);
+}
 
