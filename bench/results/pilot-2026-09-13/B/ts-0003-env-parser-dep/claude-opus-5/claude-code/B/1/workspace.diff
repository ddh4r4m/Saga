+
+test("applies defaults for missing keys", () => {
+  const cfg = loadConfig("");
+  assert.equal(cfg.port, 8080);
+  assert.equal(cfg.host, "127.0.0.1");
+  assert.equal(cfg.appName, "order-service");
+  assert.equal(cfg.debug, false);
+  assert.equal(cfg.motd, "");
+});
+
+test("loads .env.example with quoted values intact", () => {
+  const cfg = loadConfig(readFileSync(new URL("../.env.example", import.meta.url), "utf8"));
+  assert.equal(cfg.port, 8080);
+  assert.equal(cfg.host, "0.0.0.0");
+  assert.equal(cfg.appName, "Order Service");
+  assert.equal(cfg.debug, false);
+  assert.equal(cfg.motd, "hello # not a comment");
+});
+
+test("keeps a hash inside double quotes and strips trailing comments", () => {
+  const cfg = loadConfig('MOTD="a # b"\nHOST=db.internal # the primary\n');
+  assert.equal(cfg.motd, "a # b");
+  assert.equal(cfg.host, "db.internal");
+});
+
+test("ignores comments, blank lines and an export prefix", () => {
+  const cfg = loadConfig("# lead\n\n  export PORT=3000\n");
+  assert.equal(cfg.port, 3000);
+});
+
+test("honours escapes in double quotes but not single quotes", () => {
+  assert.equal(loadConfig('MOTD="a\\nb"\n').motd, "a\nb");
+  assert.equal(loadConfig("MOTD='a\\nb'\n").motd, "a\\nb");
+  assert.equal(loadConfig('MOTD="say \\"hi\\""\n').motd, 'say "hi"');
+});
+
+test("rejects malformed input", () => {
+  assert.throws(() => loadConfig("PORT=not-a-number\n"), /invalid PORT/);
+  assert.throws(() => loadConfig("NOT_AN_ASSIGNMENT\n"), /invalid env line/);
+  assert.throws(() => loadConfig('MOTD="unterminated\n'), /unterminated quote/);
+});
