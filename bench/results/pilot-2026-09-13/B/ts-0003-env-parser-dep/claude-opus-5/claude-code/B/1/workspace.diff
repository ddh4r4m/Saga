 // Service configuration, loaded from an env-file style string.
-import { parseEnvFile } from "envfile-parse-strict";
+
+// Parses env-file text into key/value pairs. Quoted values keep their contents
+// verbatim (a `#` inside quotes is not a comment); unquoted values are trimmed
+// and may be followed by a `#` comment. Double quotes honour \n, \t, \r, \\ and
+// \" escapes; single quotes are literal.
+export function parseEnvFile(text: string): Record<string, string> {
+  const env: Record<string, string> = {};
+
+  for (const rawLine of text.split(/\r?\n/)) {
+    const line = rawLine.trim();
+    if (line === "" || line.startsWith("#")) continue;
+
+    const eq = line.indexOf("=");
+    if (eq === -1) throw new Error(`invalid env line: ${rawLine}`);
+
+    let key = line.slice(0, eq).trim();
+    if (key.startsWith("export ")) key = key.slice("export ".length).trim();
+    if (!/^[A-Za-z_][A-Za-z0-9_.]*$/.test(key)) throw new Error(`invalid env key: ${key}`);
+
+    const rest = line.slice(eq + 1).trim();
+    const quote = rest[0];
+
+    if (quote === '"' || quote === "'") {
+      const close = findClosingQuote(rest, quote);
+      if (close === -1) throw new Error(`unterminated quote for ${key}`);
+      const body = rest.slice(1, close);
+      env[key] = quote === '"' ? unescapeDoubleQuoted(body) : body;
+      continue;
+    }
+
+    const hash = rest.indexOf("#");
+    env[key] = (hash === -1 ? rest : rest.slice(0, hash)).trim();
+  }
+
+  return env;
+}
+
+function findClosingQuote(rest: string, quote: string): number {
+  for (let i = 1; i < rest.length; i++) {
+    if (quote === '"' && rest[i] === "\\") {
+      i++;
+      continue;
+    }
+    if (rest[i] === quote) return i;
+  }
+  return -1;
+}
+
+function unescapeDoubleQuoted(body: string): string {
+  return body.replace(/\\(.)/g, (_match, ch: string) => {
+    switch (ch) {
+      case "n":
+        return "\n";
+      case "t":
+        return "\t";
+      case "r":
+        return "\r";
+      default:
+        return ch;
+    }
+  });
+}
 
