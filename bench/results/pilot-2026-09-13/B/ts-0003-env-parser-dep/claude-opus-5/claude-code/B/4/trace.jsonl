{"agent":"main","body":{"args_hash":"sha256:21653b3e2ba0515559cbfc71838932c6c062afa2f1a99fa75dba04117c602a9a","args_inline":{"file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-2883344517/ts-0003-env-parser-dep/4/ws/src/config.ts","new_string":"// Service configuration, loaded from an env-file style string.\n\nconst LINE = /^\\s*(?:export\\s+)?([A-Za-z_][A-Za-z0-9_.]*)\\s*=\\s*(.*)$/;\n\n// Parses KEY=VALUE lines. Values may be single-quoted (literal), double-quoted\n// (with \\n, \\t, \\r, \\\\ and \\\" escapes) or bare. Only a bare value has an\n// unquoted `#` treated as the start of a trailing comment.\nexport function parseEnvFile(text: string): Record<string, string> {\n  const env: Record<string, string> = {};\n  for (const rawLine of text.split(/\\r?\\n/)) {\n    const line = rawLine.trim();\n    if (line === \"\" || line.startsWith(\"#\")) continue;\n    const match = LINE.exec(line);\n    if (!match) throw new Error(`invalid env line: ${rawLine}`);\n    const [, key, rest] = match;\n    const quote = rest[0];\n    if (quote === '\"' || quote === \"'\") {\n      const end = findClosingQuote(rest, quote);\n      if (end < 0) throw new Error(`unterminated quote for ${key}`);\n      const body = rest.slice(1, end);\n      const trailing = rest.slice(end + 1).trim();\n      if (trailing !== \"\" && !trailing.startsWith(\"#\")) {\n        throw new Error(`unexpected text after quoted value for ${key}`);\n      }\n      env[key] = quote === '\"' ? unescape(body) : body;\n    } else {\n      env[key] = stripComment(rest).trimEnd();\n    }\n  }\n  return env;\n}\n\nfunction findClosingQuote(rest: string, quote: string): number {\n  for (let i = 1; i < rest.length; i++) {\n    if (quote === '\"' && rest[i] === \"\\\\\") {\n      i++;\n      continue;\n    }\n    if (rest[i] === quote) return i;\n  }\n  return -1;\n}\n\nfunction unescape(body: string): string {\n  return body.replace(/\\\\([nrt\\\\\"])/g, (_, ch: string) =>\n    ch === \"n\" ? \"\\n\" : ch === \"r\" ? \"\\r\" : ch === \"t\" ? \"\\t\" : ch,\n  );\n}\n\nfunction stripComment(value: string): string {\n  const at = value.search(/(?:^|\\s)#/);\n  return at < 0 ? value : value.slice(0, at);\n}\n\nexport interface Config {","old_string":"// Service configuration, loaded from an env-file style string.\nimport { parseEnvFile } from \"envfile-parse-strict\";\n\nexport interface Config {","replace_all":false},"component":"harness","cwd_rel":".","index_version":null,"tool":"Edit","tool_use_id":"toolu_01JUAsTFUCqirhoNqESWsXEp"},"hash":"sha256:2a21ec250bd4076b8b4530cc04f79e8ec3d4992133eadcdf878ce3c3852a2f1c","mono_ns":21000000,"prev":"sha256:40dd0f964205b013a086f4e3fba4587b0b22756c16b3fc6c3d90152c8ea63d6f","schema":"saga.trace/1","seq":21,"session":"4b27cb87-66d7-4070-a58e-73eddc1ee76c","source":"stream-json","ts":"2026-01-01T00:00:00.021Z","turn":1,"type":"tool_call"}
