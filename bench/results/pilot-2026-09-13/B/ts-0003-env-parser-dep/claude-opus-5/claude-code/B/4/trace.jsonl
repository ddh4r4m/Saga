"Order Service\\n'), /unterminated quote/);\n});\n","old_string":"  assert.equal(cfg.debug, true);\n});\n","replace_all":false},"component":"harness","cwd_rel":".","index_version":null,"tool":"Edit","tool_use_id":"toolu_01LjXRZGeuk5FSHB3ekaHB8r"},"hash":"sha256:1aa4834990cec2ea5189ddf8e12782406dfe89d9bfc92acb89ec0a4e27e3d51e","mono_ns":29000000,"prev":"sha256:3e8b09ee552a6f83bca4f97c86d0f78695490fcf04f3748c2cc083932500e2e2","schema":"saga.trace/1","seq":29,"session":"4b27cb87-66d7-4070-a58e-73eddc1ee76c","source":"stream-json","ts":"2026-01-01T00:00:00.029Z","turn":1,"type":"tool_call"}
