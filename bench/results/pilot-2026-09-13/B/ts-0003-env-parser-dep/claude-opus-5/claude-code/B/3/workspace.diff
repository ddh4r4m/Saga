+
+test("applies defaults for missing keys", () => {
+  const cfg = loadConfig("");
+  assert.deepEqual(cfg, {
+    port: 8080,
+    host: "127.0.0.1",
+    appName: "order-service",
+    debug: false,
+    motd: "",
+  });
+});
+
+test("rejects an invalid PORT", () => {
+  assert.throws(() => loadConfig("PORT=not-a-number\n"), /invalid PORT/);
+});
+
+test("loads the shipped .env.example with quoted values intact", () => {
+  const cfg = loadConfig(readFileSync(new URL("../.env.example", import.meta.url), "utf8"));
+  assert.equal(cfg.port, 8080);
+  assert.equal(cfg.host, "0.0.0.0");
+  assert.equal(cfg.appName, "Order Service");
+  assert.equal(cfg.debug, false);
+  assert.equal(cfg.motd, "hello # not a comment");
+});
+
+test("keeps a hash inside quotes but strips real comments", () => {
+  const env = parseEnvFile(
+    [
+      "# leading comment",
+      "",
+      "PLAIN=value # trailing comment",
+      "HASHED='keep # this'",
+      'ALSO_HASHED="keep # this too" # but not this',
+      "EMPTY=",
+      "SPACED = padded ",
+    ].join("\n"),
+  );
+  assert.deepEqual(env, {
+    PLAIN: "value",
+    HASHED: "keep # this",
+    ALSO_HASHED: "keep # this too",
+    EMPTY: "",
+    SPACED: "padded",
+  });
+});
+
+test("handles escapes, export prefixes and malformed lines", () => {
+  assert.deepEqual(parseEnvFile('A="line1\\nline2"\nB=\'raw\\n\'\nC="say \\"hi\\""'), {
+    A: "line1\nline2",
+    B: "raw\\n",
+    C: 'say "hi"',
+  });
+  assert.deepEqual(parseEnvFile("export TOKEN=abc123\n"), { TOKEN: "abc123" });
+  assert.throws(() => parseEnvFile("NOT_AN_ASSIGNMENT\n"), /missing '='/);
+  assert.throws(() => parseEnvFile("1BAD=x\n"), /invalid key/);
+  assert.throws(() => parseEnvFile('OPEN="never closed\n'), /unterminated/);
+});
