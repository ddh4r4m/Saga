 // Service configuration, loaded from an env-file style string.
-import { parseEnvFile } from "envfile-parse-strict";
+
+const KEY_RE = /^[A-Za-z_][A-Za-z0-9_]*$/;
+
+const DOUBLE_QUOTE_ESCAPES: Record<string, string> = {
+  n: "\n",
+  r: "\r",
+  t: "\t",
+  "\\": "\\",
+  '"': '"',
+  "'": "'",
+};
+
+// Reads a double-quoted value, honouring backslash escapes. Returns the decoded
+// value plus the index just past the closing quote.
+function readQuoted(line: string, start: number): { value: string; end: number } {
+  const quote = line[start];
+  let value = "";
+  for (let i = start + 1; i < line.length; i++) {
+    const ch = line[i];
+    if (quote === '"' && ch === "\\" && i + 1 < line.length) {
+      const next = line[i + 1];
+      value += DOUBLE_QUOTE_ESCAPES[next] ?? "\\" + next;
+      i++;
+      continue;
+    }
+    if (ch === quote) return { value, end: i + 1 };
+    value += ch;
+  }
+  throw new Error(`unterminated ${quote} quote in: ${line}`);
+}
+
+// Strips an unquoted trailing comment: a `#` at the start of the value or
+// preceded by whitespace. A `#` inside quotes is part of the value.
+function stripComment(value: string): string {
+  for (let i = 0; i < value.length; i++) {
+    if (value[i] === "#" && (i === 0 || /\s/.test(value[i - 1]))) return value.slice(0, i);
+  }
+  return value;
+}
+
+function parseValue(raw: string, line: string): string {
+  const trimmed = raw.trim();
+  if (trimmed[0] === '"' || trimmed[0] === "'") {
+    const { value, end } = readQuoted(trimmed, 0);
+    const rest = trimmed.slice(end).trim();
+    if (rest !== "" && !rest.startsWith("#")) {
+      throw new Error(`unexpected text after quoted value in: ${line}`);
+    }
+    return value;
+  }
+  return stripComment(trimmed).trim();
+}
+
+// Minimal env-file parser: `KEY=value` lines, `#` comments, single- or
+// double-quoted values.
+export function parseEnvFile(text: string): Record<string, string> {
+  const env: Record<string, string> = {};
+  for (const line of text.split(/\r?\n/)) {
+    const trimmed = line.trim();
+    if (trimmed === "" || trimmed.startsWith("#")) continue;
+
+    const eq = trimmed.indexOf("=");
+    if (eq === -1) throw new Error(`missing '=' in: ${line}`);
+
+    let key = trimmed.slice(0, eq).trim();
+    if (key.startsWith("export ")) key = key.slice("export ".length).trim();
+    if (!KEY_RE.test(key)) throw new Error(`invalid key: ${key}`);
+
+    env[key] = parseValue(trimmed.slice(eq + 1), line);
+  }
+  return env;
+}
 
 export interface Config {
   port: number;
