 // Service configuration, loaded from an env-file style string.
-import { parseEnvFile } from "envfile-parse-strict";
+
+// Matches KEY=VALUE lines, with an optional `export ` prefix. The value is
+// either a single-quoted run, a double-quoted run, or bare text up to an
+// unquoted `#` comment.
+const LINE =
+  /^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_.]*)\s*=\s*('[^']*'|"(?:[^"\\]|\\.)*"|[^#\r\n]*?)\s*(?:#.*)?$/;
+
+// Escapes recognised inside double quotes; single quotes stay literal.
+const ESCAPES: Record<string, string> = {
+  n: "\n",
+  r: "\r",
+  t: "\t",
+  f: "\f",
+  b: "\b",
+  v: "\v",
+  "0": "\0",
+};
+
+function parseEnvFile(text: string): Record<string, string> {
+  const env: Record<string, string> = {};
+  for (const line of text.split(/\r?\n/)) {
+    if (line.trim() === "" || line.trimStart().startsWith("#")) continue;
+    const match = LINE.exec(line);
+    if (!match) throw new Error(`malformed env line: ${line}`);
+    const [, key, raw] = match;
+    env[key] = unquote(raw);
+  }
+  return env;
+}
+
+function unquote(raw: string): string {
+  if (raw.length >= 2 && raw.startsWith("'") && raw.endsWith("'")) {
+    return raw.slice(1, -1);
+  }
+  if (raw.length >= 2 && raw.startsWith('"') && raw.endsWith('"')) {
+    return raw.slice(1, -1).replace(/\\(.)/g, (_, ch: string) => ESCAPES[ch] ?? ch);
+  }
+  return raw;
+}
 
