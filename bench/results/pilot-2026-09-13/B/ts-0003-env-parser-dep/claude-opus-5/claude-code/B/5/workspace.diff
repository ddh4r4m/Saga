+
+test("applies defaults for missing keys", () => {
+  const cfg = loadConfig("");
+  assert.deepEqual(cfg, {
+    port: 8080,
+    host: "127.0.0.1",
+    appName: "order-service",
+    debug: false,
+    motd: "",
+  });
+});
+
+test("rejects a non-numeric PORT", () => {
+  assert.throws(() => loadConfig("PORT=nope\n"), /invalid PORT/);
+});
+
+test("keeps quoted values intact", () => {
+  const cfg = loadConfig(readFileSync(".env.example", "utf8"));
+  assert.equal(cfg.port, 8080);
+  assert.equal(cfg.host, "0.0.0.0");
+  assert.equal(cfg.appName, "Order Service");
+  assert.equal(cfg.debug, false);
+  assert.equal(cfg.motd, "hello # not a comment");
+});
+
+test("strips comments only outside quotes", () => {
+  const cfg = loadConfig(
+    "# leading comment\nPORT=8080 # trailing comment\nAPP_NAME=\"a # b\"\n",
+  );
+  assert.equal(cfg.port, 8080);
+  assert.equal(cfg.appName, "a # b");
+});
+
+test("handles export prefixes, blank lines and CRLF", () => {
+  const cfg = loadConfig("export PORT=3000\r\n\r\nexport HOST=api.internal\r\n");
+  assert.equal(cfg.port, 3000);
+  assert.equal(cfg.host, "api.internal");
+});
+
+test("unescapes inside double quotes but not single quotes", () => {
+  assert.equal(loadConfig('MOTD="line\\none"\n').motd, "line\none");
+  assert.equal(loadConfig("MOTD='line\\none'\n").motd, "line\\none");
+  assert.equal(loadConfig('MOTD="say \\"hi\\""\n').motd, 'say "hi"');
+});
+
+test("rejects a malformed line", () => {
+  assert.throws(() => loadConfig("not an assignment\n"), /malformed env line/);
+});
