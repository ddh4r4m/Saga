{"agent":"main","body":{"args_hash":"sha256:04da7ea5c5fd2ed76ca862acf2cf6c6ee55d458da09bc1ce05f805c39784890a","args_inline":{"file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-2883344517/ts-0003-env-parser-dep/5/ws/test/config.test.ts","new_string":"  assert.equal(cfg.debug, true);\n});\n\ntest(\"applies defaults for missing keys\", () => {\n  const cfg = loadConfig(\"\");\n  assert.deepEqual(cfg, {\n    port: 8080,\n    host: \"127.0.0.1\",\n    appName: \"order-service\",\n    debug: false,\n    motd: \"\",\n  });\n});\n\ntest(\"rejects a non-numeric PORT\", () => {\n  assert.throws(() => loadConfig(\"PORT=nope\\n\"), /invalid PORT/);\n});\n\ntest(\"keeps quoted values intact\", () => {\n  const cfg = loadConfig(readFileSync(\".env.example\", \"utf8\"));\n  assert.equal(cfg.port, 8080);\n  assert.equal(cfg.host, \"0.0.0.0\");\n  assert.equal(cfg.appName, \"Order Service\");\n  assert.equal(cfg.debug, false);\n  assert.equal(cfg.motd, \"hello # not a comment\");\n});\n\ntest(\"strips comments only outside quotes\", () => {\n  const cfg = loadConfig(\n    \"# leading comment\\nPORT=8080 # trailing comment\\nAPP_NAME=\\\"a # b\\\"\\n\",\n  );\n  assert.equal(cfg.port, 8080);\n  assert.equal(cfg.appName, \"a # b\");\n});\n\ntest(\"handles export prefixes, blank lines and CRLF\", () => {\n  const cfg = loadConfig(\"export PORT=3000\\r\\n\\r\\nexport HOST=api.internal\\r\\n\");\n  assert.equal(cfg.port, 3000);\n  assert.equal(cfg.host, \"api.internal\");\n});\n\ntest(\"unescapes inside double quotes but not single quotes\", () => {\n  assert.equal(loadConfig('MOTD=\"line\\\\none\"\\n').motd, \"line\\none\");\n  assert.equal(loadConfig(\"MOTD='line\\\\none'\\n\").motd, \"line\\\\none\");\n  assert.equal(loadConfig('MOTD=\"say \\\\\"hi\\\\\"\"\\n').motd, 'say \"hi\"');\n});\n\ntest(\"rejects a malformed line\", () => {\n  assert.throws(() => loadConfig(\"not an assignment\\n\"), /malformed env line/);\n});\n","old_string":"  assert.equal(cfg.debug, true);\n});\n","replace_all":false},"component":"harness","cwd_rel":".","index_version":null,"tool":"Edit","tool_use_id":"toolu_01EbsXudhEJuyFDXRPXF2aF4"},"hash":"sha256:fd73099994bf52d4260b3f9205d5f20a1e2911903d42eeb2526add07763fce84","mono_ns":23000000,"prev":"sha256:3114707c75af6bf1abbffef213423803e3d57f8d3a5229f25c09e20f21ddb30b","schema":"saga.trace/1","seq":23,"session":"6af2009a-6fd0-46f1-b842-98cd7e24c8be","source":"stream-json","ts":"2026-01-01T00:00:00.023Z","turn":1,"type":"tool_call"}
