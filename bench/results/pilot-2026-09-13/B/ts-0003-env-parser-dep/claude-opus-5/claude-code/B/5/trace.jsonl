fs').readFileSync('.env.example','utf8'));console.log(c.appName+'|'+c.motd)})\"\n    EXPECT: /^Order Service\\|hello # not a comment$/m\n    FROM: R4 \"the MOTD line with a hash inside the quotes have to come through intact\"","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:ca83fbb723d779e5595577a131c1dfbb9185e15bb7a4c45474e1e632d0c6953c","mono_ns":4000000,"prev":"sha256:861b1c9caa496c398b4fca2f8f86a1269327a7cf1693db82ff6828e8c2a2e7f9","schema":"saga.trace/1","seq":4,"session":"6af2009a-6fd0-46f1-b842-98cd7e24c8be","source":"stream-json","ts":"2026-01-01T00:00:00.004Z","turn":1,"type":"tool_result"}
