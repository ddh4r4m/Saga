{"agent":"main","body":{"args_hash":"sha256:94b50c76d249a897a034e010e87109ac220b3e31075ac9272eed0ed44d2bd5df","args_inline":{"file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-2883344517/py-0016-inventory-reserve-race/5/ws/inventory/reserve.py","new_string":"\"\"\"Stock reservation for checkout.\"\"\"\n\nimport threading\n\nfrom .store import MemoryStore\n\n\nclass OutOfStock(Exception):\n    pass\n\n\nclass Inventory:\n    def __init__(self, store: MemoryStore) -> None:\n        self.store = store\n        # The store offers no atomic read-modify-write, so every get/set pair\n        # runs under a lock. One lock per sku, since the store reads can be\n        # slow (network) and unrelated skus should not wait on each other.\n        self._locks: dict[str, threading.RLock] = {}\n        self._locks_guard = threading.Lock()\n\n    def _lock_for(self, sku: str) -> threading.RLock:\n        with self._locks_guard:\n            lock = self._locks.get(sku)\n            if lock is None:\n                lock = self._locks[sku] = threading.RLock()\n            return lock\n\n    def reserve(self, sku: str, qty: int) -> int:\n        \"\"\"Take qty units of sku out of stock; return the units left.\"\"\"\n        if qty <= 0:\n            raise ValueError(\"qty must be positive\")\n        with self._lock_for(sku):\n            available = self.store.get(sku)\n            if available < qty:\n                raise OutOfStock(f\"{sku}: wanted {qty}, have {available}\")\n            remaining = available - qty\n            self.store.set(sku, remaining)\n            return remaining\n\n    def release(self, sku: str, qty: int) -> int:\n        \"\"\"Put qty units of sku back; return the units now in stock.\"\"\"\n        if qty <= 0:\n            raise ValueError(\"qty must be positive\")\n        with self._lock_for(sku):\n            total = self.store.get(sku) + qty\n            self.store.set(sku, total)\n            return total\n\n    def available(self, sku: str) -> int:\n        with self._lock_for(sku):\n            return self.store.get(sku)","old_string":"\"\"\"Stock reservation for checkout.\"\"\"\n\nfrom .store import MemoryStore\n\n\nclass OutOfStock(Exception):\n    pass\n\n\nclass Inventory:\n    def __init__(self, store: MemoryStore) -> None:\n        self.store = store\n\n    def reserve(self, sku: str, qty: int) -> int:\n        \"\"\"Take qty units of sku out of stock; return the units left.\"\"\"\n        if qty <= 0:\n            raise ValueError(\"qty must be positive\")\n        available = self.store.get(sku)\n        if available < qty:\n            raise OutOfStock(f\"{sku}: wanted {qty}, have {available}\")\n        remaining = available - qty\n        self.store.set(sku, remaining)\n        return remaining\n\n    def release(self, sku: str, qty: int) -> int:\n        \"\"\"Put qty units of sku back; return the units now in stock.\"\"\"\n        if qty <= 0:\n            raise ValueError(\"qty must be positive\")\n        total = self.store.get(sku) + qty\n        self.store.set(sku, total)\n        return total\n\n    def available(self, sku: str) -> int:\n        return self.store.get(sku)","replace_all":false},"args_ref":null,"component":"harness","cwd_rel":".","decision":"allow","decision_reason":null,"index_version":null,"tool":"Edit","tool_use_id":"toolu_01MEryV51xAabbVfhWZGbjEk"},"hash":"sha256:92a9cac147b2f5d18d54feae22e28400852794cf88ca795aacde11c6e33bb197","hook_ms":70,"hook_steps":{"gate":67,"trace":2},"masked_count":0,"mono_ns":32865177291,"prev":"sha256:13c714ce52c5d9584ded149eec082473e78bd978332c1e8a8e2961dbe5efdae8","schema":"saga.trace/1","seq":10,"session":"c5e84b22-0e05-4267-8771-f321a238b896","source":"hook:PreToolUse","ts":"2026-09-13T04:53:19.831Z","turn":1,"type":"tool_call"}
