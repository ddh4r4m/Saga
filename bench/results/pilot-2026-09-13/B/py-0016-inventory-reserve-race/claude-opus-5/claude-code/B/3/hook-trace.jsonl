{"agent":"main","body":{"attribution":{"gate":0,"guard":0,"harness":1,"index":0,"mem.preamble":0,"mem.query":0,"mem.state":0,"mem.targeted":0,"route":0,"shape":0,"tool_results":0,"trace":0,"user":0},"call_key":null,"call_key_reason":"system and messages not observable from hooks","context_tokens_est":13680,"effort":null,"effort_reason":"per-call value not in transcript","fingerprint":null,"fingerprint_reason":"anthropic does not expose one","latency_ms":null,"latency_ms_reason":"not in transcript","message_id":"msg_011CezqNg81Y6vReSNDGehrY","model_requested":null,"model_requested_reason":"not in transcript","model_served":"claude-opus-5","request_id":"req_011CezqNfDwKEkgiPtidenFF","request_id_reason":null,"status":"ok","stop_reason":"tool_use","system_hash":null,"system_hash_reason":"not exposed by claude-code hooks","tools_hash":null,"tools_hash_reason":"not exposed by claude-code hooks","usage":{"cache_read":13329,"cache_write_1h":349,"cache_write_5m":0,"input_fresh":2,"output":161,"raw":{"cache_creation":{"ephemeral_1h_input_tokens":349,"ephemeral_5m_input_tokens":0},"cache_creation_input_tokens":349,"cache_read_input_tokens":13329,"inference_geo":"not_available","input_tokens":2,"iterations":[{"cache_creation":{"ephemeral_1h_input_tokens":349,"ephemeral_5m_input_tokens":0},"cache_creation_input_tokens":349,"cache_read_input_tokens":13329,"input_tokens":2,"model":null,"output_tokens":161,"type":"message"}],"output_tokens":161,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_fetch_requests":0,"web_search_requests":0},"service_tier":"standard","speed":"standard"},"reasoning":null,"reasoning_reason":"anthropic bills thinking inside output","source":"transcript"}},"hash":"sha256:cf7c2541361c9d1406bda16da3dea68de4d631f11eefbc9bbb817cd481f517ad","hook_ms":1,"mono_ns":42493778083,"prev":"sha256:471d93784389179c015b8a6072511f8bfd67b1b903423dc5aeaca55ec16a9d5c","schema":"saga.trace/1","seq":25,"session":"892b238e-11b1-414c-a8c2-5dde56202f69","source":