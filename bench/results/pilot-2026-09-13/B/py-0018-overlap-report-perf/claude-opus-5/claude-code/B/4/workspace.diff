 @dataclass(frozen=True)
@@ -21,13 +24,29 @@ def find_overlaps(bookings: list[Booking]) -> list[tuple[str, str]]:
     Two bookings clash when they are in the same room and their half-open
     intervals intersect. A booking fully inside a longer one clashes with it;
     a booking that ends exactly when another starts does not.
+
+    Bookings in different rooms never clash, so each room is swept on its own:
+    walk its bookings in start order and keep the ones that are still running in
+    a heap ordered by end. Everything left in that heap when a booking starts
+    clashes with it, so the work is the sort plus one step per clash reported.
     """
+    by_room: dict[str, list[Booking]] = defaultdict(list)
+    for b in bookings:
+        by_room[b.room].append(b)
+
     pairs: list[tuple[str, str]] = []
-    for i in range(len(bookings)):
-        a = bookings[i]
-        for j in range(i + 1, len(bookings)):
-            b = bookings[j]
-            if overlaps(a, b):
-                pairs.append((a.id, b.id) if a.id < b.id else (b.id, a.id))
+    for room_bookings in by_room.values():
+        room_bookings.sort(key=attrgetter("start"))
+        active: list[tuple[int, int, str]] = []  # (end, start, id), still running
+        for b in room_bookings:
+            start, end, b_id = b.start, b.end, b.id
+            while active and active[0][0] <= start:
+                heapq.heappop(active)
+            for a_end, a_start, a_id in active:
+                # a_end > start already; a_start < end can only fail for an
+                # empty booking, which the half-open rule still lets clash.
+                if a_start < end:
+                    pairs.append((a_id, b_id) if a_id < b_id else (b_id, a_id))
+            heapq.heappush(active, (end, start, b_id))
     pairs.sort()
     return pairs
