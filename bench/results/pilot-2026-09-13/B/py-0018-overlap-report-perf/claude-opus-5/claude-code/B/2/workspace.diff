@@ -21,13 +22,26 @@ def find_overlaps(bookings: list[Booking]) -> list[tuple[str, str]]:
     Two bookings clash when they are in the same room and their half-open
     intervals intersect. A booking fully inside a longer one clashes with it;
     a booking that ends exactly when another starts does not.
+
+    A sweep over the bookings ordered by (room, start): every booking still
+    open when the next one starts clashes with it, so the work is
+    O(n log n + pairs) rather than a comparison per pair of bookings.
     """
     pairs: list[tuple[str, str]] = []
-    for i in range(len(bookings)):
