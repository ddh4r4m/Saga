-        for j in range(i + 1, len(bookings)):
-            b = bookings[j]
+    # (end, tie-breaker, booking) heap of the bookings still open at the
+    # current point of the sweep; the tie-breaker keeps Bookings uncompared.
+    active: list[tuple[int, int, Booking]] = []
+    room = None
+    for seq, b in enumerate(sorted(bookings, key=lambda b: (b.room, b.start))):
+        if b.room != room:
+            room, active = b.room, []
+        while active and active[0][0] <= b.start:
+            heapq.heappop(active)
+        # Everything left open clashes with b, bar a zero-length b that merely
+        # touches the start of an open booking, so keep the predicate honest.
+        for _, _, a in active:
             if overlaps(a, b):
                 pairs.append((a.id, b.id) if a.id < b.id else (b.id, a.id))
+        heapq.heappush(active, (b.end, seq, b))
     pairs.sort()
