diff --git a/ledger/fx.py b/ledger/fx.py
index ba10a28..64922ce 100644
--- a/ledger/fx.py
+++ b/ledger/fx.py
@@ -1,6 +1,15 @@
 """Currency conversion of minor-unit amounts."""
+from decimal import Decimal, ROUND_HALF_UP
 
 
 def convert(cents: int, rate: float) -> int:
-    """Convert an amount in minor units at rate, returning minor units."""
-    return int(cents * rate)
+    """Convert an amount in minor units at rate, returning minor units.
+
+    Rounds to the nearest minor unit, ties away from zero. Truncating instead
+    pulls every converted leg toward zero, and that bias does not cancel
+    between the debit and credit legs of a converted account.
+    """
+    if rate == 1.0:
+        return cents
+    converted = Decimal(cents) * Decimal(str(rate))
+    return int(converted.quantize(Decimal(1), rounding=ROUND_HALF_UP))
diff --git a/tests/test_fx.py b/tests/test_fx.py
new file mode 100644
index 0000000..3089fc3
--- /dev/null
+++ b/tests/test_fx.py
@@ -0,0 +1,18 @@
+import unittest
+from ledger.fx import convert
+
+
+class ConvertTests(unittest.TestCase):
+    def test_same_currency_rate_is_exact(self):
+        self.assertEqual(convert(4072, 1.0), 4072)
+
+    def test_rounds_to_nearest(self):
+        # 3823 * 0.9228 = 3527.87..., truncating would give 3527
+        self.assertEqual(convert(3823, 0.9228), 3528)
+
+    def test_ties_go_away_from_zero(self):
+        self.assertEqual(convert(5, 0.5), 3)
+        self.assertEqual(convert(-5, 0.5), -3)
+
+    def test_negative_amounts_round_symmetrically(self):
+        self.assertEqual(convert(-3823, 0.9228), -convert(3823, 0.9228))
