+++ b/tests/test_fx.py
@@ -0,0 +1,22 @@
+import unittest
+from ledger.fx import convert
+
+
+class ConvertTests(unittest.TestCase):
+    def test_rounds_to_nearest(self):
+        self.assertEqual(convert(3823, 0.9228), 3528)  # 3527.66...
+        self.assertEqual(convert(1000, 0.9228), 923)  # 922.8
+
+    def test_ties_go_to_even(self):
+        self.assertEqual(convert(50, 0.05), 2)  # 2.5
+        self.assertEqual(convert(70, 0.05), 4)  # 3.5
+
+    def test_identity_rate(self):
+        self.assertEqual(convert(-4609, 1.0), -4609)
+
+    def test_negative_amounts_round_symmetrically(self):
+        self.assertEqual(convert(-1000, 0.9228), -923)
+
+
+if __name__ == "__main__":
+    unittest.main()
