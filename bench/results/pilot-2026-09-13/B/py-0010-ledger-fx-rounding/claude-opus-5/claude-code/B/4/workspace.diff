+++ b/tests/test_fx.py
@@ -0,0 +1,20 @@
+import unittest
+from ledger.fx import convert
+
+
+class ConvertTests(unittest.TestCase):
+    def test_rounds_to_nearest(self):
+        self.assertEqual(convert(3823, 0.9228), 3528)  # 3527.8644
+        self.assertEqual(convert(100, 0.9228), 92)  # 92.28
+        self.assertEqual(convert(105, 0.9228), 97)  # 96.894
+
+    def test_rounds_half_away_from_zero(self):
+        self.assertEqual(convert(1, 0.5), 1)
+        self.assertEqual(convert(-1, 0.5), -1)
+
+    def test_identity_rate(self):
+        self.assertEqual(convert(12345, 1.0), 12345)
+
+
+if __name__ == "__main__":
+    unittest.main()
