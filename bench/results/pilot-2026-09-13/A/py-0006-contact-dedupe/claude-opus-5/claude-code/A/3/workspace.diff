 from .models import Contact
 
 
+def _email_key(contact: Contact) -> str:
+    """Feeds disagree on case and pad the address, so ignore both."""
+    return contact.email.strip().lower()
+
+
 def dedupe(contacts: list[Contact]) -> list[Contact]:
-    """Return the list without duplicate people."""
-    raise NotImplementedError("dedupe is not implemented yet")
+    """Return the list without duplicate people, keeping the first of each.
+
+    Two entries are the same person when their email addresses match once
+    surrounding whitespace and capitalisation are ignored. Entries with a
+    blank email are never considered duplicates of each other.
+    """
+    seen: set[str] = set()
+    result: list[Contact] = []
+    for contact in contacts:
+        key = _email_key(contact)
+        if key and key in seen:
+            continue
+        seen.add(key)
+        result.append(contact)
+    return result
