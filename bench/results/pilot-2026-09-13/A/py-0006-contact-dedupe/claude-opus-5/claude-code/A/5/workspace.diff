 from .models import Contact
 
 
+def _email_key(contact: Contact) -> str:
+    """Normalised email: feeds disagree on case and pad with whitespace."""
+    return contact.email.strip().lower()
+
+
 def dedupe(contacts: list[Contact]) -> list[Contact]:
-    """Return the list without duplicate people."""
-    raise NotImplementedError("dedupe is not implemented yet")
+    """Return the list without duplicate people, in the original order.
+
+    Two entries are the same person when their emails match, ignoring
+    surrounding whitespace and capitalisation. The first entry of each
+    group is kept. Entries without an email are all kept, since a missing
+    address says nothing about who the person is.
+    """
+    seen: set[str] = set()
+    result: list[Contact] = []
+    for contact in contacts:
+        key = _email_key(contact)
+        if key:
+            if key in seen:
+                continue
+            seen.add(key)
+        result.append(contact)
+    return result
