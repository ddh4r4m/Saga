 from .models import Contact
 
 
+def _email_key(contact: Contact) -> str:
+    """Email as the feeds should have sent it: no padding, no case differences."""
+    return contact.email.strip().lower()
+
+
 def dedupe(contacts: list[Contact]) -> list[Contact]:
-    """Return the list without duplicate people."""
-    raise NotImplementedError("dedupe is not implemented yet")
+    """Return the list without duplicate people.
+
+    Two entries are the same person when their emails match, ignoring
+    surrounding whitespace and capitalisation. The first entry for each
+    person is kept and the original ordering is preserved.
+    """
+    seen: set[str] = set()
+    result: list[Contact] = []
+    for contact in contacts:
+        key = _email_key(contact)
+        if key in seen:
+            continue
+        seen.add(key)
+        result.append(contact)
+    return result
