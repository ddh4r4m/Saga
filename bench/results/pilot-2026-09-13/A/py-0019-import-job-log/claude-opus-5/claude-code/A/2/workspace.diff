diff --git a/importer/parse.py b/importer/parse.py
index dfbfda4..e194b73 100644
--- a/importer/parse.py
+++ b/importer/parse.py
@@ -22,7 +22,9 @@ def parse_price(text: str) -> Decimal:
     according to their own locale: a comma, a space or a no-break space, so
     all of those have to be ignored. Anything else is a ParseError.
     """
-    cleaned = text.strip().replace(",", "")
+    cleaned = text.strip()
+    for sep in (",", " ", "\xa0"):
+        cleaned = cleaned.replace(sep, "")
     try:
         return Decimal(cleaned)
     except InvalidOperation:
diff --git a/tests/test_import.py b/tests/test_import.py
index 66ff2a2..e4c70cb 100644
--- a/tests/test_import.py
+++ b/tests/test_import.py
@@ -16,6 +16,12 @@ class ParseTests(unittest.TestCase):
     def test_comma_thousands(self):
         self.assertEqual(parse_price("1,250.00"), Decimal("1250.00"))
 
+    def test_space_thousands(self):
+        self.assertEqual(parse_price("3 868.13"), Decimal("3868.13"))
+
+    def test_no_break_space_thousands(self):
+        self.assertEqual(parse_price("3\xa0868.13"), Decimal("3868.13"))
+
     def test_garbage_rejected(self):
         with self.assertRaises(ParseError):
             parse_price("n/a")
