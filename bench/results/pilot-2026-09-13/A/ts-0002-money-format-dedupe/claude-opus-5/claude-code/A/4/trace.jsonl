{"agent":"main","body":{"error":null,"exit":0,"for_seq":7,"result_bytes":756,"result_hash":"sha256:0eb5b24336f3523429d379f23d46eeec78b0ba4e71441f4e271cf0b718412be6","result_inline":"1\t// Invoice rendering for the customer portal.\n2\t\n3\texport interface Line {\n4\t  description: string;\n5\t  cents: number;\n6\t}\n7\t\n8\tfunction formatMoney(cents: number): string {\n9\t  const sign = cents < 0 ? \"-\" : \"\";\n10\t  const abs = Math.abs(cents);\n11\t  const whole = Math.floor(abs / 100).toLocaleString(\"en-US\");\n12\t  const frac = String(abs % 100).padStart(2, \"0\");\n13\t  return `${sign}$${whole}.${frac}`;\n14\t}\n15\t\n16\texport function renderInvoice(lines: Line[]): string {\n17\t  const rows = lines.map((l) => `${l.description.padEnd(20)} ${formatMoney(l.cents).padStart(12)}`);\n18\t  const total = lines.reduce((sum, l) => sum + l.cents, 0);\n19\t  rows.push(`${\"TOTAL\".padEnd(20)} ${formatMoney(total).padStart(12)}`);\n20\t  return rows.join(\"\\n\");\n21\t}\n22\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:d2be1243992862e0caa13800fae44767b2ff95f1eadf91a3ad59caea0cc6b9bb","mono_ns":8000000,"prev":"sha256:d22406a9b55fd8d197428a70e45ed2639f068b204a5b1786d9ece4e9c1386a03","schema":"saga.trace/1","seq":8,"session":"b7924e85-0ef1-40f9-a86b-3303ea27e6fc","source":"stream-json","ts":"2026-01-01T00:00:00.008Z","turn":1,"type":"tool_result"}
