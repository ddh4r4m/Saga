 | code | message | when |
 |---|---|---|
 | E_UNKNOWN_SKU | unknown sku | the sku is not in the catalogue |
+| E_BAD_QTY | quantity must be a positive whole number | add was given a quantity that is not a whole number of 1 or more |
 | E_EMPTY_CART | cart is empty | checkout was asked for an empty cart |
 | E_USAGE | usage: cartctl add <sku> <qty> | the command line could not be parsed |
diff --git a/src/commands/add.ts b/src/commands/add.ts
index c79d097..2f5a984 100644
--- a/src/commands/add.ts
+++ b/src/commands/add.ts
@@ -5,6 +5,8 @@ import { fail } from "../errors.ts";
 // Add qty of sku to the cart, merging with an existing line for the same sku.
 export function addItem(cart: Cart, sku: string, qty: number): Cart {
   if (!(sku in CATALOGUE)) fail("E_UNKNOWN_SKU", `unknown sku ${sku}`);
+  if (!Number.isInteger(qty)) fail("E_BAD_QTY", `quantity must be a whole number, got ${qty}`);
+  if (qty < 1) fail("E_BAD_QTY", `quantity must be 1 or more, got ${qty}`);
   const lines = cart.lines.map((l) => ({ ...l }));
   const existing = lines.find((l) => l.sku === sku);
   if (existing) existing.qty += qty;
