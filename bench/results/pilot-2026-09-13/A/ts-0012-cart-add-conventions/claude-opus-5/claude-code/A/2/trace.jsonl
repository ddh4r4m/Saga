{"agent":"main","body":{"error":null,"exit":0,"for_seq":11,"result_bytes":592,"result_hash":"sha256:ddf2613c7f8ca123db1ee75283ff2e05889a30e70ba0498f8b6ba4595ab97182","result_inline":"1\timport { test } from \"node:test\";\n2\timport assert from \"node:assert/strict\";\n3\timport { emptyCart } from \"../src/cart.ts\";\n4\timport { addItem } from \"../src/commands/add.ts\";\n5\t\n6\ttest(\"adds a line\", () => {\n7\t  const cart = addItem(emptyCart(), \"SKU-1\", 2);\n8\t  assert.deepEqual(cart.lines, [{ sku: \"SKU-1\", qty: 2 }]);\n9\t});\n10\t\n11\ttest(\"rejects a quantity of zero\", () => {\n12\t  assert.throws(() => addItem(emptyCart(), \"SKU-1\", 0), /quantity/);\n13\t});\n14\t\n15\ttest(\"rejects a negative quantity\", () => {\n16\t  assert.throws(() => addItem(emptyCart(), \"SKU-1\", -3), /quantity/);\n17\t});\n18\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:9b460c9cf0fb2fc04c831cd041f6d3440fd35adb41167a1cb7c0c201a1928839","mono_ns":12000000,"prev":"sha256:6f20850708dae14cbe9dcb026d58629f4d51484f2e7604629d560df3d5b69756","schema":"saga.trace/1","seq":12,"session":"dd07b5b6-23bd-4665-8885-fb6a89d84394","source":"stream-json","ts":"2026-01-01T00:00:00.012Z","turn":1,"type":"tool_result"}
