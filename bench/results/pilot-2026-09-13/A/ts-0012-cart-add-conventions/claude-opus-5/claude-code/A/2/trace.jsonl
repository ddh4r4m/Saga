{"agent":"main","body":{"error":null,"exit":0,"for_seq":17,"result_bytes":838,"result_hash":"sha256:21deb63b09e145a5f11d17c6dec4617c0114d17b2f0483a414b2992ba15fbb3c","result_inline":"1\timport { emptyCart } from \"./cart.ts\";\n2\timport { addItem } from \"./commands/add.ts\";\n3\timport { totalCents } from \"./commands/checkout.ts\";\n4\timport { CliError, fail } from \"./errors.ts\";\n5\t\n6\texport function run(argv: string[]): number {\n7\t  try {\n8\t    if (argv[0] !== \"add\" || argv.length !== 3) fail(\"E_USAGE\");\n9\t    const cart = addItem(emptyCart(), argv[1], Number(argv[2]));\n10\t    process.stdout.write(`${cart.lines.length} line(s), total ${totalCents(cart)}\\n`);\n11\t    return 0;\n12\t  } catch (e) {\n13\t    if (e instanceof CliError) {\n14\t      process.stderr.write(`error ${e.code}: ${e.message}\\n`);\n15\t      return 2;\n16\t    }\n17\t    process.stderr.write(`${(e as Error).stack ?? e}\\n`);\n18\t    return 70;\n19\t  }\n20\t}\n21\t\n22\tif (import.meta.url === `file://${process.argv[1]}`) process.exit(run(process.argv.slice(2)));\n23\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:02f2579a5a4380a3a33cbd270cbca78eb5bf08a919a6cca235c80c13c3797ab8","mono_ns":18000000,"prev":"sha256:2b6a17df86ea93370532407b07ba93f0bc5b58af31ed52ddb5e61ba4a3368e35","schema":"saga.trace/1","seq":18,"session":"dd07b5b6-23bd-4665-8885-fb6a89d84394","source":"stream-json","ts":"2026-01-01T00:00:00.018Z","turn":1,"type":"tool_result"}
