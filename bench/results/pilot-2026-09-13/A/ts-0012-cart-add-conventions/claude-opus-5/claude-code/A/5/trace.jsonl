{"agent":"main","body":{"error":null,"exit":0,"for_seq":7,"result_bytes":573,"result_hash":"sha256:e5e2dd27e0c028ea444f04c6285f56797b94ec4518b27fc7ae64f6d643a7cf8e","result_inline":"1\timport type { Cart } from \"../cart.ts\";\n2\timport { CATALOGUE } from \"../catalogue.ts\";\n3\timport { fail } from \"../errors.ts\";\n4\t\n5\t// Add qty of sku to the cart, merging with an existing line for the same sku.\n6\texport function addItem(cart: Cart, sku: string, qty: number): Cart {\n7\t  if (!(sku in CATALOGUE)) fail(\"E_UNKNOWN_SKU\", `unknown sku ${sku}`);\n8\t  const lines = cart.lines.map((l) => ({ ...l }));\n9\t  const existing = lines.find((l) => l.sku === sku);\n10\t  if (existing) existing.qty += qty;\n11\t  else lines.push({ sku, qty });\n12\t  return { lines };\n13\t}\n14\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:b0af264b266e4ea47e6eb3c653984ed381f5baefc3c88a011cc3c73a04d60a41","mono_ns":8000000,"prev":"sha256:5f229e05904172cd1b8cfe83407e11d7b166bbbfd43bea9e33b0025c6058c4e8","schema":"saga.trace/1","seq":8,"session":"f9aee1d1-6989-4e2d-bdf8-67d791b985ea","source":"stream-json","ts":"2026-01-01T00:00:00.008Z","turn":1,"type":"tool_result"}
