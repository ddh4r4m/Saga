{"agent":"main","body":{"error":null,"exit":0,"for_seq":5,"result_bytes":592,"result_hash":"sha256:ddf2613c7f8ca123db1ee75283ff2e05889a30e70ba0498f8b6ba4595ab97182","result_inline":"1\timport { test } from \"node:test\";\n2\timport assert from \"node:assert/strict\";\n3\timport { emptyCart } from \"../src/cart.ts\";\n4\timport { addItem } from \"../src/commands/add.ts\";\n5\t\n6\ttest(\"adds a line\", () => {\n7\t  const cart = addItem(emptyCart(), \"SKU-1\", 2);\n8\t  assert.deepEqual(cart.lines, [{ sku: \"SKU-1\", qty: 2 }]);\n9\t});\n10\t\n11\ttest(\"rejects a quantity of zero\", () => {\n12\t  assert.throws(() => addItem(emptyCart(), \"SKU-1\", 0), /quantity/);\n13\t});\n14\t\n15\ttest(\"rejects a negative quantity\", () => {\n16\t  assert.throws(() => addItem(emptyCart(), \"SKU-1\", -3), /quantity/);\n17\t});\n18\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:95f0f78752129edcaea14514cc9343222311af9d77960d89f28c796b174853dc","mono_ns":6000000,"prev":"sha256:e72c29b2ddd6121c8b1b5ef1a3ea8755ae70de762c9990e1ce30f3b2c05e2320","schema":"saga.trace/1","seq":6,"session":"f9aee1d1-6989-4e2d-bdf8-67d791b985ea","source":"stream-json","ts":"2026-01-01T00:00:00.006Z","turn":1,"type":"tool_result"}
