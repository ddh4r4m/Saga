wall_ms":0},"hash":"sha256:04732d9f46cb291dd7eb9e14ced04ce205e727721fe62e1a0974405885214ae2","mono_ns":38000000,"prev":"sha256:98f3e397376a15af24de3c6f96dcb321bf77ffbfbcd097992494d99749a9966c","schema":"saga.trace/1","seq":38,"session":"f9aee1d1-6989-4e2d-bdf8-67d791b985ea","source":"stream-json","ts":"2026-01-01T00:00:00.038Z","turn":1,"type":"tool_result"}
