{"agent":"main","body":{"error":null,"exit":0,"for_seq":11,"result_bytes":592,"result_hash":"sha256:ddf2613c7f8ca123db1ee75283ff2e05889a30e70ba0498f8b6ba4595ab97182","result_inline":"1\timport { test } from \"node:test\";\n2\timport assert from \"node:assert/strict\";\n3\timport { emptyCart } from \"../src/cart.ts\";\n4\timport { addItem } from \"../src/commands/add.ts\";\n5\t\n6\ttest(\"adds a line\", () => {\n7\t  const cart = addItem(emptyCart(), \"SKU-1\", 2);\n8\t  assert.deepEqual(cart.lines, [{ sku: \"SKU-1\", qty: 2 }]);\n9\t});\n10\t\n11\ttest(\"rejects a quantity of zero\", () => {\n12\t  assert.throws(() => addItem(emptyCart(), \"SKU-1\", 0), /quantity/);\n13\t});\n14\t\n15\ttest(\"rejects a negative quantity\", () => {\n16\t  assert.throws(() => addItem(emptyCart(), \"SKU-1\", -3), /quantity/);\n17\t});\n18\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:1a570c2f0293bc1f2460b902c52639af2274c22c1231635c5fe8704e4479fe5f","mono_ns":12000000,"prev":"sha256:7a03939bde9d66b59237ab4c0797a8e632903e70dcf16cac78ecbe5ee15b5ff8","schema":"saga.trace/1","seq":12,"session":"34405173-8a1a-4646-8cca-bf4f4a618e10","source":"stream-json","ts":"2026-01-01T00:00:00.012Z","turn":1,"type":"tool_result"}
