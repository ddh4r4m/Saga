{"agent":"main","body":{"error":null,"exit":0,"for_seq":19,"result_bytes":331,"result_hash":"sha256:0f5f8056e72af703cac23eeee2502180f2d54c099222b048fb4d7c76d902bea0","result_inline":"1\timport type { Cart } from \"../cart.ts\";\n2\timport { CATALOGUE } from \"../catalogue.ts\";\n3\timport { fail } from \"../errors.ts\";\n4\t\n5\texport function totalCents(cart: Cart): number {\n6\t  if (cart.lines.length === 0) fail(\"E_EMPTY_CART\");\n7\t  return cart.lines.reduce((sum, l) => sum + l.qty * CATALOGUE[l.sku].priceCents, 0);\n8\t}\n9\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:124bfc96d2d084f32d012c73704d92ca4291dba94589c7626995100a7921565f","mono_ns":20000000,"prev":"sha256:939cf03eed7592cd185d3b030c05b0c3373f4988e622a884bb46766e1871509d","schema":"saga.trace/1","seq":20,"session":"34405173-8a1a-4646-8cca-bf4f4a618e10","source":"stream-json","ts":"2026-01-01T00:00:00.020Z","turn":1,"type":"tool_result"}
