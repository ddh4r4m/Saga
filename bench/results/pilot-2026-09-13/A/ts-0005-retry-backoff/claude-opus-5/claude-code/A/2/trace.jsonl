{"agent":"main","body":{"error":null,"exit":0,"for_seq":7,"result_bytes":186,"result_hash":"sha256:ae41cb1e96e47de3ca4bca140a4ee527766a4a73c62d032305c5491e847b011b","result_inline":"src/retry.ts\ntest/retry.test.ts\n{\n  \"name\": \"retry-kit\",\n  \"version\": \"0.9.2\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"scripts\": {\n    \"test\": \"node --test \\\"test/**/*.test.ts\\\"\"\n  }\n}","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:7d6308df10bf24d035cce1ecabb0e83eccf83b491e98e61d88b56ec93fe56693","mono_ns":8000000,"prev":"sha256:61f2ba42849aa86055a9141ced574ccaff63400e14e72643a3292b13ad1f3474","schema":"saga.trace/1","seq":8,"session":"6f8e1463-5ebb-4295-a9a8-75e42c148551","source":"stream-json","ts":"2026-01-01T00:00:00.008Z","turn":1,"type":"tool_result"}
