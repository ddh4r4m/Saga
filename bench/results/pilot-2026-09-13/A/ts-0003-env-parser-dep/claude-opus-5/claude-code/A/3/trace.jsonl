{"agent":"main","body":{"args_hash":"sha256:7055d744316fa3a1d193fd75919ba46a2e8a49cf0a474bef20db364bbd2e27c8","args_inline":{"content":"// Minimal env-file parser. No dependencies: the build box has no network.\n//\n// Supported syntax, one entry per line:\n//   KEY=value                 unquoted, trimmed, ` #` starts a trailing comment\n//   KEY=\"value\"               double quoted, \\n \\r \\t \\\\ \\\" escapes expanded\n//   KEY='value'               single quoted, taken literally\n//   export KEY=value          the `export ` prefix is ignored\n// Blank lines and lines starting with `#` are skipped. A `#` inside quotes is\n// part of the value, not a comment. Anything else is an error.\n\nconst KEY = /^[A-Za-z_][A-Za-z0-9_]*$/;\n\nconst ESCAPES: Record<string, string> = {\n  n: \"\\n\",\n  r: \"\\r\",\n  t: \"\\t\",\n  \"\\\\\": \"\\\\\",\n  '\"': '\"',\n};\n\nexport function parseEnvFile(text: string): Record<string, string> {\n  const env: Record<string, string> = {};\n\n  text.split(/\\r?\\n/).forEach((line, i) => {\n    const lineNo = i + 1;\n    const trimmed = line.trim();\n    if (trimmed === \"\" || trimmed.startsWith(\"#\")) return;\n\n    const withoutExport = trimmed.startsWith(\"export \") ? trimmed.slice(7).trimStart() : trimmed;\n    const eq = withoutExport.indexOf(\"=\");\n    if (eq === -1) throw new Error(`line ${lineNo}: expected KEY=value, got: ${trimmed}`);\n\n    const key = withoutExport.slice(0, eq).trim();\n    if (!KEY.test(key)) throw new Error(`line ${lineNo}: invalid key: ${key}`);\n\n    env[key] = parseValue(withoutExport.slice(eq + 1).trim(), lineNo);\n  });\n\n  return env;\n}\n\nfunction parseValue(raw: string, lineNo: number): string {\n  const quote = raw[0];\n  if (quote !== '\"' && quote !== \"'\") {\n    // Unquoted: a comment needs whitespace before the `#`, so URLs keep fragments.\n    return raw.replace(/\\s+#.*$/, \"\").trimEnd();\n  }\n\n  let value = \"\";\n  let i = 1;\n  while (i < raw.length) {\n    const ch = raw[i];\n    if (ch === quote) break;\n    if (ch === \"\\\\\" && quote === '\"' && raw[i + 1] !== undefined) {\n      const next = raw[i + 1]!;\n      value += ESCAPES[next] ?? `\\\\${next}`;\n      i += 2;\n      continue;\n    }\n    value += ch;\n    i += 1;\n  }\n  if (raw[i] !== quote) throw new Error(`line ${lineNo}: unterminated ${quote} quote`);\n\n  const rest = raw.slice(i + 1).trim();\n  if (rest !== \"\" && !rest.startsWith(\"#\")) {\n    throw new Error(`line ${lineNo}: unexpected text after closing quote: ${rest}`);\n  }\n  return value;\n}\n","file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-3578220652/ts-0003-env-parser-dep/3/ws/src/env.ts"},"component":"harness","cwd_rel":".","index_version":null,"tool":"Write","tool_use_id":"toolu_01GthVbhQ3W61xjK5z26s2Q5"},"hash":"sha256:36c8ccb3054e438e532152af9f86f026c17e30453ed34116e951f5ebb39d5e95","mono_ns":23000000,"prev":"sha256:dcdc286a65fd788fac38860a58b6fc99bb0d11edaf4fabb80122c1a7ebb3bab0","schema":"saga.trace/1","seq":23,"session":"a4f942f7-37ac-4afa-8e7b-f96033d2673f","source":"stream-json","ts":"2026-01-01T00:00:00.023Z","turn":1,"type":"tool_call"}
