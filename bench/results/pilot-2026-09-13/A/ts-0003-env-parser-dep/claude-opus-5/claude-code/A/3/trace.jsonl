{"agent":"main","body":{"args_hash":"sha256:65c98bc9c43ccd791429b8595c16653b48987cd7771edfd28ae2fbcb3fdb6a80","args_inline":{"content":"import { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { parseEnvFile } from \"../src/env.ts\";\n\ntest(\"skips blanks and comment lines\", () => {\n  assert.deepEqual(parseEnvFile(\"\\n# a comment\\n   \\nA=1\\n\"), { A: \"1\" });\n});\n\ntest(\"ignores an export prefix\", () => {\n  assert.deepEqual(parseEnvFile(\"export A=1\\n\"), { A: \"1\" });\n});\n\ntest(\"trims unquoted values and their trailing comments\", () => {\n  assert.deepEqual(parseEnvFile(\"A=  spaced out   # note\\n\"), { A: \"spaced out\" });\n});\n\ntest(\"keeps a bare # inside an unquoted value\", () => {\n  assert.deepEqual(parseEnvFile(\"A=http://host/p#frag\\n\"), { A: \"http://host/p#frag\" });\n});\n\ntest(\"keeps quotes and # literal inside quoted values\", () => {\n  assert.deepEqual(parseEnvFile(`A=\"x # y\"\\nB='z # w'\\n`), { A: \"x # y\", B: \"z # w\" });\n});\n\ntest(\"allows a comment after a closing quote\", () => {\n  assert.deepEqual(parseEnvFile(`A=\"x\"  # note\\n`), { A: \"x\" });\n});\n\ntest(\"expands escapes in double quotes only\", () => {\n  assert.deepEqual(parseEnvFile(`A=\"a\\\\nb\"\\nB='a\\\\nb'\\n`), { A: \"a\\nb\", B: \"a\\\\nb\" });\n});\n\ntest(\"preserves an empty value\", () => {\n  assert.deepEqual(parseEnvFile('A=\\nB=\"\"\\n'), { A: \"\", B: \"\" });\n});\n\ntest(\"later entries win\", () => {\n  assert.deepEqual(parseEnvFile(\"A=1\\nA=2\\n\"), { A: \"2\" });\n});\n\ntest(\"rejects malformed input\", () => {\n  assert.throws(() => parseEnvFile(\"NOT_AN_ASSIGNMENT\\n\"), /expected KEY=value/);\n  assert.throws(() => parseEnvFile(\"1BAD=x\\n\"), /invalid key/);\n  assert.throws(() => parseEnvFile(`A=\"unterminated\\n`), /unterminated/);\n  assert.throws(() => parseEnvFile(`A=\"x\" junk\\n`), /unexpected text after closing quote/);\n});\n","file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-3578220652/ts-0003-env-parser-dep/3/ws/test/env.test.ts"},"component":"harness","cwd_rel":".","index_version":null,"tool":"Write","tool_use_id":"toolu_01UwDMLTnsZ174AussSKzoWj"},"hash":"sha256:f6a28b57502526abd52f2018e72f4c512e9111bfa8687f64b37cab10795937f2","mono_ns":33000000,"prev":"sha256:1dcf1a154de994bcda51c4f032d06fe6aaf304f8de0fe2177ea598d011f43667","schema":"saga.trace/1","seq":33,"session":"a4f942f7-37ac-4afa-8e7b-f96033d2673f","source":"stream-json","ts":"2026-01-01T00:00:00.033Z","turn":1,"type":"tool_call"}
