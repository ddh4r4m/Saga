{"agent":"main","body":{"args_hash":"sha256:e2ad1d7df74236dfb75ffa6bd1c3d75e031845c7602df724af18675e555d5f1f","args_inline":{"content":"import { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { readFileSync } from \"node:fs\";\nimport { loadConfig } from \"../src/config.ts\";\n\ntest(\"loads a basic env file\", () => {\n  const cfg = loadConfig(\"PORT=9090\\nHOST=db.internal\\nDEBUG=true\\n\");\n  assert.equal(cfg.port, 9090);\n  assert.equal(cfg.host, \"db.internal\");\n  assert.equal(cfg.debug, true);\n});\n\ntest(\"applies defaults for missing keys\", () => {\n  const cfg = loadConfig(\"\");\n  assert.deepEqual(cfg, {\n    port: 8080,\n    host: \"127.0.0.1\",\n    appName: \"order-service\",\n    debug: false,\n    motd: \"\",\n  });\n});\n\ntest(\"rejects a non-numeric PORT\", () => {\n  assert.throws(() => loadConfig(\"PORT=eighty\\n\"), /invalid PORT/);\n});\n\ntest(\"keeps quoted values intact\", () => {\n  const cfg = loadConfig(`APP_NAME=\"Order Service\"\\nMOTD='hello # not a comment'\\n`);\n  assert.equal(cfg.appName, \"Order Service\");\n  assert.equal(cfg.motd, \"hello # not a comment\");\n});\n\ntest(\"strips comments outside quotes\", () => {\n  const cfg = loadConfig(\"# leading comment\\nPORT=9090 # trailing\\nHOST=local\\n\");\n  assert.equal(cfg.port, 9090);\n  assert.equal(cfg.host, \"local\");\n});\n\ntest(\"loads .env.example as shipped\", () => {\n  const cfg = loadConfig(readFileSync(new URL(\"../.env.example\", import.meta.url), \"utf8\"));\n  assert.deepEqual(cfg, {\n    port: 8080,\n    host: \"0.0.0.0\",\n    appName: \"Order Service\",\n    debug: false,\n    motd: \"hello # not a comment\",\n  });\n});\n","file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-3578220652/ts-0003-env-parser-dep/3/ws/test/config.test.ts"},"component":"harness","cwd_rel":".","index_version":null,"tool":"Write","tool_use_id":"toolu_01DeUSewWbYJy94gtzLATNwx"},"hash":"sha256:f6bfbf656dbf6dd1f3e78946d8358a5bf1bbfcee3364b94b5d897243957f8aae","mono_ns":31000000,"prev":"sha256:168a1b833d3c4aac8371c598c53a940d9e4f8dca4c457de9ee0224d1ab031a3f","schema":"saga.trace/1","seq":31,"session":"a4f942f7-37ac-4afa-8e7b-f96033d2673f","source":"stream-json","ts":"2026-01-01T00:00:00.031Z","turn":1,"type":"tool_call"}
