--- a/test/config.test.ts
+++ b/test/config.test.ts
@@ -1,5 +1,6 @@
 import { test } from "node:test";
 import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
 import { loadConfig } from "../src/config.ts";
 
 test("loads a basic env file", () => {
@@ -8,3 +9,44 @@ test("loads a basic env file", () => {
   assert.equal(cfg.host, "db.internal");
   assert.equal(cfg.debug, true);
 });
+
+test("loads .env.example with quotes intact", () => {
+  const cfg = loadConfig(readFileSync(new URL("../.env.example", import.meta.url), "utf8"));
+  assert.deepEqual(cfg, {
+    port: 8080,
+    host: "0.0.0.0",
+    appName: "Order Service",
+    debug: false,
+    motd: "hello # not a comment",
+  });
+});
+
+test("strips comments outside quotes, keeps them inside", () => {
+  const cfg = loadConfig(
+    "# leading comment\nPORT=9090 # trailing comment\nAPP_NAME=\"a # b\" # after\nMOTD='keep # this'\n",
+  );
+  assert.equal(cfg.port, 9090);
+  assert.equal(cfg.appName, "a # b");
+  assert.equal(cfg.motd, "keep # this");
+});
+
+test("handles export prefix, blank lines, escapes and repeated keys", () => {
+  const cfg = loadConfig("\nexport HOST=db.internal\r\nMOTD=\"line1\\nline2\"\nPORT=1\nPORT=2\n");
+  assert.equal(cfg.host, "db.internal");
+  assert.equal(cfg.motd, "line1\nline2");
+  assert.equal(cfg.port, 2);
+});
+
+test("defaults apply and bad input is rejected", () => {
+  assert.deepEqual(loadConfig(""), {
+    port: 8080,
+    host: "127.0.0.1",
+    appName: "order-service",
+    debug: false,
+    motd: "",
+  });
+  assert.throws(() => loadConfig("PORT=notanumber\n"), /invalid PORT/);
+  assert.throws(() => loadConfig('APP_NAME="unterminated\n'), /unterminated/);
+  assert.throws(() => loadConfig("HOST\n"), /missing "="/);
+  assert.throws(() => loadConfig("2BAD=x\n"), /invalid key/);
+});
