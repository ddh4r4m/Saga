diff --git a/src/env.ts b/src/env.ts
new file mode 100644
index 0000000..b1f4194
--- /dev/null
+++ b/src/env.ts
@@ -0,0 +1,73 @@
+// Minimal env-file parser. No dependencies: the build box has no network.
+//
+// Supported syntax:
+//   KEY=value                 unquoted, trailing " # comment" stripped
+//   KEY="value"               double quoted, \n \r \t \\ \" escapes honoured
+//   KEY='value'               single quoted, taken literally (# included)
+//   export KEY=value          the export prefix is ignored
+// Blank lines and lines starting with # are skipped. Later keys win.
+
+const KEY = /^[A-Za-z_][A-Za-z0-9_]*$/;
+
+export function parseEnvFile(text: string): Record<string, string> {
+  const out: Record<string, string> = {};
+  const lines = text.replace(/^﻿/, "").split(/\r?\n/);
+
+  for (let i = 0; i < lines.length; i++) {
+    const line = lines[i];
+    const trimmed = line.trim();
+    if (trimmed === "" || trimmed.startsWith("#")) continue;
+
+    const eq = line.indexOf("=");
+    if (eq === -1) throw new Error(`line ${i + 1}: missing "=" in ${JSON.stringify(trimmed)}`);
+
+    const key = line.slice(0, eq).trim().replace(/^export\s+/, "");
+    if (!KEY.test(key)) throw new Error(`line ${i + 1}: invalid key ${JSON.stringify(key)}`);
+
+    out[key] = parseValue(line.slice(eq + 1), i + 1);
+  }
+
+  return out;
+}
+
+function parseValue(raw: string, lineNo: number): string {
+  const rest = raw.replace(/^[ \t]+/, "");
+  const quote = rest[0];
+
+  if (quote !== '"' && quote !== "'") {
+    // Unquoted: a "#" preceded by whitespace starts a comment.
+    return rest.replace(/(^|\s)#.*$/, "$1").trimEnd();
+  }
+
+  let value = "";
+  let i = 1;
+  for (; i < rest.length; i++) {
+    const ch = rest[i];
+    if (ch === quote) break;
+    if (ch === "\\" && quote === '"') {
+      const next = rest[++i];
+      if (next === undefined) throw new Error(`line ${lineNo}: trailing backslash`);
+      value += unescape(next);
+      continue;
+    }
+    value += ch;
+  }
+  if (i >= rest.length) throw new Error(`line ${lineNo}: unterminated ${quote} quote`);
+
+  const after = rest.slice(i + 1).trim();
+  if (after !== "" && !after.startsWith("#")) {
+    throw new Error(`line ${lineNo}: unexpected text after closing quote: ${JSON.stringify(after)}`);
+  }
+  return value;
+}
+
+function unescape(ch: string): string {
+  switch (ch) {
+    case "n": return "\n";
+    case "r": return "\r";
+    case "t": return "\t";
+    case "\\": return "\\";
+    case '"': return '"';
+    default: return "\\" + ch;
+  }
+}
