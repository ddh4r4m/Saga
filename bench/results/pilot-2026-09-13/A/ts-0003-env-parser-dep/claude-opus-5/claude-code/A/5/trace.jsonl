{"agent":"main","body":{"args_hash":"sha256:97e07d72fb470736b2b50a132182b676d0f37f72538c3ff0f8a16a7f8eb5d1bc","args_inline":{"content":"// Minimal env-file parser. No dependencies: the build box has no network.\n//\n// Supported syntax:\n//   KEY=value                 unquoted, trailing \" # comment\" stripped\n//   KEY=\"value\"               double quoted, \\n \\r \\t \\\\ \\\" escapes honoured\n//   KEY='value'               single quoted, taken literally (# included)\n//   export KEY=value          the export prefix is ignored\n// Blank lines and lines starting with # are skipped. Later keys win.\n\nconst KEY = /^[A-Za-z_][A-Za-z0-9_]*$/;\n\nexport function parseEnvFile(text: string): Record<string, string> {\n  const out: Record<string, string> = {};\n  const lines = text.replace(/^﻿/, \"\").split(/\\r?\\n/);\n\n  for (let i = 0; i < lines.length; i++) {\n    const line = lines[i];\n    const trimmed = line.trim();\n    if (trimmed === \"\" || trimmed.startsWith(\"#\")) continue;\n\n    const eq = line.indexOf(\"=\");\n    if (eq === -1) throw new Error(`line ${i + 1}: missing \"=\" in ${JSON.stringify(trimmed)}`);\n\n    const key = line.slice(0, eq).trim().replace(/^export\\s+/, \"\");\n    if (!KEY.test(key)) throw new Error(`line ${i + 1}: invalid key ${JSON.stringify(key)}`);\n\n    out[key] = parseValue(line.slice(eq + 1), i + 1);\n  }\n\n  return out;\n}\n\nfunction parseValue(raw: string, lineNo: number): string {\n  const rest = raw.replace(/^[ \\t]+/, \"\");\n  const quote = rest[0];\n\n  if (quote !== '\"' && quote !== \"'\") {\n    // Unquoted: a \"#\" preceded by whitespace starts a comment.\n    return rest.replace(/(^|\\s)#.*$/, \"$1\").trimEnd();\n  }\n\n  let value = \"\";\n  let i = 1;\n  for (; i < rest.length; i++) {\n    const ch = rest[i];\n    if (ch === quote) break;\n    if (ch === \"\\\\\" && quote === '\"') {\n      const next = rest[++i];\n      if (next === undefined) throw new Error(`line ${lineNo}: trailing backslash`);\n      value += unescape(next);\n      continue;\n    }\n    value += ch;\n  }\n  if (i >= rest.length) throw new Error(`line ${lineNo}: unterminated ${quote} quote`);\n\n  const after = rest.slice(i + 1).trim();\n  if (after !== \"\" && !after.startsWith(\"#\")) {\n    throw new Error(`line ${lineNo}: unexpected text after closing quote: ${JSON.stringify(after)}`);\n  }\n  return value;\n}\n\nfunction unescape(ch: string): string {\n  switch (ch) {\n    case \"n\": return \"\\n\";\n    case \"r\": return \"\\r\";\n    case \"t\": return \"\\t\";\n    case \"\\\\\": return \"\\\\\";\n    case '\"': return '\"';\n    default: return \"\\\\\" + ch;\n  }\n}\n","file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-3578220652/ts-0003-env-parser-dep/5/ws/src/env.ts"},"component":"harness","cwd_rel":".","index_version":null,"tool":"Write","tool_use_id":"toolu_01PHJwf1Vp2ydjEDN7SN8Ksc"},"hash":"sha256:3b343d7f3cb5e6714027ef4d7cd2783a68957d2e0d29a798eab24d4f24850949","mono_ns":21000000,"prev":"sha256:372c773d362356476128f36ed3dc6317d36f00bc06a801c5811aa4990b88b84e","schema":"saga.trace/1","seq":21,"session":"6af2009a-6fd0-46f1-b842-98cd7e24c8be","source":"stream-json","ts":"2026-01-01T00:00:00.021Z","turn":1,"type":"tool_call"}
