{"agent":"main","body":{"args_hash":"sha256:b87a5ebb9af4c8c37b8d7aabd7ed96e5a888d79552a6b8fc6d0ab3061ef6be1e","args_inline":{"file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-3578220652/ts-0003-env-parser-dep/5/ws/test/config.test.ts","new_string":"  assert.equal(cfg.debug, true);\n});\n\ntest(\"loads .env.example with quotes intact\", () => {\n  const cfg = loadConfig(readFileSync(new URL(\"../.env.example\", import.meta.url), \"utf8\"));\n  assert.deepEqual(cfg, {\n    port: 8080,\n    host: \"0.0.0.0\",\n    appName: \"Order Service\",\n    debug: false,\n    motd: \"hello # not a comment\",\n  });\n});\n\ntest(\"strips comments outside quotes, keeps them inside\", () => {\n  const cfg = loadConfig(\n    \"# leading comment\\nPORT=9090 # trailing comment\\nAPP_NAME=\\\"a # b\\\" # after\\nMOTD='keep # this'\\n\",\n  );\n  assert.equal(cfg.port, 9090);\n  assert.equal(cfg.appName, \"a # b\");\n  assert.equal(cfg.motd, \"keep # this\");\n});\n\ntest(\"handles export prefix, blank lines, escapes and repeated keys\", () => {\n  const cfg = loadConfig(\"\\nexport HOST=db.internal\\r\\nMOTD=\\\"line1\\\\nline2\\\"\\nPORT=1\\nPORT=2\\n\");\n  assert.equal(cfg.host, \"db.internal\");\n  assert.equal(cfg.motd, \"line1\\nline2\");\n  assert.equal(cfg.port, 2);\n});\n\ntest(\"defaults apply and bad input is rejected\", () => {\n  assert.deepEqual(loadConfig(\"\"), {\n    port: 8080,\n    host: \"127.0.0.1\",\n    appName: \"order-service\",\n    debug: false,\n    motd: \"\",\n  });\n  assert.throws(() => loadConfig(\"PORT=notanumber\\n\"), /invalid PORT/);\n  assert.throws(() => loadConfig('APP_NAME=\"unterminated\\n'), /unterminated/);\n  assert.throws(() => loadConfig(\"HOST\\n\"), /missing \"=\"/);\n  assert.throws(() => loadConfig(\"2BAD=x\\n\"), /invalid key/);\n});\n","old_string":"  assert.equal(cfg.debug, true);\n});\n","replace_all":false},"component":"harness","cwd_rel":".","index_version":null,"tool":"Edit","tool_use_id":"toolu_018FdKipkJf7KgKynNnmHbxU"},"hash":"sha256:bb284ce3d57a4000f531c72f705ec5ede95c15030e414b74df013948aad38b46","mono_ns":31000000,"prev":"sha256:d9fb20767c30e4dcc650e4024a264792b5d77a8875c501b4d4983914753ebd3d","schema":"saga.trace/1","seq":31,"session":"6af2009a-6fd0-46f1-b842-98cd7e24c8be","source":"stream-json","ts":"2026-01-01T00:00:00.031Z","turn":1,"type":"tool_call"}
