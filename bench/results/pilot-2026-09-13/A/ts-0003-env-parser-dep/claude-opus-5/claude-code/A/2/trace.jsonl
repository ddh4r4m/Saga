{"agent":"main","body":{"args_hash":"sha256:cf21ac2cccf49a16e13e3e9a0d689b007c527c0d7b6b07c200618960eb84dfec","args_inline":{"content":"// Minimal env-file parser. Kept in-tree so config loading has no dependencies.\n\nconst ENTRY = /^\\s*(?:export\\s+)?([A-Za-z_][A-Za-z0-9_]*)\\s*=\\s*(.*)$/s;\n\nconst ESCAPES: Record<string, string> = {\n  n: \"\\n\",\n  r: \"\\r\",\n  t: \"\\t\",\n  \"\\\\\": \"\\\\\",\n  '\"': '\"',\n  \"'\": \"'\",\n};\n\n// Reads a quoted value starting at the opening quote. Returns the unquoted text\n// and the index just past the closing quote. Escapes apply inside double quotes\n// only; single quotes are literal, as in shell.\nfunction readQuoted(text: string, start: number): { value: string; end: number } {\n  const quote = text[start];\n  let value = \"\";\n  for (let i = start + 1; i < text.length; i++) {\n    const ch = text[i];\n    if (quote === '\"' && ch === \"\\\\\" && i + 1 < text.length) {\n      const next = text[i + 1];\n      value += ESCAPES[next] ?? \"\\\\\" + next;\n      i++;\n      continue;\n    }\n    if (ch === quote) return { value, end: i + 1 };\n    value += ch;\n  }\n  throw new Error(`unterminated ${quote} quote in env file`);\n}\n\n// Strips a trailing comment from a bare value. A `#` only starts a comment when\n// it begins the value or follows whitespace, so `pass#word` stays intact.\nfunction stripComment(raw: string): string {\n  for (let i = 0; i < raw.length; i++) {\n    if (raw[i] === \"#\" && (i === 0 || /\\s/.test(raw[i - 1]))) return raw.slice(0, i);\n  }\n  return raw;\n}\n\n/**\n * Parses env-file text into key/value pairs.\n *\n * Supports `export` prefixes, blank lines, `#` comments, and single- or\n * double-quoted values (which may span lines and may contain `#`). Later\n * assignments to the same key win. Throws on malformed lines.\n */\nexport function parseEnvFile(text: string): Record<string, string> {\n  const env: Record<string, string> = {};\n  // Normalise line endings so a CRLF file does not leave \\r on every value.\n  const src = text.replace(/\\r\\n?/g, \"\\n\");\n  let pos = 0;\n\n  while (pos < src.length) {\n    let lineEnd = src.indexOf(\"\\n\", pos);\n    if (lineEnd === -1) lineEnd = src.length;\n    const line = src.slice(pos, lineEnd);\n\n    if (!line.trim() || line.trimStart().startsWith(\"#\")) {\n      pos = lineEnd + 1;\n      continue;\n    }\n\n    const match = ENTRY.exec(line);\n    if (!match) throw new Error(`malformed env file line: ${line}`);\n    const [, key, rest] = match;\n\n    const quote = rest[0];\n    if (quote === '\"' || quote === \"'\") {\n      // Scan from the whole remaining source so quoted values may span lines.\n      const valueStart = pos + line.length - rest.length;\n      const { value, end } = readQuoted(src, valueStart);\n      const trailing = src.slice(end, src.indexOf(\"\\n\", end) === -1 ? src.length : src.indexOf(\"\\n\", end));\n      if (trailing.trim() && !trailing.trimStart().startsWith(\"#\")) {\n        throw new Error(`unexpected text after quoted value for ${key}: ${trailing.trim()}`);\n      }\n      env[key] = value;\n      const nextBreak = src.indexOf(\"\\n\", end);\n      pos = nextBreak === -1 ? src.length : nextBreak + 1;\n      continue;\n    }\n\n    env[key] = stripComment(rest).trimEnd();\n    pos = lineEnd + 1;\n  }\n\n  return env;\n}\n","file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-3578220652/ts-0003-env-parser-dep/2/ws/src/env.ts"},"component":"harness","cwd_rel":".","index_version":null,"tool":"Write","tool_use_id":"toolu_01Erv7gynV8YWS2rMb399Emw"},"hash":"sha256:2689c002a5f0c9d8f41047c05c2e160f962893089844b4a1d0b46c491897ac4f","mono_ns":21000000,"prev":"sha256:940f10a8bb8422da80ebafa83067d2ae8849ab8bc2f75e3c964c44cd6a00a93a","schema":"saga.trace/1","seq":21,"session":"20ab78ba-e07e-41b5-8ed7-68a3e112403f","source":"stream-json","ts":"2026-01-01T00:00:00.021Z","turn":1,"type":"tool_call"}
