{"agent":"main","body":{"args_hash":"sha256:1db5309332783f918c2435e6a8214a39024922e4c572526d80a8f59b48780c54","args_inline":{"content":"import { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { parseEnvFile } from \"../src/env.ts\";\n\ntest(\"keeps quoted values intact, including spaces and inner hashes\", () => {\n  const env = parseEnvFile('APP_NAME=\"Order Service\"\\nMOTD=\\'hello # not a comment\\'\\n');\n  assert.equal(env.APP_NAME, \"Order Service\");\n  assert.equal(env.MOTD, \"hello # not a comment\");\n});\n\ntest(\"skips blanks and comment lines\", () => {\n  const env = parseEnvFile(\"# leading comment\\n\\nPORT=8080\\n   # indented comment\\nHOST=0.0.0.0\\n\");\n  assert.deepEqual(env, { PORT: \"8080\", HOST: \"0.0.0.0\" });\n});\n\ntest(\"strips trailing comments from bare values only at a whitespace boundary\", () => {\n  const env = parseEnvFile(\"PORT=8080 # the port\\nTOKEN=pass#word\\n\");\n  assert.equal(env.PORT, \"8080\");\n  assert.equal(env.TOKEN, \"pass#word\");\n});\n\ntest(\"allows a comment after a quoted value\", () => {\n  const env = parseEnvFile('APP_NAME=\"Order Service\" # display name\\n');\n  assert.equal(env.APP_NAME, \"Order Service\");\n});\n\ntest(\"handles export prefixes, empty values and a missing final newline\", () => {\n  const env = parseEnvFile(\"export HOST=db.internal\\nEMPTY=\\nPORT=9090\");\n  assert.deepEqual(env, { HOST: \"db.internal\", EMPTY: \"\", PORT: \"9090\" });\n});\n\ntest(\"applies escapes in double quotes but not single quotes\", () => {\n  const env = parseEnvFile('A=\"line1\\\\nline2\"\\nB=\\'line1\\\\nline2\\'\\n');\n  assert.equal(env.A, \"line1\\nline2\");\n  assert.equal(env.B, \"line1\\\\nline2\");\n});\n\ntest(\"supports quoted values spanning lines\", () => {\n  const env = parseEnvFile('KEY=\"first\\nsecond\"\\nPORT=8080\\n');\n  assert.equal(env.KEY, \"first\\nsecond\");\n  assert.equal(env.PORT, \"8080\");\n});\n\ntest(\"tolerates CRLF line endings\", () => {\n  const env = parseEnvFile(\"PORT=8080\\r\\nHOST=0.0.0.0\\r\\n\");\n  assert.deepEqual(env, { PORT: \"8080\", HOST: \"0.0.0.0\" });\n});\n\ntest(\"last assignment to a key wins\", () => {\n  assert.equal(parseEnvFile(\"PORT=1\\nPORT=2\\n\").PORT, \"2\");\n});\n\ntest(\"rejects malformed input\", () => {\n  assert.throws(() => parseEnvFile(\"NOT_AN_ASSIGNMENT\\n\"), /malformed/);\n  assert.throws(() => parseEnvFile('KEY=\"unterminated\\n'), /unterminated/);\n  assert.throws(() => parseEnvFile('KEY=\"done\" junk\\n'), /unexpected text/);\n});\n","file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-3578220652/ts-0003-env-parser-dep/2/ws/test/env.test.ts"},"component":"harness","cwd_rel":".","index_version":null,"tool":"Write","tool_use_id":"toolu_01PoFFrdPQwNPS4yGcPUfvaz"},"hash":"sha256:491c9313b0960e738915a1bddf0ff2d38bddcac1163229aa6a489038a8488486","mono_ns":29000000,"prev":"sha256:8d22926d700c3f8046a8b4020730838de3cba5d54ad0dbde1617cda0f4707b4e","schema":"saga.trace/1","seq":29,"session":"20ab78ba-e07e-41b5-8ed7-68a3e112403f","source":"stream-json","ts":"2026-01-01T00:00:00.029Z","turn":1,"type":"tool_call"}
