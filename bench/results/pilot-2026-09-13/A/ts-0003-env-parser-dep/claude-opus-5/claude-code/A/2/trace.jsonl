{"agent":"main","body":{"args_hash":"sha256:92305f0f9fcd4011ce3135afe4ac8063aa8a3b61fbdb934a3b1f4813708d9bff","args_inline":{"file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-3578220652/ts-0003-env-parser-dep/2/ws/test/config.test.ts","new_string":"  assert.equal(cfg.debug, true);\n});\n\ntest(\"loads .env.example as shipped\", () => {\n  const cfg = loadConfig(readFileSync(new URL(\"../.env.example\", import.meta.url), \"utf8\"));\n  assert.deepEqual(cfg, {\n    port: 8080,\n    host: \"0.0.0.0\",\n    appName: \"Order Service\",\n    debug: false,\n    motd: \"hello # not a comment\",\n  });\n});\n\ntest(\"falls back to defaults for missing keys\", () => {\n  assert.deepEqual(loadConfig(\"\"), {\n    port: 8080,\n    host: \"127.0.0.1\",\n    appName: \"order-service\",\n    debug: false,\n    motd: \"\",\n  });\n});\n\ntest(\"rejects a non-integer PORT\", () => {\n  assert.throws(() => loadConfig(\"PORT=abc\\n\"), /invalid PORT/);\n});\n","old_string":"  assert.equal(cfg.debug, true);\n});\n","replace_all":false},"component":"harness","cwd_rel":".","index_version":null,"tool":"Edit","tool_use_id":"toolu_01SY6yPNWU3xHJ1NQehkKx2x"},"hash":"sha256:65246aae67f4606e282b1ecd07699770c7365ac9a4c3fbe18d670cb7a582b88f","mono_ns":33000000,"prev":"sha256:b8ba2706f146cef85717c0715eea234fecf974edb6cf476e26028cdba548c0da","schema":"saga.trace/1","seq":33,"session":"20ab78ba-e07e-41b5-8ed7-68a3e112403f","source":"stream-json","ts":"2026-01-01T00:00:00.033Z","turn":1,"type":"tool_call"}
