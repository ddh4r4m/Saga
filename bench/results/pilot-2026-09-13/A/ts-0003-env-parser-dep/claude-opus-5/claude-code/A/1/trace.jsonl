{"agent":"main","body":{"args_hash":"sha256:41edc350d08eaf28dd35704247db6837f8f4b99abadae14e22b975a9a271b025","args_inline":{"content":"// Minimal env-file parser. Covers the dotenv-style subset this service uses:\n// comments, blank lines, optional `export`, and single/double quoted values.\n// Malformed lines throw rather than being silently skipped.\n\nconst KEY = /^[A-Za-z_][A-Za-z0-9_]*$/;\n\nconst ESCAPES: Record<string, string> = {\n  n: \"\\n\",\n  r: \"\\r\",\n  t: \"\\t\",\n  \"0\": \"\\0\",\n};\n\nconst isBlank = (c: string) => c === \" \" || c === \"\\t\" || c === \"\\r\";\n\nexport function parseEnvFile(text: string): Record<string, string> {\n  const src = text.charCodeAt(0) === 0xfeff ? text.slice(1) : text;\n  const out: Record<string, string> = {};\n  let i = 0;\n  let line = 1;\n\n  const fail = (msg: string): never => {\n    throw new Error(`env line ${line}: ${msg}`);\n  };\n\n  // Advance past the rest of the current line, including its newline.\n  const skipLine = () => {\n    while (i < src.length && src[i] !== \"\\n\") i++;\n    if (i < src.length) {\n      line++;\n      i++;\n    }\n  };\n\n  while (i < src.length) {\n    const c = src[i];\n    if (c === \"\\n\") {\n      line++;\n      i++;\n      continue;\n    }\n    if (isBlank(c)) {\n      i++;\n      continue;\n    }\n    if (c === \"#\") {\n      skipLine();\n      continue;\n    }\n\n    const keyStart = i;\n    while (i < src.length && src[i] !== \"=\" && src[i] !== \"\\n\") i++;\n    if (i >= src.length || src[i] === \"\\n\") fail(`expected KEY=value, got ${JSON.stringify(src.slice(keyStart, i))}`);\n    let key = src.slice(keyStart, i).trim();\n    i++; // consume '='\n    if (key.startsWith(\"export \")) key = key.slice(\"export \".length).trim();\n    if (!KEY.test(key)) fail(`invalid key ${JSON.stringify(key)}`);\n\n    while (i < src.length && isBlank(src[i])) i++;\n\n    const quote = src[i];\n    if (quote === '\"' || quote === \"'\") {\n      i++;\n      let value = \"\";\n      for (;;) {\n        if (i >= src.length) fail(`unterminated ${quote} quote`);\n        const ch = src[i];\n        if (ch === quote) {\n          i++;\n          break;\n        }\n        if (ch === \"\\\\\" && quote === '\"') {\n          i++;\n          if (i >= src.length) fail(\"unterminated escape\");\n          value += ESCAPES[src[i]] ?? src[i];\n          if (src[i] === \"\\n\") line++;\n          i++;\n          continue;\n        }\n        if (ch === \"\\n\") line++;\n        value += ch;\n        i++;\n      }\n      out[key] = value;\n      while (i < src.length && isBlank(src[i])) i++;\n      if (i < src.length && src[i] !== \"\\n\" && src[i] !== \"#\") {\n        fail(`unexpected text after closing quote for ${key}`);\n      }\n      skipLine();\n    } else {\n      let value = \"\";\n      while (i < src.length && src[i] !== \"\\n\") {\n        // An unquoted '#' starts a comment when it follows whitespace.\n        if (src[i] === \"#\" && (value === \"\" || isBlank(src[i - 1]))) break;\n        value += src[i];\n        i++;\n      }\n      out[key] = value.trimEnd();\n      skipLine();\n    }\n  }\n\n  return out;\n}\n","file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-3578220652/ts-0003-env-parser-dep/1/ws/src/env.ts"},"component":"harness","cwd_rel":".","index_version":null,"tool":"Write","tool_use_id":"toolu_01QZdt9b7P1G1f6JxWPz5zNa"},"hash":"sha256:935e723e87d343cdafa7c2fccb941051740a3ba907ccddb1bc4227d6fec68fab","mono_ns":21000000,"prev":"sha256:40cfcb89ef3ef1eaa14c901f88ae3b6e429df2c8e1aaa220cb3bc7113e83ae55","schema":"saga.trace/1","seq":21,"session":"2c3baa3d-7263-4826-92fc-c85f1705e42a","source":"stream-json","ts":"2026-01-01T00:00:00.021Z","turn":1,"type":"tool_call"}
