diff --git a/test/env.test.ts b/test/env.test.ts
new file mode 100644
index 0000000..3668b00
--- /dev/null
+++ b/test/env.test.ts
@@ -0,0 +1,46 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { parseEnvFile } from "../src/env.ts";
+
+test("skips blanks and comment lines", () => {
+  assert.deepEqual(parseEnvFile("\n# a comment\n   \nA=1\n"), { A: "1" });
+});
+
+test("ignores an export prefix", () => {
+  assert.deepEqual(parseEnvFile("export A=1\n"), { A: "1" });
+});
+
+test("trims unquoted values and their trailing comments", () => {
+  assert.deepEqual(parseEnvFile("A=  spaced out   # note\n"), { A: "spaced out" });
+});
+
+test("keeps a bare # inside an unquoted value", () => {
+  assert.deepEqual(parseEnvFile("A=http://host/p#frag\n"), { A: "http://host/p#frag" });
+});
+
+test("keeps quotes and # literal inside quoted values", () => {
+  assert.deepEqual(parseEnvFile(`A="x # y"\nB='z # w'\n`), { A: "x # y", B: "z # w" });
+});
+
+test("allows a comment after a closing quote", () => {
+  assert.deepEqual(parseEnvFile(`A="x"  # note\n`), { A: "x" });
+});
+
+test("expands escapes in double quotes only", () => {
+  assert.deepEqual(parseEnvFile(`A="a\\nb"\nB='a\\nb'\n`), { A: "a\nb", B: "a\\nb" });
+});
+
+test("preserves an empty value", () => {
+  assert.deepEqual(parseEnvFile('A=\nB=""\n'), { A: "", B: "" });
+});
+
+test("later entries win", () => {
+  assert.deepEqual(parseEnvFile("A=1\nA=2\n"), { A: "2" });
+});
+
+test("rejects malformed input", () => {
+  assert.throws(() => parseEnvFile("NOT_AN_ASSIGNMENT\n"), /expected KEY=value/);
+  assert.throws(() => parseEnvFile("1BAD=x\n"), /invalid key/);
+  assert.throws(() => parseEnvFile(`A="unterminated\n`), /unterminated/);
+  assert.throws(() => parseEnvFile(`A="x" junk\n`), /unexpected text after closing quote/);
+});
