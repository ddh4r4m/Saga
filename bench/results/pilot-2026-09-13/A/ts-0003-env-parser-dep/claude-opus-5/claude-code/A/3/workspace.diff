+
+test("applies defaults for missing keys", () => {
+  const cfg = loadConfig("");
+  assert.deepEqual(cfg, {
+    port: 8080,
+    host: "127.0.0.1",
+    appName: "order-service",
+    debug: false,
+    motd: "",
+  });
+});
+
+test("rejects a non-numeric PORT", () => {
+  assert.throws(() => loadConfig("PORT=eighty\n"), /invalid PORT/);
+});
+
+test("keeps quoted values intact", () => {
+  const cfg = loadConfig(`APP_NAME="Order Service"\nMOTD='hello # not a comment'\n`);
+  assert.equal(cfg.appName, "Order Service");
+  assert.equal(cfg.motd, "hello # not a comment");
+});
+
+test("strips comments outside quotes", () => {
+  const cfg = loadConfig("# leading comment\nPORT=9090 # trailing\nHOST=local\n");
+  assert.equal(cfg.port, 9090);
+  assert.equal(cfg.host, "local");
+});
+
