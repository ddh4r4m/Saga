diff --git a/src/env.ts b/src/env.ts
new file mode 100644
index 0000000..b5f97b2
--- /dev/null
+++ b/src/env.ts
@@ -0,0 +1,70 @@
+// Minimal env-file parser. No dependencies: the build box has no network.
+//
+// Supported syntax, one entry per line:
+//   KEY=value                 unquoted, trimmed, ` #` starts a trailing comment
+//   KEY="value"               double quoted, \n \r \t \\ \" escapes expanded
+//   KEY='value'               single quoted, taken literally
+//   export KEY=value          the `export ` prefix is ignored
+// Blank lines and lines starting with `#` are skipped. A `#` inside quotes is
+// part of the value, not a comment. Anything else is an error.
+
+const KEY = /^[A-Za-z_][A-Za-z0-9_]*$/;
+
+const ESCAPES: Record<string, string> = {
+  n: "\n",
+  r: "\r",
+  t: "\t",
+  "\\": "\\",
+  '"': '"',
+};
+
+export function parseEnvFile(text: string): Record<string, string> {
+  const env: Record<string, string> = {};
+
+  text.split(/\r?\n/).forEach((line, i) => {
+    const lineNo = i + 1;
+    const trimmed = line.trim();
+    if (trimmed === "" || trimmed.startsWith("#")) return;
+
+    const withoutExport = trimmed.startsWith("export ") ? trimmed.slice(7).trimStart() : trimmed;
+    const eq = withoutExport.indexOf("=");
+    if (eq === -1) throw new Error(`line ${lineNo}: expected KEY=value, got: ${trimmed}`);
+
+    const key = withoutExport.slice(0, eq).trim();
+    if (!KEY.test(key)) throw new Error(`line ${lineNo}: invalid key: ${key}`);
+
+    env[key] = parseValue(withoutExport.slice(eq + 1).trim(), lineNo);
+  });
+
+  return env;
+}
+
+function parseValue(raw: string, lineNo: number): string {
+  const quote = raw[0];
+  if (quote !== '"' && quote !== "'") {
+    // Unquoted: a comment needs whitespace before the `#`, so URLs keep fragments.
+    return raw.replace(/\s+#.*$/, "").trimEnd();
+  }
+
+  let value = "";
+  let i = 1;
+  while (i < raw.length) {
+    const ch = raw[i];
+    if (ch === quote) break;
+    if (ch === "\\" && quote === '"' && raw[i + 1] !== undefined) {
+      const next = raw[i + 1]!;
+      value += ESCAPES[next] ?? `\\${next}`;
+      i += 2;
+      continue;
+    }
+    value += ch;
+    i += 1;
+  }
+  if (raw[i] !== quote) throw new Error(`line ${lineNo}: unterminated ${quote} quote`);
+
+  const rest = raw.slice(i + 1).trim();
+  if (rest !== "" && !rest.startsWith("#")) {
+    throw new Error(`line ${lineNo}: unexpected text after closing quote: ${rest}`);
+  }
+  return value;
+}
