diff --git a/test/env.test.ts b/test/env.test.ts
new file mode 100644
index 0000000..0264891
--- /dev/null
+++ b/test/env.test.ts
@@ -0,0 +1,57 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { parseEnvFile } from "../src/env.ts";
+
+test("keeps quoted values intact, including spaces and inner hashes", () => {
+  const env = parseEnvFile('APP_NAME="Order Service"\nMOTD=\'hello # not a comment\'\n');
+  assert.equal(env.APP_NAME, "Order Service");
+  assert.equal(env.MOTD, "hello # not a comment");
+});
+
+test("skips blanks and comment lines", () => {
+  const env = parseEnvFile("# leading comment\n\nPORT=8080\n   # indented comment\nHOST=0.0.0.0\n");
+  assert.deepEqual(env, { PORT: "8080", HOST: "0.0.0.0" });
+});
+
+test("strips trailing comments from bare values only at a whitespace boundary", () => {
+  const env = parseEnvFile("PORT=8080 # the port\nTOKEN=pass#word\n");
+  assert.equal(env.PORT, "8080");
+  assert.equal(env.TOKEN, "pass#word");
+});
+
+test("allows a comment after a quoted value", () => {
+  const env = parseEnvFile('APP_NAME="Order Service" # display name\n');
+  assert.equal(env.APP_NAME, "Order Service");
+});
+
+test("handles export prefixes, empty values and a missing final newline", () => {
+  const env = parseEnvFile("export HOST=db.internal\nEMPTY=\nPORT=9090");
+  assert.deepEqual(env, { HOST: "db.internal", EMPTY: "", PORT: "9090" });
+});
+
+test("applies escapes in double quotes but not single quotes", () => {
+  const env = parseEnvFile('A="line1\\nline2"\nB=\'line1\\nline2\'\n');
+  assert.equal(env.A, "line1\nline2");
+  assert.equal(env.B, "line1\\nline2");
+});
+
+test("supports quoted values spanning lines", () => {
+  const env = parseEnvFile('KEY="first\nsecond"\nPORT=8080\n');
+  assert.equal(env.KEY, "first\nsecond");
+  assert.equal(env.PORT, "8080");
+});
+
+test("tolerates CRLF line endings", () => {
+  const env = parseEnvFile("PORT=8080\r\nHOST=0.0.0.0\r\n");
+  assert.deepEqual(env, { PORT: "8080", HOST: "0.0.0.0" });
+});
+
+test("last assignment to a key wins", () => {
+  assert.equal(parseEnvFile("PORT=1\nPORT=2\n").PORT, "2");
+});
+
+test("rejects malformed input", () => {
+  assert.throws(() => parseEnvFile("NOT_AN_ASSIGNMENT\n"), /malformed/);
+  assert.throws(() => parseEnvFile('KEY="unterminated\n'), /unterminated/);
+  assert.throws(() => parseEnvFile('KEY="done" junk\n'), /unexpected text/);
+});
