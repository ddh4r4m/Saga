index 0000000..048adbb
--- /dev/null
+++ b/src/env.ts
@@ -0,0 +1,90 @@
+// Minimal env-file parser. Kept in-tree so config loading has no dependencies.
+
+const ENTRY = /^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*)$/s;
+
+const ESCAPES: Record<string, string> = {
+  n: "\n",
+  r: "\r",
+  t: "\t",
+  "\\": "\\",
+  '"': '"',
+  "'": "'",
+};
+
+// Reads a quoted value starting at the opening quote. Returns the unquoted text
+// and the index just past the closing quote. Escapes apply inside double quotes
+// only; single quotes are literal, as in shell.
+function readQuoted(text: string, start: number): { value: string; end: number } {
+  const quote = text[start];
+  let value = "";
+  for (let i = start + 1; i < text.length; i++) {
+    const ch = text[i];
+    if (quote === '"' && ch === "\\" && i + 1 < text.length) {
+      const next = text[i + 1];
+      value += ESCAPES[next] ?? "\\" + next;
+      i++;
+      continue;
+    }
+    if (ch === quote) return { value, end: i + 1 };
+    value += ch;
+  }
+  throw new Error(`unterminated ${quote} quote in env file`);
+}
+
+// Strips a trailing comment from a bare value. A `#` only starts a comment when
+// it begins the value or follows whitespace, so `pass#word` stays intact.
+function stripComment(raw: string): string {
+  for (let i = 0; i < raw.length; i++) {
+    if (raw[i] === "#" && (i === 0 || /\s/.test(raw[i - 1]))) return raw.slice(0, i);
+  }
+  return raw;
+}
+
+/**
+ * Parses env-file text into key/value pairs.
+ *
+ * Supports `export` prefixes, blank lines, `#` comments, and single- or
+ * double-quoted values (which may span lines and may contain `#`). Later
+ * assignments to the same key win. Throws on malformed lines.
+ */
+export function parseEnvFile(text: string): Record<string, string> {
+  const env: Record<string, string> = {};
+  // Normalise line endings so a CRLF file does not leave \r on every value.
+  const src = text.replace(/\r\n?/g, "\n");
+  let pos = 0;
+
+  while (pos < src.length) {
+    let lineEnd = src.indexOf("\n", pos);
+    if (lineEnd === -1) lineEnd = src.length;
+    const line = src.slice(pos, lineEnd);
+
+    if (!line.trim() || line.trimStart().startsWith("#")) {
+      pos = lineEnd + 1;
+      continue;
+    }
+
+    const match = ENTRY.exec(line);
+    if (!match) throw new Error(`malformed env file line: ${line}`);
+    const [, key, rest] = match;
+
+    const quote = rest[0];
+    if (quote === '"' || quote === "'") {
+      // Scan from the whole remaining source so quoted values may span lines.
+      const valueStart = pos + line.length - rest.length;
+      const { value, end } = readQuoted(src, valueStart);
+      const trailing = src.slice(end, src.indexOf("\n", end) === -1 ? src.length : src.indexOf("\n", end));
+      if (trailing.trim() && !trailing.trimStart().startsWith("#")) {
+        throw new Error(`unexpected text after quoted value for ${key}: ${trailing.trim()}`);
+      }
+      env[key] = value;
+      const nextBreak = src.indexOf("\n", end);
+      pos = nextBreak === -1 ? src.length : nextBreak + 1;
+      continue;
+    }
+
+    env[key] = stripComment(rest).trimEnd();
+    pos = lineEnd + 1;
+  }
+
+  return env;
+}
