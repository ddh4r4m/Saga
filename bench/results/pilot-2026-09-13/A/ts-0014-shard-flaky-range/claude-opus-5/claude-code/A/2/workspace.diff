 const fixture = JSON.parse(readFileSync("fixtures/assignments.json", "utf8"));
 
@@ -11,10 +11,19 @@ test("live assignments do not move", () => {
   }
 });
 
+// Fixed keys, not random ones: roughly half of all hashes are negative, so a random
+// sample turned a real bug into a coin flip. This range covers both signs.
 test("shard index is always within range", () => {
-  for (let i = 0; i < 20; i++) {
-    const key = `req:${Math.random().toString(36).slice(2)}`;
+  for (let i = 0; i < 1000; i++) {
+    const key = `req:${i}`;
     const s = shardFor(key, 16);
     assert.ok(s >= 0 && s < 16, `${key} -> ${s}`);
   }
 });
+
+// hashKey stays signed, so shardFor must fold the remainder back the way Python's % does.
+test("keys with a negative hash still land in range", () => {
+  assert.ok(hashKey("req:0") < 0);
+  assert.equal(shardFor("req:0", 16), 1);
+  assert.equal(shardFor("req:1", 16), 14);
+});
