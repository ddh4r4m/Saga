{"agent":"main","body":{"error":null,"exit":0,"for_seq":7,"result_bytes":712,"result_hash":"sha256:f183f9cc9ad5deecd8ea17408b06de8dbb82cb64a537ef11f787a828e60a226c","result_inline":"1\t// Shard selection for cache keys. See README for the contract with the routing table.\n2\t\n3\t// FNV-1a, 32-bit, folded to a signed integer like the routing table stores it.\n4\texport function hashKey(key: string): number {\n5\t  let h = 0x811c9dc5;\n6\t  for (let i = 0; i < key.length; i++) {\n7\t    h ^= key.charCodeAt(i);\n8\t    h = Math.imul(h, 0x01000193);\n9\t  }\n10\t  return h | 0;\n11\t}\n12\t\n13\t// The non-negative remainder of the hash divided by shards (Python's % semantics).\n14\texport function shardFor(key: string, shards: number): number {\n15\t  if (!Number.isInteger(shards) || shards <= 0) throw new RangeError(`shards must be a positive integer, got ${shards}`);\n16\t  return hashKey(key) % shards;\n17\t}\n18\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:3e2450e4e5e6446df8ef285c99f06b7882dcb21179e18024e49b5cab23c7adfb","mono_ns":8000000,"prev":"sha256:af72f640f3a482c09af7760748e0035eb894093c31cdfde594a1fbfa7ce0922a","schema":"saga.trace/1","seq":8,"session":"c91a8a93-3723-4350-9bb4-6a5ee54f486b","source":"stream-json","ts":"2026-01-01T00:00:00.008Z","turn":1,"type":"tool_result"}
