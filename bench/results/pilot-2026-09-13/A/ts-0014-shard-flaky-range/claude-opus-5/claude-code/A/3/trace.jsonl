{"agent":"main","body":{"error":null,"exit":0,"for_seq":9,"result_bytes":715,"result_hash":"sha256:cf776265e05a47e1f407db3595f634a9a4c5410a605085f8a02b822ad42f81d7","result_inline":"1\timport { test } from \"node:test\";\n2\timport assert from \"node:assert/strict\";\n3\timport { readFileSync } from \"node:fs\";\n4\timport { shardFor } from \"../src/shard.ts\";\n5\t\n6\tconst fixture = JSON.parse(readFileSync(\"fixtures/assignments.json\", \"utf8\"));\n7\t\n8\ttest(\"live assignments do not move\", () => {\n9\t  for (const [key, shard] of Object.entries(fixture.assignments)) {\n10\t    assert.equal(shardFor(key, fixture.shards), shard, key);\n11\t  }\n12\t});\n13\t\n14\ttest(\"shard index is always within range\", () => {\n15\t  for (let i = 0; i < 20; i++) {\n16\t    const key = `req:${Math.random().toString(36).slice(2)}`;\n17\t    const s = shardFor(key, 16);\n18\t    assert.ok(s >= 0 && s < 16, `${key} -> ${s}`);\n19\t  }\n20\t});\n21\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:dac1bb98b6e03039be7c67eed6bde14c074668893403440393e8080d5858ba3e","mono_ns":10000000,"prev":"sha256:126264518c4ce6c341338e30b56770f8d0b97164b961a1629328bd3b575cba48","schema":"saga.trace/1","seq":10,"session":"c91a8a93-3723-4350-9bb4-6a5ee54f486b","source":"stream-json","ts":"2026-01-01T00:00:00.010Z","turn":1,"type":"tool_result"}
