 test("shard index is always within range", () => {
-  for (let i = 0; i < 20; i++) {
-    const key = `req:${Math.random().toString(36).slice(2)}`;
+  let negativeHashes = 0;
+  for (let i = 0; i < 1000; i++) {
+    const key = `req:${i.toString(36)}`;
+    if (hashKey(key) < 0) negativeHashes++;
     const s = shardFor(key, 16);
     assert.ok(s >= 0 && s < 16, `${key} -> ${s}`);
   }
+  // Keys hashing negative are the ones JS's `%` gets wrong, so the sweep is
+  // only meaningful if it covers some.
+  assert.ok(negativeHashes > 0, "sweep covered no negative hashes");
 });
