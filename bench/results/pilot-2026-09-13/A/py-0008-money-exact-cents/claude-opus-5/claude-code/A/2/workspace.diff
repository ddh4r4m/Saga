+@dataclass(frozen=True, init=False)
 class Money:
-    amount: float
+    """A currency amount held as an exact number of cents.
+
+    The constructor takes an amount in currency units, so ``Money(0.10)`` is
+    ten cents; ``Money.from_cents(10)`` is the same value without the
