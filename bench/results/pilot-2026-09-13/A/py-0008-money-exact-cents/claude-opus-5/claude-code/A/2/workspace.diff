@@ -4,4 +4,6 @@ from .money import Money
 
 def apply_tax(subtotal: Money, rate: float) -> Money:
     """Return subtotal plus tax, rounded to the cent."""
+    # The rate is a float, so the multiplication is done in floats and rounded
+    # the way it always has been; Money puts the result back on exact cents.
     return Money(round(subtotal.amount * (1 + rate), 2))
diff --git a/tests/test_money.py b/tests/test_money.py
new file mode 100644
index 0000000..49b80ad
--- /dev/null
+++ b/tests/test_money.py
@@ -0,0 +1,40 @@
+import unittest
+from pricing.money import Money, ZERO
+from pricing.format import format_money
+from pricing.tax import apply_tax
+
+
+class MoneyTests(unittest.TestCase):
+    def test_amount_is_stored_as_cents(self):
+        self.assertEqual(Money(0.10).cents, 10)
+        self.assertEqual(Money(1234.56).cents, 123456)
+        self.assertEqual(Money(-2.5).cents, -250)
+        self.assertEqual(ZERO.cents, 0)
+
+    def test_repeated_addition_does_not_drift(self):
+        total = ZERO
+        for _ in range(10):
+            total = total + Money(0.10)
+        self.assertEqual(total, Money(1.00))
+
+    def test_equal_amounts_are_interchangeable(self):
+        self.assertEqual(Money(0.10) * 3, Money(0.30))
+        self.assertEqual(hash(Money(0.10) * 3), hash(Money(0.30)))
+
+    def test_negation(self):
+        self.assertEqual(-Money(0.30), Money(-0.30))
+
+
+class FormatTests(unittest.TestCase):
+    def test_display_format(self):
+        self.assertEqual(format_money(Money(1234.5)), "$1,234.50")
+        self.assertEqual(format_money(Money(0.07)), "$0.07")
+        self.assertEqual(format_money(ZERO), "$0.00")
+        self.assertEqual(format_money(-Money(0.10)), "-$0.10")
+
+
+class TaxTests(unittest.TestCase):
+    def test_tax_is_rounded_to_the_cent(self):
+        self.assertEqual(apply_tax(Money(19.99), 0.0825), Money(21.64))
+        self.assertEqual(apply_tax(Money(0.30), 0.0825), Money(0.32))
+        self.assertEqual(apply_tax(Money(10.00), 0.0), Money(10.00))
