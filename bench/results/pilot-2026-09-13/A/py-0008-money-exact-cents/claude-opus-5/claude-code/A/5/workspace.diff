--- a/pricing/money.py
+++ b/pricing/money.py
@@ -1,19 +1,49 @@
-"""Money value object."""
+"""Money value object.
+
+The amount is held as a whole number of cents so that adding and
+multiplying never drifts. Money(0.10) still takes dollars, as before.
+"""
 from dataclasses import dataclass
+from decimal import Decimal, ROUND_HALF_UP
+
+
+def _to_cents(amount: "float | int | str | Decimal") -> int:
+    if isinstance(amount, float):
+        amount = str(amount)  # 0.10 -> Decimal("0.10"), not the binary expansion
+    dollars = Decimal(amount)
+    return int((dollars * 100).quantize(Decimal(1), rounding=ROUND_HALF_UP))
 
 
 @dataclass(frozen=True)
 class Money:
-    amount: float
+    cents: int
+
+    def __init__(self, amount: "float | int | str | Decimal") -> None:
+        object.__setattr__(self, "cents", _to_cents(amount))
+
+    @classmethod
+    def from_cents(cls, cents: int) -> "Money":
+        m = cls.__new__(cls)
+        object.__setattr__(m, "cents", int(cents))
+        return m
+
+    @property
+    def amount(self) -> float:
+        """Dollar amount as a float, for callers that do float maths."""
+        return self.cents / 100
+
+    def as_decimal(self) -> Decimal:
+        """Dollar amount, exactly."""
+        return Decimal(self.cents) / 100
 
     def __add__(self, other: "Money") -> "Money":
-        return Money(self.amount + other.amount)
+        return Money.from_cents(self.cents + other.cents)
 
     def __mul__(self, qty: int) -> "Money":
-        return Money(self.amount * qty)
+        return Money.from_cents(self.cents * qty)
 
     def __neg__(self) -> "Money":
-        return Money(-self.amount)
+        return Money.from_cents(-self.cents)
 
 
 ZERO = Money(0.0)
