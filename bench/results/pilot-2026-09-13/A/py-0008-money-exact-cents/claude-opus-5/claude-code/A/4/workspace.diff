diff --git a/pricing/money.py b/pricing/money.py
index f586e26..26fdaf6 100644
--- a/pricing/money.py
+++ b/pricing/money.py
@@ -1,19 +1,70 @@
-"""Money value object."""
-from dataclasses import dataclass
+"""Money value object.
+
+The value is held as a whole number of cents so that sums stay exact:
+three dimes are 30 cents, never 0.30000000000000004.
+"""
+from decimal import Decimal, ROUND_HALF_UP
+
+
+def _to_cents(amount) -> int:
+    """Convert a dollar amount to whole cents, rounding halves up."""
+    if isinstance(amount, float):
+        # str() gives the shortest repr, so 0.10 becomes Decimal("0.10")
+        # rather than the binary expansion of the float.
+        amount = Decimal(str(amount))
+    else:
+        amount = Decimal(amount)
+    return int((amount * 100).quantize(Decimal(1), rounding=ROUND_HALF_UP))
 
 
-@dataclass(frozen=True)
 class Money:
-    amount: float
+    """A dollar amount. Construct from dollars, compare and add exactly."""
+
+    __slots__ = ("cents",)
+
+    def __init__(self, amount) -> None:
+        object.__setattr__(self, "cents", _to_cents(amount))
+
+    @classmethod
+    def from_cents(cls, cents: int) -> "Money":
+        money = cls.__new__(cls)
+        object.__setattr__(money, "cents", int(cents))
+        return money
+
+    @property
+    def amount(self) -> float:
+        """The value in dollars, for callers that want a plain number."""
+        return self.cents / 100
+
+    def to_decimal(self) -> Decimal:
+        """The exact value in dollars."""
+        return Decimal(self.cents).scaleb(-2)
+
+    def __setattr__(self, name, value):
+        raise AttributeError("Money is immutable")
+
+    def __delattr__(self, name):
+        raise AttributeError("Money is immutable")
 
     def __add__(self, other: "Money") -> "Money":
-        return Money(self.amount + other.amount)
+        return Money.from_cents(self.cents + other.cents)
 
     def __mul__(self, qty: int) -> "Money":
-        return Money(self.amount * qty)
+        return Money.from_cents(self.cents * qty)
 
     def __neg__(self) -> "Money":
-        return Money(-self.amount)
+        return Money.from_cents(-self.cents)
+
+    def __eq__(self, other) -> bool:
+        if not isinstance(other, Money):
+            return NotImplemented
+        return self.cents == other.cents
+
+    def __hash__(self) -> int:
+        return hash(self.cents)
+
+    def __repr__(self) -> str:
+        return f"Money({self.to_decimal():.2f})"
 
 
 ZERO = Money(0.0)
