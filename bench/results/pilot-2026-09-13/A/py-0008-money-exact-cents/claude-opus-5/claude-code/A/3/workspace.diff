-"""Money value object."""
-from dataclasses import dataclass
+"""Money value object.
+
+The amount is stored as a whole number of cents, so sums and multiples are
+exact and never drift. The constructor still takes a dollar amount, e.g.
+``Money(0.10)``; use :meth:`Money.from_cents` when cents are already at hand.
+"""
+from decimal import ROUND_HALF_UP, Decimal
+
+Amount = int | float | str | Decimal
+
+_CENT = Decimal(1)
+
+
+def _to_cents(amount: Amount) -> int:
+    """Convert a dollar amount to whole cents, rounding halves away from zero."""
+    if isinstance(amount, float):
+        # str() gives the shortest repr, so 0.10 becomes "0.1" rather than the
+        # binary expansion that would otherwise round its way into the cents.
+        amount = str(amount)
+    return int((Decimal(amount) * 100).quantize(_CENT, rounding=ROUND_HALF_UP))
 
 
-@dataclass(frozen=True)
 class Money:
-    amount: float
+    """An immutable monetary amount held as an exact whole number of cents."""
+
+    __slots__ = ("cents",)
+
+    cents: int
+
+    def __init__(self, amount: Amount = 0) -> None:
+        object.__setattr__(self, "cents", _to_cents(amount))
+
+    @classmethod
+    def from_cents(cls, cents: int) -> "Money":
+        money = cls.__new__(cls)
+        object.__setattr__(money, "cents", int(cents))
+        return money
+
+    @property
+    def dollars(self) -> Decimal:
+        """The exact dollar value, for formatting."""
+        return Decimal(self.cents).scaleb(-2)
+
+    @property
+    def amount(self) -> float:
+        """The dollar value as a float, for arithmetic against rates."""
+        return self.cents / 100
+
+    def __setattr__(self, name: str, value: object) -> None:
+        raise AttributeError(f"{type(self).__name__} is immutable")
+
+    def __delattr__(self, name: str) -> None:
+        raise AttributeError(f"{type(self).__name__} is immutable")
+
+    def __repr__(self) -> str:
+        return f"Money({self.dollars:.2f})"
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Money):
+            return NotImplemented
+        return self.cents == other.cents
+
+    def __hash__(self) -> int:
+        return hash(self.cents)
 
     def __add__(self, other: "Money") -> "Money":
-        return Money(self.amount + other.amount)
+        return Money.from_cents(self.cents + other.cents)
 
     def __mul__(self, qty: int) -> "Money":
-        return Money(self.amount * qty)
+        return Money.from_cents(round(self.cents * qty))
 
     def __neg__(self) -> "Money":
-        return Money(-self.amount)
+        return Money.from_cents(-self.cents)
 
 
-ZERO = Money(0.0)
+ZERO = Money(0)
