{"agent":"main","body":{"args_hash":"sha256:61ba847880fe970796ad6b5f4f63a5f9fbccf4f682ee2c43bba78daf25b42627","args_inline":{"content":"\"\"\"Money value object.\n\nThe value is held as a whole number of cents so that sums stay exact:\nthree dimes are 30 cents, never 0.30000000000000004.\n\"\"\"\nfrom decimal import Decimal, ROUND_HALF_UP\n\n\ndef _to_cents(amount) -> int:\n    \"\"\"Convert a dollar amount to whole cents, rounding halves up.\"\"\"\n    if isinstance(amount, float):\n        # str() gives the shortest repr, so 0.10 becomes Decimal(\"0.10\")\n        # rather than the binary expansion of the float.\n        amount = Decimal(str(amount))\n    else:\n        amount = Decimal(amount)\n    return int((amount * 100).quantize(Decimal(1), rounding=ROUND_HALF_UP))\n\n\nclass Money:\n    \"\"\"A dollar amount. Construct from dollars, compare and add exactly.\"\"\"\n\n    __slots__ = (\"cents\",)\n\n    def __init__(self, amount) -> None:\n        object.__setattr__(self, \"cents\", _to_cents(amount))\n\n    @classmethod\n    def from_cents(cls, cents: int) -> \"Money\":\n        money = cls.__new__(cls)\n        object.__setattr__(money, \"cents\", int(cents))\n        return money\n\n    @property\n    def amount(self) -> float:\n        \"\"\"The value in dollars, for callers that want a plain number.\"\"\"\n        return self.cents / 100\n\n    def to_decimal(self) -> Decimal:\n        \"\"\"The exact value in dollars.\"\"\"\n        return Decimal(self.cents).scaleb(-2)\n\n    def __setattr__(self, name, value):\n        raise AttributeError(\"Money is immutable\")\n\n    def __delattr__(self, name):\n        raise AttributeError(\"Money is immutable\")\n\n    def __add__(self, other: \"Money\") -> \"Money\":\n        return Money.from_cents(self.cents + other.cents)\n\n    def __mul__(self, qty: int) -> \"Money\":\n        return Money.from_cents(self.cents * qty)\n\n    def __neg__(self) -> \"Money\":\n        return Money.from_cents(-self.cents)\n\n    def __eq__(self, other) -> bool:\n        if not isinstance(other, Money):\n            return NotImplemented\n        return self.cents == other.cents\n\n    def __hash__(self) -> int:\n        return hash(self.cents)\n\n    def __repr__(self) -> str:\n        return f\"Money({self.to_decimal():.2f})\"\n\n\nZERO = Money(0.0)\n","file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-3578220652/py-0008-money-exact-cents/4/ws/pricing/money.py"},"component":"harness","cwd_rel":".","index_version":null,"tool":"Write","tool_use_id":"toolu_01KXCNTFDtWQDoC38ypxAXxY"},"hash":"sha256:976bf565db49ca2299469bf71ffa5cec8190299ec511213a976a11a4bfc98cf6","mono_ns":27000000,"prev":"sha256:60bfb4e9325798b26c5326e195c7e5d039466cc32e67cf0ae9dc7075292ebc60","schema":"saga.trace/1","seq":27,"session":"09b5c480-f395-4e31-8d17-a570dc298fb9","source":"stream-json","ts":"2026-01-01T00:00:00.027Z","turn":1,"type":"tool_call"}
