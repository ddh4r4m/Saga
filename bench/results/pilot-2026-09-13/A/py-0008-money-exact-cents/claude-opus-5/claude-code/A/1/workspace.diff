+
+class DisplayTests(unittest.TestCase):
+    def test_format_is_unchanged(self):
+        self.assertEqual(format_money(Money(1234567.89)), "$1,234,567.89")
+        self.assertEqual(format_money(-Money(1234567.89)), "-$1,234,567.89")
+        self.assertEqual(format_money(ZERO), "$0.00")
+
+    def test_tax_rounding_is_unchanged(self):
