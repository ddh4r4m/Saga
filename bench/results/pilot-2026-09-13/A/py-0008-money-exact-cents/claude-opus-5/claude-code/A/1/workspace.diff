+class MoneyTests(unittest.TestCase):
+    def test_stored_as_integer_cents(self):
+        self.assertIsInstance(Money(0.10).cents, int)
+        self.assertEqual(Money(0.10).cents, 10)
+        self.assertEqual(Money.from_cents(10), Money(0.10))
+
+    def test_equal_values_hash_alike(self):
+        self.assertEqual(len({Money(0.10), Money(0.10)}), 1)
+
+    def test_negation_round_trips(self):
+        self.assertEqual(Money(0.10) + -Money(0.10), ZERO)
+
+    def test_is_immutable(self):
+        with self.assertRaises(AttributeError):
+            Money(0.10).cents = 99
