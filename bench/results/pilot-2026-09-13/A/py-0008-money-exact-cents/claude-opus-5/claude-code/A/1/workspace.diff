@@ -1,19 +1,69 @@
-"""Money value object."""
-from dataclasses import dataclass
+"""Money value object, held as a whole number of cents."""
+from decimal import Decimal, ROUND_HALF_UP
+
+CENTS_PER_DOLLAR = 100
+
+Amount = int | float | str | Decimal
+
+
+def _to_cents(amount: Amount) -> int:
+    """Convert a dollar amount to whole cents, rounding halves away from zero."""
+    dollars = Decimal(str(amount))
+    return int((dollars * CENTS_PER_DOLLAR).quantize(Decimal(1), rounding=ROUND_HALF_UP))
 
 
-@dataclass(frozen=True)
 class Money:
-    amount: float
+    """An immutable amount of money stored as an integer count of cents.
+
+    The constructor still takes dollars, so ``Money(0.10)`` is ten cents, but
+    arithmetic runs on the integer cents and therefore cannot drift.
+    """
+
+    __slots__ = ("cents",)
+
+    def __init__(self, amount: Amount = 0) -> None:
+        object.__setattr__(self, "cents", _to_cents(amount))
+
+    @classmethod
+    def from_cents(cls, cents: int) -> "Money":
+        money = cls.__new__(cls)
+        object.__setattr__(money, "cents", int(cents))
+        return money
+
+    @property
+    def amount(self) -> float:
+        """The value in dollars, for callers that want a float."""
+        return self.cents / CENTS_PER_DOLLAR
+
+    def to_decimal(self) -> Decimal:
+        """The value in dollars, exactly."""
+        return Decimal(self.cents).scaleb(-2)
+
+    def __setattr__(self, name: str, value: object) -> None:
+        raise AttributeError("Money is immutable")
+
+    def __delattr__(self, name: str) -> None:
+        raise AttributeError("Money is immutable")
 
     def __add__(self, other: "Money") -> "Money":
-        return Money(self.amount + other.amount)
+        return Money.from_cents(self.cents + other.cents)
 
     def __mul__(self, qty: int) -> "Money":
-        return Money(self.amount * qty)
+        return Money.from_cents(self.cents * qty)
 
     def __neg__(self) -> "Money":
-        return Money(-self.amount)
+        return Money.from_cents(-self.cents)
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Money):
+            return NotImplemented
+        return self.cents == other.cents
+
+    def __hash__(self) -> int:
+        return hash(self.cents)
+
+    def __repr__(self) -> str:
+        return f"Money({self.to_decimal():.2f})"
 
 
-ZERO = Money(0.0)
+ZERO = Money(0)
