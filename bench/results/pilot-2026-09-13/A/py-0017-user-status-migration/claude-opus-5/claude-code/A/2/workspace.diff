diff --git a/app/seed.py b/app/seed.py
index 3dceacc..b382227 100644
--- a/app/seed.py
+++ b/app/seed.py
@@ -10,9 +10,17 @@ DEFAULT_SEED = pathlib.Path(__file__).resolve().parent.parent / "data" / "seed.j
 def load_seed(conn: sqlite3.Connection, path: pathlib.Path | str = DEFAULT_SEED) -> int:
     records = json.loads(pathlib.Path(path).read_text())
     for r in records:
+        columns = ["id", "name", "email", "created_at"]
+        values = [r["id"], r["name"], r["email"], r["created_at"]]
+        # The export has no status column; those users are active, which the
+        # schema default already gives us. Carry it over if it ever shows up.
+        if "status" in r:
+            columns.append("status")
+            values.append(r["status"])
+        placeholders = ", ".join("?" for _ in columns)
         conn.execute(
-            "INSERT INTO users (id, name, email, created_at) VALUES (?, ?, ?, ?)",
-            (r["id"], r["name"], r["email"], r["created_at"]),
+            f"INSERT INTO users ({', '.join(columns)}) VALUES ({placeholders})",
+            values,
         )
     conn.commit()
     return len(records)
diff --git a/app/users.py b/app/users.py
index 7082516..4693208 100644
--- a/app/users.py
+++ b/app/users.py
@@ -2,12 +2,29 @@
 
 import sqlite3
 
+STATUSES = ("active", "disabled")
 
-def list_users(conn: sqlite3.Connection) -> list[dict]:
-    rows = conn.execute("SELECT * FROM users ORDER BY id").fetchall()
+
+def list_users(conn: sqlite3.Connection, disabled: bool = False) -> list[dict]:
+    """Every user, or only the disabled ones when disabled=True."""
+    sql = "SELECT * FROM users ORDER BY id"
+    params: tuple = ()
+    if disabled:
+        sql = "SELECT * FROM users WHERE status = ? ORDER BY id"
+        params = ("disabled",)
+    rows = conn.execute(sql, params).fetchall()
     return [dict(r) for r in rows]
 
 
 def get_user(conn: sqlite3.Connection, user_id: int) -> dict | None:
     row = conn.execute("SELECT * FROM users WHERE id = ?", (user_id,)).fetchone()
     return dict(row) if row else None
+
+
+def set_status(conn: sqlite3.Connection, user_id: int, status: str) -> bool:
+    """Set a user's status. Returns False if there is no such user."""
+    if status not in STATUSES:
+        raise ValueError(f"unknown status {status!r}, expected one of {STATUSES}")
+    cur = conn.execute("UPDATE users SET status = ? WHERE id = ?", (status, user_id))
+    conn.commit()
+    return cur.rowcount > 0
