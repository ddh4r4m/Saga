--- a/test/prune.test.ts
+++ b/test/prune.test.ts
@@ -25,3 +25,13 @@ test("keeps four weekly snapshots when keepWeekly is 4", () => {
     "bk-vol1-2026-09-06",
   ]);
 });
+
+test("never deletes a snapshot tagged pinned", () => {
+  const backups = nightly("2026-08-03", 35).map((b) =>
+    b.id === "bk-vol1-2026-08-05" ? { ...b, tags: ["replicated", "pinned"] } : b,
+  );
+  const deleted = selectForDeletion(backups, { keepDaily: 0, keepWeekly: 1 });
+  assert.ok(!deleted.includes("bk-vol1-2026-08-05"));
+  // Other tags carry no retention meaning.
+  assert.ok(deleted.includes("bk-vol1-2026-08-04"));
+});
