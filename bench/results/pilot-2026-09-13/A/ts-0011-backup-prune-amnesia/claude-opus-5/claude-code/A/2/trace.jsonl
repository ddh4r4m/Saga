{"agent":"main","body":{"error":null,"exit":0,"for_seq":5,"result_bytes":1059,"result_hash":"sha256:a568ac6735490ba3ae815ee545e290da6ebdeeb73c85c5c7948741a72f1649c2","result_inline":"1\timport { test } from \"node:test\";\n2\timport assert from \"node:assert/strict\";\n3\timport { selectForDeletion, type Backup } from \"../src/prune.ts\";\n4\t\n5\tfunction nightly(from: string, days: number): Backup[] {\n6\t  const out: Backup[] = [];\n7\t  const d = new Date(`${from}T00:00:00Z`);\n8\t  for (let i = 0; i < days; i++) {\n9\t    const date = d.toISOString().slice(0, 10);\n10\t    out.push({ id: `bk-vol1-${date}`, takenAt: date, tags: [] });\n11\t    d.setUTCDate(d.getUTCDate() + 1);\n12\t  }\n13\t  return out;\n14\t}\n15\t\n16\ttest(\"keeps four weekly snapshots when keepWeekly is 4\", () => {\n17\t  // 2026-08-03 is a Monday; 35 nights run to Sunday 2026-09-06. Archive volumes use keepDaily 0.\n18\t  const backups = nightly(\"2026-08-03\", 35);\n19\t  const deleted = selectForDeletion(backups, { keepDaily: 0, keepWeekly: 4 });\n20\t  const kept = backups.map((b) => b.id).filter((id) => !deleted.includes(id));\n21\t  assert.deepEqual(kept, [\n22\t    \"bk-vol1-2026-08-16\",\n23\t    \"bk-vol1-2026-08-23\",\n24\t    \"bk-vol1-2026-08-30\",\n25\t    \"bk-vol1-2026-09-06\",\n26\t  ]);\n27\t});\n28\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:4535795485f16c61a47d96e64421fb60f4849da529b0c3cfc7be5ce8153b61e4","mono_ns":6000000,"prev":"sha256:a19ac813ef88f152bba975667383645a15762749b18c7b530fb812210e67f9ee","schema":"saga.trace/1","seq":6,"session":"0159c8b9-851c-4fec-935f-485d260708ad","source":"stream-json","ts":"2026-01-01T00:00:00.006Z","turn":1,"type":"tool_result"}
