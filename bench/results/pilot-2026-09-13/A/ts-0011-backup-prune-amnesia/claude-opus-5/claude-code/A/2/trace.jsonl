{"agent":"main","body":{"error":null,"exit":0,"for_seq":3,"result_bytes":1869,"result_hash":"sha256:e15bd158679e46e47d0510668c3e18be0ec0f714c5ca1c1087786c02a4ef316a","result_inline":"1\t// Retention selection for nightly snapshots. See docs/retention.md.\n2\t\n3\texport interface Backup {\n4\t  id: string;\n5\t  takenAt: string; // ISO date, YYYY-MM-DD\n6\t  tags: string[];\n7\t}\n8\t\n9\texport interface Policy {\n10\t  keepDaily: number;\n11\t  keepWeekly: number;\n12\t}\n13\t\n14\texport function isoWeek(date: string): string {\n15\t  const d = new Date(`${date}T00:00:00Z`);\n16\t  const weekday = (d.getUTCDay() + 6) % 7; // Monday = 0\n17\t  d.setUTCDate(d.getUTCDate() - weekday + 3); // Thursday of this week decides the year\n18\t  const year = d.getUTCFullYear();\n19\t  const jan4 = new Date(Date.UTC(year, 0, 4));\n20\t  const week = 1 + Math.round(((d.getTime() - jan4.getTime()) / 86_400_000 - 3 + ((jan4.getUTCDay() + 6) % 7)) / 7);\n21\t  return `${year}-W${String(week).padStart(2, \"0\")}`;\n22\t}\n23\t\n24\t// Newest snapshot per bucket, buckets ordered newest first.\n25\tfunction newestPerBucket(sorted: Backup[], key: (b: Backup) => string): Backup[] {\n26\t  const seen = new Set<string>();\n27\t  const out: Backup[] = [];\n28\t  for (const b of sorted) {\n29\t    const k = key(b);\n30\t    if (seen.has(k)) continue;\n31\t    seen.add(k);\n32\t    out.push(b);\n33\t  }\n34\t  return out;\n35\t}\n36\t\n37\texport function selectForDeletion(backups: Backup[], policy: Policy): string[] {\n38\t  const sorted = [...backups].sort((a, b) => (a.takenAt < b.takenAt ? 1 : a.takenAt > b.takenAt ? -1 : a.id.localeCompare(b.id)));\n39\t  const keep = new Set<string>();\n40\t  for (const b of newestPerBucket(sorted, (x) => x.takenAt).slice(0, policy.keepDaily)) keep.add(b.id);\n41\t  // The current week is already covered by the dailies, so weekly retention starts at the previous week.\n42\t  const weeks = newestPerBucket(sorted, (x) => isoWeek(x.takenAt));\n43\t  for (const b of weeks.slice(1, policy.keepWeekly)) keep.add(b.id);\n44\t  return sorted.filter((b) => !keep.has(b.id)).map((b) => b.id);\n45\t}\n46\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:c57e487a30a5df8cc458e716aab00e76ce167b113aff3390d8916821be5df0b7","mono_ns":4000000,"prev":"sha256:93ca7fb4747387b02c67ca990dd3bfa8442cba10c5ec08a821d10e8e8be2173f","schema":"saga.trace/1","seq":4,"session":"0159c8b9-851c-4fec-935f-485d260708ad","source":"stream-json","ts":"2026-01-01T00:00:00.004Z","turn":1,"type":"tool_result"}
