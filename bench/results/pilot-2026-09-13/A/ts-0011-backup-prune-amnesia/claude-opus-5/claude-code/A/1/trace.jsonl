{"agent":"main","body":{"args_hash":"sha256:439768076aa8ad5d70a0bc47a4c3a1e3258c25c127fdac8291671a706d578a38","args_inline":{"file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-3578220652/ts-0011-backup-prune-amnesia/1/ws/src/prune.ts"},"component":"harness","cwd_rel":".","index_version":null,"tool":"Read","tool_use_id":"toolu_01C2cCjYPw7kZiuQUabvJn6X"},"hash":"sha256:542db162edd6f491081cd131535578e24f7c3f7606dbcd8dc245a84362e342d5","mono_ns":3000000,"prev":"sha256:342cb609ea727ef365e5eedfa75f5c3fb20f332aec7ac9881a22acc685f9652a","schema":"saga.trace/1","seq":3,"session":"fa7984d1-1211-4ab8-8b2b-d47534a277cc","source":"stream-json","ts":"2026-01-01T00:00:00.003Z","turn":1,"type":"tool_call"}
{"agent":"main","body":{"error":null,"exit":0,"for_seq":3,"result_bytes":1869,"result_hash":"sha256:e15bd158679e46e47d0510668c3e18be0ec0f714c5ca1c1087786c02a4ef316a","result_inline":"1\t// Retention selection for nightly snapshots. See docs/retention.md.\n2\t\n3\texport interface Backup {\n4\t  id: string;\n5\t  takenAt: string; // ISO date, YYYY-MM-DD\n6\t  tags: string[];\n7\t}\n8\t\n9\texport interface Policy {\n10\t  keepDaily: number;\n11\t  keepWeekly: number;\n12\t}\n13\t\n14\texport function isoWeek(date: string): string {\n15\t  const d = new Date(`${date}T00:00:00Z`);\n16\t  const weekday = (d.getUTCDay() + 6) % 7; // Monday = 0\n17\t  d.setUTCDate(d.getUTCDate() - weekday + 3); // Thursday of this week decides the year\n18\t  const year = d.getUTCFullYear();\n19\t  const jan4 = new Date(Date.UTC(year, 0, 4));\n20\t  const week = 1 + Math.round(((d.getTime() - jan4.getTime()) / 86_400_000 - 3 + ((jan4.getUTCDay() + 6) % 7)) / 7);\n21\t  return `${year}-W${String(week).padStart(2, \"0\")}`;\n22\t}\n23\t\n24\t// Newest snapshot per bucket, buckets ordered newest first.\n25\tfunction newestPerBucket(sorted: Backup[], key: (b: Backup) => string): Backup[] {\n26\t  const seen = new Set<string>();\n27\t  const out: Backup[] = [];\n28\t  for (const b of sorted) {\n29\t    const k = key(b);\n30\t    if (seen.has(k)) continue;\n31\t    seen.add(k);\n32\t    out.push(b);\n33\t  }\n34\t  return out;\n35\t}\n36\t\n37\texport function selectForDeletion(backups: Backup[], policy: Policy): string[] {\n38\t  const sorted = [...backups].sort((a, b) => (a.takenAt < b.takenAt ? 1 : a.takenAt > b.takenAt ? -1 : a.id.localeCompare(b.id)));\n39\t  const keep = new Set<string>();\n40\t  for (const b of newestPerBucket(sorted, (x) => x.takenAt).slice(0, policy.keepDaily)) keep.add(b.id);\n41\t  // The current week is already covered by the dailies, so weekly retention starts at the previous week.\n42\t  const weeks = newestPerBucket(sorted, (x) => isoWeek(x.takenAt));\n43\t  for (const b of weeks.slice(1, policy.keepWeekly)) keep.add(b.id);\n44\t  return sorted.filter((b) => !keep.has(b.id)).map((b) => b.id);\n45\t}\n46\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:dc2e222460dec7ea74798ba88d3ef9b133f60e1e6554adcf5d7087d2b2e4ca76","mono_ns":4000000,"prev":"sha256:542db162edd6f491081cd131535578e24f7c3f7606dbcd8dc245a84362e342d5","schema":"saga.trace/1","seq":4,"session":"fa7984d1-1211-4ab8-8b2b-d47534a277cc","source":"stream-json","ts":"2026-01-01T00:00:00.004Z","turn":1,"type":"tool_result"}
