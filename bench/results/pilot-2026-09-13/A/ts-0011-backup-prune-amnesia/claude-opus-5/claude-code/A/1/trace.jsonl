{"agent":"main","body":{"error":null,"exit":0,"for_seq":5,"result_bytes":1059,"result_hash":"sha256:a568ac6735490ba3ae815ee545e290da6ebdeeb73c85c5c7948741a72f1649c2","result_inline":"1\timport { test } from \"node:test\";\n2\timport assert from \"node:assert/strict\";\n3\timport { selectForDeletion, type Backup } from \"../src/prune.ts\";\n4\t\n5\tfunction nightly(from: string, days: number): Backup[] {\n6\t  const out: Backup[] = [];\n7\t  const d = new Date(`${from}T00:00:00Z`);\n8\t  for (let i = 0; i < days; i++) {\n9\t    const date = d.toISOString().slice(0, 10);\n10\t    out.push({ id: `bk-vol1-${date}`, takenAt: date, tags: [] });\n11\t    d.setUTCDate(d.getUTCDate() + 1);\n12\t  }\n13\t  return out;\n14\t}\n15\t\n16\ttest(\"keeps four weekly snapshots when keepWeekly is 4\", () => {\n17\t  // 2026-08-03 is a Monday; 35 nights run to Sunday 2026-09-06. Archive volumes use keepDaily 0.\n18\t  const backups = nightly(\"2026-08-03\", 35);\n19\t  const deleted = selectForDeletion(backups, { keepDaily: 0, keepWeekly: 4 });\n20\t  const kept = backups.map((b) => b.id).filter((id) => !deleted.includes(id));\n21\t  assert.deepEqual(kept, [\n22\t    \"bk-vol1-2026-08-16\",\n23\t    \"bk-vol1-2026-08-23\",\n24\t    \"bk-vol1-2026-08-30\",\n25\t    \"bk-vol1-2026-09-06\",\n26\t  ]);\n27\t});\n28\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:7b1162499a4a7d80c0ea0aa99f54bf45569fae6ab50812ea4b231cea96ee04a9","mono_ns":6000000,"prev":"sha256:ce211d6235a1a7c7549e23f22bc48d8092ced47ce613a161177193d8ab35f24c","schema":"saga.trace/1","seq":6,"session":"fa7984d1-1211-4ab8-8b2b-d47534a277cc","source":"stream-json","ts":"2026-01-01T00:00:00.006Z","turn":1,"type":"tool_result"}
{"agent":"main","body":{"args_hash":"sha256:bf5735539b837ed67c89a2663db417664711840230fbce4575a666bc5ab02ce5","args_inline":{"file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-3578220652/ts-0011-backup-prune-amnesia/1/ws/docs/retention.md"},"component":"harness","cwd_rel":".","index_version":null,"tool":"Read","tool_use_id":"toolu_01FVVX8ib9BNzQi6rDtGk6go"},"hash":"sha256:3a0df7ad51541c594f9b414627e7b9edeb7767c6af47e9d56ae475c0359a559b","mono_ns":7000000,"prev":"sha256:7b1162499a4a7d80c0ea0aa99f54bf45569fae6ab50812ea4b231cea96ee04a9","schema":"saga.trace/1","seq":7,"session":"fa7984d1-1211-4ab8-8b2b-d47534a277cc","source":"stream-json","ts":"2026-01-01T00:00:00.007Z","turn":1,"type":"tool_call"}
{"agent":"main","body":{"error":null,"exit":0,"for_seq":7,"result_bytes":554,"result_hash":"sha256:f6e53aee9daef7586ed5c850e222b45e41601f9979f5cc042e688589b1dc9243","result_inline":"1\t# Retention\n2\t\n3\tSnapshots are taken nightly per volume and named `bk-<volume>-<date>`. The scheduler runs `selectForDeletion` once a day and deletes what it returns, so the function is the only thing standing between a policy typo and data loss; it must be conservative and deterministic.\n4\t\n5\tBoth rules count distinct calendar units, newest first, and the current unit counts: with `keepWeekly: 4` on a Wednesday, this week and the three before it each keep their newest snapshot. Daily and weekly are independent; a snapshot can be kept by both.\n6\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:3d8f41afebdaba7a9ae18ced480d8594dcd212fbf566384178b4669382cecad3","mono_ns":8000000,"prev":"sha256:3a0df7ad51541c594f9b414627e7b9edeb7767c6af47e9d56ae475c0359a559b","schema":"saga.trace/1","seq":8,"session":"fa7984d1-1211-4ab8-8b2b-d47534a277cc","source":"stream-json","ts":"2026-01-01T00:00:00.008Z","turn":1,"type":"tool_result"}
