+test("never deletes a snapshot tagged pinned", () => {
+  const backups = nightly("2026-08-03", 35);
+  const held = backups.find((b) => b.id === "bk-vol1-2026-08-05")!;
+  held.tags = ["replicated", "pinned"];
+  const deleted = selectForDeletion(backups, { keepDaily: 0, keepWeekly: 1 });
+  assert.ok(!deleted.includes(held.id));
+});
