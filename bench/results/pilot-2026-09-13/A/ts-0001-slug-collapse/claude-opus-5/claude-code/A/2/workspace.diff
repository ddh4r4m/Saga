diff --git a/src/slug.ts b/src/slug.ts
index 65623a4..f658a57 100644
--- a/src/slug.ts
+++ b/src/slug.ts
@@ -2,7 +2,10 @@
 // Used by the CMS to build article URLs from titles.
 
 export function slugify(input: string): string {
-  const lowered = input.toLowerCase();
-  const replaced = lowered.replace(/[^a-z0-9]/g, "-");
-  return replaced;
+  // Decompose accented letters (é -> e + U+0301) and drop the combining marks,
+  // so "Café" folds to "cafe" instead of losing the letter entirely.
+  const folded = input.normalize("NFD").replace(/[\u0300-\u036f]/g, "");
+  const lowered = folded.toLowerCase();
+  const replaced = lowered.replace(/[^a-z0-9]+/g, "-");
+  return replaced.replace(/^-+|-+$/g, "");
 }
