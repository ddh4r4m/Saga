{"agent":"main","body":{"error":null,"exit":0,"for_seq":5,"result_bytes":1078,"result_hash":"sha256:d2db016a47c6528fe65c4558447909622c3f3c9b130fc8bef04a31ef33b8c7e9","result_inline":"1\t\"\"\"Invoice totals under the FIN-12 rounding policy (docs/rounding-policy.md).\"\"\"\n2\t\n3\timport json\n4\timport pathlib\n5\tfrom dataclasses import dataclass\n6\tfrom decimal import ROUND_HALF_UP, Decimal\n7\t\n8\tCENT = Decimal(\"0.01\")\n9\t\n10\t\n11\t@dataclass(frozen=True)\n12\tclass Line:\n13\t    sku: str\n14\t    qty: int\n15\t    unit_price: Decimal\n16\t\n17\t\n18\t@dataclass(frozen=True)\n19\tclass Invoice:\n20\t    id: str\n21\t    lines: tuple[Line, ...]\n22\t\n23\t\n24\tdef load(path: str | pathlib.Path) -> Invoice:\n25\t    raw = json.loads(pathlib.Path(path).read_text())\n26\t    lines = tuple(Line(l[\"sku\"], int(l[\"qty\"]), Decimal(l[\"unit_price\"])) for l in raw[\"lines\"])\n27\t    return Invoice(raw[\"id\"], lines)\n28\t\n29\t\n30\tdef line_total(line: Line) -> Decimal:\n31\t    \"\"\"Policy item 2: round each line to the cent, half up.\"\"\"\n32\t    return (line.qty * line.unit_price).quantize(CENT, rounding=ROUND_HALF_UP)\n33\t\n34\t\n35\tdef total(invoice: Invoice) -> Decimal:\n36\t    \"\"\"Policy item 3: the sum of the rounded line totals.\"\"\"\n37\t    return sum((line_total(l) for l in invoice.lines), Decimal(\"0.00\"))\n38\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:6d256b95a44199fd3e5978296d3443873bb9435cec631af657f22479a11d31fe","mono_ns":6000000,"prev":"sha256:97b3dfa694303d5ffa0901f1d27c0bdf741f31ecf579d4db007e98b2ee45d120","schema":"saga.trace/1","seq":6,"session":"0ee81121-8f8f-4903-82db-12f37ccc1f2f","source":"stream-json","ts":"2026-01-01T00:00:00.006Z","turn":1,"type":"tool_result"}
