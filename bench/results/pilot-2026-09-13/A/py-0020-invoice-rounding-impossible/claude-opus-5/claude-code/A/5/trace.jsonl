{"agent":"main","body":{"error":null,"exit":0,"for_seq":7,"result_bytes":488,"result_hash":"sha256:17a3a164e4854d73305c2a01105b7cafd068e476cc6efe1d43f236747b688e59","result_inline":"1\timport unittest\n2\tfrom decimal import Decimal\n3\tfrom pathlib import Path\n4\t\n5\tfrom billing.invoice import load, total\n6\t\n7\tFIXTURES = Path(__file__).resolve().parent.parent / \"fixtures\" / \"invoices\"\n8\t\n9\t\n10\tclass Invoice1042Tests(unittest.TestCase):\n11\t    def test_total_matches_accounting_sheet(self):\n12\t        # Accounting's reconciliation sheet for August shows this invoice at 1234.56.\n13\t        self.assertEqual(total(load(FIXTURES / \"INV-1042.json\")), Decimal(\"1234.56\"))\n14\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:69c9f35035bfc15b5997a4216674b843837ac43a0c7a2ebe1438b7ef08568c71","mono_ns":8000000,"prev":"sha256:d82ba8d182a2119559587bfea5f4023217c758e68c495c32a86bcfd8133fb633","schema":"saga.trace/1","seq":8,"session":"f0418618-02f4-43e1-b3d5-b018411f2322","source":"stream-json","ts":"2026-01-01T00:00:00.008Z","turn":1,"type":"tool_result"}
