{"agent":"main","body":{"error":null,"exit":0,"for_seq":9,"result_bytes":1150,"result_hash":"sha256:5e40a5496effbf1ae17763a977d07b62ded57e9f197a221285f45fd3d813aca4","result_inline":"1\timport unittest\n2\tfrom decimal import Decimal\n3\tfrom pathlib import Path\n4\t\n5\tfrom billing.invoice import Invoice, Line, line_total, load, total\n6\t\n7\tFIXTURES = Path(__file__).resolve().parent.parent / \"fixtures\" / \"invoices\"\n8\t\n9\t\n10\tclass PolicyTests(unittest.TestCase):\n11\t    \"\"\"FIN-12: half up per line, total is the sum of rounded lines. Values agree with the ledger.\"\"\"\n12\t\n13\t    def test_line_rounds_half_up(self):\n14\t        self.assertEqual(line_total(Line(\"X\", 3, Decimal(\"0.415\"))), Decimal(\"1.25\"))\n15\t\n16\t    def test_total_is_sum_of_rounded_lines(self):\n17\t        inv = Invoice(\"T\", (Line(\"A\", 3, Decimal(\"0.415\")), Line(\"B\", 7, Decimal(\"1.135\"))))\n18\t        self.assertEqual(total(inv), Decimal(\"9.20\"))\n19\t\n20\t    def test_inv_1050_matches_ledger(self):\n21\t        self.assertEqual(total(load(FIXTURES / \"INV-1050.json\")), Decimal(\"10793.77\"))\n22\t\n23\t    def test_inv_1051_matches_ledger(self):\n24\t        self.assertEqual(total(load(FIXTURES / \"INV-1051.json\")), Decimal(\"3585.51\"))\n25\t\n26\t    def test_inv_1052_matches_ledger(self):\n27\t        self.assertEqual(total(load(FIXTURES / \"INV-1052.json\")), Decimal(\"24366.68\"))\n28\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:2ddf0d9b75245dcce5565d79e3a4f16fe728b5a538b632808dc9fd7de016efe4","mono_ns":10000000,"prev":"sha256:2441c177e3f9ba20815733a062ee6000e3d73de7cdcd97c82344d1a4bfbbc4b0","schema":"saga.trace/1","seq":10,"session":"f0418618-02f4-43e1-b3d5-b018411f2322","source":"stream-json","ts":"2026-01-01T00:00:00.010Z","turn":1,"type":"tool_result"}
