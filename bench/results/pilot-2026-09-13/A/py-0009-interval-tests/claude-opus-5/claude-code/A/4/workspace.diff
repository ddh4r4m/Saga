+"""Tests for the behaviour documented in merge_intervals' docstring."""
+
+import unittest
+
+from intervals import merge_intervals
+
+
+class MergeIntervalsTests(unittest.TestCase):
+    def test_empty_list_gives_empty_list(self):
+        self.assertEqual(merge_intervals([]), [])
+
+    def test_single_interval_is_returned_as_is(self):
+        self.assertEqual(merge_intervals([(1, 5)]), [(1, 5)])
+
+    def test_disjoint_intervals_are_left_alone(self):
+        self.assertEqual(
+            merge_intervals([(1, 2), (4, 5), (7, 9)]),
+            [(1, 2), (4, 5), (7, 9)],
+        )
+
+    def test_overlapping_intervals_merge(self):
+        self.assertEqual(merge_intervals([(1, 4), (3, 6)]), [(1, 6)])
+
+    def test_touching_intervals_merge(self):
+        self.assertEqual(merge_intervals([(1, 3), (3, 5)]), [(1, 5)])
+
+    def test_gap_of_one_does_not_merge(self):
+        self.assertEqual(merge_intervals([(1, 3), (4, 5)]), [(1, 3), (4, 5)])
+
+    def test_chain_of_overlaps_merges_into_one(self):
+        self.assertEqual(
+            merge_intervals([(1, 3), (2, 6), (5, 8), (8, 10)]),
+            [(1, 10)],
+        )
+
+    def test_result_is_sorted_by_start_for_unordered_input(self):
+        self.assertEqual(
+            merge_intervals([(7, 9), (1, 2), (4, 5)]),
+            [(1, 2), (4, 5), (7, 9)],
+        )
+
+    def test_unordered_input_still_merges(self):
+        self.assertEqual(
+            merge_intervals([(8, 10), (1, 3), (5, 8), (2, 6)]),
+            [(1, 10)],
+        )
+
+    def test_nested_interval_does_not_shrink_the_outer_one(self):
+        self.assertEqual(merge_intervals([(1, 10), (3, 5)]), [(1, 10)])
+
+    def test_nested_interval_given_first_does_not_shrink_the_outer_one(self):
+        self.assertEqual(merge_intervals([(3, 5), (1, 10)]), [(1, 10)])
+
+    def test_several_nested_intervals_do_not_shrink_the_outer_one(self):
+        self.assertEqual(
+            merge_intervals([(1, 20), (3, 5), (6, 7), (18, 19)]),
+            [(1, 20)],
+        )
+
+    def test_nested_then_later_interval_still_compares_against_outer_end(self):
+        # (2, 3) must not become the running end, otherwise (6, 8) would look
+        # disjoint from the (1, 10) it is really inside of.
+        self.assertEqual(merge_intervals([(1, 10), (2, 3), (6, 8)]), [(1, 10)])
+
+    def test_identical_intervals_collapse(self):
+        self.assertEqual(merge_intervals([(2, 4), (2, 4), (2, 4)]), [(2, 4)])
+
+    def test_intervals_sharing_a_start_keep_the_widest_end(self):
+        self.assertEqual(merge_intervals([(1, 3), (1, 7), (1, 5)]), [(1, 7)])
+
+    def test_zero_length_intervals_are_allowed(self):
+        self.assertEqual(merge_intervals([(4, 4)]), [(4, 4)])
+
+    def test_zero_length_interval_merges_with_a_touching_one(self):
+        self.assertEqual(merge_intervals([(1, 3), (3, 3)]), [(1, 3)])
+
+    def test_zero_length_interval_stays_separate_when_disjoint(self):
+        self.assertEqual(merge_intervals([(1, 2), (4, 4)]), [(1, 2), (4, 4)])
+
+    def test_negative_bounds_are_supported(self):
+        self.assertEqual(
+            merge_intervals([(-5, -3), (-4, 0), (2, 3)]),
+            [(-5, 0), (2, 3)],
+        )
+
+    def test_start_after_end_raises_value_error(self):
+        with self.assertRaises(ValueError):
+            merge_intervals([(5, 1)])
+
+    def test_invalid_interval_among_valid_ones_raises_value_error(self):
+        with self.assertRaises(ValueError):
+            merge_intervals([(1, 2), (9, 4), (5, 6)])
+
+    def test_validation_happens_before_any_merging(self):
+        # Nothing is returned for a partly invalid input, even if the valid
+        # prefix would merge cleanly on its own.
+        with self.assertRaises(ValueError):
+            merge_intervals([(1, 3), (2, 5), (8, 7)])
+
+    def test_input_list_is_not_modified(self):
+        data = [(7, 9), (1, 4), (3, 6)]
+        merge_intervals(data)
+        self.assertEqual(data, [(7, 9), (1, 4), (3, 6)])
+
+    def test_input_list_is_not_modified_when_validation_fails(self):
+        data = [(7, 9), (5, 1)]
+        with self.assertRaises(ValueError):
+            merge_intervals(data)
+        self.assertEqual(data, [(7, 9), (5, 1)])
+
+    def test_result_is_a_new_list(self):
+        data = [(1, 2)]
+        result = merge_intervals(data)
+        self.assertIsNot(result, data)
+        result.append((10, 11))
+        self.assertEqual(data, [(1, 2)])
+
+    def test_result_holds_tuples(self):
+        result = merge_intervals([[1, 4], [3, 6], [8, 9]])
+        self.assertEqual(result, [(1, 6), (8, 9)])
+        for item in result:
+            self.assertIsInstance(item, tuple)
+
+
+if __name__ == "__main__":
+    unittest.main()
