+"""Tests for merge_intervals, covering the behaviour in its docstring."""
+
+import unittest
+
+from intervals import merge_intervals
+
+
+class EmptyAndSingleTest(unittest.TestCase):
+    def test_empty_list_gives_empty_list(self):
+        self.assertEqual(merge_intervals([]), [])
+
+    def test_single_interval_is_returned_as_is(self):
+        self.assertEqual(merge_intervals([(2, 7)]), [(2, 7)])
+
+    def test_single_degenerate_interval_is_returned_as_is(self):
+        self.assertEqual(merge_intervals([(4, 4)]), [(4, 4)])
+
+
+class OrderingTest(unittest.TestCase):
+    def test_disjoint_input_is_sorted_by_start(self):
+        self.assertEqual(
+            merge_intervals([(8, 9), (1, 2), (4, 5)]),
+            [(1, 2), (4, 5), (8, 9)],
+        )
+
+    def test_unsorted_overlapping_input_still_merges(self):
+        self.assertEqual(merge_intervals([(5, 8), (1, 6)]), [(1, 8)])
+
+    def test_intervals_sharing_a_start_are_merged(self):
+        self.assertEqual(merge_intervals([(1, 4), (1, 9)]), [(1, 9)])
+        self.assertEqual(merge_intervals([(1, 9), (1, 4)]), [(1, 9)])
+
+
+class MergingTest(unittest.TestCase):
+    def test_disjoint_intervals_are_kept_separate(self):
+        self.assertEqual(merge_intervals([(1, 2), (4, 5)]), [(1, 2), (4, 5)])
+
+    def test_adjacent_but_not_touching_intervals_stay_separate(self):
+        # a gap of one unit between 2 and 3 is still a gap for closed intervals
+        self.assertEqual(merge_intervals([(1, 2), (3, 4)]), [(1, 2), (3, 4)])
+
+    def test_overlapping_intervals_merge(self):
+        self.assertEqual(merge_intervals([(1, 5), (3, 8)]), [(1, 8)])
+
+    def test_touching_intervals_merge(self):
+        self.assertEqual(merge_intervals([(1, 3), (3, 5)]), [(1, 5)])
+
+    def test_touching_at_a_point_interval_merges(self):
+        self.assertEqual(merge_intervals([(1, 3), (3, 3)]), [(1, 3)])
+        self.assertEqual(merge_intervals([(3, 3), (3, 6)]), [(3, 6)])
+
+    def test_chain_of_touching_intervals_collapses_to_one(self):
+        self.assertEqual(
+            merge_intervals([(1, 3), (3, 5), (5, 7), (7, 9)]),
+            [(1, 9)],
+        )
+
+    def test_duplicate_intervals_collapse(self):
+        self.assertEqual(merge_intervals([(2, 6), (2, 6), (2, 6)]), [(2, 6)])
+
+    def test_negative_and_mixed_sign_bounds_merge(self):
+        self.assertEqual(
+            merge_intervals([(0, 4), (-5, -1), (-1, 0)]),
+            [(-5, 4)],
+        )
+
+    def test_mixture_of_merging_and_disjoint_groups(self):
+        self.assertEqual(
+            merge_intervals([(10, 12), (1, 4), (3, 5), (20, 20), (12, 15)]),
+            [(1, 5), (10, 15), (20, 20)],
+        )
+
+
+class ContainmentTest(unittest.TestCase):
+    def test_interval_fully_inside_another_does_not_shrink_it(self):
+        self.assertEqual(merge_intervals([(1, 10), (3, 4)]), [(1, 10)])
+
+    def test_containment_when_inner_interval_comes_first(self):
+        self.assertEqual(merge_intervals([(3, 4), (1, 10)]), [(1, 10)])
+
+    def test_several_nested_intervals_keep_the_outer_bounds(self):
+        self.assertEqual(
+            merge_intervals([(1, 20), (2, 3), (5, 19), (6, 6)]),
+            [(1, 20)],
+        )
+
+    def test_contained_interval_does_not_hide_a_later_extension(self):
+        self.assertEqual(
+            merge_intervals([(1, 10), (2, 3), (9, 15)]),
+            [(1, 15)],
+        )
+
+    def test_interval_sharing_the_end_of_a_longer_one(self):
+        self.assertEqual(merge_intervals([(1, 10), (7, 10)]), [(1, 10)])
+
+
+class ResultShapeTest(unittest.TestCase):
+    def test_result_is_a_new_list(self):
+        given = [(1, 2), (5, 6)]
+        result = merge_intervals(given)
+        self.assertIsNot(result, given)
+
+    def test_input_list_is_not_modified(self):
+        given = [(5, 8), (1, 6), (20, 21)]
+        before = list(given)
+        merge_intervals(given)
+        self.assertEqual(given, before)
+
+    def test_mutating_the_result_does_not_affect_the_input(self):
+        given = [(1, 2), (5, 6)]
+        result = merge_intervals(given)
+        result.append((100, 200))
+        self.assertEqual(given, [(1, 2), (5, 6)])
+
+    def test_result_is_a_list_of_tuples(self):
+        result = merge_intervals([(5, 8), (1, 6), (20, 21)])
+        self.assertIsInstance(result, list)
+        for interval in result:
+            self.assertIsInstance(interval, tuple)
+            self.assertEqual(len(interval), 2)
+
+
+class ValidationTest(unittest.TestCase):
+    def test_start_after_end_raises_value_error(self):
+        with self.assertRaises(ValueError):
+            merge_intervals([(5, 1)])
+
+    def test_error_message_names_the_invalid_interval(self):
+        with self.assertRaisesRegex(ValueError, r"\(5, 1\)"):
+            merge_intervals([(5, 1)])
+
+    def test_invalid_interval_later_in_the_list_also_raises(self):
+        with self.assertRaises(ValueError):
+            merge_intervals([(1, 2), (3, 4), (9, 8)])
+
+    def test_validation_happens_before_any_merging(self):
+        # the valid intervals would merge happily; the invalid one still wins
+        with self.assertRaises(ValueError):
+            merge_intervals([(1, 3), (3, 5), (7, 6)])
+
+    def test_equal_start_and_end_is_valid(self):
+        self.assertEqual(merge_intervals([(4, 4), (9, 9)]), [(4, 4), (9, 9)])
+
+
+if __name__ == "__main__":
+    unittest.main()
