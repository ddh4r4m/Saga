+"""Tests for merge_intervals, covering each behaviour in its docstring."""
+
+import unittest
+
+from intervals import merge_intervals
+
+
+class MergeIntervalsTests(unittest.TestCase):
+    def test_empty_list_gives_empty_list(self):
+        self.assertEqual(merge_intervals([]), [])
+
+    def test_single_interval_returned_as_is(self):
+        self.assertEqual(merge_intervals([(1, 5)]), [(1, 5)])
+
+    def test_disjoint_intervals_are_kept_separate(self):
+        self.assertEqual(
+            merge_intervals([(1, 2), (5, 6), (9, 10)]),
+            [(1, 2), (5, 6), (9, 10)],
+        )
+
+    def test_adjacent_but_not_touching_intervals_do_not_merge(self):
+        # Closed intervals only merge when they share an endpoint; a gap of 1
+        # between end and the next start is still a gap.
+        self.assertEqual(merge_intervals([(1, 3), (4, 6)]), [(1, 3), (4, 6)])
+
+    def test_overlapping_intervals_merge(self):
+        self.assertEqual(merge_intervals([(1, 4), (3, 6)]), [(1, 6)])
+
+    def test_touching_intervals_merge(self):
+        self.assertEqual(merge_intervals([(1, 3), (3, 5)]), [(1, 5)])
+
+    def test_result_is_sorted_by_start_regardless_of_input_order(self):
+        self.assertEqual(
+            merge_intervals([(9, 10), (1, 2), (5, 6)]),
+            [(1, 2), (5, 6), (9, 10)],
+        )
+
+    def test_unsorted_overlapping_intervals_merge(self):
+        self.assertEqual(
+            merge_intervals([(8, 10), (1, 3), (2, 6), (15, 18)]),
+            [(1, 6), (8, 10), (15, 18)],
+        )
+
+    def test_nested_interval_does_not_shrink_the_outer_one(self):
+        self.assertEqual(merge_intervals([(1, 10), (3, 4)]), [(1, 10)])
+
+    def test_nested_interval_given_first_does_not_shrink_the_outer_one(self):
+        self.assertEqual(merge_intervals([(3, 4), (1, 10)]), [(1, 10)])
+
+    def test_several_nested_intervals_do_not_shrink_the_outer_one(self):
+        self.assertEqual(
+            merge_intervals([(1, 20), (3, 4), (6, 9), (11, 12)]),
+            [(1, 20)],
+        )
+
+    def test_nested_interval_does_not_hide_a_later_disjoint_interval(self):
+        self.assertEqual(
+            merge_intervals([(1, 10), (2, 3), (12, 14)]),
+            [(1, 10), (12, 14)],
+        )
+
+    def test_chain_of_overlaps_merges_into_one(self):
+        self.assertEqual(
+            merge_intervals([(1, 3), (2, 5), (4, 8), (7, 9)]),
+            [(1, 9)],
+        )
+
+    def test_identical_intervals_collapse(self):
+        self.assertEqual(merge_intervals([(2, 5), (2, 5), (2, 5)]), [(2, 5)])
+
+    def test_intervals_sharing_a_start_keep_the_widest_end(self):
+        self.assertEqual(merge_intervals([(1, 3), (1, 7)]), [(1, 7)])
+
+    def test_intervals_sharing_an_end_merge(self):
+        self.assertEqual(merge_intervals([(1, 7), (4, 7)]), [(1, 7)])
+
+    def test_degenerate_interval_is_allowed(self):
+        self.assertEqual(merge_intervals([(4, 4)]), [(4, 4)])
+
+    def test_degenerate_interval_touching_another_merges(self):
+        self.assertEqual(merge_intervals([(1, 4), (4, 4)]), [(1, 4)])
+
+    def test_degenerate_interval_on_its_own_stays_separate(self):
+        self.assertEqual(merge_intervals([(1, 2), (4, 4)]), [(1, 2), (4, 4)])
+
+    def test_negative_bounds_are_handled(self):
+        self.assertEqual(
+            merge_intervals([(-5, -3), (-4, 0), (2, 3)]),
+            [(-5, 0), (2, 3)],
+        )
+
+    def test_input_list_is_not_modified(self):
+        intervals = [(5, 8), (1, 3), (2, 6)]
+        before = list(intervals)
+        merge_intervals(intervals)
+        self.assertEqual(intervals, before)
+
+    def test_result_is_a_new_list(self):
+        intervals = [(1, 2), (5, 6)]
+        result = merge_intervals(intervals)
+        self.assertIsNot(result, intervals)
+        result.append((9, 10))
+        self.assertEqual(intervals, [(1, 2), (5, 6)])
+
+    def test_result_is_a_list_of_tuples(self):
+        result = merge_intervals([(1, 4), (3, 6), (9, 10)])
+        self.assertIsInstance(result, list)
+        for interval in result:
+            self.assertIsInstance(interval, tuple)
+            self.assertEqual(len(interval), 2)
+
+    def test_invalid_interval_raises_value_error(self):
+        with self.assertRaises(ValueError):
+            merge_intervals([(5, 1)])
+
+    def test_invalid_interval_among_valid_ones_raises_value_error(self):
+        with self.assertRaises(ValueError):
+            merge_intervals([(1, 2), (9, 4), (10, 12)])
+
+    def test_invalid_interval_is_detected_before_any_merging(self):
+        # The check covers the whole input, including an interval that would
+        # have been merged away.
+        with self.assertRaises(ValueError):
+            merge_intervals([(1, 10), (2, 3), (8, 7)])
+
+    def test_value_error_message_names_the_offending_interval(self):
+        with self.assertRaises(ValueError) as ctx:
+            merge_intervals([(1, 2), (9, 4)])
+        self.assertIn("(9, 4)", str(ctx.exception))
+
+
+if __name__ == "__main__":
+    unittest.main()
