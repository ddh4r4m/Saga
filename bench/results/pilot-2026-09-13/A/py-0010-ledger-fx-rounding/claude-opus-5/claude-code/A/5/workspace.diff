+++ b/tests/test_fx.py
@@ -0,0 +1,15 @@
+import unittest
+from ledger.fx import convert
+
+
+class ConvertTests(unittest.TestCase):
+    def test_identity(self):
+        self.assertEqual(convert(4097, 1.0), 4097)
+
+    def test_rounds_up_not_truncates(self):
+        # 3823 * 0.9228 = 3527.86...; truncation would give 3527.
+        self.assertEqual(convert(3823, 0.9228), 3528)
+
+    def test_half_rounds_away_from_zero(self):
+        self.assertEqual(convert(5, 0.5), 3)
+        self.assertEqual(convert(-5, 0.5), -3)
