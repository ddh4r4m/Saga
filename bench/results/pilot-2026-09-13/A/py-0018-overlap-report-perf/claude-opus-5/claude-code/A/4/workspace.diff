 """Clash detection between bookings."""
 
+from collections import defaultdict
 from dataclasses import dataclass
+from heapq import heappop, heappush
 
 
 @dataclass(frozen=True)
@@ -21,13 +23,29 @@ def find_overlaps(bookings: list[Booking]) -> list[tuple[str, str]]:
     Two bookings clash when they are in the same room and their half-open
     intervals intersect. A booking fully inside a longer one clashes with it;
     a booking that ends exactly when another starts does not.
+
+    Sweeps each room in start order, keeping the bookings that are still open
+    in a heap ordered by end, so the cost is n log n plus one step per pair
+    reported rather than one per pair of bookings.
     """
+    by_room: dict[str, list[Booking]] = defaultdict(list)
+    for b in bookings:
+        by_room[b.room].append(b)
+
     pairs: list[tuple[str, str]] = []
-    for i in range(len(bookings)):
-        a = bookings[i]
-        for j in range(i + 1, len(bookings)):
-            b = bookings[j]
-            if overlaps(a, b):
-                pairs.append((a.id, b.id) if a.id < b.id else (b.id, a.id))
+    for room_bookings in by_room.values():
+        # Ties break on end so an empty booking is seen, and dropped again,
+        # before any longer booking starting at the same minute: the two do
+        # not clash, since neither strictly contains the other.
+        room_bookings.sort(key=lambda b: (b.start, b.end))
+        active: list[tuple[int, str]] = []  # (end, id) of bookings still open
+        for b in room_bookings:
+            while active and active[0][0] <= b.start:
+                heappop(active)
+            # What is left started at or before b and ends after b starts,
+            # so every one of them clashes with b.
+            for _, other_id in active:
+                pairs.append((other_id, b.id) if other_id < b.id else (b.id, other_id))
+            heappush(active, (b.end, b.id))
     pairs.sort()
     return pairs
