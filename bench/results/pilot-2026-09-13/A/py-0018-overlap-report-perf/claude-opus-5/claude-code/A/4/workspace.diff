 from overlaps import Booking, find_overlaps
+from overlaps.core import overlaps
+
+
+def pairwise(bookings):
+    """The obvious O(n^2) definition, used to pin down find_overlaps."""
+    pairs = []
+    for i, a in enumerate(bookings):
+        for b in bookings[i + 1 :]:
+            if overlaps(a, b):
+                pairs.append((a.id, b.id) if a.id < b.id else (b.id, a.id))
+    pairs.sort()
+    return pairs
 
 
