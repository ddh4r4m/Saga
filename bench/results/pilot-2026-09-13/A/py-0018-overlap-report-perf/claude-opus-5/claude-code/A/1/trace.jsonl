{"agent":"main","body":{"args_hash":"sha256:89c66baded634f3859d632e40e1f82298ce4cbabe6c8b7584ee66921e1ba9f78","args_inline":{"content":"\"\"\"Throwaway: brute force vs sweep on randomised + degenerate inputs.\"\"\"\nimport random, time\nfrom overlaps.core import Booking, overlaps, find_overlaps\n\n\ndef brute(bookings):\n    pairs = []\n    for i in range(len(bookings)):\n        a = bookings[i]\n        for j in range(i + 1, len(bookings)):\n            b = bookings[j]\n            if overlaps(a, b):\n                pairs.append((a.id, b.id) if a.id < b.id else (b.id, a.id))\n    pairs.sort()\n    return pairs\n\n\ndef gen(rng, n, rooms, span, maxlen, minlen=0, dup_ids=False):\n    out = []\n    for i in range(n):\n        s = rng.randrange(0, span)\n        ident = f\"b{rng.randrange(max(1, n // 2)):05d}\" if dup_ids else f\"b{i:05d}\"\n        out.append(Booking(ident, f\"room-{rng.randrange(rooms)}\", s, s + rng.randrange(minlen, maxlen)))\n    return out\n\n\nrng = random.Random(1)\nfor trial in range(3000):\n    n = rng.randrange(0, 40)\n    b = gen(rng, n, rng.randrange(1, 4), rng.randrange(1, 60), rng.randrange(1, 20) + 1,\n            minlen=rng.choice([0, 0, 1]), dup_ids=rng.random() < 0.3)\n    if rng.random() < 0.1 and b:  # exact duplicate booking objects\n        b.append(b[0])\n    got, want = find_overlaps(b), brute(b)\n    assert got == want, (trial, b, got, want)\n\n# degenerate: zero-length booking sharing a start with a longer one\nz = [Booking(\"a\", \"r\", 10, 20), Booking(\"z\", \"r\", 10, 10), Booking(\"y\", \"r\", 15, 15)]\nassert find_overlaps(z) == brute(z), (find_overlaps(z), brute(z))\n# end < start\nw = [Booking(\"a\", \"r\", 10, 5), Booking(\"b\", \"r\", 0, 12), Booking(\"c\", \"r\", 10, 20)]\nassert find_overlaps(w) == brute(w), (find_overlaps(w), brute(w))\n\n# big input: same-room heavy, matches docs/perf.md shape\nrng = random.Random(7)\nbig = gen(rng, 60000, 4, 100_000, 300)\nt0 = time.perf_counter(); p = find_overlaps(big); el = time.perf_counter() - t0\nprint(f\"60k bookings / 4 rooms: {len(p)} pairs in {el:.2f}s\")\nt0 = time.perf_counter(); p2 = brute(big[:6000]); el2 = time.perf_counter() - t0\nassert find_overlaps(big[:6000]) == p2\nprint(f\"brute 6k: {el2:.2f}s (agrees)\")\nprint(\"all equivalence checks passed\")\n","file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-3578220652/py-0018-overlap-report-perf/1/ws/_equiv_check.py"},"component":"harness","cwd_rel":".","index_version":null,"tool":"Write","tool_use_id":"toolu_012LW74UNkHkMbgGzgEyLjWn"},"hash":"sha256:9018d1955d4e6f0d93c8fa33575379e2f09f501846598ea868e9932b43f511f3","mono_ns":29000000,"prev":"sha256:13ec71744108b8c5420746dd61e4b3b7782560bc3c99786cb309f21695d8150c","schema":"saga.trace/1","seq":29,"session":"19c7a700-63ae-4425-aee3-d866d737bf20","source":"stream-json","ts":"2026-01-01T00:00:00.029Z","turn":1,"type":"tool_call"}
