{"agent":"main","body":{"error":null,"exit":0,"for_seq":11,"result_bytes":429,"result_hash":"sha256:264e1ebbbf45405c1b695d6b405cb255ceaac3d2ae3b8b4519208702c576568a","result_inline":"1\t\"\"\"Plain-text clash report.\"\"\"\n2\t\n3\tfrom .core import Booking, find_overlaps\n4\t\n5\t\n6\tdef render(bookings: list[Booking]) -> str:\n7\t    by_id = {b.id: b for b in bookings}\n8\t    lines = []\n9\t    for a, b in find_overlaps(bookings):\n10\t        x, y = by_id[a], by_id[b]\n11\t        lines.append(f\"{x.room}: {a} [{x.start}-{x.end}) clashes with {b} [{y.start}-{y.end})\")\n12\t    return \"\\n\".join(lines) + (\"\\n\" if lines else \"\")\n13\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:097c23d18ee10edf37b5a93a0f70dd4758f50f892cad1eff814db54ba1c2579c","mono_ns":12000000,"prev":"sha256:8d3eaede23d191686d74a8b4b305aa488af7a96ae28015e6441fcca31a7a69c9","schema":"saga.trace/1","seq":12,"session":"19c7a700-63ae-4425-aee3-d866d737bf20","source":"stream-json","ts":"2026-01-01T00:00:00.012Z","turn":1,"type":"tool_result"}
