{"agent":"main","body":{"error":null,"exit":0,"for_seq":13,"result_bytes":328,"result_hash":"sha256:12631041d94f45c03e298a39f91fde36448dd4940c591dc7ca02349c09f26f2d","result_inline":"1\t# Changelog\n2\t\n3\t## 0.4.1\n4\t- find_overlaps rewritten as a plain pairwise comparison for readability; the old sweep was hard to follow.\n5\t\n6\t## 0.4.0\n7\t- half-open intervals: a booking ending at 10:00 does not clash with one starting at 10:00.\n8\t\n9\t## 0.3.0\n10\t- bookings carry a room; only same-room clashes are reported.\n11\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:25c95ad3e1d3802d20468206e504dd71c212e7ec8b05f7c0723c2fd8aec9cd8d","mono_ns":14000000,"prev":"sha256:e4925508c56368780c03514e19f5cd18248f8661e73dfa5bf63e5d846137f3c1","schema":"saga.trace/1","seq":14,"session":"19c7a700-63ae-4425-aee3-d866d737bf20","source":"stream-json","ts":"2026-01-01T00:00:00.014Z","turn":1,"type":"tool_result"}
