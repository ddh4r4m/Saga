{"agent":"main","body":{"error":null,"exit":0,"for_seq":23,"result_bytes":1668,"result_hash":"sha256:c3362c4d2dab4978c7134e58af9ca1b0a722917050865c5a2651e7bc4af12dc2","result_inline":"1\t\"\"\"Clash detection between bookings.\"\"\"\n2\t\n3\tfrom dataclasses import dataclass\n4\tfrom heapq import heappop, heappush\n5\t\n6\t\n7\t@dataclass(frozen=True)\n8\tclass Booking:\n9\t    id: str\n10\t    room: str\n11\t    start: int  # minutes since midnight\n12\t    end: int  # exclusive\n13\t\n14\t\n15\tdef overlaps(a: Booking, b: Booking) -> bool:\n16\t    return a.room == b.room and a.start < b.end and b.start < a.end\n17\t\n18\t\n19\tdef find_overlaps(bookings: list[Booking]) -> list[tuple[str, str]]:\n20\t    \"\"\"Return every clashing pair as (id_a, id_b) with id_a < id_b, sorted.\n21\t\n22\t    Two bookings clash when they are in the same room and their half-open\n23\t    intervals intersect. A booking fully inside a longer one clashes with it;\n24\t    a booking that ends exactly when another starts does not.\n25\t    \"\"\"\n26\t    Swept in start order, keeping one heap of still-running bookings per room\n27\t    keyed on end time: everything left in a room's heap once the finished\n28\t    bookings are popped runs past the new booking's start, so it clashes.\n29\t    \"\"\"\n30\t    pairs: list[tuple[str, str]] = []\n31\t    active: dict[str, list[tuple[int, int, Booking]]] = {}\n32\t    for seq, b in enumerate(sorted(bookings, key=lambda b: b.start)):\n33\t        running = active.setdefault(b.room, [])\n34\t        while running and running[0][0] <= b.start:\n35\t            heappop(running)\n36\t        for _, _, a in running:\n37\t            if overlaps(a, b):  # only false for zero-length bookings\n38\t                pairs.append((a.id, b.id) if a.id < b.id else (b.id, a.id))\n39\t        heappush(running, (b.end, seq, b))  # seq keeps equal ends comparable\n40\t    pairs.sort()\n41\t    return pairs\n42\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:ae3ead41f66dbc5d687895a5c4053ee83cc501b4de576f5a8919e4cf55101d64","mono_ns":24000000,"prev":"sha256:2cdfcfc4ba48bcc4ab6e545d905b43f030e8964171c86dbd27c64c606a7e8798","schema":"saga.trace/1","seq":24,"session":"19c7a700-63ae-4425-aee3-d866d737bf20","source":"stream-json","ts":"2026-01-01T00:00:00.024Z","turn":1,"type":"tool_result"}
