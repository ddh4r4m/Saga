{"agent":"main","body":{"args_hash":"sha256:a31520d83533e49f5f6e180cf44038dcf50a0e6a475765064afd74416080e158","args_inline":{"content":"\"\"\"Money value object.\"\"\"\nfrom dataclasses import dataclass, field\n\n\n@dataclass(frozen=True)\nclass Money:\n    cents: int = field(default=0)\n\n    def __init__(self, amount: float = 0) -> None:\n        object.__setattr__(self, \"cents\", round(amount * 100))\n\n    @property\n    def amount(self) -> float:\n        return self.cents / 100\n\n    def __add__(self, other: \"Money\") -> \"Money\":\n        return Money._from_cents(self.cents + other.cents)\n\n    def __mul__(self, qty: int) -> \"Money\":\n        return Money._from_cents(self.cents * qty)\n\n    def __neg__(self) -> \"Money\":\n        return Money._from_cents(-self.cents)\n\n    @classmethod\n    def _from_cents(cls, cents: int) -> \"Money\":\n        obj = object.__new__(cls)\n        object.__setattr__(obj, \"cents\", cents)\n        return obj\n\n\nZERO = Money(0)\n","file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-3256608174/py-0008-money-exact-cents/1/ws/pricing/money.py"},"component":"harness","cwd_rel":".","index_version":null,"tool":"Write","tool_use_id":"toolu_015DXyzFVHUBn2Z1R6pgRMic"},"hash":"sha256:b00ce55f78560ab3851129f0210b4247a7ebcbe7a3754da85e2ea55a700d4817","mono_ns":25000000,"prev":"sha256:8d919d561943678d2e71307cead47542f66cfb3231da1ce637befd0a25bb62ec","schema":"saga.trace/1","seq":25,"session":"4966d22a-b50a-4c64-80f9-fc229a562498","source":"stream-json","ts":"2026-01-01T00:00:00.025Z","turn":1,"type":"tool_call"}
