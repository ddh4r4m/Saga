{"agent":"main","body":{"error":null,"exit":0,"for_seq":9,"result_bytes":469,"result_hash":"sha256:6a3a3d8d479f85f4be39d9f1a53491161fd075929e730f2d238d9556ed1afb8d","result_inline":"1\t\"\"\"Cart arithmetic.\"\"\"\n2\tfrom .money import Money, ZERO\n3\t\n4\tLine = tuple[str, Money, int]  # (name, unit price, quantity)\n5\t\n6\t\n7\tdef line_total(price: Money, qty: int) -> Money:\n8\t    if qty < 0:\n9\t        raise ValueError(\"quantity must be non-negative\")\n10\t    return price * qty\n11\t\n12\t\n13\tdef cart_total(lines: list[Line]) -> Money:\n14\t    total = ZERO\n15\t    for _, price, qty in lines:\n16\t        total = total + line_total(price, qty)\n17\t    return total\n18\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:102c5fb1be1b34062ddb79908fb229b11f9b622713f6ae3f8b875a8fc1537128","mono_ns":10000000,"prev":"sha256:367ab27e21e71e4fbe8f39fee2cfa803fd119a99a4b3a6b84fd59748e2dc964f","schema":"saga.trace/1","seq":10,"session":"4966d22a-b50a-4c64-80f9-fc229a562498","source":"stream-json","ts":"2026-01-01T00:00:00.010Z","turn":1,"type":"tool_result"}
