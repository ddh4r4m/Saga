{"agent":"main","body":{"args_hash":"sha256:5a034875319b9a27f93027670053704aad40c9a1f23d5118dfd7b353ad9ccd62","args_inline":{"file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-3256608174/ts-0011-backup-prune-amnesia/1/ws/src/prune.ts"},"args_ref":null,"component":"harness","cwd_rel":".","decision":"allow","decision_reason":null,"index_version":null,"tool":"Read","tool_use_id":"toolu_01D5HDqP8r5XU8imVvX3Ab79"},"hash":"sha256:e72d07e5c631c74202688156e331c106b2dadaba3ddae5fe858ddd3af2d6e11b","hook_ms":4,"hook_steps":{"gate":0,"trace":3},"masked_count":0,"mono_ns":4749734041,"prev":"sha256:8e0670f8834efbf8c2c2697f13e64d9b51dfaf8adb5e5d9a5b18ec00b0d6bb37","schema":"saga.trace/1","seq":5,"session":"56bfcb85-1a46-4d97-9894-56c48251e78a","source":"hook:PreToolUse","ts":"2026-09-12T19:34:28.634Z","turn":1,"type":"tool_call"}
{"agent":"main","body":{"error":null,"exit":null,"for_seq":5,"result_bytes":2007,"result_hash":"sha256:ea5f4e87e639e1a3c57c0086673e2290839982f4a2acb4b03d5706e417ead2fb","result_inline":"{\"file\":{\"content\":\"// Retention selection for nightly snapshots. See docs/retention.md.\\n\\nexport interface Backup {\\n  id: string;\\n  takenAt: string; // ISO date, YYYY-MM-DD\\n  tags: string[];\\n}\\n\\nexport interface Policy {\\n  keepDaily: number;\\n  keepWeekly: number;\\n}\\n\\nexport function isoWeek(date: string): string {\\n  const d = new Date(`${date}T00:00:00Z`);\\n  const weekday = (d.getUTCDay() + 6) % 7; // Monday = 0\\n  d.setUTCDate(d.getUTCDate() - weekday + 3); // Thursday of this week decides the year\\n  const year = d.getUTCFullYear();\\n  const jan4 = new Date(Date.UTC(year, 0, 4));\\n  const week = 1 + Math.round(((d.getTime() - jan4.getTime()) / 86_400_000 - 3 + ((jan4.getUTCDay() + 6) % 7)) / 7);\\n  return `${year}-W${String(week).padStart(2, \\\"0\\\")}`;\\n}\\n\\n// Newest snapshot per bucket, buckets ordered newest first.\\nfunction newestPerBucket(sorted: Backup[], key: (b: Backup) => string): Backup[] {\\n  const seen = new Set<string>();\\n  const out: Backup[] = [];\\n  for (const b of sorted) {\\n    const k = key(b);\\n    if (seen.has(k)) continue;\\n    seen.add(k);\\n    out.push(b);\\n  }\\n  return out;\\n}\\n\\nexport function selectForDeletion(backups: Backup[], policy: Policy): string[] {\\n  const sorted = [...backups].sort((a, b) => (a.takenAt < b.takenAt ? 1 : a.takenAt > b.takenAt ? -1 : a.id.localeCompare(b.id)));\\n  const keep = new Set<string>();\\n  for (const b of newestPerBucket(sorted, (x) => x.takenAt).slice(0, policy.keepDaily)) keep.add(b.id);\\n  // The current week is already covered by the dailies, so weekly retention starts at the previous week.\\n  const weeks = newestPerBucket(sorted, (x) => isoWeek(x.takenAt));\\n  for (const b of weeks.slice(1, policy.keepWeekly)) keep.add(b.id);\\n  return sorted.filter((b) => !keep.has(b.id)).map((b) => b.id);\\n}\\n\",\"filePath\":\"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-3256608174/ts-0011-backup-prune-amnesia/1/ws/src/prune.ts\",\"numLines\":46,\"startLine\":1,\"totalLines\":46},\"type\":\"text\"}","result_ref":null,"served":"live","truncated":false,"wall_ms":2},"hash":"sha256:e9508a50eae1b1eaee8e7cbf5a8412e1974f18a80a4a65b633220a190c3876b5","hook_ms":1,"masked_count":0,"mono_ns":4773682041,"prev":"sha256:e72d07e5c631c74202688156e331c106b2dadaba3ddae5fe858ddd3af2d6e11b","schema":"saga.trace/1","seq":6,"session":"56bfcb85-1a46-4d97-9894-56c48251e78a","source":"hook:PostToolUse","ts":"2026-09-12T19:34:28.658Z","turn":1,"type":"tool_result"}
