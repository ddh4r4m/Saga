{"agent":"main","body":{"error":null,"exit":null,"for_seq":8,"result_bytes":761,"result_hash":"sha256:20d4add29c17275a3651dddb218b905e60b2a0cceb0c12b1d1e1badf113dd5ba","result_inline":"{\"file\":{\"content\":\"import { test } from \\\"node:test\\\";\\nimport assert from \\\"node:assert/strict\\\";\\nimport { retry } from \\\"../src/retry.ts\\\";\\n\\ntest(\\\"waits grow exponentially with jitter\\\", async () => {\\n  const waits: number[] = [];\\n  const sleep = async (ms: number) => { waits.push(ms); };\\n  let calls = 0;\\n  const fn = async () => { calls++; throw new Error(\\\"nope\\\"); };\\n  await assert.rejects(retry(fn, { attempts: 4, baseMs: 100, sleep, random: () => 0.5 }), /nope/);\\n  assert.deepEqual(waits, [150, 300, 600]);\\n  assert.equal(calls, 4);\\n});\\n\",\"filePath\":\"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-3256608174/ts-0005-retry-backoff/1/ws/test/retry.test.ts\",\"numLines\":14,\"startLine\":1,\"totalLines\":14},\"type\":\"text\"}","result_ref":null,"served":"live","truncated":false,"wall_ms":1},"hash":"sha256:1baa1614b56376a38a5cd1c09a4a690e68a258ea46c5484205562b794d625573","hook_ms":0,"masked_count":0,"mono_ns":7315783042,"prev":"sha256:ecd3ed164c57620e312376702ad6938d62aa9b1e97547e682fcfa1f3fd61a97f","schema":"saga.trace/1","seq":9,"session":"552f27ed-1c45-43c2-81d6-f4fd26ed479a","source":"hook:PostToolUse","ts":"2026-09-12T19:24:06.014Z","turn":1,"type":"tool_result"}
