{"agent":"main","body":{"error":null,"exit":null,"for_seq":6,"result_bytes":1306,"result_hash":"sha256:510bb05beffff6eebc8aa2fdfc4ca0e1d9158d22ba20fb4b198e83711b6a58bf","result_inline":"{\"file\":{\"content\":\"\\\"\\\"\\\"Stock reservation for checkout.\\\"\\\"\\\"\\n\\nfrom .store import MemoryStore\\n\\n\\nclass OutOfStock(Exception):\\n    pass\\n\\n\\nclass Inventory:\\n    def __init__(self, store: MemoryStore) -> None:\\n        self.store = store\\n\\n    def reserve(self, sku: str, qty: int) -> int:\\n        \\\"\\\"\\\"Take qty units of sku out of stock; return the units left.\\\"\\\"\\\"\\n        if qty <= 0:\\n            raise ValueError(\\\"qty must be positive\\\")\\n        available = self.store.get(sku)\\n        if available < qty:\\n            raise OutOfStock(f\\\"{sku}: wanted {qty}, have {available}\\\")\\n        remaining = available - qty\\n        self.store.set(sku, remaining)\\n        return remaining\\n\\n    def release(self, sku: str, qty: int) -> int:\\n        \\\"\\\"\\\"Put qty units of sku back; return the units now in stock.\\\"\\\"\\\"\\n        if qty <= 0:\\n            raise ValueError(\\\"qty must be positive\\\")\\n        total = self.store.get(sku) + qty\\n        self.store.set(sku, total)\\n        return total\\n\\n    def available(self, sku: str) -> int:\\n        return self.store.get(sku)\\n\",\"filePath\":\"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-3256608174/py-0016-inventory-reserve-race/1/ws/inventory/reserve.py\",\"numLines\":35,\"startLine\":1,\"totalLines\":35},\"type\":\"text\"}","result_ref":null,"served":"live","truncated":false,"wall_ms":4},"hash":"sha256:dad9e7289534ade0117a9c5a486391cc9d3c50ff4ba1f1ecff22831fc5822c25","hook_ms":0,"masked_count":0,"mono_ns":5902681500,"prev":"sha256:d01faf5ddee810733e0e9de480b92582582d5ed5fda634ad1bcce26b19633eae","schema":"saga.trace/1","seq":7,"session":"0aaf2bd4-ba86-48b3-a5da-d8468c26615c","source":"hook:PostToolUse","ts":"2026-09-12T1