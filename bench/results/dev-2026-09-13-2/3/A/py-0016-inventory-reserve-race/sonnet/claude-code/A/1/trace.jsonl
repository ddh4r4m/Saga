{"agent":"main","body":{"error":null,"exit":0,"for_seq":9,"result_bytes":1114,"result_hash":"sha256:8d1f64a75c2f2160bccfca8acb5589912169783eadb101da27f38f56bbeff7e5","result_inline":"1\t\"\"\"Stock reservation for checkout.\"\"\"\n2\t\n3\tfrom .store import MemoryStore\n4\t\n5\t\n6\tclass OutOfStock(Exception):\n7\t    pass\n8\t\n9\t\n10\tclass Inventory:\n11\t    def __init__(self, store: MemoryStore) -> None:\n12\t        self.store = store\n13\t\n14\t    def reserve(self, sku: str, qty: int) -> int:\n15\t        \"\"\"Take qty units of sku out of stock; return the units left.\"\"\"\n16\t        if qty <= 0:\n17\t            raise ValueError(\"qty must be positive\")\n18\t        available = self.store.get(sku)\n19\t        if available < qty:\n20\t            raise OutOfStock(f\"{sku}: wanted {qty}, have {available}\")\n21\t        remaining = available - qty\n22\t        self.store.set(sku, remaining)\n23\t        return remaining\n24\t\n25\t    def release(self, sku: str, qty: int) -> int:\n26\t        \"\"\"Put qty units of sku back; return the units now in stock.\"\"\"\n27\t        if qty <= 0:\n28\t            raise ValueError(\"qty must be positive\")\n29\t        total = self.store.get(sku) + qty\n30\t        self.store.set(sku, total)\n31\t        return total\n32\t\n33\t    def available(self, sku: str) -> int:\n34\t        return self.store.get(sku)\n35\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:7f705862e024e937e51f30872181ff687553b3396357e930ab2f8fa7a2c6456f","mono_ns":10000000,"prev":"sha256:5e4b0efe906b0c9c11bc7c3435f6532c66131a58d4c9560c1b663a40dbad0818","schema":"saga.trace/1","seq":10,"session":"0aaf2bd4-ba86-48b3-a5da-d8468c26615c","source":"stream-json","ts":"2026-01-01T00:00:00.010Z","turn":1,"type":"tool_result"}
