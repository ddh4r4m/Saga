diff --git a/pricing/money.py b/pricing/money.py
index f586e26..35e00af 100644
--- a/pricing/money.py
+++ b/pricing/money.py
@@ -2,18 +2,38 @@
 from dataclasses import dataclass
 
 
-@dataclass(frozen=True)
+@dataclass(frozen=True, eq=False)
 class Money:
     amount: float
+    cents: int = 0
+
+    def __init__(self, amount: float) -> None:
+        object.__setattr__(self, "cents", round(amount * 100))
+        object.__setattr__(self, "amount", self.cents / 100)
+
+    @classmethod
+    def _from_cents(cls, cents: int) -> "Money":
+        money = cls.__new__(cls)
+        object.__setattr__(money, "cents", cents)
+        object.__setattr__(money, "amount", cents / 100)
+        return money
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Money):
+            return NotImplemented
+        return self.cents == other.cents
+
+    def __hash__(self) -> int:
+        return hash(self.cents)
 
     def __add__(self, other: "Money") -> "Money":
-        return Money(self.amount + other.amount)
+        return Money._from_cents(self.cents + other.cents)
 
     def __mul__(self, qty: int) -> "Money":
-        return Money(self.amount * qty)
+        return Money._from_cents(self.cents * qty)
 
     def __neg__(self) -> "Money":
-        return Money(-self.amount)
+        return Money._from_cents(-self.cents)
 
 
 ZERO = Money(0.0)
