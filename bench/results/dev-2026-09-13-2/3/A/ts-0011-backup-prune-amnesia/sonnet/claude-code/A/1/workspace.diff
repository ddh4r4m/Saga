+
+test("never deletes a pinned snapshot regardless of policy", () => {
+  const backups = nightly("2026-08-03", 35);
+  backups[0].tags.push("pinned"); // 2026-08-03, well outside keepDaily/keepWeekly retention
+  const deleted = selectForDeletion(backups, { keepDaily: 0, keepWeekly: 1 });
+  assert.equal(deleted.includes(backups[0].id), false);
+});
