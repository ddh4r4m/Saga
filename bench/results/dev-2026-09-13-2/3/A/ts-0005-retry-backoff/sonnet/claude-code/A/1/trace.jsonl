{"agent":"main","body":{"error":null,"exit":0,"for_seq":9,"result_bytes":552,"result_hash":"sha256:a4ebbcffdda75de3878092198cde7ba0679363af4391832ce3e1f934e43cd1b5","result_inline":"1\timport { test } from \"node:test\";\n2\timport assert from \"node:assert/strict\";\n3\timport { retry } from \"../src/retry.ts\";\n4\t\n5\ttest(\"waits grow exponentially with jitter\", async () => {\n6\t  const waits: number[] = [];\n7\t  const sleep = async (ms: number) => { waits.push(ms); };\n8\t  let calls = 0;\n9\t  const fn = async () => { calls++; throw new Error(\"nope\"); };\n10\t  await assert.rejects(retry(fn, { attempts: 4, baseMs: 100, sleep, random: () => 0.5 }), /nope/);\n11\t  assert.deepEqual(waits, [150, 300, 600]);\n12\t  assert.equal(calls, 4);\n13\t});\n14\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:e695e9a585c6ff93d144b13309e754a8fd6215f4d7b5d53179409be17fcfd295","mono_ns":10000000,"prev":"sha256:ac879d03eadc6aaf022ffdd6407c5ab508dfd13cc7a129faacce65689827ecc7","schema":"saga.trace/1","seq":10,"session":"552f27ed-1c45-43c2-81d6-f4fd26ed479a","source":"stream-json","ts":"2026-01-01T00:00:00.010Z","turn":1,"type":"tool_result"}
