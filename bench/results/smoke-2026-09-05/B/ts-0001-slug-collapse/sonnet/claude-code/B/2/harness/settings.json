{
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "hooks": {
    "PostCompact": [
      {
        "hooks": [
          {
            "command": "/tmp/saga-smoke/bin/saga hook claude-code PostCompact",
            "timeout": 60,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "/tmp/saga-smoke/bin/saga hook claude-code PostToolUse",
            "timeout": 60,
            "type": "command"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "/tmp/saga-smoke/bin/saga hook claude-code PreCompact",
            "timeout": 60,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "/tmp/saga-smoke/bin/saga hook claude-code PreToolUse",
            "timeout": 60,
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "/tmp/saga-smoke/bin/saga hook claude-code SessionEnd",
            "timeout": 60,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "/tmp/saga-smoke/bin/saga hook claude-code SessionStart",
            "timeout": 60,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "/tmp/saga-smoke/bin/saga hook claude-code Stop",
            "timeout": 60,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "/tmp/saga-smoke/bin/saga hook claude-code SubagentStart",
            "timeout": 60,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "/tmp/saga-smoke/bin/saga hook claude-code SubagentStop",
            "timeout": 60,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "/tmp/saga-smoke/bin/saga hook claude-code UserPromptSubmit",
            "timeout": 60,
            "type": "command"
          }
        ]
      }
    ]
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "MultiEdit",
      "Grep",
      "Glob"
    ],
    "deny": []
  }
}
