{"agent":"main","body":{"args_hash":"sha256:a44091115755576ad991c2f4afdd90693c9cfeac19b27276d00dd302ab1f085a","args_inline":{"content":"import { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { parseEnvFile } from \"../src/env.ts\";\n\ntest(\"keeps quoted values intact, quotes stripped\", () => {\n  const env = parseEnvFile('APP_NAME=\"Order Service\"\\nMOTD=\\'hello # not a comment\\'\\n');\n  assert.equal(env.APP_NAME, \"Order Service\");\n  assert.equal(env.MOTD, \"hello # not a comment\");\n});\n\ntest(\"strips comments outside quotes\", () => {\n  const env = parseEnvFile('# header\\nPORT=8080 # inline\\nAPP_NAME=\"a # b\" # after\\n');\n  assert.deepEqual({ ...env }, { PORT: \"8080\", APP_NAME: \"a # b\" });\n});\n\ntest(\"handles blank lines, whitespace and export prefix\", () => {\n  const env = parseEnvFile(\"\\n  \\nexport HOST = db.internal  \\n\");\n  assert.equal(env.HOST, \"db.internal\");\n});\n\ntest(\"expands escapes in double quotes but not single quotes\", () => {\n  const env = parseEnvFile('A=\"one\\\\ntwo\"\\nB=\\'one\\\\ntwo\\'\\nC=\"say \\\\\"hi\\\\\"\"\\n');\n  assert.equal(env.A, \"one\\ntwo\");\n  assert.equal(env.B, \"one\\\\ntwo\");\n  assert.equal(env.C, 'say \"hi\"');\n});\n\ntest(\"empty and equals-containing values\", () => {\n  const env = parseEnvFile(\"EMPTY=\\nURL=postgres://u:p@h/db?a=1\\n\");\n  assert.equal(env.EMPTY, \"\");\n  assert.equal(env.URL, \"postgres://u:p@h/db?a=1\");\n});\n\ntest(\"rejects malformed lines\", () => {\n  assert.throws(() => parseEnvFile(\"NOT_AN_ASSIGNMENT\\n\"), /expected KEY=value/);\n  assert.throws(() => parseEnvFile('A=\"unterminated\\n'), /unterminated double quote/);\n  assert.throws(() => parseEnvFile(\"1BAD=x\\n\"), /invalid key/);\n});\n","file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-868155472/ts-0003-env-parser-dep/2/ws/test/env.test.ts"},"component":"harness","cwd_rel":".","index_version":null,"tool":"Write","tool_use_id":