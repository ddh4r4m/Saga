{"agent":"main","body":{"args_hash":"sha256:df7f76cca7bee4d96889e7048bbe1078d95472f1808f6d6f27f0c7002086bc6f","args_inline":{"content":"// Minimal env-file parser. Kept in-repo so the service has no runtime deps.\n//\n// Supported syntax:\n//   KEY=value                  unquoted, trailing ` # comment` stripped\n//   KEY=\"value\"                double quoted, \\n \\t \\r \\\\ \\\" escapes expanded\n//   KEY='value'                single quoted, taken literally\n//   export KEY=value           the `export ` prefix is ignored\n// Blank lines and lines starting with `#` are skipped. A `#` inside quotes is\n// part of the value, not a comment.\n\nconst KEY = /^[A-Za-z_][A-Za-z0-9_]*$/;\n\nexport function parseEnvFile(text: string): Record<string, string> {\n  const out: Record<string, string> = Object.create(null);\n\n  text.split(/\\r?\\n/).forEach((line, i) => {\n    const lineNo = i + 1;\n    const trimmed = line.trim();\n    if (trimmed === \"\" || trimmed.startsWith(\"#\")) return;\n\n    const eq = line.indexOf(\"=\");\n    if (eq === -1) throw new Error(`line ${lineNo}: expected KEY=value, got: ${trimmed}`);\n\n    let key = line.slice(0, eq).trim();\n    if (key.startsWith(\"export \")) key = key.slice(\"export \".length).trim();\n    if (!KEY.test(key)) throw new Error(`line ${lineNo}: invalid key: ${key}`);\n\n    out[key] = parseValue(line.slice(eq + 1), lineNo);\n  });\n\n  return out;\n}\n\nfunction parseValue(raw: string, lineNo: number): string {\n  const rest = raw.trimStart();\n  const quote = rest[0];\n\n  if (quote !== '\"' && quote !== \"'\") {\n    // Unquoted: a `#` starts a comment only when it begins the value or\n    // follows whitespace, so URLs like host/#frag survive.\n    const comment = rest.search(/(^|\\s)#/);\n    return (comment === -1 ? rest : rest.slice(0, comment)).trim();\n  }\n\n  let value = \"\";\n  for (let i = 1; i < rest.length; i++) {\n    const ch = rest[i];\n    if (ch === \"\\\\\" && quote === '\"') {\n      const next = rest[++i];\n      if (next === undefined) break;\n      value += ESCAPES[next] ?? `\\\\${next}`;\n      continue;\n    }\n    if (ch === quote) {\n      const tail = rest.slice(i + 1).trim();\n      if (tail !== \"\" && !tail.startsWith(\"#\")) {\n        throw new Error(`line ${lineNo}: unexpected text after closing quote: ${tail}`);\n      }\n      return value;\n    }\n    value += ch;\n  }\n\n  throw new Error(`line ${lineNo}: unterminated ${quote === '\"' ? \"double\" : \"single\"} quote`);\n}\n\nconst ESCAPES: Record<string, string> = {\n  n: \"\\n\",\n  r: \"\\r\",\n  t: \"\\t\",\n  \"\\\\\": \"\\\\\",\n  '\"': '\"',\n};\n","file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-868155472/ts-0003-env-parser-dep/2/ws/src/env.ts"},"component":"harness","cwd_rel":".","index_version":null,"tool":"Write","tool_use_id":"toolu_01KHeDWLfhGzukw7tX1X8nrm"},"hash":"sha256:11aebd95fbe665ce9e7c7176b41f2a7d86ef0636c8ece5529c5e7612e9ca3bb7","mono_ns":19000000,"prev":"sha256:371974cb8bfe789e31f1266c29733c7ff219b22a85166709047d0e36cf7dcf86","schema":"saga.trace/1","seq":19,"session":"c0d55f03-6f26-45fa-ab8d-ff984ace64d1","source":"stream-json","ts":"2026-01-01T00:00:00.019Z","turn":1,"type":"tool_call"}
