--- a/test/config.test.ts
+++ b/test/config.test.ts
@@ -1,5 +1,6 @@
 import { test } from "node:test";
 import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
 import { loadConfig } from "../src/config.ts";
 
 test("loads a basic env file", () => {
@@ -8,3 +9,40 @@ test("loads a basic env file", () => {
   assert.equal(cfg.host, "db.internal");
   assert.equal(cfg.debug, true);
 });
+
+test("applies defaults for missing keys", () => {
+  const cfg = loadConfig("");
+  assert.deepEqual(cfg, {
+    port: 8080,
+    host: "127.0.0.1",
+    appName: "order-service",
+    debug: false,
+    motd: "",
+  });
+});
+
+test("keeps quoted values intact", () => {
+  const cfg = loadConfig(`APP_NAME="Order Service"\nMOTD='hello # not a comment'\n`);
+  assert.equal(cfg.appName, "Order Service");
+  assert.equal(cfg.motd, "hello # not a comment");
+});
+
+test("ignores comments and blank lines", () => {
+  const cfg = loadConfig("# leading comment\n\nPORT=3000\n");
+  assert.equal(cfg.port, 3000);
+});
+
+test("loads .env.example", () => {
+  const cfg = loadConfig(readFileSync(new URL("../.env.example", import.meta.url), "utf8"));
+  assert.deepEqual(cfg, {
+    port: 8080,
+    host: "0.0.0.0",
+    appName: "Order Service",
+    debug: false,
+    motd: "hello # not a comment",
+  });
+});
+
+test("rejects a non-numeric PORT", () => {
+  assert.throws(() => loadConfig("PORT=notaport\n"), /invalid PORT/);
+});
