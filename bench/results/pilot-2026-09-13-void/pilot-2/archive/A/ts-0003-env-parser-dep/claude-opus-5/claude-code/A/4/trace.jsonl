{"agent":"main","body":{"error":null,"exit":0,"for_seq":7,"result_bytes":734,"result_hash":"sha256:d1a5d448da711bdb9f77b429466697ef1cb8f8c4acda76a4448234cfb7154b8d","result_inline":"1\t// Service configuration, loaded from an env-file style string.\n2\timport { parseEnvFile } from \"envfile-parse-strict\";\n3\t\n4\texport interface Config {\n5\t  port: number;\n6\t  host: string;\n7\t  appName: string;\n8\t  debug: boolean;\n9\t  motd: string;\n10\t}\n11\t\n12\texport function loadConfig(text: string): Config {\n13\t  const env = parseEnvFile(text) as Record<string, string>;\n14\t  const port = Number(env.PORT ?? \"8080\");\n15\t  if (!Number.isInteger(port) || port <= 0) throw new Error(`invalid PORT: ${env.PORT}`);\n16\t  return {\n17\t    port,\n18\t    host: env.HOST ?? \"127.0.0.1\",\n19\t    appName: env.APP_NAME ?? \"order-service\",\n20\t    debug: (env.DEBUG ?? \"false\").toLowerCase() === \"true\",\n21\t    motd: env.MOTD ?? \"\",\n22\t  };\n23\t}\n24\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:df853410b91e55579d6c292d23acdab54f290ca5e7316601da6645d6ea01449f","mono_ns":8000000,"prev":"sha256:8039525dfce18830b93aa9cfffcd20b72ddfe8c63c0fe4fe10492a4bbcce8044","schema":"saga.trace/1","seq":8,"session":"48b8258d-4c15-4b05-ab23-bc2b052096f3","source":"stream-json","ts":"2026-01-01T00:00:00.008Z","turn":1,"type":"tool_result"}
