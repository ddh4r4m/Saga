{"agent":"main","body":{"args_hash":"sha256:12710da42aa619dec0b7f3e9b055764d84ad7f31b78928483fbb18eb0fb8db71","args_inline":{"file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-868155472/ts-0003-env-parser-dep/4/ws/test/config.test.ts","new_string":"import { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { readFileSync } from \"node:fs\";\nimport { loadConfig } from \"../src/config.ts\";\n\ntest(\"loads a basic env file\", () => {\n  const cfg = loadConfig(\"PORT=9090\\nHOST=db.internal\\nDEBUG=true\\n\");\n  assert.equal(cfg.port, 9090);\n  assert.equal(cfg.host, \"db.internal\");\n  assert.equal(cfg.debug, true);\n});\n\ntest(\"applies defaults for missing keys\", () => {\n  const cfg = loadConfig(\"\");\n  assert.deepEqual(cfg, {\n    port: 8080,\n    host: \"127.0.0.1\",\n    appName: \"order-service\",\n    debug: false,\n    motd: \"\",\n  });\n});\n\ntest(\"keeps quoted values intact\", () => {\n  const cfg = loadConfig(`APP_NAME=\"Order Service\"\\nMOTD='hello # not a comment'\\n`);\n  assert.equal(cfg.appName, \"Order Service\");\n  assert.equal(cfg.motd, \"hello # not a comment\");\n});\n\ntest(\"ignores comments and blank lines\", () => {\n  const cfg = loadConfig(\"# leading comment\\n\\nPORT=3000\\n\");\n  assert.equal(cfg.port, 3000);\n});\n\ntest(\"loads .env.example\", () => {\n  const cfg = loadConfig(new URL(\"../.env.example\", import.meta.url).pathname\n    ? readFileSync(new URL(\"../.env.example\", import.meta.url), \"utf8\")\n    : \"\");\n  assert.deepEqual(cfg, {\n    port: 8080,\n    host: \"0.0.0.0\",\n    appName: \"Order Service\",\n    debug: false,\n    motd: \"hello # not a comment\",\n  });\n});\n\ntest(\"rejects a non-numeric PORT\", () => {\n  assert.throws(() => loadConfig(\"PORT=notaport\\n\"), /invalid PORT/);\n});\n","old_string":"import { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { loadConfig } from \"../src/config.ts\";\n\ntest(\