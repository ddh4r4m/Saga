 import { loadConfig } from "../src/config.ts";
 
 test("loads a basic env file", () => {
@@ -8,3 +9,29 @@ test("loads a basic env file", () => {
   assert.equal(cfg.host, "db.internal");
   assert.equal(cfg.debug, true);
