+// Minimal env-file parser: no dependencies, no network needed to build.
+//
+// Grammar, per line:
+//   - blank lines and lines whose first non-space character is `#` are ignored
+//   - KEY=VALUE, with an optional `export ` prefix
+//   - a value may be double quoted ("..."), single quoted ('...') or bare
+//   - inside double quotes, \n \r \t \\ \" and \$ are unescaped; inside single
+//     quotes everything is literal, so a `#` there stays part of the value
+//   - a bare value ends at an unquoted `#` that follows whitespace, and keeps
+//     no trailing whitespace
+// Anything else (a line with no `=`, a bad key, an unterminated quote) throws,
+// so a typo in a config file fails loudly instead of silently dropping a key.
+
+const KEY = /^[A-Za-z_][A-Za-z0-9_.]*$/;
+
+const ESCAPES: Record<string, string> = {
+  n: "\n",
+  r: "\r",
+  t: "\t",
+  "\\": "\\",
+  '"': '"',
+  $: "$",
+};
+
+export function parseEnvFile(text: string): Record<string, string> {
+  const out: Record<string, string> = {};
+  // Strip a UTF-8 BOM and normalise CRLF so \r never leaks into a value.
+  const src = text.replace(/^\uFEFF/, "").replace(/\r\n?/g, "\n");
+
+  let i = 0;
+  let line = 1;
+  while (i < src.length) {
+    const ch = src[i];
+    if (ch === "\n") {
+      i++;
+      line++;
+      continue;
+    }
+    if (ch === " " || ch === "\t") {
+      i++;
+      continue;
+    }
+    if (ch === "#") {
+      i = endOfLine(src, i);
+      continue;
+    }
+
+    const start = i;
+    i = endOfLine(src, i);
+    const rawKey = src.slice(start, i);
+    const eq = rawKey.indexOf("=");
+    if (eq === -1) throw new Error(`line ${line}: expected KEY=VALUE, got ${JSON.stringify(rawKey.trim())}`);
+
+    let key = rawKey.slice(0, eq).trim();
+    if (key.startsWith("export ")) key = key.slice("export ".length).trim();
+    if (!KEY.test(key)) throw new Error(`line ${line}: invalid key ${JSON.stringify(key)}`);
+
+    // Re-scan the value from the full source: a quoted value may span lines.
+    const valueStart = start + eq + 1;
+    const parsed = readValue(src, valueStart, line);
+    out[key] = parsed.value;
+    i = endOfLine(src, parsed.end);
+    line = parsed.line;
+  }
+  return out;
+}
+
+function endOfLine(src: string, from: number): number {
+  const nl = src.indexOf("\n", from);
+  return nl === -1 ? src.length : nl;
+}
+
+function readValue(src: string, from: number, line: number): { value: string; end: number; line: number } {
+  let i = from;
+  while (src[i] === " " || src[i] === "\t") i++;
+
+  const quote = src[i];
+  if (quote !== '"' && quote !== "'") {
+    const stop = endOfLine(src, i);
+    return { value: stripBare(src.slice(i, stop)), end: stop, line };
+  }
+
+  i++;
+  let value = "";
+  let endLine = line;
+  while (i < src.length) {
+    const ch = src[i];
+    if (ch === quote) return { value, end: i + 1, line: endLine };
+    if (ch === "\n") endLine++;
+    if (ch === "\\" && quote === '"' && i + 1 < src.length) {
+      const next = src[i + 1];
+      value += ESCAPES[next] ?? `\\${next}`;
+      if (next === "\n") endLine++;
+      i += 2;
+      continue;
+    }
+    value += ch;
+    i++;
+  }
+  throw new Error(`line ${line}: unterminated ${quote === '"' ? "double" : "single"} quote`);
+}
+
+// Drop an inline comment (a `#` at the start or after whitespace), then trim.
+function stripBare(raw: string): string {
+  for (let i = 0; i < raw.length; i++) {
+    if (raw[i] !== "#") continue;
+    if (i === 0 || raw[i - 1] === " " || raw[i - 1] === "\t") return raw.slice(0, i).trim();
+  }
+  return raw.trim();
+}
