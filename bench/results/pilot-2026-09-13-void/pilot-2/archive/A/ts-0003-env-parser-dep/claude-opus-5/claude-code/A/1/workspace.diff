+
+test("loads .env.example with quoted values intact", () => {
+  const cfg = loadConfig(readFileSync(new URL("../.env.example", import.meta.url), "utf8"));
+  assert.deepEqual(cfg, {
+    port: 8080,
+    host: "0.0.0.0",
+    appName: "Order Service",
+    debug: false,
+    motd: "hello # not a comment",
+  });
+});
+
+test("falls back to defaults", () => {
+  assert.deepEqual(loadConfig(""), {
+    port: 8080,
+    host: "127.0.0.1",
+    appName: "order-service",
+    debug: false,
+    motd: "",
+  });
+});
+
+test("rejects a bad port", () => {
+  assert.throws(() => loadConfig("PORT=notanumber\n"), /invalid PORT/);
+  assert.throws(() => loadConfig("PORT=0\n"), /invalid PORT/);
+});
diff --git a/test/env.test.ts b/test/env.test.ts
new file mode 100644
index 0000000..9d439f8
--- /dev/null
+++ b/test/env.test.ts
@@ -0,0 +1,52 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { parseEnvFile } from "../src/env.ts";
+
+test("ignores blank lines and comment lines", () => {
+  assert.deepEqual(parseEnvFile("\n# a comment\n\n  # indented\nA=1\n"), { A: "1" });
+});
+
+test("keeps spaces inside double quotes", () => {
+  assert.deepEqual(parseEnvFile('APP_NAME="Order Service"\n'), { APP_NAME: "Order Service" });
+});
+
+test("keeps a hash inside quotes", () => {
+  assert.deepEqual(parseEnvFile("MOTD='hello # not a comment'\n"), { MOTD: "hello # not a comment" });
+  assert.deepEqual(parseEnvFile('MOTD="hello # not a comment"\n'), { MOTD: "hello # not a comment" });
+});
+
+test("strips an inline comment from a bare value", () => {
+  assert.deepEqual(parseEnvFile("PORT=8080 # the http port\n"), { PORT: "8080" });
+  assert.deepEqual(parseEnvFile("URL=http://x/#frag\n"), { URL: "http://x/#frag" });
+});
+
+test("trims whitespace around bare values but not quoted ones", () => {
+  assert.deepEqual(parseEnvFile("A =  spaced out  \nB= ' padded '\n"), { A: "spaced out", B: " padded " });
+});
+
+test("unescapes inside double quotes only", () => {
+  assert.deepEqual(parseEnvFile('A="one\\ntwo\\t\\"q\\""\n'), { A: 'one\ntwo\t"q"' });
+  assert.deepEqual(parseEnvFile("B='one\\ntwo'\n"), { B: "one\\ntwo" });
+});
+
+test("supports export prefix and empty values", () => {
+  assert.deepEqual(parseEnvFile("export A=1\nB=\nC=''\n"), { A: "1", B: "", C: "" });
+});
+
+test("allows a quoted value to span lines", () => {
+  assert.deepEqual(parseEnvFile("KEY=\"line1\nline2\"\nNEXT=ok\n"), { KEY: "line1\nline2", NEXT: "ok" });
+});
+
+test("normalises CRLF", () => {
+  assert.deepEqual(parseEnvFile("A=1\r\nB=2\r\n"), { A: "1", B: "2" });
+});
+
+test("later assignments win", () => {
+  assert.deepEqual(parseEnvFile("A=1\nA=2\n"), { A: "2" });
+});
+
+test("rejects malformed input", () => {
+  assert.throws(() => parseEnvFile("NOT_AN_ASSIGNMENT\n"), /expected KEY=VALUE/);
+  assert.throws(() => parseEnvFile("1BAD=x\n"), /invalid key/);
+  assert.throws(() => parseEnvFile('A="unterminated\n'), /unterminated/);
+});
