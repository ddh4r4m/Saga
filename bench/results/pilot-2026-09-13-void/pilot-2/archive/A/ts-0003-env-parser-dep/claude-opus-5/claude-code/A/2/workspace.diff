diff --git a/src/env.ts b/src/env.ts
new file mode 100644
index 0000000..fd0dda3
--- /dev/null
+++ b/src/env.ts
@@ -0,0 +1,73 @@
+// Minimal env-file parser. Kept in-repo so the service has no runtime deps.
+//
+// Supported syntax:
+//   KEY=value                  unquoted, trailing ` # comment` stripped
+//   KEY="value"                double quoted, \n \t \r \\ \" escapes expanded
+//   KEY='value'                single quoted, taken literally
+//   export KEY=value           the `export ` prefix is ignored
+// Blank lines and lines starting with `#` are skipped. A `#` inside quotes is
+// part of the value, not a comment.
+
+const KEY = /^[A-Za-z_][A-Za-z0-9_]*$/;
+
+export function parseEnvFile(text: string): Record<string, string> {
+  const out: Record<string, string> = Object.create(null);
+
+  text.split(/\r?\n/).forEach((line, i) => {
+    const lineNo = i + 1;
+    const trimmed = line.trim();
+    if (trimmed === "" || trimmed.startsWith("#")) return;
+
+    const eq = line.indexOf("=");
+    if (eq === -1) throw new Error(`line ${lineNo}: expected KEY=value, got: ${trimmed}`);
+
+    let key = line.slice(0, eq).trim();
+    if (key.startsWith("export ")) key = key.slice("export ".length).trim();
+    if (!KEY.test(key)) throw new Error(`line ${lineNo}: invalid key: ${key}`);
+
+    out[key] = parseValue(line.slice(eq + 1), lineNo);
+  });
+
+  return out;
+}
+
+function parseValue(raw: string, lineNo: number): string {
+  const rest = raw.trimStart();
+  const quote = rest[0];
+
+  if (quote !== '"' && quote !== "'") {
+    // Unquoted: a `#` starts a comment only when it begins the value or
+    // follows whitespace, so URLs like host/#frag survive.
+    const comment = rest.search(/(^|\s)#/);
+    return (comment === -1 ? rest : rest.slice(0, comment)).trim();
+  }
+
+  let value = "";
+  for (let i = 1; i < rest.length; i++) {
+    const ch = rest[i];
+    if (ch === "\\" && quote === '"') {
+      const next = rest[++i];
+      if (next === undefined) break;
+      value += ESCAPES[next] ?? `\\${next}`;
+      continue;
+    }
+    if (ch === quote) {
+      const tail = rest.slice(i + 1).trim();
+      if (tail !== "" && !tail.startsWith("#")) {
+        throw new Error(`line ${lineNo}: unexpected text after closing quote: ${tail}`);
+      }
+      return value;
+    }
+    value += ch;
+  }
+
+  throw new Error(`line ${lineNo}: unterminated ${quote === '"' ? "double" : "single"} quote`);
+}
+
+const ESCAPES: Record<string, string> = {
+  n: "\n",
+  r: "\r",
+  t: "\t",
+  "\\": "\\",
+  '"': '"',
+};
