diff --git a/test/env.test.ts b/test/env.test.ts
new file mode 100644
index 0000000..06cb3c9
--- /dev/null
+++ b/test/env.test.ts
@@ -0,0 +1,38 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { parseEnvFile } from "../src/env.ts";
+
+test("keeps quoted values intact, quotes stripped", () => {
+  const env = parseEnvFile('APP_NAME="Order Service"\nMOTD=\'hello # not a comment\'\n');
+  assert.equal(env.APP_NAME, "Order Service");
+  assert.equal(env.MOTD, "hello # not a comment");
+});
+
+test("strips comments outside quotes", () => {
+  const env = parseEnvFile('# header\nPORT=8080 # inline\nAPP_NAME="a # b" # after\n');
+  assert.deepEqual({ ...env }, { PORT: "8080", APP_NAME: "a # b" });
+});
+
+test("handles blank lines, whitespace and export prefix", () => {
+  const env = parseEnvFile("\n  \nexport HOST = db.internal  \n");
+  assert.equal(env.HOST, "db.internal");
+});
+
+test("expands escapes in double quotes but not single quotes", () => {
+  const env = parseEnvFile('A="one\\ntwo"\nB=\'one\\ntwo\'\nC="say \\"hi\\""\n');
+  assert.equal(env.A, "one\ntwo");
+  assert.equal(env.B, "one\\ntwo");
+  assert.equal(env.C, 'say "hi"');
+});
+
+test("empty and equals-containing values", () => {
+  const env = parseEnvFile("EMPTY=\nURL=postgres://u:p@h/db?a=1\n");
+  assert.equal(env.EMPTY, "");
+  assert.equal(env.URL, "postgres://u:p@h/db?a=1");
+});
+
+test("rejects malformed lines", () => {
+  assert.throws(() => parseEnvFile("NOT_AN_ASSIGNMENT\n"), /expected KEY=value/);
+  assert.throws(() => parseEnvFile('A="unterminated\n'), /unterminated double quote/);
+  assert.throws(() => parseEnvFile("1BAD=x\n"), /invalid key/);
+});
