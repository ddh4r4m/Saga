{"agent":"main","body":{"args_hash":"sha256:1a8595d0c129dbffbda9ccf67106d0b93daca389ccfedbf2eb7798b5d6f75141","args_inline":{"file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-868155472/ts-0003-env-parser-dep/3/ws/test/config.test.ts","new_string":"  assert.equal(cfg.debug, true);\n});\n\ntest(\"loads .env.example as shipped\", () => {\n  const cfg = loadConfig(readFileSync(new URL(\"../.env.example\", import.meta.url), \"utf8\"));\n  assert.deepEqual(cfg, {\n    port: 8080,\n    host: \"0.0.0.0\",\n    appName: \"Order Service\",\n    debug: false,\n    motd: \"hello # not a comment\",\n  });\n});\n\ntest(\"falls back to defaults for missing keys\", () => {\n  assert.deepEqual(loadConfig(\"\"), {\n    port: 8080,\n    host: \"127.0.0.1\",\n    appName: \"order-service\",\n    debug: false,\n    motd: \"\",\n  });\n});\n\ntest(\"rejects a non-numeric PORT\", () => {\n  assert.throws(() => loadConfig(\"PORT=eighty\\n\"), /invalid PORT/);\n});\n","old_string":"  assert.equal(cfg.debug, true);\n});\n","replace_all":false},"component":"harness","cwd_rel":".","index_version":null,"tool":"Edit","tool_use_id":"toolu_0192e6snaVZdxDUNxTDibGoG"},"hash":"sha256:c865b742c9cceed0953f6b778bd4c3f50a2112a59c8b7ce74922b1f0b11bea7b","mono_ns":35000000,"prev":"sha256:8210fd49c9bc33b7230453a45ae62521184b37a893600ce922fc3004c215d37f","schema":"saga.trace/1","seq":35,"session":"4eb95206-09e9-48c2-85ee-337a33ef73cd","source":"stream-json","ts":"2026-01-01T00:00:00.035Z","turn":1,"type":"tool_call"}
