{"agent":"main","body":{"args_hash":"sha256:5d5ad5729ff7027b7496eae619f2a8a930f02b761c35e2c52b0f66ad0656e3cb","args_inline":{"content":"// Minimal env-file parser. No dependencies: the build box has no network.\n//\n// Supported per line:\n//   KEY=value                 unquoted, trimmed, `#` starts a comment\n//   KEY=\"value\"               double quoted, \\n \\r \\t \\\\ \\\" escapes honoured\n//   KEY='value'               single quoted, taken literally\n//   export KEY=value          the `export ` prefix is ignored\n// Blank lines and lines whose first non-blank character is `#` are skipped.\n// Anything else is rejected, so a typo fails loudly instead of silently\n// producing a missing key.\n\nconst KEY_RE = /^[A-Za-z_][A-Za-z0-9_]*$/;\n\nconst ESCAPES: Record<string, string> = {\n  n: \"\\n\",\n  r: \"\\r\",\n  t: \"\\t\",\n  \"\\\\\": \"\\\\\",\n  '\"': '\"',\n};\n\nexport function parseEnvFile(text: string): Record<string, string> {\n  const out: Record<string, string> = {};\n\n  text.split(/\\r?\\n/).forEach((rawLine, i) => {\n    const line = rawLine.trim();\n    if (line === \"\" || line.startsWith(\"#\")) return;\n\n    const lineNo = i + 1;\n    const eq = line.indexOf(\"=\");\n    if (eq === -1) throw new Error(`line ${lineNo}: expected KEY=value, got ${JSON.stringify(rawLine)}`);\n\n    const key = line.slice(0, eq).trim().replace(/^export\\s+/, \"\");\n    if (!KEY_RE.test(key)) throw new Error(`line ${lineNo}: invalid key ${JSON.stringify(key)}`);\n\n    out[key] = parseValue(line.slice(eq + 1).trim(), lineNo);\n  });\n\n  return out;\n}\n\nfunction parseValue(raw: string, lineNo: number): string {\n  const quote = raw[0];\n  if (quote !== '\"' && quote !== \"'\") {\n    // Unquoted: a `#` at the start or after whitespace begins a comment.\n    return raw.replace(/(^|\\s)#.*$/, \"$1\").trimEnd();\n  }\n\n  let value = \"\";\n  for (let i = 1; i < raw.length; i++) {\n    const ch = raw[i];\n\n    if (quote === '\"' && ch === \"\\\\\") {\n      const next = raw[++i];\n      // An unknown escape keeps both characters rather than dropping the backslash.\n      value += next === undefined ? \"\\\\\" : (ESCAPES[next] ?? \"\\\\\" + next);\n      continue;\n    }\n\n    if (ch === quote) {\n      const rest = raw.slice(i + 1).trim();\n      if (rest !== \"\" && !rest.startsWith(\"#\")) {\n        throw new Error(`line ${lineNo}: unexpected text after closing quote: ${JSON.stringify(rest)}`);\n      }\n      return value;\n    }\n\n    value += ch;\n  }\n\n  throw new Error(`line ${lineNo}: unterminated ${quote === '\"' ? \"double\" : \"single\"} quote`);\n}\n","file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-868155472/ts-0003-env-parser-dep/3/ws/src/env.ts"},"component":"harness","cwd_rel":".","index_version":null,"tool":"Write","tool_use_id":"toolu_01EnKLHTTVesSPHu5XmRebN7"},"hash":"sha256:ec79662c5ece52853ff6d9e07a48e5e927ec22d1904ccf861b91e0ecaa81e659","mono_ns":21000000,"prev":"sha256:6c5419ad22dde3243538c21ffa047982bffd510b727d62deace39c244277ae5f","schema":"saga.trace/1","seq":21,"session":"4eb95206-09e9-48c2-85ee-337a33ef73cd","source":"stream-json","ts":"2026-01-01T00:00:00.021Z","turn":1,"type":"tool_call"}
