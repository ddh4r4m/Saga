diff --git a/src/env.ts b/src/env.ts
new file mode 100644
index 0000000..c7d6926
--- /dev/null
+++ b/src/env.ts
@@ -0,0 +1,72 @@
+// Minimal env-file parser. No dependencies: the build box has no network.
+//
+// Supported per line:
+//   KEY=value                 unquoted, trimmed, `#` starts a comment
+//   KEY="value"               double quoted, \n \r \t \\ \" escapes honoured
+//   KEY='value'               single quoted, taken literally
+//   export KEY=value          the `export ` prefix is ignored
+// Blank lines and lines whose first non-blank character is `#` are skipped.
+// Anything else is rejected, so a typo fails loudly instead of silently
+// producing a missing key.
+
+const KEY_RE = /^[A-Za-z_][A-Za-z0-9_]*$/;
+
+const ESCAPES: Record<string, string> = {
+  n: "\n",
+  r: "\r",
+  t: "\t",
+  "\\": "\\",
+  '"': '"',
+};
+
+export function parseEnvFile(text: string): Record<string, string> {
+  const out: Record<string, string> = {};
+
+  text.split(/\r?\n/).forEach((rawLine, i) => {
+    const line = rawLine.trim();
+    if (line === "" || line.startsWith("#")) return;
+
+    const lineNo = i + 1;
+    const eq = line.indexOf("=");
+    if (eq === -1) throw new Error(`line ${lineNo}: expected KEY=value, got ${JSON.stringify(rawLine)}`);
+
+    const key = line.slice(0, eq).trim().replace(/^export\s+/, "");
+    if (!KEY_RE.test(key)) throw new Error(`line ${lineNo}: invalid key ${JSON.stringify(key)}`);
+
+    out[key] = parseValue(line.slice(eq + 1).trim(), lineNo);
+  });
+
+  return out;
+}
+
+function parseValue(raw: string, lineNo: number): string {
+  const quote = raw[0];
+  if (quote !== '"' && quote !== "'") {
+    // Unquoted: a `#` at the start or after whitespace begins a comment.
+    return raw.replace(/(^|\s)#.*$/, "$1").trimEnd();
+  }
+
+  let value = "";
+  for (let i = 1; i < raw.length; i++) {
+    const ch = raw[i];
+
+    if (quote === '"' && ch === "\\") {
+      const next = raw[++i];
+      // An unknown escape keeps both characters rather than dropping the backslash.
+      value += next === undefined ? "\\" : (ESCAPES[next] ?? "\\" + next);
+      continue;
+    }
+
+    if (ch === quote) {
+      const rest = raw.slice(i + 1).trim();
+      if (rest !== "" && !rest.startsWith("#")) {
+        throw new Error(`line ${lineNo}: unexpected text after closing quote: ${JSON.stringify(rest)}`);
+      }
+      return value;
+    }
+
+    value += ch;
+  }
+
+  throw new Error(`line ${lineNo}: unterminated ${quote === '"' ? "double" : "single"} quote`);
+}
