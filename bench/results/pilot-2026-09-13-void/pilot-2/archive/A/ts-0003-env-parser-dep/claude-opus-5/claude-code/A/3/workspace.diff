diff --git a/test/env.test.ts b/test/env.test.ts
new file mode 100644
index 0000000..4af96ae
--- /dev/null
+++ b/test/env.test.ts
@@ -0,0 +1,41 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { parseEnvFile } from "../src/env.ts";
+
+test("keeps quoted values intact, quotes stripped", () => {
+  const env = parseEnvFile(`APP_NAME="Order Service"\nMOTD='hello # not a comment'\n`);
+  assert.equal(env.APP_NAME, "Order Service");
+  assert.equal(env.MOTD, "hello # not a comment");
+});
+
+test("a hash survives inside double quotes too", () => {
+  assert.equal(parseEnvFile('MOTD="hi # there"\n').MOTD, "hi # there");
+});
+
+test("strips comments outside quotes", () => {
+  const env = parseEnvFile(`# leading comment\nPORT=8080 # inline\nHOST="0.0.0.0" # after quotes\n`);
+  assert.equal(env.PORT, "8080");
+  assert.equal(env.HOST, "0.0.0.0");
+});
+
+test("handles blank lines, export prefix and empty values", () => {
+  const env = parseEnvFile(`\nexport HOST=db.internal\n\nAPP_NAME=\n`);
+  assert.equal(env.HOST, "db.internal");
+  assert.equal(env.APP_NAME, "");
+});
+
+test("honours escapes in double quotes but not single quotes", () => {
+  assert.equal(parseEnvFile('MOTD="a\\nb"\n').MOTD, "a\nb");
+  assert.equal(parseEnvFile("MOTD='a\\nb'\n").MOTD, "a\\nb");
+});
+
+test("a `#` glued to an unquoted value is not a comment", () => {
+  assert.equal(parseEnvFile("MOTD=red#1\n").MOTD, "red#1");
+});
+
+test("rejects malformed lines", () => {
+  assert.throws(() => parseEnvFile("PORT 8080\n"), /expected KEY=value/);
+  assert.throws(() => parseEnvFile("2FA=yes\n"), /invalid key/);
+  assert.throws(() => parseEnvFile('APP_NAME="Order Service\n'), /unterminated/);
+  assert.throws(() => parseEnvFile('APP_NAME="Order" Service\n'), /after closing quote/);
+});
