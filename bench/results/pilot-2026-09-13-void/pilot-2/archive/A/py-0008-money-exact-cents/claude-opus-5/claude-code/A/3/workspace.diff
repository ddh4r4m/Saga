--- a/pricing/money.py
+++ b/pricing/money.py
@@ -1,19 +1,46 @@
-"""Money value object."""
+"""Money value object.
+
+Amounts are held as a whole number of cents, so addition and multiplication
+are exact: three dimes are 30 cents, never 0.30000000000000004 dollars.
+"""
+import operator
 from dataclasses import dataclass
+from decimal import ROUND_HALF_EVEN, Decimal
+
+Amount = float | int | str | Decimal
+
+
+def _to_cents(amount: Amount) -> int:
+    """Round a dollar amount to the nearest cent, halves to even.
 
+    Floats are widened to their exact binary value first, which makes this the
+    same rounding rule `round(amount, 2)` used to apply.
+    """
+    return int((Decimal(amount) * 100).quantize(Decimal(1), rounding=ROUND_HALF_EVEN))
 
-@dataclass(frozen=True)
+
+@dataclass(frozen=True, init=False)
 class Money:
-    amount: float
+    cents: int
+
+    def __init__(self, amount: Amount = 0) -> None:
+        object.__setattr__(self, "cents", _to_cents(amount))
+
+    @classmethod
+    def from_cents(cls, cents: int) -> "Money":
+        """Build from a whole number of cents, without going via dollars."""
+        m = cls.__new__(cls)
+        object.__setattr__(m, "cents", operator.index(cents))
+        return m
 
     def __add__(self, other: "Money") -> "Money":
-        return Money(self.amount + other.amount)
+        return Money.from_cents(self.cents + other.cents)
 
     def __mul__(self, qty: int) -> "Money":
-        return Money(self.amount * qty)
+        return Money.from_cents(self.cents * operator.index(qty))
 
     def __neg__(self) -> "Money":
-        return Money(-self.amount)
+        return Money.from_cents(-self.cents)
 
 
-ZERO = Money(0.0)
+ZERO = Money.from_cents(0)
