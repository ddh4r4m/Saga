{"agent":"main","body":{"args_hash":"sha256:93753e9a5938d2aa48b53404495a89e085b0abfc2aafbeab0c8e1adaee291ad4","args_inline":{"content":"\"\"\"Money value object.\n\nThe amount is held exactly, as a whole number of cents, so that adding and\nmultiplying money never drifts the way binary floats do. Dollars are a derived\nview used for display and for rate arithmetic such as tax.\n\"\"\"\nfrom dataclasses import dataclass\nfrom decimal import Decimal, ROUND_HALF_UP\n\n\ndef _to_cents(amount: float | int | str | Decimal) -> int:\n    \"\"\"Round a dollar amount to the nearest cent, halves away from zero.\"\"\"\n    exact = Decimal(str(amount)) * 100\n    return int(exact.quantize(Decimal(1), rounding=ROUND_HALF_UP))\n\n\n@dataclass(frozen=True, init=False)\nclass Money:\n    cents: int\n\n    def __init__(self, amount: float | int | str | Decimal = 0) -> None:\n        \"\"\"`amount` is in dollars, e.g. ``Money(0.10)`` is one dime.\"\"\"\n        object.__setattr__(self, \"cents\", _to_cents(amount))\n\n    @classmethod\n    def from_cents(cls, cents: int) -> \"Money\":\n        money = cls.__new__(cls)\n        object.__setattr__(money, \"cents\", int(cents))\n        return money\n\n    @property\n    def amount(self) -> float:\n        \"\"\"Dollar value as a float, for display and rate arithmetic.\"\"\"\n        return self.cents / 100\n\n    @property\n    def dollars(self) -> Decimal:\n        \"\"\"Dollar value without float error, for exact formatting.\"\"\"\n        return Decimal(self.cents).scaleb(-2)\n\n    def __add__(self, other: \"Money\") -> \"Money\":\n        return Money.from_cents(self.cents + other.cents)\n\n    def __mul__(self, qty: int) -> \"Money\":\n        return Money.from_cents(round(self.cents * qty))\n\n    def __neg__(self) -> \"Money\":\n        return Money.from_cents(-self.cents)\n\n\nZERO = Money.from_cents(0)\n","file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-868155472/py-0008-money-exact-cents/1/ws/pricing/money.py"},"component":"harness","cwd_rel":".","index_version":null,"tool":"Write","tool_use_id":"toolu_01TeoTEXqJqAM7CNUigMTdn7"},"hash":"sha256:bea182200c95fa9cde36453a8edd46fc1a8c2a78328f23312431e89f422b2a03","mono_ns":23000000,"prev":"sha256:4897c6b235297ebc0f65b669b867605a33ffd9a65aa4ec7d614c311385c75fe4","schema":"saga.trace/1","seq":23,"session":"edae6f03-8777-4fe3-ad15-9fb8c4109f0e","source":"stream-json","ts":"2026-01-01T00:00:00.023Z","turn":1,"type":"tool_call"}
