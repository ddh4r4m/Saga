diff --git a/pricing/money.py b/pricing/money.py
index f586e26..9c766d9 100644
--- a/pricing/money.py
+++ b/pricing/money.py
@@ -1,19 +1,48 @@
 """Money value object."""
 from dataclasses import dataclass
+from decimal import Decimal
 
 
-@dataclass(frozen=True)
+@dataclass(frozen=True, init=False)
 class Money:
-    amount: float
+    """A monetary amount held exactly, as a whole number of cents.
+
+    Built from a decimal amount (``Money(0.10)``) so callers keep speaking in
+    dollars, but arithmetic and equality run on the integer ``cents``.
+    """
+
+    cents: int
+
+    def __init__(self, amount: float | int | str | Decimal = 0) -> None:
+        # round() on the dollar amount first, so an amount given to sub-cent
+        # precision lands on the same cent it always has; str() then converts
+        # that 2dp value to cents without picking up any binary error.
+        dollars = Decimal(str(round(float(amount), 2)))
+        object.__setattr__(self, "cents", int(dollars.scaleb(2)))
+
+    @classmethod
+    def from_cents(cls, cents: int) -> "Money":
+        money = cls.__new__(cls)
+        object.__setattr__(money, "cents", int(cents))
+        return money
+
+    @property
+    def amount(self) -> float:
+        """The amount in dollars, for callers that need a float."""
+        return self.cents / 100
+
+    def as_decimal(self) -> Decimal:
+        """The amount in dollars, exact and always scaled to the cent."""
+        return Decimal(self.cents).scaleb(-2)
 
     def __add__(self, other: "Money") -> "Money":
-        return Money(self.amount + other.amount)
+        return Money.from_cents(self.cents + other.cents)
 
     def __mul__(self, qty: int) -> "Money":
-        return Money(self.amount * qty)
+        return Money.from_cents(self.cents * qty)
 
     def __neg__(self) -> "Money":
-        return Money(-self.amount)
+        return Money.from_cents(-self.cents)
 
 
 ZERO = Money(0.0)
