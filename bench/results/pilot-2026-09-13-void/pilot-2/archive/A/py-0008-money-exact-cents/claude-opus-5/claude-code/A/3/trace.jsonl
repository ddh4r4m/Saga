{"agent":"main","body":{"args_hash":"sha256:cb015f1fb7f879e0fd2e866bfa0b3adacc8dd9415018a23a74cce8f4c6938069","args_inline":{"command":"python3 - <<'PY'\nimport random\nfrom decimal import Decimal\nfrom pricing.money import Money, ZERO\nfrom pricing.cart import cart_total, line_total\nfrom pricing.format import format_money, format_amount\nfrom pricing.tax import apply_tax\nfrom pricing.report import to_csv\n\nrandom.seed(7)\n# 1. display format matches the OLD float formatter for every representable-cent value\nbad = []\nfor _ in range(200000):\n    c = random.randint(-10**9, 10**9)\n    m = Money.from_cents(c)\n    a = c / 100\n    old = f\"{'-' if a < 0 else ''}${abs(a):,.2f}\"\n    if format_money(m) != old:\n        bad.append((c, format_money(m), old))\nprint(\"display mismatches:\", len(bad), bad[:3])\n\n# 2. tax matches old float pipeline exactly\nbad = []\nfor _ in range(200000):\n    c = random.randint(-10**7, 10**7)\n    rate = random.choice([0.0, 0.05, 0.0825, 0.07, 0.1, 0.19, 0.155, random.random()])\n    new = apply_tax(Money.from_cents(c), rate)\n    old = round(c / 100 * (1 + rate), 2)          # old amount arithmetic\n    if new.cents != round(Decimal(old) * 100):\n        bad.append((c, rate, new.cents, old))\nprint(\"tax mismatches:\", len(bad), bad[:3])\n\n# 3. drift is gone: cents stay integral, totals exact\nt = cart_total([(\"widget\", Money(0.10), 3)])\nprint(\"three dimes:\", t, t == Money(0.30), format_money(t), format_amount(t))\nbig = cart_total([(\"w\", Money(0.10), 1)] * 30000)\nprint(\"30k dimes exact:\", big == Money(3000.00), big.cents, type(big.cents).__name__)\nprint(\"0.1+0.2==0.3:\", Money(0.10) + Money(0.20) == Money(0.30))\nprint(\"all int:\", all(isinstance(x.cents, int) for x in [ZERO, t, big, -t, apply_tax(t, .0825)]))\n\n# 4. CSV layout unchanged (header, ordering, plain 2-dp numbers, negatives)\nprint(repr(to_csv([(\"widget\", Money(0.10), 3), (\"gadget\", Money(19.99), 2),\n                   (\"refund\", -Money(5.00), 1), (\"free\", Money(0), 0),\n                   (\"bulk\", Money(1234.56), 1000)])))\n\n# 5. value-object semantics preserved\nprint(\"eq/hash/frozen:\", Money(1.00) == Money(1.0), len({Money(1.0), Money(1.00), Money(2.0)}),\n      ZERO == Money(0.0), format_money(-Money(0.30)))\ntry:\n    Money(1.0).cents = 5\nexcept Exception as e:\n    print(\"immutable:\", type(e).__name__)\n# alt constructors\nprint(Money(\"0.10\").cents, Money(Decimal(\"19.99\")).cents, Money(5).cents, Money.from_cents(30).cents)\ntry:\n    line_total(Money(1.0), -1)\nexcept ValueError as e:\n    print(\"neg qty still raises:\", e)\nPY","description":"Randomized equivalence and exactness verification"},"component":"harness","cwd_rel":".","index_version":null,"tool":"Bash","tool_use_id":"toolu_01DfTQTNjPZwM93TiNyoZ4h5"},"hash":"sha256:f63603d58abf19b1c815d758c275b66942bceaaec6dd87094840348f5b4de2c1","mono_ns":37000000,"prev":"sha256:ad4c9c78d53b0fb10afa6b57b1c7778f05673ae95e78d7d8dbb1a57ca7a8abb9","schema":"saga.trace/1","seq":37,"session":"e5f89003-5bd1-404e-8c63-f4769a75cbf1","source":"stream-json","ts":"2026-01-01T00:00:00.037Z","turn":1,"type":"tool_call"}
