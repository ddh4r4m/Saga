{"agent":"main","body":{"args_hash":"sha256:f4a0f60fde1f87b34701f19ca8a6c09d27164b2ee026575913addfc9223e5c87","args_inline":{"content":"\"\"\"Money value object.\n\nAmounts are held as a whole number of cents, so addition and multiplication\nare exact: three dimes are 30 cents, never 0.30000000000000004 dollars.\n\"\"\"\nimport operator\nfrom dataclasses import dataclass\nfrom decimal import ROUND_HALF_EVEN, Decimal\n\nAmount = float | int | str | Decimal\n\n\ndef _to_cents(amount: Amount) -> int:\n    \"\"\"Round a dollar amount to the nearest cent, halves to even.\n\n    Floats are widened to their exact binary value first, which makes this the\n    same rounding rule `round(amount, 2)` used to apply.\n    \"\"\"\n    return int((Decimal(amount) * 100).quantize(Decimal(1), rounding=ROUND_HALF_EVEN))\n\n\n@dataclass(frozen=True, init=False)\nclass Money:\n    cents: int\n\n    def __init__(self, amount: Amount = 0) -> None:\n        object.__setattr__(self, \"cents\", _to_cents(amount))\n\n    @classmethod\n    def from_cents(cls, cents: int) -> \"Money\":\n        \"\"\"Build from a whole number of cents, without going via dollars.\"\"\"\n        m = cls.__new__(cls)\n        object.__setattr__(m, \"cents\", operator.index(cents))\n        return m\n\n    def __add__(self, other: \"Money\") -> \"Money\":\n        return Money.from_cents(self.cents + other.cents)\n\n    def __mul__(self, qty: int) -> \"Money\":\n        return Money.from_cents(self.cents * operator.index(qty))\n\n    def __neg__(self) -> \"Money\":\n        return Money.from_cents(-self.cents)\n\n\nZERO = Money.from_cents(0)\n","file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-868155472/py-0008-money-exact-cents/3/ws/pricing/money.py"},"component":"harness","cwd_rel":".","index_version":null,"tool":"Write","tool_use_id":"toolu_01UY4ERghhPpJdAXvKbKSAaT"},"hash":"sha256:694d40b85875a6046f9934a141f7c981e884e260baf8d2f42e150af2a4e20ea2","mono_ns":27000000,"prev":"sha256:9827a9733c5c29f58ceef8079467665612b0e61b2f7f63666b40fea58e97a898","schema":"saga.trace/1","seq":27,"session":"e5f89003-5bd1-404e-8c63-f4769a75cbf1","source":"stream-json","ts":"2026-01-01T00:00:00.027Z","turn":1,"type":"tool_call"}
