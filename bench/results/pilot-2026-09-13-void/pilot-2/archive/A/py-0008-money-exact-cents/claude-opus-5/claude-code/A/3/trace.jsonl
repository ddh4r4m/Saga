{"agent":"main","body":{"error":null,"exit":0,"for_seq":5,"result_bytes":443,"result_hash":"sha256:139de9157962704d4d4c4a5d7947fbe5c30faf729dbfb1f0090b77fc7cc404e8","result_inline":"1\t\"\"\"Money value object.\"\"\"\n2\tfrom dataclasses import dataclass\n3\t\n4\t\n5\t@dataclass(frozen=True)\n6\tclass Money:\n7\t    amount: float\n8\t\n9\t    def __add__(self, other: \"Money\") -> \"Money\":\n10\t        return Money(self.amount + other.amount)\n11\t\n12\t    def __mul__(self, qty: int) -> \"Money\":\n13\t        return Money(self.amount * qty)\n14\t\n15\t    def __neg__(self) -> \"Money\":\n16\t        return Money(-self.amount)\n17\t\n18\t\n19\tZERO = Money(0.0)\n20\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:7838cabe06ed5f6df688029ecd5e5a1f43408bce4b5929e7baf143bacf285973","mono_ns":6000000,"prev":"sha256:0378142836e9e58dee8199b3aa4c74b874054a324e7f3e9adcd111de8ddbfac3","schema":"saga.trace/1","seq":6,"session":"e5f89003-5bd1-404e-8c63-f4769a75cbf1","source":"stream-json","ts":"2026-01-01T00:00:00.006Z","turn":1,"type":"tool_result"}
