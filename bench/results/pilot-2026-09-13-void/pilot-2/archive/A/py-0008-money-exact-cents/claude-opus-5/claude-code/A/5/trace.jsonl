{"agent":"main","body":{"args_hash":"sha256:8b528305d766b2b5040e3bdb088418f9c04e80e7bd4e69ebfe202d1ff4bf99e0","args_inline":{"content":"\"\"\"Money value object.\"\"\"\nfrom decimal import Decimal, ROUND_HALF_UP\n\n_CENT = Decimal(\"0.01\")\n\n\ndef _to_cents(amount: float | int | str | Decimal) -> int:\n    \"\"\"Convert an amount in currency units to whole cents.\"\"\"\n    if isinstance(amount, float):\n        # str() gives the shortest representation that round-trips, so the\n        # binary drift in e.g. 0.30000000000000004 does not survive the trip.\n        amount = str(amount)\n    return int(Decimal(amount).quantize(_CENT, rounding=ROUND_HALF_UP) * 100)\n\n\nclass Money:\n    \"\"\"An amount of money, stored exactly as a whole number of cents.\n\n    The constructor takes currency units (``Money(0.10)`` is ten cents) and\n    rounds them to the nearest cent; use :meth:`from_cents` when the value is\n    already in cents.\n    \"\"\"\n\n    __slots__ = (\"cents\",)\n\n    cents: int\n\n    def __init__(self, amount: float | int | str | Decimal) -> None:\n        object.__setattr__(self, \"cents\", _to_cents(amount))\n\n    @classmethod\n    def from_cents(cls, cents: int) -> \"Money\":\n        money = cls.__new__(cls)\n        object.__setattr__(money, \"cents\", int(cents))\n        return money\n\n    @property\n    def amount(self) -> float:\n        \"\"\"The value in currency units.\"\"\"\n        return self.cents / 100\n\n    def as_decimal(self) -> Decimal:\n        \"\"\"The exact value in currency units, to the cent.\"\"\"\n        return Decimal(self.cents).scaleb(-2)\n\n    def __add__(self, other: \"Money\") -> \"Money\":\n        return Money.from_cents(self.cents + other.cents)\n\n    def __mul__(self, qty: int) -> \"Money\":\n        return Money.from_cents(self.cents * qty)\n\n    def __neg__(self) -> \"Money\":\n        return Money.from_cents(-self.cents)\n\n    def __eq__(self, other: object) -> bool:\n        if not isinstance(other, Money):\n            return NotImplemented\n        return self.cents == other.cents\n\n    def __hash__(self) -> int:\n        return hash((Money, self.cents))\n\n    def __repr__(self) -> str:\n        return f\"Money({self.as_decimal()})\"\n\n    def __setattr__(self, name: str, value: object) -> None:\n        raise AttributeError(f\"cannot assign to field {name!r}\")\n\n    def __delattr__(self, name: str) -> None:\n        raise AttributeError(f\"cannot delete field {name!r}\")\n\n\nZERO = Money.from_cents(0)\n","file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-868155472/py-0008-money-exact-cents/5/ws/pricing/money.py"},"component":"harness","cwd_rel":".","index_version":null,"tool":"Write","tool_use_id":"toolu_01HE9yh5RhzRkER5PFSmmcuB"},"hash":"sha256:0c3e68390692f16814855e76e638598cc7c430b845ca7591da9f92aaf9426574","mono_ns":27000000,"prev":"sha256:609a07aaa8be059f53bdb62f1b841e8fb2b786cb8bca1456ac5481cd2998cca2","schema":"saga.trace/1","seq":27,"session":"4b762182-bade-4b47-810e-915e8f81c3fd","source":"stream-json","ts":"2026-01-01T00:00:00.027Z","turn":1,"type":"tool_call"}
