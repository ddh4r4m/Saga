{"agent":"main","body":{"args_hash":"sha256:a76d23d0d026cc3e4c410f3ee69785cfbf559d99abe248d3209f445f1054ca02","args_inline":{"command":"python3 - <<'PY'\nfrom pricing.money import Money, ZERO\nfrom pricing.cart import cart_total, line_total\nfrom pricing.tax import apply_tax\nfrom pricing.format import format_money\nfrom pricing.report import to_csv\n\nlines=[(\"widget\",Money(0.10),3),(\"gadget\",Money(1234.5),2),(\"refund\",Money(-0.05),1),(\"free\",Money(0),4)]\nprint(repr(cart_total(lines)), cart_total(lines).amount)\nprint(to_csv(lines))\nfor v in [0, 0.05, -0.05, 1, 1.5, 1234567.89, -1234567.89, 0.30000000000000004]:\n    print(v, format_money(Money(v)), Money(v).cents)\n# tax parity vs old float behaviour\nfor sub, rate in [(0.30,0.0825),(19.99,0.07),(100,0.0),(0.10,0.5),(1.045,0.0),(2.675,0.0)]:\n    new = apply_tax(Money(sub), rate)\n    old = round(sub*(1+rate), 2)\n    print(sub, rate, new.amount, old, new.amount==old)\nprint(Money(0.1)+Money(0.2)==Money(0.3), sum([Money(0.1)]*10, ZERO)==Money(1.0))\nprint(-Money(0.05), line_total(Money(0.10),0), {Money(0.3), Money(0.30)})\ntry: Money(1).cents = 5\nexcept AttributeError as e: print(\"immutable:\", e)\ntry: line_total(Money(1), -1)\nexcept ValueError as e: print(\"qty guard:\", e)\nPY"},"component":"harness","cwd_rel":".","index_version":null,"tool":"Bash","tool_use_id":"toolu_016pe95XnBLFNYZ8PF318NnJ"},"hash":"sha256:e686e15bc30ea025cecce6a0a10bc8ec024c09f8c490d63b0fdd4ba00178ac69","mono_ns":35000000,"prev":"sha256:ac3eb1ab829ab164744b19e2c6fe4449088e6f786d08d19b041335ff4fe90e28","schema":"saga.trace/1","seq":35,"session":"4b762182-bade-4b47-810e-915e8f81c3fd","source":"stream-json","ts":"2026-01-01T00:00:00.035Z","turn":1,"type":"tool_call"}
