{"agent":"main","body":{"error":null,"exit":0,"for_seq":7,"result_bytes":443,"result_hash":"sha256:139de9157962704d4d4c4a5d7947fbe5c30faf729dbfb1f0090b77fc7cc404e8","result_inline":"1\t\"\"\"Money value object.\"\"\"\n2\tfrom dataclasses import dataclass\n3\t\n4\t\n5\t@dataclass(frozen=True)\n6\tclass Money:\n7\t    amount: float\n8\t\n9\t    def __add__(self, other: \"Money\") -> \"Money\":\n10\t        return Money(self.amount + other.amount)\n11\t\n12\t    def __mul__(self, qty: int) -> \"Money\":\n13\t        return Money(self.amount * qty)\n14\t\n15\t    def __neg__(self) -> \"Money\":\n16\t        return Money(-self.amount)\n17\t\n18\t\n19\tZERO = Money(0.0)\n20\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:69012cd131ff6f149f3f3c73117ace1c941b318d428f73c7a85943fb2d4bc228","mono_ns":8000000,"prev":"sha256:b1441db55b60602aa6d8e0664f3fe9143d1323c992a96685344907fb86c9131c","schema":"saga.trace/1","seq":8,"session":"4b762182-bade-4b47-810e-915e8f81c3fd","source":"stream-json","ts":"2026-01-01T00:00:00.008Z","turn":1,"type":"tool_result"}
