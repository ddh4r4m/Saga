{"agent":"main","body":{"args_hash":"sha256:52cdf1d9fd76f019f98e700268205b2c99a67f84a73a529f6b3a36289bd8a177","args_inline":{"command":"python3 - <<'PY'\nfrom pricing.money import Money\nfrom pricing.tax import apply_tax\nfrom pricing.format import format_money\n\n# tax parity against the old float implementation, for every whole-cent subtotal\nbad=0\nfor c in range(-50000, 200001, 7):\n    sub = c/100\n    for rate in (0.0, 0.07, 0.0825, 0.2, 1/3):\n        new = apply_tax(Money(sub), rate).amount\n        old = round(sub*(1+rate), 2)\n        if abs(new-old) > 1e-9:\n            bad+=1\n            if bad<6: print(\"TAX DIFF\", sub, rate, new, old)\nprint(\"tax diffs:\", bad)\n\n# display parity against the old formatter\nbad=0\nfor c in list(range(-200000,200001,3))+[123456789,-123456789,999999999]:\n    m=Money.from_cents(c)\n    old = (\"-\" if m.amount<0 else \"\")+f\"${abs(m.amount):,.2f}\"\n    if format_money(m)!=old:\n        bad+=1\n        if bad<6: print(\"FMT DIFF\", c, format_money(m), old)\nprint(\"fmt diffs:\", bad)\nPY"},"component":"harness","cwd_rel":".","index_version":null,"tool":"Bash","tool_use_id":"toolu_01MoL1w95CNvocdYWp84hVMq"},"hash":"sha256:1f22ef8ce506d5405c213d58ba11efb1cf9d23a1691568de9a0da8984b0f83a4","mono_ns":37000000,"prev":"sha256:e25540bf45da836091f4715b24c7544dc434ab1feda5b9d4fa5b01c3309d3853","schema":"saga.trace/1","seq":37,"session":"4b762182-bade-4b47-810e-915e8f81c3fd","source":"stream-json","ts":"2026-01-01T00:00:00.037Z","turn":1,"type":"tool_call"}
