diff --git a/pricing/money.py b/pricing/money.py
index f586e26..52a5c70 100644
--- a/pricing/money.py
+++ b/pricing/money.py
@@ -1,19 +1,55 @@
 """Money value object."""
 from dataclasses import dataclass
+from decimal import Decimal, ROUND_HALF_UP
+
+CENTS_PER_DOLLAR = 100
+
+
+def _to_cents(dollars: int | float | str | Decimal) -> int:
+    """Convert an amount of dollars to the nearest whole cent."""
+    exact = Decimal(str(dollars)) * CENTS_PER_DOLLAR
+    return int(exact.to_integral_value(rounding=ROUND_HALF_UP))
 
 
 @dataclass(frozen=True)
 class Money:
-    amount: float
+    """An amount of money, stored as an exact whole number of cents.
+
+    Constructed from dollars, so ``Money(0.10)`` is ten cents. Because the
+    stored value is an integer, adding and multiplying never introduce
+    floating point drift.
+    """
+
+    cents: int
+
+    # dataclass keeps a hand-written __init__, so construction stays
+    # dollars-based while the field itself holds cents.
+    def __init__(self, dollars: int | float | str | Decimal = 0) -> None:
+        object.__setattr__(self, "cents", _to_cents(dollars))
+
+    @classmethod
+    def from_cents(cls, cents: int) -> "Money":
+        money = object.__new__(cls)
+        object.__setattr__(money, "cents", int(cents))
+        return money
+
+    @property
+    def dollars(self) -> float:
+        """The amount in dollars, for arithmetic against float rates."""
+        return self.cents / CENTS_PER_DOLLAR
+
+    def as_decimal(self) -> Decimal:
+        """The exact amount in dollars, for display and export."""
+        return Decimal(self.cents) / CENTS_PER_DOLLAR
 
     def __add__(self, other: "Money") -> "Money":
-        return Money(self.amount + other.amount)
+        return Money.from_cents(self.cents + other.cents)
 
     def __mul__(self, qty: int) -> "Money":
-        return Money(self.amount * qty)
+        return Money.from_cents(self.cents * qty)
 
     def __neg__(self) -> "Money":
-        return Money(-self.amount)
+        return Money.from_cents(-self.cents)
 
 
-ZERO = Money(0.0)
+ZERO = Money(0)
