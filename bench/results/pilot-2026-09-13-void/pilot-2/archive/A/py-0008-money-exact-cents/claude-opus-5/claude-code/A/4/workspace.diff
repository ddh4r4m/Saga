+
+    def test_stored_as_whole_cents(self):
+        self.assertEqual(Money(0.10).cents, 10)
+        self.assertEqual(Money(1234.56).cents, 123456)
+
+    def test_adding_dimes_does_not_drift(self):
+        total = cart_total([("widget", Money(0.10), 1)] * 1000)
+        self.assertEqual(total, Money(100.00))
+        self.assertEqual(total.cents, 10000)
+
+    def test_format_money(self):
+        self.assertEqual(format_money(Money(0.10)), "$0.10")
+        self.assertEqual(format_money(Money(1234567.89)), "$1,234,567.89")
+        self.assertEqual(format_money(-Money(1.5)), "-$1.50")
+
+    def test_tax_rounds_to_the_cent(self):
+        self.assertEqual(apply_tax(Money(19.99), 0.0825), Money(21.64))
+        self.assertEqual(apply_tax(Money(0.30), 0.05), Money(0.32))
