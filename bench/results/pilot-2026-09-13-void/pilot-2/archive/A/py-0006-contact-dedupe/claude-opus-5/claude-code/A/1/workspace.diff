 from .models import Contact
 
 
+def _key(contact: Contact) -> str:
+    """Comparable form of an email: feeds differ on case and padding."""
+    return contact.email.strip().lower()
+
+
 def dedupe(contacts: list[Contact]) -> list[Contact]:
-    """Return the list without duplicate people."""
-    raise NotImplementedError("dedupe is not implemented yet")
+    """Return the list without duplicate people.
+
+    Two entries are the same person when their email addresses match once
+    surrounding whitespace and letter case are ignored. The first entry wins
+    and the original order is preserved. Entries without an email have nothing
+    to match on, so each is kept.
+    """
+    seen: set[str] = set()
+    result: list[Contact] = []
+    for contact in contacts:
+        key = _key(contact)
+        if key and key in seen:
+            continue
+        if key:
+            seen.add(key)
+        result.append(contact)
+    return result
