+"""Tests for the behaviour documented in merge_intervals' docstring."""
+
+import unittest
+
+from intervals import merge_intervals
+
+
+class MergeIntervalsTest(unittest.TestCase):
+    def test_empty_list_gives_empty_list(self):
+        self.assertEqual(merge_intervals([]), [])
+
+    def test_single_interval_returned_as_is(self):
+        self.assertEqual(merge_intervals([(2, 5)]), [(2, 5)])
+
+    def test_disjoint_intervals_are_left_alone(self):
+        self.assertEqual(
+            merge_intervals([(1, 2), (4, 6), (8, 9)]),
+            [(1, 2), (4, 6), (8, 9)],
+        )
+
+    def test_overlapping_intervals_merge(self):
+        self.assertEqual(merge_intervals([(1, 4), (3, 6)]), [(1, 6)])
+
+    def test_touching_intervals_merge(self):
+        self.assertEqual(merge_intervals([(1, 3), (3, 5)]), [(1, 5)])
+
+    def test_gap_of_one_does_not_merge(self):
+        # (1, 2) and (3, 4) neither overlap nor touch, so they stay separate.
+        self.assertEqual(merge_intervals([(1, 2), (3, 4)]), [(1, 2), (3, 4)])
+
+    def test_result_is_sorted_by_start_for_unsorted_input(self):
+        self.assertEqual(
+            merge_intervals([(8, 9), (1, 2), (4, 6)]),
+            [(1, 2), (4, 6), (8, 9)],
+        )
+
+    def test_unsorted_overlapping_intervals_merge(self):
+        self.assertEqual(
+            merge_intervals([(5, 7), (1, 4), (2, 6), (10, 11)]),
+            [(1, 7), (10, 11)],
+        )
+
+    def test_contained_interval_does_not_shrink_the_outer_one(self):
+        self.assertEqual(merge_intervals([(1, 10), (3, 4)]), [(1, 10)])
+
+    def test_contained_interval_given_first(self):
+        self.assertEqual(merge_intervals([(3, 4), (1, 10)]), [(1, 10)])
+
+    def test_several_contained_intervals(self):
+        self.assertEqual(
+            merge_intervals([(1, 10), (2, 3), (4, 5), (9, 9)]),
+            [(1, 10)],
+        )
+
+    def test_chain_of_merges_collapses_to_one_interval(self):
+        self.assertEqual(
+            merge_intervals([(1, 3), (2, 5), (5, 8), (7, 12)]),
+            [(1, 12)],
+        )
+
+    def test_duplicate_intervals_collapse(self):
+        self.assertEqual(merge_intervals([(1, 3), (1, 3), (1, 3)]), [(1, 3)])
+
+    def test_intervals_sharing_a_start_keep_the_longest_end(self):
+        self.assertEqual(merge_intervals([(1, 3), (1, 7), (1, 5)]), [(1, 7)])
+
+    def test_degenerate_interval_is_valid(self):
+        self.assertEqual(merge_intervals([(3, 3)]), [(3, 3)])
+
+    def test_degenerate_interval_merges_when_touching(self):
+        self.assertEqual(merge_intervals([(1, 3), (3, 3)]), [(1, 3)])
+
+    def test_negative_bounds(self):
+        self.assertEqual(
+            merge_intervals([(-5, -3), (-4, 0), (2, 3)]),
+            [(-5, 0), (2, 3)],
+        )
+
+    def test_raises_value_error_when_start_after_end(self):
+        with self.assertRaises(ValueError):
+            merge_intervals([(5, 1)])
+
+    def test_raises_value_error_even_when_other_intervals_are_valid(self):
+        with self.assertRaises(ValueError):
+            merge_intervals([(1, 2), (9, 4), (6, 7)])
+
+    def test_input_list_is_not_modified(self):
+        intervals = [(5, 7), (1, 4), (2, 6)]
+        before = list(intervals)
+        merge_intervals(intervals)
+        self.assertEqual(intervals, before)
+
+    def test_result_is_a_new_list(self):
+        intervals = [(1, 2), (4, 6)]
+        result = merge_intervals(intervals)
+        self.assertIsNot(result, intervals)
+        result.append((99, 100))
+        self.assertEqual(intervals, [(1, 2), (4, 6)])
+
+    def test_result_is_a_list_of_tuples(self):
+        result = merge_intervals([(1, 4), (3, 6), (8, 9)])
+        self.assertIsInstance(result, list)
+        for item in result:
+            self.assertIsInstance(item, tuple)
+            self.assertEqual(len(item), 2)
+
+
+if __name__ == "__main__":
+    unittest.main()
