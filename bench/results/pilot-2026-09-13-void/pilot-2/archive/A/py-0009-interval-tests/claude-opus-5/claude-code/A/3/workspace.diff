+"""Tests for the behaviour documented in merge_intervals' docstring."""
+
+import unittest
+
+from intervals import merge_intervals
+
+
+class MergeIntervalsOrderingTest(unittest.TestCase):
+    """Input may be in any order; the result is sorted by start."""
+
+    def test_sorted_input_stays_sorted(self):
+        self.assertEqual(
+            merge_intervals([(1, 2), (4, 5), (7, 8)]),
+            [(1, 2), (4, 5), (7, 8)],
+        )
+
+    def test_unsorted_input_is_sorted_by_start(self):
+        self.assertEqual(
+            merge_intervals([(7, 8), (1, 2), (4, 5)]),
+            [(1, 2), (4, 5), (7, 8)],
+        )
+
+    def test_reversed_overlapping_input_merges(self):
+        self.assertEqual(merge_intervals([(5, 9), (3, 6), (1, 4)]), [(1, 9)])
+
+    def test_negative_bounds_sort_before_positive(self):
+        self.assertEqual(
+            merge_intervals([(2, 4), (-10, -8), (-3, -1)]),
+            [(-10, -8), (-3, -1), (2, 4)],
+        )
+
+
+class MergeIntervalsOverlapTest(unittest.TestCase):
+    """Overlapping intervals merge, and so do touching ones."""
+
+    def test_partial_overlap_merges(self):
+        self.assertEqual(merge_intervals([(1, 5), (3, 8)]), [(1, 8)])
+
+    def test_touching_intervals_merge(self):
+        self.assertEqual(merge_intervals([(1, 3), (3, 5)]), [(1, 5)])
+
+    def test_gap_of_one_does_not_merge(self):
+        self.assertEqual(merge_intervals([(1, 3), (4, 6)]), [(1, 3), (4, 6)])
+
+    def test_identical_intervals_collapse_to_one(self):
+        self.assertEqual(merge_intervals([(2, 6), (2, 6), (2, 6)]), [(2, 6)])
+
+    def test_shared_start_keeps_widest_end(self):
+        self.assertEqual(merge_intervals([(1, 4), (1, 9), (1, 2)]), [(1, 9)])
+
+    def test_shared_end_merges(self):
+        self.assertEqual(merge_intervals([(1, 9), (5, 9)]), [(1, 9)])
+
+    def test_chain_of_touching_intervals_merges_into_one(self):
+        self.assertEqual(
+            merge_intervals([(1, 2), (2, 3), (3, 4), (4, 5)]),
+            [(1, 5)],
+        )
+
+    def test_mixed_merging_and_disjoint_groups(self):
+        self.assertEqual(
+            merge_intervals([(10, 12), (1, 3), (2, 6), (20, 20), (12, 15)]),
+            [(1, 6), (10, 15), (20, 20)],
+        )
+
+    def test_zero_width_interval_touching_another_merges(self):
+        self.assertEqual(merge_intervals([(3, 3), (3, 7)]), [(3, 7)])
+
+    def test_zero_width_interval_inside_another_merges(self):
+        self.assertEqual(merge_intervals([(1, 7), (4, 4)]), [(1, 7)])
+
+    def test_disjoint_zero_width_intervals_are_kept_separate(self):
+        self.assertEqual(merge_intervals([(5, 5), (1, 1)]), [(1, 1), (5, 5)])
+
+
+class MergeIntervalsContainmentTest(unittest.TestCase):
+    """An interval fully inside another does not shrink the outer one."""
+
+    def test_contained_interval_does_not_shrink_outer(self):
+        self.assertEqual(merge_intervals([(1, 10), (3, 5)]), [(1, 10)])
+
+    def test_contained_interval_listed_first(self):
+        self.assertEqual(merge_intervals([(3, 5), (1, 10)]), [(1, 10)])
+
+    def test_several_contained_intervals(self):
+        self.assertEqual(
+            merge_intervals([(1, 100), (2, 3), (50, 60), (98, 99)]),
+            [(1, 100)],
+        )
+
+    def test_contained_interval_after_a_merge_does_not_shrink_result(self):
+        # (2, 4) is swallowed by the (1, 20) built from the first two entries.
+        self.assertEqual(merge_intervals([(1, 5), (5, 20), (2, 4)]), [(1, 20)])
+
+    def test_contained_interval_does_not_block_later_extension(self):
+        self.assertEqual(
+            merge_intervals([(1, 10), (2, 3), (9, 15)]),
+            [(1, 15)],
+        )
+
+
+class MergeIntervalsTrivialInputTest(unittest.TestCase):
+    """An empty list gives an empty list; a single interval is returned as is."""
+
+    def test_empty_list_gives_empty_list(self):
+        self.assertEqual(merge_intervals([]), [])
+
+    def test_single_interval_is_returned_as_is(self):
+        self.assertEqual(merge_intervals([(2, 7)]), [(2, 7)])
+
+    def test_single_zero_width_interval_is_returned_as_is(self):
+        self.assertEqual(merge_intervals([(4, 4)]), [(4, 4)])
+
+    def test_single_negative_interval_is_returned_as_is(self):
+        self.assertEqual(merge_intervals([(-9, -2)]), [(-9, -2)])
+
+
+class MergeIntervalsResultShapeTest(unittest.TestCase):
+    """The result is a new list of tuples; the input list is not modified."""
+
+    def test_result_is_a_new_list(self):
+        source = [(1, 2), (5, 6)]
+        result = merge_intervals(source)
+        self.assertIsNot(result, source)
+
+    def test_empty_result_is_a_new_list(self):
+        source = []
+        result = merge_intervals(source)
+        self.assertIsNot(result, source)
+
+    def test_input_list_is_not_modified(self):
+        source = [(5, 9), (1, 3), (2, 6)]
+        merge_intervals(source)
+        self.assertEqual(source, [(5, 9), (1, 3), (2, 6)])
+
+    def test_input_list_is_not_modified_when_nothing_merges(self):
+        source = [(9, 10), (1, 2)]
+        merge_intervals(source)
+        self.assertEqual(source, [(9, 10), (1, 2)])
+
+    def test_mutating_the_result_does_not_affect_the_input(self):
+        source = [(1, 2), (5, 6)]
+        result = merge_intervals(source)
+        result.append((100, 200))
+        self.assertEqual(source, [(1, 2), (5, 6)])
+
+    def test_result_is_a_list_of_tuples(self):
+        result = merge_intervals([(3, 4), (1, 2), (2, 9)])
+        self.assertIsInstance(result, list)
+        for item in result:
+            self.assertIsInstance(item, tuple)
+            self.assertEqual(len(item), 2)
+
+    def test_unmerged_intervals_are_tuples_even_if_input_holds_lists(self):
+        result = merge_intervals([[1, 3], [2, 5]])
+        self.assertEqual(result, [(1, 5)])
+        self.assertIsInstance(result[0], tuple)
+
+
+class MergeIntervalsValidationTest(unittest.TestCase):
+    """Raises ValueError if any interval has start > end."""
+
+    def test_single_reversed_interval_raises(self):
+        with self.assertRaises(ValueError):
+            merge_intervals([(5, 1)])
+
+    def test_reversed_interval_among_valid_ones_raises(self):
+        with self.assertRaises(ValueError):
+            merge_intervals([(1, 2), (9, 4), (10, 12)])
+
+    def test_reversed_interval_raises_before_any_merging(self):
+        # The invalid entry is last, so validation must scan the whole input.
+        with self.assertRaises(ValueError):
+            merge_intervals([(1, 3), (2, 5), (8, 7)])
+
+    def test_error_message_names_the_offending_interval(self):
+        with self.assertRaisesRegex(ValueError, r"\(9, 4\)"):
+            merge_intervals([(1, 2), (9, 4)])
+
+    def test_equal_start_and_end_is_valid(self):
+        self.assertEqual(merge_intervals([(3, 3)]), [(3, 3)])
+
+    def test_reversed_negative_interval_raises(self):
+        with self.assertRaises(ValueError):
+            merge_intervals([(-1, -5)])
+
+    def test_input_is_not_modified_when_validation_fails(self):
+        source = [(1, 2), (9, 4)]
+        with self.assertRaises(ValueError):
+            merge_intervals(source)
+        self.assertEqual(source, [(1, 2), (9, 4)])
+
+
+if __name__ == "__main__":
+    unittest.main()
