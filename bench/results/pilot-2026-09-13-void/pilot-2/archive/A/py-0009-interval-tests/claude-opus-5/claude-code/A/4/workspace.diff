+"""Tests for merge_intervals, following the behaviour in its docstring."""
+
+import unittest
+
+from intervals import merge_intervals
+
+
+class MergeIntervalsTests(unittest.TestCase):
+    def test_empty_list_gives_empty_list(self):
+        self.assertEqual(merge_intervals([]), [])
+
+    def test_single_interval_returned_as_is(self):
+        self.assertEqual(merge_intervals([(2, 5)]), [(2, 5)])
+
+    def test_disjoint_intervals_are_left_alone(self):
+        self.assertEqual(
+            merge_intervals([(1, 2), (4, 5), (7, 8)]),
+            [(1, 2), (4, 5), (7, 8)],
+        )
+
+    def test_overlapping_intervals_merge(self):
+        self.assertEqual(merge_intervals([(1, 4), (3, 6)]), [(1, 6)])
+
+    def test_touching_intervals_merge(self):
+        self.assertEqual(merge_intervals([(1, 3), (3, 5)]), [(1, 5)])
+
+    def test_gap_of_one_does_not_merge(self):
+        # (1, 3) and (4, 6) do not touch: 4 > 3.
+        self.assertEqual(merge_intervals([(1, 3), (4, 6)]), [(1, 3), (4, 6)])
+
+    def test_result_is_sorted_by_start_for_unordered_input(self):
+        self.assertEqual(
+            merge_intervals([(7, 8), (1, 2), (4, 5)]),
+            [(1, 2), (4, 5), (7, 8)],
+        )
+
+    def test_unordered_input_still_merges(self):
+        self.assertEqual(
+            merge_intervals([(8, 10), (1, 4), (3, 5), (9, 12)]),
+            [(1, 5), (8, 12)],
+        )
+
+    def test_nested_interval_does_not_shrink_the_outer_one(self):
+        self.assertEqual(merge_intervals([(1, 10), (3, 5)]), [(1, 10)])
+
+    def test_nested_interval_given_first_does_not_shrink_the_outer_one(self):
+        self.assertEqual(merge_intervals([(3, 5), (1, 10)]), [(1, 10)])
+
+    def test_several_nested_intervals_keep_the_widest_end(self):
+        self.assertEqual(
+            merge_intervals([(1, 20), (2, 3), (4, 19), (5, 6)]),
+            [(1, 20)],
+        )
+
+    def test_chain_of_overlaps_merges_into_one(self):
+        self.assertEqual(
+            merge_intervals([(1, 3), (2, 6), (5, 9), (8, 11)]),
+            [(1, 11)],
+        )
+
+    def test_identical_intervals_collapse(self):
+        self.assertEqual(merge_intervals([(1, 4), (1, 4), (1, 4)]), [(1, 4)])
+
+    def test_intervals_sharing_a_start_keep_the_widest_end(self):
+        self.assertEqual(merge_intervals([(1, 3), (1, 7), (1, 5)]), [(1, 7)])
+
+    def test_zero_length_interval_is_allowed(self):
+        self.assertEqual(merge_intervals([(4, 4)]), [(4, 4)])
+
+    def test_zero_length_interval_merges_when_touching(self):
+        self.assertEqual(merge_intervals([(1, 3), (3, 3)]), [(1, 3)])
+
+    def test_zero_length_interval_stays_separate_when_disjoint(self):
+        self.assertEqual(merge_intervals([(1, 2), (5, 5)]), [(1, 2), (5, 5)])
+
+    def test_negative_bounds(self):
+        self.assertEqual(
+            merge_intervals([(-5, -3), (-4, 0), (2, 3)]),
+            [(-5, 0), (2, 3)],
+        )
+
+    def test_raises_on_start_after_end(self):
+        with self.assertRaises(ValueError):
+            merge_intervals([(5, 1)])
+
+    def test_raises_even_when_the_bad_interval_is_not_first(self):
+        with self.assertRaises(ValueError):
+            merge_intervals([(1, 2), (4, 6), (9, 7)])
+
+    def test_raises_before_merging_anything(self):
+        # Validation covers the whole input, including intervals that would
+        # otherwise have been merged away.
+        with self.assertRaises(ValueError):
+            merge_intervals([(1, 10), (5, 4)])
+
+    def test_error_message_names_the_offending_interval(self):
+        with self.assertRaisesRegex(ValueError, r"\(9, 7\)"):
+            merge_intervals([(1, 2), (9, 7)])
+
+    def test_input_list_is_not_modified(self):
+        data = [(5, 8), (1, 3), (2, 6)]
+        original = list(data)
+        merge_intervals(data)
+        self.assertEqual(data, original)
+
+    def test_result_is_a_new_list(self):
+        data = [(1, 2), (4, 5)]
+        result = merge_intervals(data)
+        self.assertIsNot(result, data)
+        result.append((10, 11))
+        self.assertEqual(data, [(1, 2), (4, 5)])
+
+    def test_result_is_a_list_of_tuples(self):
+        result = merge_intervals([(4, 5), (1, 2), (2, 3)])
+        self.assertIsInstance(result, list)
+        for item in result:
+            self.assertIsInstance(item, tuple)
+
+    def test_single_interval_result_is_a_new_list(self):
+        data = [(2, 5)]
+        result = merge_intervals(data)
+        self.assertIsNot(result, data)
+        self.assertEqual(result, [(2, 5)])
+
+
+if __name__ == "__main__":
+    unittest.main()
