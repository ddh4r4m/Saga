 """Version helpers for the changelog generator."""
 
 
+def _version_key(item: str) -> tuple[int, ...]:
+    """Split a version string into its numeric components for comparison."""
+    return tuple(int(part) for part in item.split("."))
+
+
 def sort_versions(items: list[str]) -> list[str]:
-    """Return the version strings in ascending order."""
-    return sorted(items)
