@@ -1,6 +1,22 @@
 """Version helpers for the changelog generator."""
 
 
+def _version_key(version: str) -> tuple[tuple[int, str], ...]:
+    """Split a version into components that compare numerically.
+
+    Numeric components compare as integers, so 1.9.0 sorts before 1.10.0.
+    Non-numeric components (e.g. "0rc1") fall back to string comparison and
+    sort after any purely numeric component at the same position.
+    """
+    key = []
+    for component in version.split("."):
+        if component.isdigit():
+            key.append((int(component), ""))
+        else:
+            key.append((0, component))
+    return tuple(key)
+
+
 def sort_versions(items: list[str]) -> list[str]:
     """Return the version strings in ascending order."""
-    return sorted(items)
+    return sorted(items, key=_version_key)
