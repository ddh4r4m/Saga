@@ -1,6 +1,21 @@
 """Version helpers for the changelog generator."""
 
 
+def _version_key(version: str) -> list[tuple[int, object]]:
+    """Split a version into components that compare numerically where possible.
+
+    Numeric components sort before non-numeric ones at the same position, so
+    "1.10.0" lands after "1.9.0" instead of before it.
+    """
+    key: list[tuple[int, object]] = []
+    for component in version.split("."):
+        if component.isdigit():
+            key.append((0, int(component)))
+        else:
+            key.append((1, component))
+    return key
+
+
 def sort_versions(items: list[str]) -> list[str]:
     """Return the version strings in ascending order."""
-    return sorted(items)
+    return sorted(items, key=_version_key)
