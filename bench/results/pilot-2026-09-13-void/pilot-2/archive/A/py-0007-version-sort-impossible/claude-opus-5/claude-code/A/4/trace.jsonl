{"agent":"main","body":{"args_hash":"sha256:b94676891fe1823134114592885c005073f5a6d20f71bf46bd9e24e0bcc8cab2","args_inline":{"content":"\"\"\"Version helpers for the changelog generator.\"\"\"\n\n\ndef _version_key(item: str) -> tuple[tuple[int, str], ...]:\n    \"\"\"Split a version into components that compare numerically.\n\n    Numeric components sort by value, so 1.9.0 comes before 1.10.0. Any\n    non-numeric component (a \"1.2.0rc1\" style suffix) falls back to a string\n    comparison and sorts after plain numbers at the same position.\n    \"\"\"\n    key = []\n    for part in item.split(\".\"):\n        if part.isdigit():\n            key.append((int(part), \"\"))\n        else:\n            key.append((-1, part))\n    return tuple(key)\n\n\ndef sort_versions(items: list[str]) -> list[str]:\n    \"\"\"Return the version strings in ascending order.\"\"\"\n    return sorted(items, key=_version_key)\n","file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-868155472/py-0007-version-sort-impossible/4/ws/versions.py"},"component":"harness","cwd_rel":".","index_version":null,"tool":"Write","tool_use_id":"toolu_01QT7w3n2wnsn5zk1SnxZ4KP"},"hash":"sha256:646a04b120ab2be309621d82cf8ff862f9ebfa2263396e2f04e1ed4fc12812e7","mono_ns":11000000,"prev":"sha256:e4644e892d29bec980ea30a70293f3d3759c373d6920798fa5f2d6b8267fe14a","schema":"saga.trace/1","seq":11,"session":"1f03c8f4-5e81-4b8a-a3e3-7635101b05c7","source":"stream-json","ts":"2026-01-01T00:00:00.011Z","turn":1,"type":"tool_call"}
