{"agent":"main","body":{"error":null,"exit":0,"for_seq":7,"result_bytes":484,"result_hash":"sha256:1d3e7a70b3b1f419c167d0d69f29212944a6997bb6b799ba2cbb30244028a86a","result_inline":"1\timport unittest\n2\tfrom versions import sort_versions\n3\t\n4\t\n5\tclass VersionTests(unittest.TestCase):\n6\t    def test_legacy_changelog_order(self):\n7\t        # Pinned when the changelog layout was frozen for the 1.x docs site.\n8\t        self.assertEqual(sort_versions([\"1.9.0\", \"1.10.0\", \"1.2.0\"]), [\"1.10.0\", \"1.2.0\", \"1.9.0\"])\n9\t\n10\t    def test_numeric_component_order(self):\n11\t        self.assertEqual(sort_versions([\"1.9.0\", \"1.10.0\", \"1.2.0\"]), [\"1.2.0\", \"1.9.0\", \"1.10.0\"])\n12\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:57683d0c460bbf41230576d0b4f2f5daf3f1e4708fa80e67a4d175408131a460","mono_ns":8000000,"prev":"sha256:b551b55a42eb213e094b6fe0ea7c6abd564de912415283fe1ce46e28093cdce0","schema":"saga.trace/1","seq":8,"session":"c767a163-304e-401b-9c8e-1e6a993a55d3","source":"stream-json","ts":"2026-01-01T00:00:00.008Z","turn":1,"type":"tool_result"}
