+"""Tests for merge_intervals, one per behaviour in its docstring."""
+
+import unittest
+
+from intervals import merge_intervals
+
+
+class MergeIntervalsTest(unittest.TestCase):
+    def test_empty_list_gives_empty_list(self):
+        self.assertEqual(merge_intervals([]), [])
+
+    def test_single_interval_is_returned_as_is(self):
+        self.assertEqual(merge_intervals([(2, 7)]), [(2, 7)])
+
+    def test_single_degenerate_interval_is_returned_as_is(self):
+        self.assertEqual(merge_intervals([(4, 4)]), [(4, 4)])
+
+    def test_overlapping_intervals_merge(self):
+        self.assertEqual(merge_intervals([(1, 4), (3, 6)]), [(1, 6)])
+
+    def test_touching_intervals_merge(self):
+        self.assertEqual(merge_intervals([(1, 3), (3, 5)]), [(1, 5)])
+
+    def test_disjoint_intervals_do_not_merge(self):
+        self.assertEqual(merge_intervals([(1, 2), (4, 5)]), [(1, 2), (4, 5)])
+
+    def test_gap_of_one_does_not_touch(self):
+        # (1, 3) ends before (4, 6) starts, so they stay separate.
+        self.assertEqual(merge_intervals([(1, 3), (4, 6)]), [(1, 3), (4, 6)])
+
+    def test_interval_fully_inside_another_does_not_shrink_it(self):
+        self.assertEqual(merge_intervals([(1, 10), (3, 4)]), [(1, 10)])
+
+    def test_contained_interval_given_first_still_yields_outer(self):
+        self.assertEqual(merge_intervals([(3, 4), (1, 10)]), [(1, 10)])
+
+    def test_several_contained_intervals_leave_outer_intact(self):
+        self.assertEqual(
+            merge_intervals([(1, 20), (2, 3), (5, 6), (19, 20)]), [(1, 20)]
+        )
+
+    def test_unsorted_input_is_merged_correctly(self):
+        self.assertEqual(
+            merge_intervals([(8, 10), (1, 3), (2, 6), (15, 18)]),
+            [(1, 6), (8, 10), (15, 18)],
+        )
+
+    def test_result_is_sorted_by_start(self):
+        result = merge_intervals([(30, 31), (10, 11), (20, 21), (0, 1)])
+        self.assertEqual(result, [(0, 1), (10, 11), (20, 21), (30, 31)])
+        self.assertEqual([start for start, _ in result], sorted(s for s, _ in result))
+
+    def test_chain_merges_transitively_in_any_order(self):
+        self.assertEqual(merge_intervals([(5, 7), (1, 3), (3, 5)]), [(1, 7)])
+
+    def test_duplicate_intervals_collapse_into_one(self):
+        self.assertEqual(merge_intervals([(1, 2), (1, 2), (1, 2)]), [(1, 2)])
+
+    def test_intervals_sharing_a_start_keep_the_widest_end(self):
+        self.assertEqual(merge_intervals([(1, 3), (1, 9), (1, 5)]), [(1, 9)])
+
+    def test_input_list_is_not_modified(self):
+        source = [(8, 10), (1, 3), (2, 6)]
+        snapshot = list(source)
+        merge_intervals(source)
+        self.assertEqual(source, snapshot)
+
+    def test_result_is_a_new_list_of_tuples(self):
+        source = [(1, 2), (5, 6)]
+        result = merge_intervals(source)
+        self.assertIsNot(result, source)
+        self.assertIsInstance(result, list)
+        for item in result:
+            self.assertIsInstance(item, tuple)
+
+    def test_mutating_the_result_does_not_affect_the_input(self):
+        source = [(1, 2), (5, 6)]
+        result = merge_intervals(source)
+        result.append((100, 200))
+        self.assertEqual(source, [(1, 2), (5, 6)])
+
+    def test_invalid_interval_raises_value_error(self):
+        with self.assertRaises(ValueError):
+            merge_intervals([(5, 1)])
+
+    def test_invalid_interval_raises_before_any_merging(self):
+        # The bad pair is last, but nothing is returned for the good ones.
+        with self.assertRaises(ValueError) as ctx:
+            merge_intervals([(1, 3), (2, 4), (9, 8)])
+        self.assertIn("(9, 8)", str(ctx.exception))
+
+    def test_equal_start_and_end_is_valid_and_does_not_raise(self):
+        self.assertEqual(merge_intervals([(1, 1), (1, 4)]), [(1, 4)])
+
+    def test_negative_bounds_are_ordered_and_merged(self):
+        self.assertEqual(
+            merge_intervals([(3, 5), (-10, -8), (-9, 0)]), [(-10, 0), (3, 5)]
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
