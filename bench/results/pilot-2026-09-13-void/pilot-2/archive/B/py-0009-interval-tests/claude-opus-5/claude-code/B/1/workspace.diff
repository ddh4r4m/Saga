+"""Tests for merge_intervals, following the behaviour in its docstring."""
+
+import unittest
+
+from intervals import merge_intervals
+
+
+class MergeIntervalsTest(unittest.TestCase):
+    def test_empty_list_gives_empty_list(self):
+        self.assertEqual(merge_intervals([]), [])
+
+    def test_single_interval_returned_as_is(self):
+        self.assertEqual(merge_intervals([(2, 7)]), [(2, 7)])
+
+    def test_disjoint_intervals_are_not_merged(self):
+        self.assertEqual(
+            merge_intervals([(1, 2), (4, 5), (7, 8)]),
+            [(1, 2), (4, 5), (7, 8)],
+        )
+
+    def test_adjacent_disjoint_intervals_with_a_gap_of_one_stay_separate(self):
+        # (1, 3) and (4, 6) do not touch: 4 > 3.
+        self.assertEqual(merge_intervals([(1, 3), (4, 6)]), [(1, 3), (4, 6)])
+
+    def test_overlapping_intervals_merge(self):
+        self.assertEqual(merge_intervals([(1, 4), (2, 6)]), [(1, 6)])
+
+    def test_touching_intervals_merge(self):
+        self.assertEqual(merge_intervals([(1, 3), (3, 5)]), [(1, 5)])
+
+    def test_touching_merge_chains_across_several_intervals(self):
+        self.assertEqual(
+            merge_intervals([(1, 2), (2, 3), (3, 4), (4, 5)]),
+            [(1, 5)],
+        )
+
+    def test_interval_contained_in_another_does_not_shrink_the_outer_one(self):
+        self.assertEqual(merge_intervals([(1, 10), (3, 4)]), [(1, 10)])
+
+    def test_contained_interval_given_first_still_yields_the_outer_one(self):
+        self.assertEqual(merge_intervals([(3, 4), (1, 10)]), [(1, 10)])
+
+    def test_several_intervals_inside_one_outer_interval(self):
+        self.assertEqual(
+            merge_intervals([(0, 100), (5, 6), (50, 60), (99, 100)]),
+            [(0, 100)],
+        )
+
+    def test_unsorted_input_is_sorted_by_start(self):
+        self.assertEqual(
+            merge_intervals([(7, 8), (1, 2), (4, 5)]),
+            [(1, 2), (4, 5), (7, 8)],
+        )
+
+    def test_unsorted_overlapping_input_merges_into_sorted_result(self):
+        self.assertEqual(
+            merge_intervals([(8, 10), (1, 3), (2, 6), (15, 18), (9, 12)]),
+            [(1, 6), (8, 12), (15, 18)],
+        )
+
+    def test_intervals_sharing_a_start_merge_to_the_widest_end(self):
+        self.assertEqual(merge_intervals([(1, 9), (1, 3)]), [(1, 9)])
+        self.assertEqual(merge_intervals([(1, 3), (1, 9)]), [(1, 9)])
+
+    def test_degenerate_point_intervals(self):
+        self.assertEqual(merge_intervals([(5, 5)]), [(5, 5)])
+        self.assertEqual(merge_intervals([(5, 5), (5, 5)]), [(5, 5)])
+        self.assertEqual(merge_intervals([(1, 5), (5, 5)]), [(1, 5)])
+        self.assertEqual(merge_intervals([(5, 5), (7, 7)]), [(5, 5), (7, 7)])
+
+    def test_negative_bounds_are_supported(self):
+        self.assertEqual(
+            merge_intervals([(-5, -3), (-3, 0), (2, 4)]),
+            [(-5, 0), (2, 4)],
+        )
+
+    def test_input_list_is_not_modified(self):
+        intervals = [(8, 10), (1, 3), (2, 6)]
+        original = list(intervals)
+        merge_intervals(intervals)
+        self.assertEqual(intervals, original)
+
+    def test_result_is_a_new_list_of_tuples(self):
+        intervals = [(1, 2), (4, 5)]
+        result = merge_intervals(intervals)
+        self.assertIsNot(result, intervals)
+        self.assertIsInstance(result, list)
+        for item in result:
+            self.assertIsInstance(item, tuple)
+
+    def test_mutating_the_result_does_not_affect_the_input(self):
+        intervals = [(1, 2), (4, 5)]
+        result = merge_intervals(intervals)
+        result.append((9, 9))
+        self.assertEqual(intervals, [(1, 2), (4, 5)])
+
+    def test_invalid_interval_raises_value_error(self):
+        with self.assertRaises(ValueError):
+            merge_intervals([(5, 1)])
+
+    def test_invalid_interval_raises_even_when_other_intervals_are_valid(self):
+        with self.assertRaises(ValueError):
+            merge_intervals([(1, 2), (9, 4), (10, 12)])
+
+    def test_invalid_interval_is_detected_before_any_merging(self):
+        intervals = [(1, 2), (2, 3), (9, 4)]
+        original = list(intervals)
+        with self.assertRaises(ValueError):
+            merge_intervals(intervals)
+        self.assertEqual(intervals, original)
+
+    def test_value_error_message_names_the_invalid_interval(self):
+        with self.assertRaisesRegex(ValueError, r"\(9, 4\)"):
+            merge_intervals([(1, 2), (9, 4)])
+
+    def test_equal_start_and_end_is_valid_and_does_not_raise(self):
+        self.assertEqual(merge_intervals([(3, 3)]), [(3, 3)])
+
+
+if __name__ == "__main__":
+    unittest.main()
