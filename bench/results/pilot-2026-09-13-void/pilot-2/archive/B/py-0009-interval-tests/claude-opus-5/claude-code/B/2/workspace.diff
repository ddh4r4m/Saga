+"""Tests for merge_intervals, covering each behaviour in its docstring."""
+
+import unittest
+
+from intervals import merge_intervals
+
+
+class MergeIntervalsTest(unittest.TestCase):
+    def test_empty_list_gives_empty_list(self):
+        self.assertEqual(merge_intervals([]), [])
+
+    def test_single_interval_returned_as_is(self):
+        self.assertEqual(merge_intervals([(2, 7)]), [(2, 7)])
+
+    def test_degenerate_single_point_interval_is_kept(self):
+        self.assertEqual(merge_intervals([(4, 4)]), [(4, 4)])
+
+    def test_disjoint_intervals_are_not_merged(self):
+        self.assertEqual(
+            merge_intervals([(1, 2), (5, 6), (9, 10)]),
+            [(1, 2), (5, 6), (9, 10)],
+        )
+
+    def test_gap_of_one_is_not_merged(self):
+        self.assertEqual(merge_intervals([(1, 3), (4, 6)]), [(1, 3), (4, 6)])
+
+    def test_overlapping_intervals_merge(self):
+        self.assertEqual(merge_intervals([(1, 5), (3, 8)]), [(1, 8)])
+
+    def test_touching_intervals_merge(self):
+        self.assertEqual(merge_intervals([(1, 3), (3, 5)]), [(1, 5)])
+
+    def test_touching_point_interval_merges(self):
+        self.assertEqual(merge_intervals([(1, 3), (3, 3)]), [(1, 3)])
+
+    def test_chain_of_touching_intervals_merges_into_one(self):
+        self.assertEqual(
+            merge_intervals([(1, 2), (2, 3), (3, 4), (4, 5)]),
+            [(1, 5)],
+        )
+
+    def test_interval_contained_in_another_does_not_shrink_it(self):
+        self.assertEqual(merge_intervals([(1, 10), (3, 4)]), [(1, 10)])
+
+    def test_contained_interval_given_first_does_not_shrink_outer(self):
+        self.assertEqual(merge_intervals([(3, 4), (1, 10)]), [(1, 10)])
+
+    def test_several_intervals_inside_one_outer_interval(self):
+        self.assertEqual(
+            merge_intervals([(0, 100), (10, 20), (30, 40), (99, 100)]),
+            [(0, 100)],
+        )
+
+    def test_duplicate_intervals_collapse(self):
+        self.assertEqual(merge_intervals([(2, 5), (2, 5), (2, 5)]), [(2, 5)])
+
+    def test_intervals_sharing_a_start_keep_the_widest_end(self):
+        self.assertEqual(merge_intervals([(1, 4), (1, 9), (1, 2)]), [(1, 9)])
+
+    def test_unsorted_input_is_merged_and_result_is_sorted_by_start(self):
+        self.assertEqual(
+            merge_intervals([(8, 10), (1, 3), (2, 6), (15, 18)]),
+            [(1, 6), (8, 10), (15, 18)],
+        )
+
+    def test_result_is_sorted_by_start_when_nothing_merges(self):
+        result = merge_intervals([(20, 21), (5, 6), (-4, -2), (0, 1)])
+        self.assertEqual(result, [(-4, -2), (0, 1), (5, 6), (20, 21)])
+        self.assertEqual([start for start, _ in result], sorted(start for start, _ in result))
+
+    def test_reverse_order_input_merges_correctly(self):
+        self.assertEqual(merge_intervals([(7, 9), (4, 7), (1, 4)]), [(1, 9)])
+
+    def test_negative_intervals_are_supported(self):
+        self.assertEqual(
+            merge_intervals([(-5, -1), (-2, 3), (10, 12)]),
+            [(-5, 3), (10, 12)],
+        )
+
+    def test_input_list_is_not_modified(self):
+        intervals = [(5, 7), (1, 3), (2, 6)]
+        original = list(intervals)
+        merge_intervals(intervals)
+        self.assertEqual(intervals, original)
+
+    def test_result_is_a_new_list_of_tuples(self):
+        intervals = [(1, 2)]
+        result = merge_intervals(intervals)
+        self.assertIsNot(result, intervals)
+        self.assertIsInstance(result, list)
+        for item in result:
+            self.assertIsInstance(item, tuple)
+
+    def test_mutating_the_result_does_not_affect_the_input(self):
+        intervals = [(1, 2), (4, 5)]
+        result = merge_intervals(intervals)
+        result.append((9, 9))
+        self.assertEqual(intervals, [(1, 2), (4, 5)])
+
+    def test_invalid_interval_raises_value_error(self):
+        with self.assertRaises(ValueError):
+            merge_intervals([(5, 1)])
+
+    def test_invalid_interval_among_valid_ones_raises_value_error(self):
+        with self.assertRaises(ValueError):
+            merge_intervals([(1, 2), (4, 8), (9, 3)])
+
+    def test_value_error_message_names_the_invalid_interval(self):
+        with self.assertRaises(ValueError) as ctx:
+            merge_intervals([(1, 2), (9, 3)])
+        self.assertIn("(9, 3)", str(ctx.exception))
+
+    def test_invalid_interval_is_rejected_before_any_merging(self):
+        intervals = [(1, 2), (7, 4)]
+        with self.assertRaises(ValueError):
+            merge_intervals(intervals)
+        self.assertEqual(intervals, [(1, 2), (7, 4)])
+
+
+if __name__ == "__main__":
+    unittest.main()
