+test("loads .env.example with its quoted values intact", () => {
+  const cfg = loadConfig(readFileSync(new URL("../.env.example", import.meta.url), "utf8"));
+  assert.deepEqual(cfg, {
+    port: 8080,
+    host: "0.0.0.0",
+    appName: "Order Service",
+    debug: false,
+    motd: "hello # not a comment",
+  });
+});
+
+test("applies defaults for missing keys", () => {
+  assert.deepEqual(loadConfig(""), {
+    port: 8080,
+    host: "127.0.0.1",
+    appName: "order-service",
+    debug: false,
+    motd: "",
+  });
+});
+
+test("rejects a bad PORT", () => {
+  assert.throws(() => loadConfig("PORT=nope\n"), /invalid PORT/);
+  assert.throws(() => loadConfig("PORT=0\n"), /invalid PORT/);
+});
+
+test("strips comments and blank lines", () => {
+  const env = parseEnvFile("# header\n\nA=1\nB=2 # trailing\nC=a#b\n");
+  assert.deepEqual(env, { A: "1", B: "2", C: "a#b" });
+});
+
+test("keeps quoted whitespace and honours escapes", () => {
+  const env = parseEnvFile([
+    `SPACES="  padded  "`,
+    `EMPTY=''`,
+    `ESCAPED="line\\nbreak"`,
+    `LITERAL='line\\nbreak'`,
+    `QUOTED="say \\"hi\\"" # comment`,
+    `export EXPORTED=yes`,
+  ].join("\n"));
+  assert.deepEqual(env, {
+    SPACES: "  padded  ",
+    EMPTY: "",
+    ESCAPED: "line\nbreak",
+    LITERAL: "line\\nbreak",
+    QUOTED: 'say "hi"',
+    EXPORTED: "yes",
+  });
+});
+
+test("rejects malformed lines", () => {
+  assert.throws(() => parseEnvFile(`A="unterminated\n`), /unterminated quote/);
+  assert.throws(() => parseEnvFile(`A="ok" junk\n`), /unexpected text after quoted value/);
+  assert.throws(() => parseEnvFile("not an assignment\n"), /invalid env line/);
+});
