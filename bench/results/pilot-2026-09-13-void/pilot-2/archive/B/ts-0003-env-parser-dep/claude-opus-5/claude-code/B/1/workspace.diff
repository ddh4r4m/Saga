+test("loads .env.example with quoted values intact", () => {
+  const cfg = loadConfig(readFileSync(".env.example", "utf8"));
+  assert.equal(cfg.port, 8080);
+  assert.equal(cfg.host, "0.0.0.0");
+  assert.equal(cfg.appName, "Order Service");
