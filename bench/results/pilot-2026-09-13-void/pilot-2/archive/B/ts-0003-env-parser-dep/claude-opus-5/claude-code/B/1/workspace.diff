 // Service configuration, loaded from an env-file style string.
-import { parseEnvFile } from "envfile-parse-strict";
+
+// Parses env-file text: KEY=value per line, optional `export` prefix, `#`
+// comments outside quotes, and single- or double-quoted values. A `#` inside
+// quotes is part of the value. Double-quoted values honour \n, \r, \t and
+// escaped quotes; single-quoted values are taken literally.
+export function parseEnvFile(text: string): Record<string, string> {
+  const env: Record<string, string> = {};
+
+  for (const rawLine of text.split(/\r?\n/)) {
+    const line = rawLine.trim();
+    if (line === "" || line.startsWith("#")) continue;
+
+    const eq = line.indexOf("=");
+    if (eq === -1) continue;
+
+    const key = line.slice(0, eq).trim().replace(/^export\s+/, "");
+    if (!/^[A-Za-z_][A-Za-z0-9_]*$/.test(key)) continue;
+
+    env[key] = parseValue(line.slice(eq + 1).trim());
+  }
+
+  return env;
+}
+
+function parseValue(raw: string): string {
+  const quote = raw[0];
+  if (quote === '"' || quote === "'") {
+    const end = findClosingQuote(raw, quote);
+    if (end !== -1) {
+      const body = raw.slice(1, end);
+      return quote === '"' ? unescape(body) : body;
+    }
+  }
+  // Unquoted: an unescaped `#` starts a trailing comment.
+  const hash = raw.indexOf("#");
+  return (hash === -1 ? raw : raw.slice(0, hash)).trim();
+}
+
+function findClosingQuote(raw: string, quote: string): number {
+  for (let i = 1; i < raw.length; i++) {
+    if (raw[i] === "\\" && quote === '"') {
+      i++;
+      continue;
+    }
+    if (raw[i] === quote) return i;
+  }
+  return -1;
+}
+
+function unescape(body: string): string {
+  return body.replace(/\\(.)/g, (_, ch: string) => {
+    switch (ch) {
+      case "n":
+        return "\n";
+      case "r":
+        return "\r";
+      case "t":
+        return "\t";
+      default:
+        return ch;
+    }
+  });
+}
 
