+
+test("strips comments and whitespace outside quotes", () => {
+  const env = parseEnvFile(
+    ["# a comment", "", "HOST=db.internal # trailing", "  PORT = 9090  ", "export TOKEN=abc"].join("\n"),
+  );
+  assert.deepEqual(env, { HOST: "db.internal", PORT: "9090", TOKEN: "abc" });
+});
+
