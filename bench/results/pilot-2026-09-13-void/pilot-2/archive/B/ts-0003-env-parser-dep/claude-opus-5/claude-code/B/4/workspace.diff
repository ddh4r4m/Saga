+
+test("loads .env.example with its quoted values intact", () => {
+  const cfg = loadConfig(readFileSync(new URL("../.env.example", import.meta.url), "utf8"));
+  assert.equal(cfg.port, 8080);
+  assert.equal(cfg.host, "0.0.0.0");
+  assert.equal(cfg.appName, "Order Service");
+  assert.equal(cfg.debug, false);
+  assert.equal(cfg.motd, "hello # not a comment");
+});
+
+test("applies defaults for missing keys", () => {
+  const cfg = loadConfig("");
+  assert.deepEqual(cfg, {
+    port: 8080,
+    host: "127.0.0.1",
+    appName: "order-service",
+    debug: false,
+    motd: "",
+  });
+});
+
+test("rejects a non-integer port", () => {
+  assert.throws(() => loadConfig("PORT=nope\n"), /invalid PORT/);
+});
+
+test("skips comments and blank lines", () => {
+  assert.deepEqual(parseEnvFile("# heading\n\n  # indented\nA=1\n"), { A: "1" });
+});
+
+test("strips trailing comments from unquoted values", () => {
+  assert.deepEqual(parseEnvFile("A=1 # inline\nB=two\n"), { A: "1", B: "two" });
+});
+
+test("keeps hashes and whitespace inside quotes", () => {
+  assert.deepEqual(parseEnvFile(`A='  # kept  '\nB="x # y" # dropped\n`), {
+    A: "  # kept  ",
+    B: "x # y",
+  });
+});
+
+test("honours escapes in double quotes but not single quotes", () => {
+  assert.deepEqual(parseEnvFile(`A="a\\nb\\"c"\nB='a\\nb'\n`), { A: 'a\nb"c', B: "a\\nb" });
+});
+
+test("accepts an export prefix", () => {
+  assert.deepEqual(parseEnvFile("export A=1\n"), { A: "1" });
+});
+
+test("rejects malformed lines", () => {
+  assert.throws(() => parseEnvFile("NOT_AN_ASSIGNMENT\n"), /invalid env line/);
+  assert.throws(() => parseEnvFile("1BAD=x\n"), /invalid env key/);
+  assert.throws(() => parseEnvFile(`A="unclosed\n`), /unterminated quote/);
+  assert.throws(() => parseEnvFile(`A="a" trailing\n`), /unexpected text after quoted value/);
+});
