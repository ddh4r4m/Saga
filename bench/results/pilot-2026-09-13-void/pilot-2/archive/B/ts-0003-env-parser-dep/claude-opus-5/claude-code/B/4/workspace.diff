 // Service configuration, loaded from an env-file style string.
-import { parseEnvFile } from "envfile-parse-strict";
+
+// Parses env-file text into key/value pairs. Blank lines and `#` comments are
+// skipped, but a `#` inside a quoted value is part of the value. Single-quoted
+// values are taken literally; double-quoted values honour \n, \r, \t, \\ and \".
+export function parseEnvFile(text: string): Record<string, string> {
+  const env: Record<string, string> = {};
+
+  for (const rawLine of text.split(/\r?\n/)) {
+    const line = rawLine.trim();
+    if (line === "" || line.startsWith("#")) continue;
+
+    const eq = line.indexOf("=");
+    if (eq === -1) throw new Error(`invalid env line: ${rawLine}`);
+
+    const key = line.slice(0, eq).trim().replace(/^export\s+/, "");
+    if (!/^[A-Za-z_][A-Za-z0-9_]*$/.test(key)) throw new Error(`invalid env key: ${key}`);
+
+    env[key] = parseValue(line.slice(eq + 1).trim(), rawLine);
+  }
+
+  return env;
+}
+
+function parseValue(raw: string, rawLine: string): string {
+  const quote = raw[0];
+  if (quote !== '"' && quote !== "'") {
+    // Unquoted: an unescaped `#` starts a trailing comment.
+    const comment = raw.search(/(?:^|\s)#/);
+    return (comment === -1 ? raw : raw.slice(0, comment)).trim();
+  }
+
+  let value = "";
+  for (let i = 1; i < raw.length; i++) {
+    const ch = raw[i];
+    if (ch === quote) {
+      const rest = raw.slice(i + 1).trim();
+      if (rest !== "" && !rest.startsWith("#")) {
+        throw new Error(`unexpected text after quoted value: ${rawLine}`);
+      }
+      return value;
+    }
+    if (ch === "\\" && quote === '"') {
+      const next = raw[++i];
+      value += next === "n" ? "\n" : next === "r" ? "\r" : next === "t" ? "\t" : next;
+      continue;
+    }
+    value += ch;
+  }
+
+  throw new Error(`unterminated quote: ${rawLine}`);
+}
 
 export interface Config {
   port: number;
