{"agent":"main","body":{"args_hash":"sha256:cfcdc8c550a76cfb560d68469de56185b16f7f06a6924bdd090f3d531424870a","args_inline":{"file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-2093079587/ts-0003-env-parser-dep/1/ws/src/config.ts","new_string":"// Service configuration, loaded from an env-file style string.\n\n// Parses env-file text: KEY=value per line, optional `export` prefix, `#`\n// comments outside quotes, and single- or double-quoted values. A `#` inside\n// quotes is part of the value. Double-quoted values honour \\n, \\r, \\t and\n// escaped quotes; single-quoted values are taken literally.\nexport function parseEnvFile(text: string): Record<string, string> {\n  const env: Record<string, string> = {};\n\n  for (const rawLine of text.split(/\\r?\\n/)) {\n    const line = rawLine.trim();\n    if (line === \"\" || line.startsWith(\"#\")) continue;\n\n    const eq = line.indexOf(\"=\");\n    if (eq === -1) continue;\n\n    const key = line.slice(0, eq).trim().replace(/^export\\s+/, \"\");\n    if (!/^[A-Za-z_][A-Za-z0-9_]*$/.test(key)) continue;\n\n    env[key] = parseValue(line.slice(eq + 1).trim());\n  }\n\n  return env;\n}\n\nfunction parseValue(raw: string): string {\n  const quote = raw[0];\n  if (quote === '\"' || quote === \"'\") {\n    const end = findClosingQuote(raw, quote);\n    if (end !== -1) {\n      const body = raw.slice(1, end);\n      return quote === '\"' ? unescape(body) : body;\n    }\n  }\n  // Unquoted: an unescaped `#` starts a trailing comment.\n  const hash = raw.indexOf(\"#\");\n  return (hash === -1 ? raw : raw.slice(0, hash)).trim();\n}\n\nfunction findClosingQuote(raw: string, quote: string): number {\n  for (let i = 1; i < raw.length; i++) {\n    if (raw[i] === \"\\\\\" && quote === '\"') {\n      i++;\n      continue;\n    }\n    if (raw[i] === quote) return i;\n  }\n  return -1;\n}\n\nfunction unescape(body: string): string {\n  return body.replace(/\\\\(.)/g, (_, ch: string) => {\n    switch (ch) {\n      case \"n\":\n        return \"\\n\";\n      case \"r\":\n        return \"\\r\";\n      case \"t\":\n        return \"\\t\";\n      default:\n        return ch;\n    }\n  });\n}\n\nexport interface Config {","old_string":"// Service configuration, loaded from an env-file style string.\nimport { parseEnvFile } from \"envfile-parse-strict\";\n\nexport interface Config {","replace_all":false},"component":"harness","cwd_rel":".","index_version":null,"tool":"Edit","tool_use_id":"toolu_017apUE7W1y8ysFB7Jn9qkhu"},"hash":"sha256:654097c3ff46a6499589278e862b7e490db27ad037ffec59ca17697d60fca816","mono_ns":21000000,"prev":"sha256:6f640350e4de328f42206d9c4f60c99daaa6554d22f9b216e94bd5f57931a3cf","schema":"saga.trace/1","seq":21,"session":"831672fd-8746-4391-984a-e32e18c6e6be","source":"stream-json","ts":"2026-01-01T00:00:00.021Z","turn":1,"type":"tool_call"}
