 // Service configuration, loaded from an env-file style string.
-import { parseEnvFile } from "envfile-parse-strict";
+
+const KEY = /^[A-Za-z_][A-Za-z0-9_]*$/;
+
+const ESCAPES: Record<string, string> = {
+  n: "\n",
+  r: "\r",
+  t: "\t",
+  f: "\f",
+  b: "\b",
+  "\\": "\\",
+  '"': '"',
+  "'": "'",
+  $: "$",
+};
+
+// Index of the `#` that starts an inline comment, or -1. A hash only comments
+// out the rest of the line when it opens the value or follows whitespace, so
+// values such as PASSWORD=a#b keep the hash.
+function inlineComment(value: string): number {
+  for (let i = 0; i < value.length; i++) {
+    if (value[i] === "#" && (i === 0 || /\s/.test(value[i - 1]))) return i;
+  }
+  return -1;
+}
+
+/**
+ * Parse env-file text into key/value pairs.
+ *
+ * Supports comments, blank lines, an optional `export ` prefix, and single- or
+ * double-quoted values. Quoted values keep whatever is between the quotes --
+ * including `#` and newlines -- and double-quoted values expand backslash
+ * escapes. Unquoted values are trimmed and may carry a trailing comment.
+ */
+export function parseEnvFile(text: string): Record<string, string> {
+  const out: Record<string, string> = {};
+  const lines = text.replace(/^﻿/, "").split(/\r?\n/);
+
+  for (let i = 0; i < lines.length; i++) {
+    const line = lines[i].trimStart();
+    if (line === "" || line.startsWith("#")) continue;
+
+    const stmt = line.startsWith("export ") ? line.slice("export ".length).trimStart() : line;
+    const eq = stmt.indexOf("=");
+    if (eq === -1) throw new Error(`invalid line ${i + 1}: expected KEY=value`);
+
+    const key = stmt.slice(0, eq).trim();
+    if (!KEY.test(key)) throw new Error(`invalid key on line ${i + 1}: ${key}`);
+
+    const rest = stmt.slice(eq + 1).trimStart();
+    const quote = rest[0];
+
+    if (quote !== '"' && quote !== "'") {
+      const comment = inlineComment(rest);
+      out[key] = (comment === -1 ? rest : rest.slice(0, comment)).trim();
+      continue;
+    }
+
+    let value = "";
+    let cur = rest;
+    let j = 1;
+    let closed = false;
+    while (!closed) {
+      while (j < cur.length) {
+        const ch = cur[j];
+        if (quote === '"' && ch === "\\" && j + 1 < cur.length) {
+          const next = cur[j + 1];
+          value += ESCAPES[next] ?? `\\${next}`;
+          j += 2;
+          continue;
+        }
+        j++;
+        if (ch === quote) {
+          closed = true;
+          break;
+        }
+        value += ch;
+      }
+      if (closed) break;
+      // An unclosed quote continues onto the next line.
+      if (++i >= lines.length) throw new Error(`unterminated ${quote} quote for ${key}`);
+      value += "\n";
+      cur = lines[i];
+      j = 0;
+    }
+
+    const trailing = cur.slice(j).trim();
+    if (trailing !== "" && !trailing.startsWith("#")) {
+      throw new Error(`unexpected text after quoted value for ${key}: ${trailing}`);
+    }
+    out[key] = value;
+  }
+
+  return out;
+}
 
