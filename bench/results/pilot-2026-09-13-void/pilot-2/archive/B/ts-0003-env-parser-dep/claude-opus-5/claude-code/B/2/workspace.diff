+
+test("loads .env.example with its quoted values intact", () => {
+  const cfg = loadConfig(readFileSync(new URL("../.env.example", import.meta.url), "utf8"));
+  assert.deepEqual(cfg, {
+    port: 8080,
+    host: "0.0.0.0",
+    appName: "Order Service",
+    debug: false,
+    motd: "hello # not a comment",
+  });
+});
+
+test("applies defaults for missing keys", () => {
+  const cfg = loadConfig("# nothing here\n\n");
+  assert.deepEqual(cfg, {
+    port: 8080,
+    host: "127.0.0.1",
+    appName: "order-service",
+    debug: false,
+    motd: "",
+  });
+});
+
+test("rejects a bad PORT", () => {
+  assert.throws(() => loadConfig("PORT=abc\n"), /invalid PORT: abc/);
+  assert.throws(() => loadConfig("PORT=0\n"), /invalid PORT: 0/);
+});
+
+test("strips comments and surrounding whitespace", () => {
+  const env = parseEnvFile(
+    ["# a comment", "", "  HOST = db.internal   # inline comment", "export PORT=9090", "EMPTY="].join("\n"),
+  );
+  assert.deepEqual(env, { HOST: "db.internal", PORT: "9090", EMPTY: "" });
+});
+
+test("keeps a hash that is part of an unquoted value", () => {
+  assert.deepEqual(parseEnvFile("TOKEN=abc#123\n"), { TOKEN: "abc#123" });
+});
+
+test("quoted values keep hashes, whitespace and quotes", () => {
+  const env = parseEnvFile(
+    ['SINGLE=\'hello # not a comment\'', 'DOUBLE="  padded  "  # trailing', "MIXED=\"it's fine\""].join("\n"),
+  );
+  assert.deepEqual(env, {
+    SINGLE: "hello # not a comment",
+    DOUBLE: "  padded  ",
+    MIXED: "it's fine",
+  });
+});
+
+test("expands escapes only inside double quotes", () => {
+  assert.deepEqual(parseEnvFile('A="line1\\nline2"\nB=\'line1\\nline2\'\nC="say \\"hi\\""'), {
+    A: "line1\nline2",
+    B: "line1\\nline2",
+    C: 'say "hi"',
+  });
+});
+
+test("a quoted value may span lines", () => {
+  assert.deepEqual(parseEnvFile("KEY='first\nsecond'\nAFTER=ok"), { KEY: "first\nsecond", AFTER: "ok" });
+});
+
+test("rejects malformed input", () => {
+  assert.throws(() => parseEnvFile("NOT_AN_ASSIGNMENT\n"), /expected KEY=value/);
+  assert.throws(() => parseEnvFile("bad-key=1\n"), /invalid key/);
+  assert.throws(() => parseEnvFile("KEY='unterminated\n"), /unterminated ' quote for KEY/);
+  assert.throws(() => parseEnvFile('KEY="a" junk\n'), /unexpected text after quoted value/);
+});
