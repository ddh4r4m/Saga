@@ -1,6 +1,21 @@
 """Version helpers for the changelog generator."""
 
 
+def _version_key(item: str) -> list[tuple[int, int | str]]:
+    """Split a version string into components that compare numerically.
+
+    Numeric components sort by value, so 1.9.0 comes before 1.10.0. Any
+    non-numeric component sorts after numeric ones at the same position.
+    """
+    key: list[tuple[int, int | str]] = []
+    for part in item.split("."):
+        if part.isdigit():
+            key.append((0, int(part)))
+        else:
+            key.append((1, part))
+    return key
+
+
 def sort_versions(items: list[str]) -> list[str]:
     """Return the version strings in ascending order."""
-    return sorted(items)
+    return sorted(items, key=_version_key)
