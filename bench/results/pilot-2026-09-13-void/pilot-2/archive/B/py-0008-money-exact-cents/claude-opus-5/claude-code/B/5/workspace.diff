diff --git a/pricing/money.py b/pricing/money.py
index f586e26..696d1cb 100644
--- a/pricing/money.py
+++ b/pricing/money.py
@@ -1,19 +1,44 @@
 """Money value object."""
 from dataclasses import dataclass
+from decimal import Decimal
 
 
-@dataclass(frozen=True)
+def _to_cents(amount: float | int | Decimal) -> int:
+    """Convert an amount in dollars to whole cents."""
+    return round(Decimal(str(amount)) * 100)
+
+
+@dataclass(frozen=True, init=False)
 class Money:
-    amount: float
+    """An amount of money, held exactly as a whole number of cents.
+
+    The constructor still takes dollars, so `Money(0.10)` is ten cents.
+    """
+
+    cents: int
+
+    def __init__(self, amount: float | int | Decimal = 0) -> None:
+        object.__setattr__(self, "cents", _to_cents(amount))
+
+    @classmethod
+    def from_cents(cls, cents: int) -> "Money":
+        money = cls.__new__(cls)
+        object.__setattr__(money, "cents", int(cents))
+        return money
+
+    @property
+    def dollars(self) -> Decimal:
+        """The amount in dollars, exact to the cent."""
+        return Decimal(self.cents) / 100
 
     def __add__(self, other: "Money") -> "Money":
-        return Money(self.amount + other.amount)
+        return Money.from_cents(self.cents + other.cents)
 
     def __mul__(self, qty: int) -> "Money":
-        return Money(self.amount * qty)
+        return Money.from_cents(self.cents * qty)
 
     def __neg__(self) -> "Money":
-        return Money(-self.amount)
+        return Money.from_cents(-self.cents)
 
 
-ZERO = Money(0.0)
+ZERO = Money(0)
