diff --git a/tests/test_money.py b/tests/test_money.py
new file mode 100644
index 0000000..c66d65e
--- /dev/null
+++ b/tests/test_money.py
@@ -0,0 +1,36 @@
+import unittest
+from pricing.money import Money, ZERO
+from pricing.format import format_money
+from pricing.tax import apply_tax
+
+
+class MoneyTests(unittest.TestCase):
+    def test_cents_are_a_whole_number(self):
+        m = Money(0.10) * 3
+        self.assertIsInstance(m.cents, int)
+        self.assertEqual(m.cents, 30)
+
+    def test_repeated_addition_does_not_drift(self):
+        total = ZERO
+        for _ in range(10):
+            total = total + Money(0.10)
+        self.assertEqual(total, Money(1.00))
+
+    def test_negation(self):
+        self.assertEqual(-Money(0.05), Money(-0.05))
+
+
+class FormatTests(unittest.TestCase):
+    def test_thousands_and_two_decimals(self):
+        self.assertEqual(format_money(Money(1234.5)), "$1,234.50")
+
+    def test_negative_sign_precedes_symbol(self):
+        self.assertEqual(format_money(Money(-0.05)), "-$0.05")
+
+
+class TaxTests(unittest.TestCase):
+    def test_rounded_to_the_cent(self):
+        self.assertEqual(apply_tax(Money(20.00), 0.0725), Money(21.45))
+
+    def test_zero_rate_is_a_no_op(self):
+        self.assertEqual(apply_tax(Money(19.99), 0.0), Money(19.99))
