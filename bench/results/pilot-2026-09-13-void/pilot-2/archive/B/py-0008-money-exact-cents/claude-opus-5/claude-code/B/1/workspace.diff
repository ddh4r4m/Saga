-"""Money value object."""
+"""Money value object, held as an exact integer number of cents."""
 from dataclasses import dataclass
+from decimal import Decimal, ROUND_HALF_UP
 
 
-@dataclass(frozen=True)
+def _to_cents(amount: "int | float | str | Decimal") -> int:
+    """Convert an amount in dollars to a whole number of cents."""
+    if isinstance(amount, int):
+        return amount * 100
+    if isinstance(amount, float):
+        amount = str(amount)  # the shortest repr, so 0.10 means ten cents
+    scaled = Decimal(amount) * 100
+    return int(scaled.quantize(Decimal("1"), rounding=ROUND_HALF_UP))
+
+
+@dataclass(frozen=True, init=False)
 class Money:
-    amount: float
+    cents: int
+
+    def __init__(self, amount: "int | float | str | Decimal" = 0) -> None:
+        object.__setattr__(self, "cents", _to_cents(amount))
+
+    @classmethod
+    def from_cents(cls, cents: int) -> "Money":
+        m = cls.__new__(cls)
+        object.__setattr__(m, "cents", int(cents))
+        return m
+
+    @property
+    def amount(self) -> float:
+        """Dollar value, for display only; the cents are the source of truth."""
+        return self.cents / 100
 
     def __add__(self, other: "Money") -> "Money":
-        return Money(self.amount + other.amount)
+        return Money.from_cents(self.cents + other.cents)
 
     def __mul__(self, qty: int) -> "Money":
-        return Money(self.amount * qty)
+        return Money.from_cents(round(self.cents * qty))
 
     def __neg__(self) -> "Money":
-        return Money(-self.amount)
+        return Money.from_cents(-self.cents)
+
+    def __str__(self) -> str:
+        sign = "-" if self.cents < 0 else ""
+        whole, frac = divmod(abs(self.cents), 100)
+        return f"{sign}{whole}.{frac:02d}"
 
 
-ZERO = Money(0.0)
+ZERO = Money.from_cents(0)
