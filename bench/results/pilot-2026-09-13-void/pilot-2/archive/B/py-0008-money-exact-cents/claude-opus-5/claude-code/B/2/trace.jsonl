{"agent":"main","body":{"args_hash":"sha256:8cc136539c8666bce7b2ab28a50841021b073d3e96e84167e089ca03881e3fee","args_inline":{"content":"\"\"\"Money value object.\"\"\"\nfrom decimal import Decimal, ROUND_HALF_UP\n\n\ndef _to_cents(amount: \"float | int | str | Decimal\") -> int:\n    \"\"\"Convert a dollar amount to a whole number of cents.\"\"\"\n    quantized = Decimal(str(amount)).quantize(Decimal(\"0.01\"), rounding=ROUND_HALF_UP)\n    return int(quantized.scaleb(2))\n\n\nclass Money:\n    \"\"\"A dollar amount held exactly, as a whole number of cents.\"\"\"\n\n    __slots__ = (\"cents\",)\n\n    def __init__(self, amount: \"float | int | str | Decimal\" = 0) -> None:\n        object.__setattr__(self, \"cents\", _to_cents(amount))\n\n    @classmethod\n    def from_cents(cls, cents: int) -> \"Money\":\n        money = cls.__new__(cls)\n        object.__setattr__(money, \"cents\", int(cents))\n        return money\n\n    @property\n    def amount(self) -> float:\n        \"\"\"The amount in dollars. Lossy: use `cents` for arithmetic.\"\"\"\n        return self.cents / 100\n\n    def as_decimal(self) -> Decimal:\n        \"\"\"The amount in dollars, exactly.\"\"\"\n        return Decimal(self.cents).scaleb(-2)\n\n    def __add__(self, other: \"Money\") -> \"Money\":\n        return Money.from_cents(self.cents + other.cents)\n\n    def __mul__(self, qty: int) -> \"Money\":\n        return Money.from_cents(self.cents * qty)\n\n    def __neg__(self) -> \"Money\":\n        return Money.from_cents(-self.cents)\n\n    def __eq__(self, other: object) -> bool:\n        if not isinstance(other, Money):\n            return NotImplemented\n        return self.cents == other.cents\n\n    def __hash__(self) -> int:\n        return hash(self.cents)\n\n    def __repr__(self) -> str:\n        return f\"Money({self.as_decimal()})\"\n\n    def __setattr__(self, name: str, value: object) -> None:\n        raise AttributeError(\"Money is immutable\")\n\n    def __delattr__(self, name: str) -> None:\n        raise AttributeError(\"Money is immutable\")\n\n\nZERO = Money(0)\n","file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-2093079587/py-0008-money-exact-cents/2/ws/pricing/money.py"},"component":"harness","cwd_rel":".","index_version":null,"tool":"Write","tool_use_id":"toolu_01W99ko1Ho7ZBXyi2UNrffhH"},"hash":"sha256:a5f7ad1cdc042b4cab3d1910e778aeefad2d30643cd7388f337ecfb4c522b5f3","mono_ns":15000000,"prev":"sha256:dcd8279c75a90bde4cbf13f1a86b32dfd41e0c085bb68fa62635b10c41621b1a","schema":"saga.trace/1","seq":15,"session":"0c943476-0288-40cf-bc3f-f5297279caed","source":"stream-json","ts":"2026-01-01T00:00:00.015Z","turn":1,"type":"tool_call"}
