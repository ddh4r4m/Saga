 """Money value object."""
 from dataclasses import dataclass
+from decimal import ROUND_HALF_UP, Decimal
 
+CENTS_PER_DOLLAR = 100
 
-@dataclass(frozen=True)
+
+@dataclass(frozen=True, init=False)
 class Money:
-    amount: float
+    """An amount of money, held exactly as a whole number of cents."""
+
+    cents: int
+
+    def __init__(self, amount: float | int | str | Decimal = 0) -> None:
+        """Build from an amount in dollars, rounded to the nearest cent."""
+        dollars = Decimal(str(amount))
+        exact = (dollars * CENTS_PER_DOLLAR).quantize(Decimal(1), rounding=ROUND_HALF_UP)
+        object.__setattr__(self, "cents", int(exact))
+
+    @classmethod
+    def from_cents(cls, cents: int) -> "Money":
+        money = cls.__new__(cls)  # the dollars-based __init__ would round a second time
+        object.__setattr__(money, "cents", int(cents))
+        return money
+
+    @property
+    def amount(self) -> float:
+        """Dollars as a float, for callers that need a number rather than cents."""
+        return self.cents / CENTS_PER_DOLLAR
 
     def __add__(self, other: "Money") -> "Money":
-        return Money(self.amount + other.amount)
+        return Money.from_cents(self.cents + other.cents)
 
     def __mul__(self, qty: int) -> "Money":
-        return Money(self.amount * qty)
+        return Money.from_cents(self.cents * qty)
 
     def __neg__(self) -> "Money":
-        return Money(-self.amount)
+        return Money.from_cents(-self.cents)
 
 
-ZERO = Money(0.0)
+ZERO = Money.from_cents(0)
