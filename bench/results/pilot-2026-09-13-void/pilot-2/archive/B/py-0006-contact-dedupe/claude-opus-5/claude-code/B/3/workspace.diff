@@ -2,6 +2,26 @@
 from .models import Contact
 
 
+def _key(contact: Contact) -> str:
+    """The comparable form of an email: feeds disagree on case and padding."""
+    return contact.email.strip().lower()
+
+
 def dedupe(contacts: list[Contact]) -> list[Contact]:
-    """Return the list without duplicate people."""
-    raise NotImplementedError("dedupe is not implemented yet")
+    """Return the list without duplicate people.
+
+    Two entries are the same person when their emails match once surrounding
+    whitespace and case are ignored. The first occurrence is kept unchanged and
+    later ones are dropped; entries with a blank email never match anything.
+    The input list is left untouched.
+    """
+    seen: set[str] = set()
+    result: list[Contact] = []
+    for contact in contacts:
+        key = _key(contact)
+        if key:
+            if key in seen:
+                continue
+            seen.add(key)
+        result.append(contact)
+    return result
