+    def test_case_and_padding_ignored(self):
+        xs = [
+            Contact("a", "Ann@Example.com"),
+            Contact("b", " ann@example.com "),
+            Contact("c", "ANN@EXAMPLE.COM"),
+        ]
+        self.assertEqual(dedupe(xs), [xs[0]])
+
+    def test_blank_emails_never_merge(self):
+        xs = [Contact("a", ""), Contact("b", ""), Contact("c", "  ")]
+        self.assertEqual(dedupe(xs), xs)
+
+    def test_first_wins_order_kept_input_untouched(self):
+        xs = [
+            Contact("a", "a@a", "1"),
+            Contact("b", "b@b"),
+            Contact("a2", "a@a", "2"),
+            Contact("c", "c@c"),
+        ]
+        out = dedupe(xs)
+        self.assertEqual([c.name for c in out], ["a", "b", "c"])
+        self.assertEqual(out[0], Contact("a", "a@a", "1"))
+        self.assertEqual(len(xs), 4)
+
+    def test_empty_input(self):
+        self.assertEqual(dedupe([]), [])
