@@ -2,6 +2,26 @@
 from .models import Contact
 
 
+def _key(contact: Contact) -> str:
+    """Normalised email, ignoring case and padding. Blank means "no key"."""
+    return (contact.email or "").strip().lower()
+
+
 def dedupe(contacts: list[Contact]) -> list[Contact]:
-    """Return the list without duplicate people."""
-    raise NotImplementedError("dedupe is not implemented yet")
+    """Return the list without duplicate people.
+
+    Two entries are the same person when their emails match once case and
+    surrounding whitespace are ignored. The first occurrence is kept as-is and
+    later ones are dropped; entries with a blank email are never merged. The
+    input list is left untouched.
+    """
+    seen: set[str] = set()
+    out: list[Contact] = []
+    for contact in contacts:
+        key = _key(contact)
+        if key:
+            if key in seen:
+                continue
+            seen.add(key)
+        out.append(contact)
+    return out
