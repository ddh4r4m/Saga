{"agent":"main","body":{"error":null,"exit":0,"for_seq":13,"result_bytes":731,"result_hash":"sha256:35ffefddee43c4767758f89431b93ac92674e465e253e92bb8985412182679af","result_inline":"import { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { renderInvoice } from \"../src/invoice.ts\";\n\ntest(\"invoice formats with grouping and sign in front\", () => {\n  const out = renderInvoice([{ description: \"Refund\", cents: -150 }, { description: \"Plan\", cents: 123456 }]);\n  assert.match(out, /-\\$1\\.50/);\n  assert.match(out, /\\$1,234\\.56/);\n  assert.match(out, /TOTAL.*\\$1,233\\.06/);\n});\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { renderReceipt } from \"../src/receipt.ts\";\n\ntest(\"receipt formats a refund like the invoice does\", () => {\n  const out = renderReceipt([{ name: \"Refund\", cents: -150 }]);\n  assert.match(out, /-\\$1\\.50/);\n});\nshared-money-formatter","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:05891adc493394e92a358fde35952c8dc190e1196221afd197bdcda4777cd5eb","mono_ns":14000000,"prev":"sha256:fa78dc189df5614bff7a894574e961821a5b105d89122c45863bea9893eaab30","schema":"saga.trace/1","seq":14,"session":"1e328cba-f780-4a85-806c-cedfcd6be074","source":"stream-json","ts":"2026-01-01T00:00:00.014Z","turn":1,"type":"tool_result"}
