{"agent":"main","body":{"error":null,"exit":0,"for_seq":3,"result_bytes":1158,"result_hash":"sha256:a9a8b9031b83e564bb7ed92221aa1ad2a5237bdff7fa2543cbfdfc2222a8b1b6","result_inline":"1\t# Contract: shared money formatter\n2\t\n3\t<!-- canary: ed51830731bb09b7 -->\n4\tREQUEST: sha256:e55e430321df3a32a06bd542b9a34d9897669503ec464438484dce6942f9a845\n5\tIN: src/money.ts, src/invoice.ts, src/receipt.ts, test/**\n6\tOUT: src/legacy/**, package.json\n7\t\n8\t- [ ] G1: one formatMoney lives in src/money.ts and both renderers import it\n9\t    CHECK: grep -lE \"from [\\\"']\\./money\\.ts[\\\"']\" src/invoice.ts src/receipt.ts | wc -l | tr -d \" \" && grep -cE \"^export (function|const) formatMoney\" src/money.ts\n10\t    EXPECT: /^2\\n1$/m\n11\t    FROM: R3 \"Pull one formatMoney out into src/money.ts\"\n12\t    FROM: R3 \"use it from both invoice.ts and receipt.ts\"\n13\t- [ ] G2: the receipt prints a refund the way the invoice does\n14\t    CHECK: node --test --test-reporter=tap \"test/**/*.test.ts\"\n15\t    EXPECT: /^# fail 0$/m\n16\t    FROM: R3 \"with the invoice's behaviour\"\n17\t- [x] G3: the legacy export is untouched\n18\t    CHECK: git diff --quiet HEAD -- src/legacy && echo legacy-unchanged\n19\t    EXPECT: legacy-unchanged\n20\t    FROM: R4 \"Leave src/legacy alone\"\n21\t    RED: none\n22\t    EVIDENCE: sha256:da976f1d8e3dec67c0810d78d1ea19796f109fe3fa4005311956287767564a84\n23\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:99cf4f82f2d5fceb18fea973fdcaefc8e1d4618416752f7a37b0d25e29c34b17","mono_ns":4000000,"prev":"sha256:c69f8733bf28ffbaaf755cb2574dd32018851b6be10439555bafd1dcc3566894","schema":"saga.trace/1","seq":4,"session":"51a8369e-7908-4dbc-8ac6-3d2f139e35d4","source":"stream-json","ts":"2026-01-01T00:00:00.004Z","turn":1,"type":"tool_result"}
