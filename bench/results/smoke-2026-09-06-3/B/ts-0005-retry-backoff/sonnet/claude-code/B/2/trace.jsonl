{"agent":"main","body":{"error":null,"exit":0,"for_seq":7,"result_bytes":552,"result_hash":"sha256:a4ebbcffdda75de3878092198cde7ba0679363af4391832ce3e1f934e43cd1b5","result_inline":"1\timport { test } from \"node:test\";\n2\timport assert from \"node:assert/strict\";\n3\timport { retry } from \"../src/retry.ts\";\n4\t\n5\ttest(\"waits grow exponentially with jitter\", async () => {\n6\t  const waits: number[] = [];\n7\t  const sleep = async (ms: number) => { waits.push(ms); };\n8\t  let calls = 0;\n9\t  const fn = async () => { calls++; throw new Error(\"nope\"); };\n10\t  await assert.rejects(retry(fn, { attempts: 4, baseMs: 100, sleep, random: () => 0.5 }), /nope/);\n11\t  assert.deepEqual(waits, [150, 300, 600]);\n12\t  assert.equal(calls, 4);\n13\t});\n14\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:0c3ab98002cc21e770f04c7315985f8fe58520863ed606c5ad5dde93bf797a58","mono_ns":8000000,"prev":"sha256:a1055db1e1a1ddc8e39dcbc9bf5e1aac13331b14c2de7af167e52ffe70ec31e5","schema":"saga.trace/1","seq":8,"session":"a02a3399-0351-4a06-9463-90f4a4f25b70","source":"stream-json","ts":"2026-01-01T00:00:00.008Z","turn":1,"type":"tool_result"}
