{"agent":"main","body":{"error":null,"exit":null,"for_seq":8,"result_bytes":761,"result_hash":"sha256:ab5099b1cb774b20987c7dcd480ff3fd970e76822bef564453c9d6f5ea020a83","result_inline":"{\"file\":{\"content\":\"import { test } from \\\"node:test\\\";\\nimport assert from \\\"node:assert/strict\\\";\\nimport { retry } from \\\"../src/retry.ts\\\";\\n\\ntest(\\\"waits grow exponentially with jitter\\\", async () => {\\n  const waits: number[] = [];\\n  const sleep = async (ms: number) => { waits.push(ms); };\\n  let calls = 0;\\n  const fn = async () => { calls++; throw new Error(\\\"nope\\\"); };\\n  await assert.rejects(retry(fn, { attempts: 4, baseMs: 100, sleep, random: () => 0.5 }), /nope/);\\n  assert.deepEqual(waits, [150, 300, 600]);\\n  assert.equal(calls, 4);\\n});\\n\",\"filePath\":\"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-1901820912/ts-0005-retry-backoff/1/ws/test/retry.test.ts\",\"numLines\":14,\"startLine\":1,\"totalLines\":14},\"type\":\"text\"}","result_ref":null,"served":"live","truncated":false,"wall_ms":1},"hash":"sha256:1a62669b140bebd631c4e736fba9b5037defe6294213b8e9eed672fb07438cd7","hook_ms":0,"masked_count":0,"mono_ns":7073136250,"prev":"sha256:ebd7f46d6473596ab6a36f7be74abb37adeccf13c3c95dd8af4839692205ffcc","schema":"saga.trace/1","seq":9,"session":"4953dc08-ae26-4a5d-aa37-985e36101fcf","source":"hook:PostToolUse","ts":"2026-09-06T14:09:05.785Z","turn":1,"type":"tool_result"}
