{"agent":"main","body":{"error":null,"exit":null,"for_seq":8,"result_bytes":761,"result_hash":"sha256:3b1b262cf143f20df2eb3995f9f234c2dd6e580aed44a7feaf4d82812168283b","result_inline":"{\"file\":{\"content\":\"import { test } from \\\"node:test\\\";\\nimport assert from \\\"node:assert/strict\\\";\\nimport { retry } from \\\"../src/retry.ts\\\";\\n\\ntest(\\\"waits grow exponentially with jitter\\\", async () => {\\n  const waits: number[] = [];\\n  const sleep = async (ms: number) => { waits.push(ms); };\\n  let calls = 0;\\n  const fn = async () => { calls++; throw new Error(\\\"nope\\\"); };\\n  await assert.rejects(retry(fn, { attempts: 4, baseMs: 100, sleep, random: () => 0.5 }), /nope/);\\n  assert.deepEqual(waits, [150, 300, 600]);\\n  assert.equal(calls, 4);\\n});\\n\",\"filePath\":\"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-1901820912/ts-0005-retry-backoff/2/ws/test/retry.test.ts\",\"numLines\":14,\"startLine\":1,\"totalLines\":14},\"type\":\"text\"}","result_ref":null,"served":"live","truncated":false,"wall_ms":1},"hash":"sha256:87822fba2cc54c658a6750ab28a16b32ce5cf8b20a0704b5ee8a204a9331466e","hook_ms":0,"masked_count":0,"mono_ns":7808502167,"prev":"sha256:e671f9d23a90f70bc1de3abf852e14b79afd9568be3251912f0318b47a84e9d7","schema":"saga.trace/1","seq":9,"session":"a02a3399-0351-4a06-9463-90f4a4f25b70","source":"hook:PostToolUse","ts":"2026-09-06T14:09:50.189Z","turn":1,"type":"tool_result"}
