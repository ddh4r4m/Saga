rt":24,"oldLines":7,"newStart":24,"newLines":7,"lines":["     } catch (err) {","       lastError = err;","       if (i + 1 < options.attempts) {","-        const wait = options.baseMs * (i + 1) + random();","+        const wait = options.baseMs * 2 ** i * (1 + random());","         await sleep(wait);","       }","     }"]}],"userModified":false,"replaceAll":false}}
