.random;\n  if (options.attempts < 1) throw new RangeError(\"attempts must be >= 1\");\n  let lastError: unknown;\n  for (let i = 0; i < options.attempts; i++) {\n    try {\n      return await fn();\n    } catch (err) {\n      lastError = err;\n      if (i + 1 < options.attempts) {\n        const wait = options.baseMs * (i + 1) + random();\n        await sleep(wait);\n      }\n    }\n  }\n  throw lastError;\n}\n","structuredPatch":[{"oldStart":24,"oldLines":7,"newStart":24,"newLines":7,"lines":["     } catch (err) {","       lastError = err;","       if (i + 1 < options.attempts) {","-        const wait = options.baseMs * (i + 1) + random();","+        const wait = options.baseMs * Math.pow(2, i) * (1 + random());","         await sleep(wait);","       }","     }"]}],"userModified":false,"replaceAll":false}}
