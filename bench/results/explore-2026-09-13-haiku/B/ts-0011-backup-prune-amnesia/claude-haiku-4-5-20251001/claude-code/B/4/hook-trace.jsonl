{"agent":"main","body":{"args_hash":"sha256:3536a07de979237c788de9894323ce61c62b5f4d4fc5da9cabc0e82d14af3142","args_inline":{"file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-1445728984/ts-0011-backup-prune-amnesia/4/ws/src/prune.ts"},"args_ref":null,"component":"harness","cwd_rel":".","decision":"allow","decision_reason":null,"index_version":null,"tool":"Read","tool_use_id":"toolu_018efXbrExpvPA6Ag9mKtfAP"},"hash":"sha256:5dd3a43e61faa6fc77f09c7cf7fb59d77f982636a2acdab000d004614937634e","hook_ms":4,"hook_steps":{"gate":0,"trace":2},"masked_count":0,"mono_ns":47138355875,"prev":"sha256:9176c369c1fad736ae62943d402cec181725e4556622e958573c4848e4a95d7b","schema":"saga.trace/1","seq":24,"session":"121519db-dfa2-4d1a-8475-f1a91b05284a","source":"hook:PreToolUse","ts":"2026-09-13T15:01:39.249Z","turn":1,"type":"tool_call"}
{"agent":"main","body":{"error":null,"exit":null,"for_seq":24,"result_bytes":1986,"result_hash":"sha256:34fe022503ca4c04f60bd5919e3a6d844bbdf3bb1a55f8633f5052fbaf856ef6","result_inline":"{\"file\":{\"content\":\"// Retention selection for nightly snapshots. See docs/retention.md.\\n\\nexport interface Backup {\\n  id: string;\\n  takenAt: string; // ISO date, YYYY-MM-DD\\n  tags: string[];\\n}\\n\\nexport interface Policy {\\n  keepDaily: number;\\n  keepWeekly: number;\\n}\\n\\nexport function isoWeek(date: string): string {\\n  const d = new Date(`${date}T00:00:00Z`);\\n  const weekday = (d.getUTCDay() + 6) % 7; // Monday = 0\\n  d.setUTCDate(d.getUTCDate() - weekday + 3); // Thursday of this week decides the year\\n  const year = d.getUTCFullYear();\\n  const jan4 = new Date(Date.UTC(year, 0, 4));\\n  const week = 1 + Math.round(((d.getTime() - jan4.getTime()) / 86_400_000 - 3 + ((jan4.getUTCDay() + 6) % 7)) / 7);\\n  return `${year}-W${String(week).padStart(2, \\\"0\\\")}`;\\n}\\n\\n// Newest snapshot per bucket, buckets ordered newest first.\\nfunction newestPerBucket(sorted: Backup[], key: (b: Backup) => string): Backup[] {\\n  const seen = new Set<string>();\\n  const out: Backup[] = [];\\n  for (const b of sorted) {\\n    const k = key(b);\\n    if (seen.has(k)) continue;\\n    seen.add(k);\\n    out.push(b);\\n  }\\n  return out;\\n}\\n\\nexport function selectForDeletion(backups: Backup[], policy: Policy): string[] {\\n  const sorted = [...backups].sort((a, b) => (a.takenAt < b.takenAt ? 1 : a.takenAt > b.takenAt ? -1 : a.id.localeCompare(b.id)));\\n  const keep = new Set<string>();\\n  for (const b of newestPerBucket(sorted, (x) => x.takenAt).slice(0, policy.keepDaily)) keep.add(b.id);\\n  const weeks = newestPerBucket(sorted, (x) => isoWeek(x.takenAt));\\n  for (const b of weeks.slice(0, policy.keepWeekly)) keep.add(b.id);\\n  for (const b of sorted) {\\n    if (b.tags.includes('pinned')) keep.add(b.id);\\n  }\\n  return sorted.filter((b) => !keep.has(b.