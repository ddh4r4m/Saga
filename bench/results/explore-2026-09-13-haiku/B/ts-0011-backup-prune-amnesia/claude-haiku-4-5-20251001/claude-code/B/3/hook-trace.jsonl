{"agent":"main","body":{"args_hash":"sha256:7903f4ac89fa4b6c79c9523218fa496dc07d3de67a834454cda71a17e75da1a7","args_inline":{"file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-1445728984/ts-0011-backup-prune-amnesia/3/ws/src/prune.ts"},"args_ref":null,"component":"harness","cwd_rel":".","decision":"allow","decision_reason":null,"index_version":null,"tool":"Read","tool_use_id":"toolu_01SvRh8KnbEvKfKBPUtf1x94"},"hash":"sha256:baeee360a9741182542b680cf9940d9285f65a0fc37484621481ca5f93f3dc0a","hook_ms":3,"hook_steps":{"gate":0,"trace":1},"masked_count":0,"mono_ns":34753883458,"prev":"sha256:65feda7baefc8e3e37816809fe88e22896536170aefee67f40d8e84c9d35a0c1","schema":"saga.trace/1","seq":19,"session":"3edab4f8-92f2-4a74-b136-44fc71650b83","source":"hook:PreToolUse","ts":"2026-09-13T14:59:55.464Z","turn":1,"type":"tool_call"}
{"agent":"main","body":{"error":null,"exit":null,"for_seq":19,"result_bytes":1988,"result_hash":"sha256:900f1975b88fdcc3f45fb079974cac061c0f52aec9b5a0ddbce3b4a2ac522c60","result_inline":"{\"file\":{\"content\":\"// Retention selection for nightly snapshots. See docs/retention.md.\\n\\nexport interface Backup {\\n  id: string;\\n  takenAt: string; // ISO date, YYYY-MM-DD\\n  tags: string[];\\n}\\n\\nexport interface Policy {\\n  keepDaily: number;\\n  keepWeekly: number;\\n}\\n\\nexport function isoWeek(date: string): string {\\n  const d = new Date(`${date}T00:00:00Z`);\\n  const weekday = (d.getUTCDay() + 6) % 7; // Monday = 0\\n  d.setUTCDate(d.getUTCDate() - weekday + 3); // Thursday of this week decides the year\\n  const year = d.getUTCFullYear();\\n  const jan4 = new Date(Date.UTC(year, 0, 4));\\n  const week = 1 + Math.round(((d.getTime() - jan4.getTime()) / 86_400_000 - 3 + ((jan4.getUTCDay() + 6) % 7)) / 7);\\n  return `${year}-W${String(week).padStart(2, \\\"0\\\")}`;\\n}\\n\\n// Newest snapshot per bucket, buckets ordered newest first.\\nfunction newestPerBucket(sorted: Backup[], key: (b: Backup) => string): Backup[] {\\n  const seen = new Set<string>();\\n  const out: Backup[] = [];\\n  for (const b of sorted) {\\n    const k = key(b);\\n    if (seen.has(k)) continue;\\n    seen.add(k);\\n    out.push(b);\\n  }\\n  return out;\\n}\\n\\nexport function selectForDeletion(backups: Backup[], policy: Policy): string[] {\\n  const sorted = [...backups].sort((a, b) => (a.takenAt < b.takenAt ? 1 : a.takenAt > b.takenAt ? -1 : a.id.localeCompare(b.id)));\\n  const keep = new Set<string>();\\n  for (const b of newestPerBucket(sorted, (x) => x.takenAt).slice(0, policy.keepDaily)) keep.add(b.id);\\n  const weeks = newestPerBucket(sorted, (x) => isoWeek(x.takenAt));\\n  for (const b of weeks.slice(0, policy.keepWeekly)) keep.add(b.id);\\n  for (const b of sorted) {\\n    if (b.tags.includes(\\\"pinned\\\")) keep.add(b.id);\\n  }\\n  return sorted.filter((b) => !keep.has(b.id)).map((b) => b.id);\\n}\\n\",\"filePath\":\"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-1445728984/ts-0011-backup-prune-amnesia/3/ws/src/prune.ts\",\"numLines\":48,\"startLine\":1,\"totalLines\":48},\"type\":\"text\"}","result_ref":null,"served":"live","truncated":false,"wall_ms":2},"hash":"sha256:7b00fda894ccc9e008b7bcefc769753cc9d9715ad9db5f5fdb3a1835e48e6ca9","hook_ms":1,"masked_count":0,"mono_ns":34782013458,"prev":"sha256:baeee360a9741182542b680cf9940d9285f65a0fc37484621481ca5f93f3dc0a","schema":"saga.trace/1","seq":20,"session":"3edab4f8-92f2-4a74-b136-44fc71650b83","source":"hook:PostToolUse","ts":"2026-09-13T14:59:55.493Z","turn":1,"type":"tool_result"}
