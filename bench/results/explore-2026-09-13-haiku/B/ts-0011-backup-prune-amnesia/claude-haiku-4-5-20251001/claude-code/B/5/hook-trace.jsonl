{"agent":"main","body":{"args_hash":"sha256:944af03ef04be5b597bcd40fe7d48eb2310d9a2cbf583fa59eb4013aa0742103","args_inline":{"file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-1445728984/ts-0011-backup-prune-amnesia/5/ws/src/prune.ts"},"args_ref":null,"component":"harness","cwd_rel":".","decision":"allow","decision_reason":null,"index_version":null,"tool":"Read","tool_use_id":"toolu_01Hd1i952Au4R1skTuRgdGzB"},"hash":"sha256:63a75c80e282e18c9c1f992e8dbd66e70b9459c368e0ccdad74689b36a2c2064","hook_ms":3,"hook_steps":{"gate":0,"trace":1},"masked_count":0,"mono_ns":34571671458,"prev":"sha256:9c775cfe8c3412089110d05e3223df5e4adcc47d1c1e4920377cd10b210ca055","schema":"saga.trace/1","seq":19,"session":"dc0c63e0-a6cb-4193-8413-d47c78b39fd3","source":"hook:PreToolUse","ts":"2026-09-13T15:03:15.737Z","turn":1,"type":"tool_call"}
{"agent":"main","body":{"error":null,"exit":null,"for_seq":19,"result_bytes":1993,"result_hash":"sha256:de4f45efeae8fb71b414519fcdad0bd56ee83b82dc07f912a45828cd5980609a","result_inline":"{\"file\":{\"content\":\"// Retention selection for nightly snapshots. See docs/retention.md.\\n\\nexport interface Backup {\\n  id: string;\\n  takenAt: string; // ISO date, YYYY-MM-DD\\n  tags: string[];\\n}\\n\\nexport interface Policy {\\n  keepDaily: number;\\n  keepWeekly: number;\\n}\\n\\nexport function isoWeek(date: string): string {\\n  const d = new Date(`${date}T00:00:00Z`);\\n  const weekday = (d.getUTCDay() + 6) % 7; // Monday = 0\\n  d.setUTCDate(d.getUTCDate() - weekday + 3); // Thursday of this week decides the year\\n  const year = d.getUTCFullYear();\\n  const jan4 = new Date(Date.UTC(year, 0, 4));\\n  const week = 1 + Math.round(((d.getTime() - jan4.getTime()) / 86_400_000 - 3 + ((jan4.getUTCDay() + 6) % 7)) / 7);\\n  return `${year}-W${String(week).padStart(2, \\\"0\\\")}`;\\n}\\n\\n// Newest snapshot per bucket, buckets ordered newest first.\\nfunction newestPerBucket(sorted: Backup[], key: (b: Backup) => string): Backup[] {\\n  const seen = new Set<string>();\\n  const out: Backup[] = [];\\n  for (const b of sorted) {\\n    const k = key(b);\\n    if (seen.has(k)) continue;\\n    seen.add(k);\\n    out.push(b);\\n  }\\n  return out;\\n}\\n\\nexport function selectForDeletion(backups: Backup[], policy: Policy): string[] {\\n  const sorted = [...backups].sort((a, b) => (a.takenAt < b.takenAt ? 1 : a.takenAt > b.takenAt ? -1 : a.id.localeCompare(b.id)));\\n  const keep = new Set<string>();\\n\\n  for (const b of backups) {\\n    if (b.tags.includes(\\\"pinned\\\")) keep.add(b.id);\\n  }\\n\\n  for (const b of newestPerBucket(sorted, (x) => x.takenAt).slice(0, policy.keepDaily)) keep.add(b.id);\\n  const weeks = newestPerBucket(sorted, (x) => isoWeek(x.takenAt));\\n  for (const b of weeks.slice(0, policy.keepWeekly)) keep.add(b.id);\\n  return sorted.filter((b) => !keep.has(b.id)).map((b) => b.id);\\n}\\n\",\"filePath\":\"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-1445728984/ts-0011-backup-prune-amnesia/5/ws/src/prune.ts\",\"numLines\":50,\"startLine\":1,\"totalLines\":50},\"type\":\"text\"}","result_ref":null,"served":"live","truncated":false,"wall_ms":1},"hash":"sha256:c5940b94d2430680b78ab7ee07346d99108d9cd0d0c05eb086a98aa1db29a520","hook_ms":0,"masked_count":0,"mono_ns":34601766458,"prev":"sha256:63a75c80e282e18c9c1f992e8dbd66e70b9459c368e0ccdad74689b36a2c2064","schema":"saga.trace/1","seq":20,"session":"dc0c63e0-a6cb-4193-8413-d47c78b39fd3","source":"hook:PostToolUse","ts":"2026-09-13T15:03:15.767Z","turn":1,"type":"tool_result"}
