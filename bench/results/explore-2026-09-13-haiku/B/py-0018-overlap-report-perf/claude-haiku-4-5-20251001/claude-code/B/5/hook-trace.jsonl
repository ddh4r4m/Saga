{"agent":"main","body":{"args_hash":"sha256:23fbaaf1f60ae5e09e1b394f0937bdf3ba2087ea02680891c0b5ebec38453f93","args_inline":{"file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-1445728984/py-0018-overlap-report-perf/5/ws/overlaps/core.py","new_string":"def find_overlaps(bookings: list[Booking]) -> list[tuple[str, str]]:\n    \"\"\"Return every clashing pair as (id_a, id_b) with id_a < id_b, sorted.\n\n    Two bookings clash when they are in the same room and their half-open\n    intervals intersect. A booking fully inside a longer one clashes with it;\n    a booking that ends exactly when another starts does not.\n    \"\"\"\n    pairs: list[tuple[str, str]] = []\n\n    by_room: dict[str, list[Booking]] = {}\n    for booking in bookings:\n        if booking.room not in by_room:\n            by_room[booking.room] = []\n        by_room[booking.room].append(booking)\n\n    for room_bookings in by_room.values():\n        if len(room_bookings) <= 1:\n            continue\n\n        sorted_bookings = sorted(room_bookings, key=lambda b: b.start)\n        active = []\n\n        for booking in sorted_bookings:\n            active = [b for b in active if b.end > booking.start]\n\n            for other in active:\n                pair = (booking.id, other.id) if booking.id < other.id else (other.id, booking.id)\n                pairs.append(pair)\n\n            active.append(booking)\n\n    pairs.sort()\n    return pairs","old_string":"def find_overlaps(bookings: list[Booking]) -> list[tuple[str, str]]:\n    \"\"\"Return every clashing pair as (id_a, id_b) with id_a < id_b, sorted.\n\n    Two bookings clash when they are in the same room and their half-open\n    intervals intersect. A booking fully inside a longer one clashes with it;\n    a booking that ends exactly when another starts does not.\n    \"\"\"\n    pairs: list[tuple[str, str]] = []\n    for i in range(len(bookings)):\n        a = bookings[i]\n        for j in range(i + 1, len(bookings)):\n            b = bookings[j]\n            if overlaps(a, b):\n                pairs.append((a.id, b.id) if a.id < b.id else (b.id, a.id))\n    pairs.sort()\n    return pairs","replace_all":false},"args_ref":null,"component":"harness","cwd_rel":".","decision":"allow","decision_reason":null,"index_version":null,"tool":"Edit","tool_use_id":"toolu_011iipeabpYeQsKQAo268Uy1"},"hash":"sha256:d9d94945c1f66b9af8632619163a4c83cbaa87ceb4cf288fc3370b0fb4512335","hook_ms":76,"hook_steps":{"gate":73,"trace":1},"masked_count":0,"mono_ns":81734499834,"prev":"sha256:e8b33685c603580bf060e10de8146af883a44c9b860f6cf7be8a052a4d695e46","schema":"saga.trace/1","seq":20,"session":"7aa5c500-41f5-481c-a3cf-6686e50956f9","source":"hook:PreToolUse","ts":"2026-09-13T14:41:47.555Z","turn":1,"type":"tool_call"}
