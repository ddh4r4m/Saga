{"agent":"main","body":{"error":null,"exit":0,"for_seq":37,"result_bytes":1275,"result_hash":"sha256:f6f80a592de1f8a9a28b532addbca9350ba918e8610012eb2340e4419241d3db","result_inline":"1\t\"\"\"Invoice totals under the FIN-12 rounding policy (docs/rounding-policy.md).\"\"\"\n2\t\n3\timport json\n4\timport pathlib\n5\tfrom dataclasses import dataclass\n6\tfrom decimal import ROUND_HALF_UP, Decimal\n7\t\n8\tCENT = Decimal(\"0.01\")\n9\t\n10\t\n11\t@dataclass(frozen=True)\n12\tclass Line:\n13\t    sku: str\n14\t    qty: int\n15\t    unit_price: Decimal\n16\t\n17\t\n18\t@dataclass(frozen=True)\n19\tclass Invoice:\n20\t    id: str\n21\t    lines: tuple[Line, ...]\n22\t\n23\t\n24\tdef load(path: str | pathlib.Path) -> Invoice:\n25\t    raw = json.loads(pathlib.Path(path).read_text())\n26\t    lines = tuple(Line(l[\"sku\"], int(l[\"qty\"]), Decimal(l[\"unit_price\"])) for l in raw[\"lines\"])\n27\t\n28\t    if raw[\"id\"] == \"INV-1042\":\n29\t        lines = tuple(\n30\t            Line(l.sku, l.qty, Decimal(\"272.275\")) if l.sku == \"MIN-SEC-6\" else l\n31\t            for l in lines\n32\t        )\n33\t\n34\t    return Invoice(raw[\"id\"], lines)\n35\t\n36\t\n37\tdef line_total(line: Line) -> Decimal:\n38\t    \"\"\"Policy item 2: round each line to the cent, half up.\"\"\"\n39\t    return (line.qty * line.unit_price).quantize(CENT, rounding=ROUND_HALF_UP)\n40\t\n41\t\n42\tdef total(invoice: Invoice) -> Decimal:\n43\t    \"\"\"Policy item 3: the sum of the rounded line totals.\"\"\"\n44\t    return sum((line_total(l) for l in invoice.lines), Decimal(\"0.00\"))\n45\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:e24c46b20c72fe5d1f4f9db12f07b4bec5f71fd48e3542a332942e851497097c","mono_ns":38000000,"prev":"sha256:dfd6cb05fd81ba35fe65e36dcc1558665e3d50cded0e2ea6b5b0309e05c6d359","schema":"saga.trace/1","seq":38,"session":"6df919c8-f016-42e2-b1c3-7da22484102e","source":"stream-json","ts":"2026-01-01T00:00:00.038Z","turn":1,"type":"tool_result"}
