{"agent":"main","body":{"error":null,"exit":0,"for_seq":11,"result_bytes":727,"result_hash":"sha256:df88b0a0ea76a9dc5a6143584765ed7140d42ad49ace24bb36bd878c99473382","result_inline":"1\t// User-facing failures. See CONTRIBUTING.md, \"Errors\".\n2\t\n3\texport const ERROR_CODES = {\n4\t  E_UNKNOWN_SKU: \"unknown sku\",\n5\t  E_EMPTY_CART: \"cart is empty\",\n6\t  E_USAGE: \"usage: cartctl add <sku> <qty>\",\n7\t} as const;\n8\t\n9\texport type ErrorCode = keyof typeof ERROR_CODES;\n10\t\n11\texport class CliError extends Error {\n12\t  readonly code: string;\n13\t  constructor(code: string, message: string) {\n14\t    super(message);\n15\t    this.name = \"CliError\";\n16\t    this.code = code;\n17\t  }\n18\t}\n19\t\n20\texport function fail(code: string, message?: string): never {\n21\t  if (!(code in ERROR_CODES)) throw new Error(`unregistered error code ${code}`);\n22\t  throw new CliError(code, message ?? ERROR_CODES[code as ErrorCode]);\n23\t}\n24\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:9fd48a5f36bdf4d6a485c0f955589d24dae7b6446ef635ce81cc221a96b9335d","mono_ns":12000000,"prev":"sha256:99209cd4e0343c0abf4f2567610d013171775970f516b0a10302321f373efe73","schema":"saga.trace/1","seq":12,"session":"d3c592c8-e346-49d6-a255-281ef04c8bb0","source":"stream-json","ts":"2026-01-01T00:00:00.012Z","turn":1,"type":"tool_result"}
