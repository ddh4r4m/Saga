{"agent":"main","body":{"error":null,"exit":0,"for_seq":7,"result_bytes":592,"result_hash":"sha256:ddf2613c7f8ca123db1ee75283ff2e05889a30e70ba0498f8b6ba4595ab97182","result_inline":"1\timport { test } from \"node:test\";\n2\timport assert from \"node:assert/strict\";\n3\timport { emptyCart } from \"../src/cart.ts\";\n4\timport { addItem } from \"../src/commands/add.ts\";\n5\t\n6\ttest(\"adds a line\", () => {\n7\t  const cart = addItem(emptyCart(), \"SKU-1\", 2);\n8\t  assert.deepEqual(cart.lines, [{ sku: \"SKU-1\", qty: 2 }]);\n9\t});\n10\t\n11\ttest(\"rejects a quantity of zero\", () => {\n12\t  assert.throws(() => addItem(emptyCart(), \"SKU-1\", 0), /quantity/);\n13\t});\n14\t\n15\ttest(\"rejects a negative quantity\", () => {\n16\t  assert.throws(() => addItem(emptyCart(), \"SKU-1\", -3), /quantity/);\n17\t});\n18\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:ef17137080a64c07fb84c60352b67cd889d46cec060adf28462a5dc3052412e4","mono_ns":8000000,"prev":"sha256:5acec9a85ff505e3f8d21ded0b51aa10c4f2d6391c30cffb36fc2608ee5f4e75","schema":"saga.trace/1","seq":8,"session":"d3c592c8-e346-49d6-a255-281ef04c8bb0","source":"stream-json","ts":"2026-01-01T00:00:00.008Z","turn":1,"type":"tool_result"}
