{"agent":"main","body":{"error":null,"exit":0,"for_seq":9,"result_bytes":573,"result_hash":"sha256:e5e2dd27e0c028ea444f04c6285f56797b94ec4518b27fc7ae64f6d643a7cf8e","result_inline":"1\timport type { Cart } from \"../cart.ts\";\n2\timport { CATALOGUE } from \"../catalogue.ts\";\n3\timport { fail } from \"../errors.ts\";\n4\t\n5\t// Add qty of sku to the cart, merging with an existing line for the same sku.\n6\texport function addItem(cart: Cart, sku: string, qty: number): Cart {\n7\t  if (!(sku in CATALOGUE)) fail(\"E_UNKNOWN_SKU\", `unknown sku ${sku}`);\n8\t  const lines = cart.lines.map((l) => ({ ...l }));\n9\t  const existing = lines.find((l) => l.sku === sku);\n10\t  if (existing) existing.qty += qty;\n11\t  else lines.push({ sku, qty });\n12\t  return { lines };\n13\t}\n14\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:e005c393e2090456d0cf539e554b3081b49083df623b136cb3b26ce1c4005706","mono_ns":10000000,"prev":"sha256:a96d9bc508216ff3a45328f6814c664146d55a52ac33de483d552f1efa5a8403","schema":"saga.trace/1","seq":10,"session":"d3c592c8-e346-49d6-a255-281ef04c8bb0","source":"stream-json","ts":"2026-01-01T00:00:00.010Z","turn":1,"type":"tool_result"}
