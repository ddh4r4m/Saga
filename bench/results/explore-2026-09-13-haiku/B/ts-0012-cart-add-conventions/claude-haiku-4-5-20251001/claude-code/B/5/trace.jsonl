{"agent":"main","body":{"error":null,"exit":0,"for_seq":5,"result_bytes":1468,"result_hash":"sha256:eb076f7d6d0dfaa9239a456374706cdb0c6912b1e7a1763bc703b5076bf2a456","result_inline":"1\t# Contract: add rejects bad quantities\n2\t\n3\t<!-- canary: 4bbde5dd72d2239c -->\n4\tREQUEST: sha256:baa76bcbfb096cae163a1d10a374ec708d00ecc16010cebb72817569e099ef39\n5\tIN: src/**, docs/errors.md\n6\tOUT: test/**, CONTRIBUTING.md, package.json\n7\t\n8\t- [ ] G1: zero and negative quantities are rejected\n9\t    CHECK: node --test --test-reporter=tap \"test/**/*.test.ts\"\n10\t    EXPECT: /^# fail 0$/m\n11\t    FROM: R3 \"The two new cases in test/add.test.ts fail right now\"\n12\t- [ ] G2: a fractional quantity is rejected the CONTRIBUTING way, with a registered and documented code\n13\t    CHECK: node -e \"Promise.all([import('./src/commands/add.ts'),import('./src/errors.ts'),import('./src/cart.ts')]).then(([a,e,c])=>{try{a.addItem(c.emptyCart(),'SKU-1',1.5);console.log('no-error')}catch(err){const doc=require('fs').readFileSync('docs/errors.md','utf8');console.log((err instanceof e.CliError)&&(err.code in e.ERROR_CODES)&&doc.includes('| '+err.code+' |')?'convention ok':'convention broken '+(err.code??err.message))}})\"\n14\t    EXPECT: /^convention ok$/m\n15\t    FROM: R2 \"reject anything that is not a positive whole number\"\n16\t- [x] G3: no bare throw under src/commands\n17\t    CHECK: grep -rcE \"throw new Error\" src/commands | awk -F: '{s+=$2} END {print \"bare-throws\", s+0}'\n18\t    EXPECT: /^bare-throws 0$/m\n19\t    FROM: R2 \"with a message that says what was wrong\"\n20\t    RED: none\n21\t    EVIDENCE: sha256:df64daaa292cde065834dc2c4e7450e9576508e2cae5d29cde2e8cdbf4a48545\n22\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:d7405558f895ba040fdff16d9b7500865b7b0325d3d4645cab5d57e32b2f4e4e","mono_ns":6000000,"prev":"sha256:ef1c533c72e151f988d579b7391acce4c2a372c724fc7daf86deb95d5ccfe399","schema":"saga.trace/1","seq":6,"session":"d3c592c8-e346-49d6-a