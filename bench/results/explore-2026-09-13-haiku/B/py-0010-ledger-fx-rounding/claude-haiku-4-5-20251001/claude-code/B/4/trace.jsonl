{"agent":"main","body":{"error":null,"exit":0,"for_seq":13,"result_bytes":1019,"result_hash":"sha256:c4876521f97cb328457d6385888ccabeb363ab6eaa9d0915c97b17c43e7fc64a","result_inline":"1\t\"\"\"Double-entry posting.\"\"\"\n2\tfrom .accounts import account\n3\tfrom .fx import convert\n4\tfrom .models import Entry\n5\tfrom .rates import Rates\n6\t\n7\t\n8\tclass Journal:\n9\t    def __init__(self, rates: Rates):\n10\t        self.rates = rates\n11\t        self.balances: dict[str, int] = {}\n12\t        self.postings: list[tuple[str, str, int, str]] = []\n13\t\n14\t    def _leg(self, code: str, entry: Entry, sign: int) -> int:\n15\t        acct = account(code)\n16\t        amount = convert(entry.amount_cents, self.rates.get(entry.currency, acct.currency))\n17\t        self.balances[code] = self.balances.get(code, 0) + sign * amount\n18\t        return amount\n19\t\n20\t    def post(self, entry: Entry) -> tuple[int, int]:\n21\t        dr = self._leg(entry.debit, entry, +1)\n22\t        cr = self._leg(entry.credit, entry, -1)\n23\t        self.postings.append((entry.id, entry.debit, dr, account(entry.debit).currency))\n24\t        self.postings.append((entry.id, entry.credit, -cr, account(entry.credit).currency))\n25\t        return dr, cr\n26\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:238aa570dba4919a3d13b475d97c4d2e15876eaceae09d3d7f0e674504a9312e","mono_ns":14000000,"prev":"sha256:3222f054773f54a713bc7bf6a3f88411bc5258e64b96747c85c505ac235ee59f","schema":"saga.trace/1","seq":14,"session":"a480271c-6225-44a3-95ea-ade7bc163287","source":"stream-json","ts":"2026-01-01T00:00:00.014Z","turn":1,"type":"tool_result"}
