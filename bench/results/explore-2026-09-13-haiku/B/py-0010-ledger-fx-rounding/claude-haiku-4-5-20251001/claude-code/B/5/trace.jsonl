{"agent":"main","body":{"error":null,"exit":0,"for_seq":15,"result_bytes":1453,"result_hash":"sha256:4246d0ad2e969d824a2252dbc7b4a8c4a8dc0fd524cce6b66a741ca0ab116175","result_inline":"1\t\"\"\"Nightly reconcile: post every entry, then compare balances to the control file.\n2\t\n3\tUsage: python3 -m ledger.reconcile <fixture-dir>\n4\t\"\"\"\n5\timport sys\n6\tfrom pathlib import Path\n7\tfrom .accounts import account\n8\tfrom .journal import Journal\n9\tfrom .loader import load_controls, load_entries\n10\tfrom .rates import Rates\n11\tfrom .report import balance_line, posting_line\n12\t\n13\t\n14\tdef run(fixture_dir: Path, out=sys.stdout) -> int:\n15\t    entries = load_entries(fixture_dir / \"transactions.csv\")\n16\t    controls = load_controls(fixture_dir / \"controls.csv\")\n17\t    journal = Journal(Rates.load(fixture_dir / \"rates.csv\"))\n18\t    for e in entries:\n19\t        journal.post(e)\n20\t        print(posting_line(e.id, e.date, e.debit, e.credit, e.amount_cents, e.currency), file=out)\n21\t    mismatches = 0\n22\t    for code in sorted(controls):\n23\t        acct = account(code)\n24\t        got = journal.balances.get(code, 0)\n25\t        print(balance_line(code, acct.name, got, acct.currency), file=out)\n26\t        expected = controls[code]\n27\t        if got != expected:\n28\t            mismatches += 1\n29\t            print(f\"MISMATCH account {code}: expected {expected} got {got} (diff {got - expected})\", file=out)\n30\t    print(f\"reconcile: {len(entries)} entries posted, {mismatches} mismatch{'es' if mismatches != 1 else ''}\", file=out)\n31\t    return 1 if mismatches else 0\n32\t\n33\t\n34\tif __name__ == \"__main__\":\n35\t    sys.exit(run(Path(sys.argv[1])))\n36\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:c7c85ed20dbe0ec07f488008dd45871304974ca1742e396dfab2f6e622588c99","mono_ns":16000000,"prev":"sha256:c2a7216b2351aa97f7dde1ff1fcdffe5b8c194ed9b6ca9478ed5611e77090de0","schema":"saga.trace/1","seq":16,"session":"