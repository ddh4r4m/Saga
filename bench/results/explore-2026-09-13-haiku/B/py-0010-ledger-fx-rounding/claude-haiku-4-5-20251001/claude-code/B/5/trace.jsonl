{"agent":"main","body":{"error":null,"exit":0,"for_seq":17,"result_bytes":1019,"result_hash":"sha256:c4876521f97cb328457d6385888ccabeb363ab6eaa9d0915c97b17c43e7fc64a","result_inline":"1\t\"\"\"Double-entry posting.\"\"\"\n2\tfrom .accounts import account\n3\tfrom .fx import convert\n4\tfrom .models import Entry\n5\tfrom .rates import Rates\n6\t\n7\t\n8\tclass Journal:\n9\t    def __init__(self, rates: Rates):\n10\t        self.rates = rates\n11\t        self.balances: dict[str, int] = {}\n12\t        self.postings: list[tuple[str, str, int, str]] = []\n13\t\n14\t    def _leg(self, code: str, entry: Entry, sign: int) -> int:\n15\t        acct = account(code)\n16\t        amount = convert(entry.amount_cents, self.rates.get(entry.currency, acct.currency))\n17\t        self.balances[code] = self.balances.get(code, 0) + sign * amount\n18\t        return amount\n19\t\n20\t    def post(self, entry: Entry) -> tuple[int, int]:\n21\t        dr = self._leg(entry.debit, entry, +1)\n22\t        cr = self._leg(entry.credit, entry, -1)\n23\t        self.postings.append((entry.id, entry.debit, dr, account(entry.debit).currency))\n24\t        self.postings.append((entry.id, entry.credit, -cr, account(entry.credit).currency))\n25\t        return dr, cr\n26\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:09d2b4cb18713612d98816dd095a2758e092d666f4569086262f15b4331dcd9f","mono_ns":18000000,"prev":"sha256:71f081ab166dbdbbe5eaa82688e3544cde4c34cb180f49681183d89f7f4c681b","schema":"saga.trace/1","seq":18,"session":"43e8b7dc-b067-4584-bc5b-1862cfa523e9","source":"stream-json","ts":"2026-01-01T00:00:00.018Z","turn":1,"type":"tool_result"}
