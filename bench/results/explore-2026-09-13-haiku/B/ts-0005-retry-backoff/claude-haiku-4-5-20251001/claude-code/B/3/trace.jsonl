{"agent":"main","body":{"error":null,"exit":0,"for_seq":5,"result_bytes":159,"result_hash":"sha256:c6917802276cdac3d4752c7ea5dabaf56819974dcc7c4fe48538d57996ed8174","result_inline":"1\t# retry-kit\n2\t\n3\t`retry(fn, { attempts, baseMs })` retries a failing async call. Wait before retry i is `baseMs * 2^i * (1 + r)`, r in [0, 1). `npm test`.\n4\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:fc4792bc0ef0ec2d10aab3dcd978a94708b5ac0b63a1fd5d87d9565ff19292e8","mono_ns":6000000,"prev":"sha256:abf437983fabcf49d0a39479df7d096875cb87bc20fcebad406c5b809fe25ef9","schema":"saga.trace/1","seq":6,"session":"37b9c769-5d4e-4148-9909-9c63a947656c","source":"stream-json","ts":"2026-01-01T00:00:00.006Z","turn":1,"type":"tool_result"}
