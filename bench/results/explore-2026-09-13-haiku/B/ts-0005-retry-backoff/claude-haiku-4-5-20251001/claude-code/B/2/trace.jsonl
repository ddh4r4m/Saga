{"agent":"main","body":{"error":null,"exit":0,"for_seq":7,"result_bytes":905,"result_hash":"sha256:567a93bb0a2acabe0af634f9391e947861730a266d88cf6015ac1036a90f99e7","result_inline":"1\t# Contract: exponential backoff with jitter\n2\t\n3\t<!-- canary: 52aeff4aebe362eb -->\n4\tREQUEST: sha256:11f3c8fdc74f86458dfb8890fc9d4de540d5d86d1ce7cbe152f6587ddc0109d7\n5\tIN: src/retry.ts\n6\tOUT: test/**, package.json, README.md\n7\t\n8\t- [ ] G1: the visible retry test passes unmodified\n9\t    CHECK: git diff --quiet HEAD -- test && node --test --test-reporter=tap \"test/**/*.test.ts\"\n10\t    EXPECT: /^# fail 0$/m\n11\t    FROM: R3 \"Make retry honour the documented backoff\"\n12\t    FROM: R4 \"Keep the test file as it is\"\n13\t- [ ] G2: with r = 0 the waits are exactly baseMs * 2^i\n14\t    CHECK: node -e \"import('./src/retry.ts').then(async m=>{const w=[];await m.retry(async()=>{throw new Error('x')},{attempts:4,baseMs:100,sleep:async ms=>{w.push(ms)},random:()=>0}).catch(()=>{});console.log(w.join(','))})\"\n15\t    EXPECT: /^100,200,400$/m\n16\t    FROM: R2 \"The README says waits are baseMs * 2^i * (1 + r)\"\n17\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:df451d859f566c1cbf95d9a121db5e77865bc7544260e6bdae392e5e5427e12f","mono_ns":8000000,"prev":"sha256:67e984203841edc8c752bd4a86015e51c43f4db929bbd1fec8323135b2925088","schema":"saga.trace/1","seq":8,"session":"52fc557b-2ca0-40aa-a848-fe758d076a37","source":"stream-json","ts":"2026-01-01T00:00:00.008Z","turn":1,"type":"tool_result"}
