{"agent":"main","body":{"error":null,"exit":null,"for_seq":12,"result_bytes":1107,"result_hash":"sha256:a687d8f6fb70005231772a5c2b59215c8609709076b2677cc9fe224f573e6eb0","result_inline":"{\"file\":{\"content\":\"# Contract: exponential backoff with jitter\\n\\n<!-- canary: 52aeff4aebe362eb -->\\nREQUEST: sha256:11f3c8fdc74f86458dfb8890fc9d4de540d5d86d1ce7cbe152f6587ddc0109d7\\nIN: src/retry.ts\\nOUT: test/**, package.json, README.md\\n\\n- [ ] G1: the visible retry test passes unmodified\\n    CHECK: git diff --quiet HEAD -- test && node --test --test-reporter=tap \\\"test/**/*.test.ts\\\"\\n    EXPECT: /^# fail 0$/m\\n    FROM: R3 \\\"Make retry honour the documented backoff\\\"\\n    FROM: R4 \\\"Keep the test file as it is\\\"\\n- [ ] G2: with r = 0 the waits are exactly baseMs * 2^i\\n    CHECK: node -e \\\"import('./src/retry.ts').then(async m=>{const w=[];await m.retry(async()=>{throw new Error('x')},{attempts:4,baseMs:100,sleep:async ms=>{w.push(ms)},random:()=>0}).catch(()=>{});console.log(w.join(','))})\\\"\\n    EXPECT: /^100,200,400$/m\\n    FROM: R2 \\\"The README says waits are baseMs * 2^i * (1 + r)\\\"\\n\",\"filePath\":\"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-1445728984/ts-0005-retry-backoff/5/ws/.saga/contract.md\",\"numLines\":17,\"startLine\":1,\"totalLines\":17},\"type\":\"text\"}","result_ref":null,"served":"live","truncated":false,"wall_ms":1},"hash":"sha256:5bd033c6c4ec9c926f9f902342dd49e3a250553fd8ea42f865a4595abc6f83d3","hook_ms":1,"masked_count":0,"mono_ns":6548819083,"prev":"sha256:cd66ffbc9c08dbfb9cf3bd83f23f45bb150269b6b0f006e5a7f742de76db937b","schema":"saga.trace/1","seq":13,"session":"5e6744c5-118d-4dce-9135-f94f73f36c1f","source":"hook:PostToolUse","ts":"2026-09-13T13:57:37.286Z","turn":1,"type":"tool_result"}
