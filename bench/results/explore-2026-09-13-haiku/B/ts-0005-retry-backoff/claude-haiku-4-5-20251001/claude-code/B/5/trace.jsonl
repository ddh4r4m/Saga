{"agent":"main","body":{"error":null,"exit":0,"for_seq":7,"result_bytes":552,"result_hash":"sha256:a4ebbcffdda75de3878092198cde7ba0679363af4391832ce3e1f934e43cd1b5","result_inline":"1\timport { test } from \"node:test\";\n2\timport assert from \"node:assert/strict\";\n3\timport { retry } from \"../src/retry.ts\";\n4\t\n5\ttest(\"waits grow exponentially with jitter\", async () => {\n6\t  const waits: number[] = [];\n7\t  const sleep = async (ms: number) => { waits.push(ms); };\n8\t  let calls = 0;\n9\t  const fn = async () => { calls++; throw new Error(\"nope\"); };\n10\t  await assert.rejects(retry(fn, { attempts: 4, baseMs: 100, sleep, random: () => 0.5 }), /nope/);\n11\t  assert.deepEqual(waits, [150, 300, 600]);\n12\t  assert.equal(calls, 4);\n13\t});\n14\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:2d90de630c604fd30e209eb98a9fb24564a82f1fece747c31c8d6956afa14db6","mono_ns":8000000,"prev":"sha256:b93a45fbbe6b244fbe973c9afa6393283a68be0dbd02c88465adb7aa1d3fe519","schema":"saga.trace/1","seq":8,"session":"5e6744c5-118d-4dce-9135-f94f73f36c1f","source":"stream-json","ts":"2026-01-01T00:00:00.008Z","turn":1,"type":"tool_result"}
{"agent":"main","body":{"args_hash":"sha256:641333547ecd825db44c92b76ffe04a0a11a9c4f208fd8e27069c336c9f290ad","args_inline":{"file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-1445728984/ts-0005-retry-backoff/5/ws/src/retry.ts"},"component":"harness","cwd_rel":".","index_version":null,"tool":"Read","tool_use_id":"toolu_01TCw1jXrDbMpcEsUksbXmXT"},"hash":"sha256:ae823f47f4dc1f78ce4ec4ae1d4f4668cf7c8c803b64a1a63b8c724b733c90e6","mono_ns":9000000,"prev":"sha256:2d90de630c604fd30e209eb98a9fb24564a82f1fece747c31c8d6956afa14db6","schema":"saga.trace/1","seq":9,"session":"5e6744c5-118d-4dce-9135-f94f73f36c1f","source":"stream-json","ts":"2026-01-01T00:00:00.009Z","turn":1,"type":"tool_call"}
{"agent":"main","body":{"error":null,"exit":0,"for_seq":9,"result_bytes":1190,"result_hash":"sha256:71e4fc12a4b4c7f93212b07496c6ede0de82cd732de48509c6a149edc015e10f","result_inline":"1\t// retry(fn, options): call fn until it resolves or attempts run out.\n2\t//\n3\t// Backoff policy (see README): the wait before retry number i (0-based) is\n4\t//   baseMs * 2^i * (1 + r)      with r drawn from options.random() in [0, 1)\n5\t// so waits grow exponentially with up to 100% jitter on top.\n6\t\n7\texport interface RetryOptions {\n8\t  attempts: number;\n9\t  baseMs: number;\n10\t  sleep?: (ms: number) => Promise<void>;\n11\t  random?: () => number;\n12\t}\n13\t\n14\tconst defaultSleep = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms));\n15\t\n16\texport async function retry<T>(fn: () => Promise<T>, options: RetryOptions): Promise<T> {\n17\t  const sleep = options.sleep ?? defaultSleep;\n18\t  const random = options.random ?? Math.random;\n19\t  if (options.attempts < 1) throw new RangeError(\"attempts must be >= 1\");\n20\t  let lastError: unknown;\n21\t  for (let i = 0; i < options.attempts; i++) {\n22\t    try {\n23\t      return await fn();\n24\t    } catch (err) {\n25\t      lastError = err;\n26\t      if (i + 1 < options.attempts) {\n27\t        const wait = options.baseMs * (i + 1) + random();\n28\t        await sleep(wait);\n29\t      }\n30\t    }\n31\t  }\n32\t  throw lastError;\n33\t}\n34\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:3a3f6b57a121b0ef2ccdaddff234714a8379746b965d2b0646b14147b148899e","mono_ns":10000000,"prev":"sha256:ae823f47f4dc1f78ce4ec4ae1d4f4668cf7c8c803b64a1a63b8c724b733c90e6","schema":"saga.trace/1","seq":10,"session":"5e6744c5-118d-4dce-9135-f94f73f36c1f","source":"stream-json","ts":"2026-01-01T00:00:00.010Z","turn":1,"type":"tool_result"}
