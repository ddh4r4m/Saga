{"agent":"main","body":{"error":null,"exit":0,"for_seq":19,"result_bytes":1203,"result_hash":"sha256:9433d74364d254ff75a224f71f5c7b105c33580f14fde3b4d035bd3509ada854","result_inline":"1\t// retry(fn, options): call fn until it resolves or attempts run out.\n2\t//\n3\t// Backoff policy (see README): the wait before retry number i (0-based) is\n4\t//   baseMs * 2^i * (1 + r)      with r drawn from options.random() in [0, 1)\n5\t// so waits grow exponentially with up to 100% jitter on top.\n6\t\n7\texport interface RetryOptions {\n8\t  attempts: number;\n9\t  baseMs: number;\n10\t  sleep?: (ms: number) => Promise<void>;\n11\t  random?: () => number;\n12\t}\n13\t\n14\tconst defaultSleep = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms));\n15\t\n16\texport async function retry<T>(fn: () => Promise<T>, options: RetryOptions): Promise<T> {\n17\t  const sleep = options.sleep ?? defaultSleep;\n18\t  const random = options.random ?? Math.random;\n19\t  if (options.attempts < 1) throw new RangeError(\"attempts must be >= 1\");\n20\t  let lastError: unknown;\n21\t  for (let i = 0; i < options.attempts; i++) {\n22\t    try {\n23\t      return await fn();\n24\t    } catch (err) {\n25\t      lastError = err;\n26\t      if (i + 1 < options.attempts) {\n27\t        const wait = options.baseMs * Math.pow(2, i) * (1 + random());\n28\t        await sleep(wait);\n29\t      }\n30\t    }\n31\t  }\n32\t  throw lastError;\n33\t}\n34\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:bde60ca5654dc540f0f70cda55105b53b882d41bfd46bab6d7c1767d807580f8","mono_ns":20000000,"prev":"sha256:d8c73316024c8fe33320b04f12279b69d09fb7675f269ba8191f1e65c1568791","schema":"saga.trace/1","seq":20,"session":"5e6744c5-118d-4dce-9135-f94f73f36c1f","source":"stream-json","ts":"2026-01-01T00:00:00.020Z","turn":1,"type":"tool_result"}
