{"agent":"main","body":{"error":null,"exit":null,"for_seq":8,"result_bytes":761,"result_hash":"sha256:9ad07ffd8582b7770d9a1e31b004dd8c703ef637625192920d280cb6f9ea512b","result_inline":"{\"file\":{\"content\":\"import { test } from \\\"node:test\\\";\\nimport assert from \\\"node:assert/strict\\\";\\nimport { retry } from \\\"../src/retry.ts\\\";\\n\\ntest(\\\"waits grow exponentially with jitter\\\", async () => {\\n  const waits: number[] = [];\\n  const sleep = async (ms: number) => { waits.push(ms); };\\n  let calls = 0;\\n  const fn = async () => { calls++; throw new Error(\\\"nope\\\"); };\\n  await assert.rejects(retry(fn, { attempts: 4, baseMs: 100, sleep, random: () => 0.5 }), /nope/);\\n  assert.deepEqual(waits, [150, 300, 600]);\\n  assert.equal(calls, 4);\\n});\\n\",\"filePath\":\"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-1445728984/ts-0005-retry-backoff/4/ws/test/retry.test.ts\",\"numLines\":14,\"startLine\":1,\"totalLines\":14},\"type\":\"text\"}","result_ref":null,"served":"live","truncated":false,"wall_ms":2},"hash":"sha256:c2399d391375f1b4e7f82c6d89a6fccf679637eb0f5633d61ad4a789b1c1b8f4","hook_ms":0,"masked_count":0,"mono_ns":7093657375,"prev":"sha256:7469d5fe12cc10679ed1526759f0a4f0b9289e02ac277c9d193aa543b057b000","schema":"saga.trace/1","seq":9,"session":"dcc2d4b5-a2a0-4075-bb3b-d85149c2e3b2","source":"hook:PostToolUse","ts":"2026-09-13T13:56:40.474Z","turn":1,"type":"tool_result"}
