   const wait = options.baseMs * (i + 1) + random();\\n        await sleep(wait);\\n      }\\n    }\\n  }\\n  throw lastError;\\n}\\n\",\"replaceAll\":false,\"structuredPatch\":[{\"lines\":[\"     } catch (err) {\",\"       lastError = err;\",\"       if (i + 1 < options.attempts) {\",\"-        const wait = options.baseMs * (i + 1) + random();\",\"+        const wait = options.baseMs * Math.pow(2, i) * (1 + random());\",\"         await sleep(wait);\",\"       }\",\"     }\"],\"newLines\":7,\"newStart\":24,\"oldLines\":7,\"oldStart\":24}],\"userModified\":false}","result_ref":null,"served":"live","truncated":false,"wall_ms":3},"hash":"sha256:bcdf81986eb5cd964b09b49c639a12178aacfc62310f86a72554edda91fcfd51","hook_ms":0,"masked_count":0,"mono_ns":17175479625,"prev":"sha256:698d70c21ced5aa8f376824e39a3ba67255bd1fcd19b353ab79c14259b9a5f7f","schema":"saga.trace/1","seq":15,"session":"9290f8c4-5fed-475c-acfc-0540c4476145","source":"hook:PostToolUse","ts":"2026-09-13T13:54:15.931Z","turn":1,"type":"tool_result"}
