{"agent":"main","body":{"error":null,"exit":null,"for_seq":10,"result_bytes":761,"result_hash":"sha256:629542e8167615823eb91c0364da7cd022c44867fc38f2859fb005218fa4b44b","result_inline":"{\"file\":{\"content\":\"import { test } from \\\"node:test\\\";\\nimport assert from \\\"node:assert/strict\\\";\\nimport { retry } from \\\"../src/retry.ts\\\";\\n\\ntest(\\\"waits grow exponentially with jitter\\\", async () => {\\n  const waits: number[] = [];\\n  const sleep = async (ms: number) => { waits.push(ms); };\\n  let calls = 0;\\n  const fn = async () => { calls++; throw new Error(\\\"nope\\\"); };\\n  await assert.rejects(retry(fn, { attempts: 4, baseMs: 100, sleep, random: () => 0.5 }), /nope/);\\n  assert.deepEqual(waits, [150, 300, 600]);\\n  assert.equal(calls, 4);\\n});\\n\",\"filePath\":\"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-1445728984/ts-0005-retry-backoff/1/ws/test/retry.test.ts\",\"numLines\":14,\"startLine\":1,\"totalLines\":14},\"type\":\"text\"}","result_ref":null,"served":"live","truncated":false,"wall_ms":1},"hash":"sha256:00b8f74dec1e43f493b91353640fc63186a20f4570b928bb97fa293dc714c919","hook_ms":0,"masked_count":0,"mono_ns":8299752625,"prev":"sha256:56f8d631a95047db4bca3a206d3c363a1b849530f2df9f36a2d5ad43c1882583","schema":"saga.trace/1","seq":11,"session":"9290f8c4-5fed-475c-acfc-0540c4476145","source":"hook:PostToolUse","ts":"2026-09-13T13:54:07.056Z","turn":1,"type":"tool_result"}
