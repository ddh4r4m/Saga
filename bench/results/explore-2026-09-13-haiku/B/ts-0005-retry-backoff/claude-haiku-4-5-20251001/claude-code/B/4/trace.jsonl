{"agent":"main","body":{"error":null,"exit":0,"for_seq":9,"result_bytes":1190,"result_hash":"sha256:71e4fc12a4b4c7f93212b07496c6ede0de82cd732de48509c6a149edc015e10f","result_inline":"1\t// retry(fn, options): call fn until it resolves or attempts run out.\n2\t//\n3\t// Backoff policy (see README): the wait before retry number i (0-based) is\n4\t//   baseMs * 2^i * (1 + r)      with r drawn from options.random() in [0, 1)\n5\t// so waits grow exponentially with up to 100% jitter on top.\n6\t\n7\texport interface RetryOptions {\n8\t  attempts: number;\n9\t  baseMs: number;\n10\t  sleep?: (ms: number) => Promise<void>;\n11\t  random?: () => number;\n12\t}\n13\t\n14\tconst defaultSleep = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms));\n15\t\n16\texport async function retry<T>(fn: () => Promise<T>, options: RetryOptions): Promise<T> {\n17\t  const sleep = options.sleep ?? defaultSleep;\n18\t  const random = options.random ?? Math.random;\n19\t  if (options.attempts < 1) throw new RangeError(\"attempts must be >= 1\");\n20\t  let lastError: unknown;\n21\t  for (let i = 0; i < options.attempts; i++) {\n22\t    try {\n23\t      return await fn();\n24\t    } catch (err) {\n25\t      lastError = err;\n26\t      if (i + 1 < options.attempts) {\n27\t        const wait = options.baseMs * (i + 1) + random();\n28\t        await sleep(wait);\n29\t      }\n30\t    }\n31\t  }\n32\t  throw lastError;\n33\t}\n34\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:33723bd348e930578bc4f9c8ffc73e66ee2e614989bdc003f1be4a87ae385911","mono_ns":10000000,"prev":"sha256:9ea90f964d42c332725f2e42020e2121f7127765481ab57ae92ac06fb73eb7c5","schema":"saga.trace/1","seq":10,"session":"dcc2d4b5-a2a0-4075-bb3b-d85149c2e3b2","source":"stream-json","ts":"2026-01-01T00:00:00.010Z","turn":1,"type":"tool_result"}
