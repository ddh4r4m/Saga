{"agent":"main","body":{"error":null,"exit":0,"for_seq":7,"result_bytes":552,"result_hash":"sha256:a4ebbcffdda75de3878092198cde7ba0679363af4391832ce3e1f934e43cd1b5","result_inline":"1\timport { test } from \"node:test\";\n2\timport assert from \"node:assert/strict\";\n3\timport { retry } from \"../src/retry.ts\";\n4\t\n5\ttest(\"waits grow exponentially with jitter\", async () => {\n6\t  const waits: number[] = [];\n7\t  const sleep = async (ms: number) => { waits.push(ms); };\n8\t  let calls = 0;\n9\t  const fn = async () => { calls++; throw new Error(\"nope\"); };\n10\t  await assert.rejects(retry(fn, { attempts: 4, baseMs: 100, sleep, random: () => 0.5 }), /nope/);\n11\t  assert.deepEqual(waits, [150, 300, 600]);\n12\t  assert.equal(calls, 4);\n13\t});\n14\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:36e55d057c0dba7818a85a71088efb04338f4302b1dc249346614456bc908fdd","mono_ns":8000000,"prev":"sha256:27d9fa63e07bd4541c860d9e1cbda9d1a7ca4f2ee2ecbadf9daf7728a0d9e9b4","schema":"saga.trace/1","seq":8,"session":"dcc2d4b5-a2a0-4075-bb3b-d85149c2e3b2","source":"stream-json","ts":"2026-01-01T00:00:00.008Z","turn":1,"type":"tool_result"}
