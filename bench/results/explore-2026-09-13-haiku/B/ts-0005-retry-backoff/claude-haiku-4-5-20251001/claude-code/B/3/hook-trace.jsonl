{"agent":"main","body":{"error":null,"exit":null,"for_seq":12,"result_bytes":761,"result_hash":"sha256:b7162e0f1206916352e957c2d7d19c1c4f84d9877d5850d01714f6e9291d9398","result_inline":"{\"file\":{\"content\":\"import { test } from \\\"node:test\\\";\\nimport assert from \\\"node:assert/strict\\\";\\nimport { retry } from \\\"../src/retry.ts\\\";\\n\\ntest(\\\"waits grow exponentially with jitter\\\", async () => {\\n  const waits: number[] = [];\\n  const sleep = async (ms: number) => { waits.push(ms); };\\n  let calls = 0;\\n  const fn = async () => { calls++; throw new Error(\\\"nope\\\"); };\\n  await assert.rejects(retry(fn, { attempts: 4, baseMs: 100, sleep, random: () => 0.5 }), /nope/);\\n  assert.deepEqual(waits, [150, 300, 600]);\\n  assert.equal(calls, 4);\\n});\\n\",\"filePath\":\"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-1445728984/ts-0005-retry-backoff/3/ws/test/retry.test.ts\",\"numLines\":14,\"startLine\":1,\"totalLines\":14},\"type\":\"text\"}","result_ref":null,"served":"live","truncated":false,"wall_ms":1},"hash":"sha256:5e27af3f17ca0e2c14a9cee659aad0588d78cbc7e1dd479b72d002da0bafbc18","hook_ms":0,"masked_count":0,"mono_ns":9952263625,"prev":"sha256:50e6d58004994f808682faebcf9294fc700b76fbb4c21a9830711f3bcc61f13d","schema":"saga.trace/1","seq":13,"session":"37b9c769-5d4e-4148-9909-9c63a947656c","source":"hook:PostToolUse","ts":"2026-09-13T13:55:56.183Z","turn":1,"type":"tool_result"}
