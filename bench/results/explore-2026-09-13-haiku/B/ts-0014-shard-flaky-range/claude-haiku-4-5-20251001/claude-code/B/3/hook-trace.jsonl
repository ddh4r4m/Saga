{"agent":"main","body":{"error":null,"exit":null,"for_seq":10,"result_bytes":901,"result_hash":"sha256:b22cac69fd81531be7a5cc78fd1a98d37b14a74911983632798a0e02ffbf07b8","result_inline":"{\"file\":{\"content\":\"// Shard selection for cache keys. See README for the contract with the routing table.\\n\\n// FNV-1a, 32-bit, folded to a signed integer like the routing table stores it.\\nexport function hashKey(key: string): number {\\n  let h = 0x811c9dc5;\\n  for (let i = 0; i < key.length; i++) {\\n    h ^= key.charCodeAt(i);\\n    h = Math.imul(h, 0x01000193);\\n  }\\n  return h | 0;\\n}\\n\\n// The non-negative remainder of the hash divided by shards (Python's % semantics).\\nexport function shardFor(key: string, shards: number): number {\\n  if (!Number.isInteger(shards) || shards <= 0) throw new RangeError(`shards must be a positive integer, got ${shards}`);\\n  return hashKey(key) % shards;\\n}\\n\",\"filePath\":\"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-1445728984/ts-0014-shard-flaky-range/3/ws/src/shard.ts\",\"numLines\":18,\"startLine\":1,\"totalLines\":18},\"type\":\"text\"}","result_ref":null,"served":"live","truncated":false,"wall_ms":2},"hash":"sha256:83158117e07ce5766637b0403bd469e4b684407ef2698db5f538da70705c3802","hook_ms":1,"masked_count":0,"mono_ns":8038210708,"prev":"sha256:4c75ea9ab147ceb92cc4d144044956006b3cbc418d57ff0f4465783f850bddc8","schema":"saga.trace/1","seq":11,"session":"6fb5c7f5-7df5-4863-b9b8-67723dab8bad","source":"hook:PostToolUse","ts":"2026-09-13T15:18:14.331Z","turn":1,"type":"tool_result"}
