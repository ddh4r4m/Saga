{"agent":"main","body":{"error":null,"exit":0,"for_seq":7,"result_bytes":712,"result_hash":"sha256:f183f9cc9ad5deecd8ea17408b06de8dbb82cb64a537ef11f787a828e60a226c","result_inline":"1\t// Shard selection for cache keys. See README for the contract with the routing table.\n2\t\n3\t// FNV-1a, 32-bit, folded to a signed integer like the routing table stores it.\n4\texport function hashKey(key: string): number {\n5\t  let h = 0x811c9dc5;\n6\t  for (let i = 0; i < key.length; i++) {\n7\t    h ^= key.charCodeAt(i);\n8\t    h = Math.imul(h, 0x01000193);\n9\t  }\n10\t  return h | 0;\n11\t}\n12\t\n13\t// The non-negative remainder of the hash divided by shards (Python's % semantics).\n14\texport function shardFor(key: string, shards: number): number {\n15\t  if (!Number.isInteger(shards) || shards <= 0) throw new RangeError(`shards must be a positive integer, got ${shards}`);\n16\t  return hashKey(key) % shards;\n17\t}\n18\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:0caf7eaef713035b1e19e407e5b5cbfc242f82e2d4a0b10bfd9a21c7844feb28","mono_ns":8000000,"prev":"sha256:777a574f167ba1b57a87f062814461b174edf01c5c599e3fd7821185eac07f6c","schema":"saga.trace/1","seq":8,"session":"b2f3a9d5-37c6-489e-9734-207ae9244381","source":"stream-json","ts":"2026-01-01T00:00:00.008Z","turn":1,"type":"tool_result"}
