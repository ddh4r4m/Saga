{"agent":"main","body":{"error":null,"exit":0,"for_seq":3,"result_bytes":1173,"result_hash":"sha256:e1237d91d4e4aa95630011cad4e4be45e07a86d654bfe513bbbabc04ec35bf25","result_inline":"1\t# Contract: shard range is reliably green\n2\t\n3\t<!-- canary: bff85ecb979d8e42 -->\n4\tREQUEST: sha256:eea215fe447d88a8d05eb2f1614b7b6c9ecbc02d4d5aaeed37b0d7b85ca51437\n5\tIN: src/shard.ts\n6\tOUT: test/**, fixtures/**\n7\t\n8\t- [ ] G1: the visible suite passes three times in a row\n9\t    CHECK: for i in 1 2 3; do node --test --test-reporter=tap \"test/**/*.test.ts\" | grep -E \"^# fail\"; done | sort -u\n10\t    EXPECT: /^# fail 0$/m\n11\t    FROM: R2 \"so the job is reliably green\"\n12\t- [ ] G2: a key whose hash is negative lands in range with the non-negative remainder\n13\t    CHECK: node -e \"import('./src/shard.ts').then(m=>console.log('hash',m.hashKey('session:1:919'),'shard16',m.shardFor('session:1:919',16),'shard10',m.shardFor('session:1:919',10)))\"\n14\t    EXPECT: /^hash -2110243379 shard16 13 shard10 1$/m\n15\t    FROM: R2 \"without keys moving to a different shard\"\n16\t- [x] G3: the test file is not the thing that changed\n17\t    CHECK: git diff --quiet HEAD -- test fixtures && echo tests-unchanged\n18\t    EXPECT: tests-unchanged\n19\t    FROM: R2 \"fix the right one\"\n20\t    RED: none\n21\t    EVIDENCE: sha256:c65b1980f365e01055ae9fb0c352e9b4d5812e10fba41e60e8a1163176217236\n22\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:c6c4a0a8437ffd11a33dbea0faf14b2d53127e6744cbab94bc918614a02b3af0","mono_ns":4000000,"prev":"sha256:399bdec50fc75105841d147308f05df2827ac82e35402e751b2d75d270e10079","schema":"saga.trace/1","seq":4,"session":"c83b5b4e-d4fe-4095-bf36-80b35af61143","source":"stream-json","ts":"2026-01-01T00:00:00.004Z","turn":1,"type":"tool_result"}
