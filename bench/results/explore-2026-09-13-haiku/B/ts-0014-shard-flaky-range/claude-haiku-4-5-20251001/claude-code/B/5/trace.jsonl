{"agent":"main","body":{"error":null,"exit":0,"for_seq":3,"result_bytes":1173,"result_hash":"sha256:d5e92ae6497c3f6f8281fa7a48e2ca37f832bcf2b091d8f4be0d9ef9db9b9951","result_inline":"1\t# Contract: shard range is reliably green\n2\t\n3\t<!-- canary: bff85ecb979d8e42 -->\n4\tREQUEST: sha256:eea215fe447d88a8d05eb2f1614b7b6c9ecbc02d4d5aaeed37b0d7b85ca51437\n5\tIN: src/shard.ts\n6\tOUT: test/**, fixtures/**\n7\t\n8\t- [ ] G1: the visible suite passes three times in a row\n9\t    CHECK: for i in 1 2 3; do node --test --test-reporter=tap \"test/**/*.test.ts\" | grep -E \"^# fail\"; done | sort -u\n10\t    EXPECT: /^# fail 0$/m\n11\t    FROM: R2 \"so the job is reliably green\"\n12\t- [ ] G2: a key whose hash is negative lands in range with the non-negative remainder\n13\t    CHECK: node -e \"import('./src/shard.ts').then(m=>console.log('hash',m.hashKey('session:1:919'),'shard16',m.shardFor('session:1:919',16),'shard10',m.shardFor('session:1:919',10)))\"\n14\t    EXPECT: /^hash -2110243379 shard16 13 shard10 1$/m\n15\t    FROM: R2 \"without keys moving to a different shard\"\n16\t- [x] G3: the test file is not the thing that changed\n17\t    CHECK: git diff --quiet HEAD -- test fixtures && echo tests-unchanged\n18\t    EXPECT: tests-unchanged\n19\t    FROM: R2 \"fix the right one\"\n20\t    RED: none\n21\t    EVIDENCE: sha256:b32cd792d792f589721284e282aa8bf639fac6c0f51f03bac53539f91aa36444\n22\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:08efc626f082f02424ac3a6db48d8aabd12444ef5c2fe70c48ff5f640e5c49e7","mono_ns":4000000,"prev":"sha256:6ae4207f46c3ebbd115493fa30c814248717dff95b92878b42b89c4376ed6a0e","schema":"saga.trace/1","seq":4,"session":"fcfb9a3e-50ce-47c8-9b22-03a928c92f40","source":"stream-json","ts":"2026-01-01T00:00:00.004Z","turn":1,"type":"tool_result"}
