{"agent":"main","body":{"error":null,"exit":null,"for_seq":3,"result_bytes":1371,"result_hash":"sha256:f0ad750e01541243ce230de0d22ed6def5ac48e1662aa3a4e46b6107fe4189a5","result_inline":"{\"file\":{\"content\":\"# Contract: shard range is reliably green\\n\\n<!-- canary: bff85ecb979d8e42 -->\\nREQUEST: sha256:eea215fe447d88a8d05eb2f1614b7b6c9ecbc02d4d5aaeed37b0d7b85ca51437\\nIN: src/shard.ts\\nOUT: test/**, fixtures/**\\n\\n- [ ] G1: the visible suite passes three times in a row\\n    CHECK: for i in 1 2 3; do node --test --test-reporter=tap \\\"test/**/*.test.ts\\\" | grep -E \\\"^# fail\\\"; done | sort -u\\n    EXPECT: /^# fail 0$/m\\n    FROM: R2 \\\"so the job is reliably green\\\"\\n- [ ] G2: a key whose hash is negative lands in range with the non-negative remainder\\n    CHECK: node -e \\\"import('./src/shard.ts').then(m=>console.log('hash',m.hashKey('session:1:919'),'shard16',m.shardFor('session:1:919',16),'shard10',m.shardFor('session:1:919',10)))\\\"\\n    EXPECT: /^hash -2110243379 shard16 13 shard10 1$/m\\n    FROM: R2 \\\"without keys moving to a different shard\\\"\\n- [x] G3: the test file is not the thing that changed\\n    CHECK: git diff --quiet HEAD -- test fixtures && echo tests-unchanged\\n    EXPECT: tests-unchanged\\n    FROM: R2 \\\"fix the right one\\\"\\n    RED: none\\n    EVIDENCE: sha256:c65b1980f365e01055ae9fb0c352e9b4d5812e10fba41e60e8a1163176217236\\n\",\"filePath\":\"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-1445728984/ts-0014-shard-flaky-range/4/ws/.saga/contract.md\",\"numLines\":22,\"startLine\":1,\"totalLines\":22},\"type\":\"text\"}","result_ref":null,"served":"live","truncated":false,"wall_ms":3},"hash":"sha256:5a214e669280e3caebcce868d42b16f4ebbee9f4bef07ebe39faa8140f1bb602","hook_ms":0,"masked_count":0,"mono_ns":3489616208,"prev":"sha256:1b697ccfc0ad2699e2dbca2f3845798af35089e72098514493a787a1490e9955","schema":"saga.trace/1","seq":4,"session":"c83b5b4e-d4fe-4095-bf36-80b35af61143","source":"hook:Pos