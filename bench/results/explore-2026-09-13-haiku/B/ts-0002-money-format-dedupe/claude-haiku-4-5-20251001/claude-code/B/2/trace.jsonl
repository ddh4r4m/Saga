{"agent":"main","body":{"error":null,"exit":0,"for_seq":5,"result_bytes":1158,"result_hash":"sha256:825052f9e0fd5032a234db432d6bc766ac212865a74e182d3dc5166028e05a9f","result_inline":"1\t# Contract: shared money formatter\n2\t\n3\t<!-- canary: ed51830731bb09b7 -->\n4\tREQUEST: sha256:e55e430321df3a32a06bd542b9a34d9897669503ec464438484dce6942f9a845\n5\tIN: src/money.ts, src/invoice.ts, src/receipt.ts, test/**\n6\tOUT: src/legacy/**, package.json\n7\t\n8\t- [ ] G1: one formatMoney lives in src/money.ts and both renderers import it\n9\t    CHECK: grep -lE \"from [\\\"']\\./money\\.ts[\\\"']\" src/invoice.ts src/receipt.ts | wc -l | tr -d \" \" && grep -cE \"^export (function|const) formatMoney\" src/money.ts\n10\t    EXPECT: /^2\\n1$/m\n11\t    FROM: R3 \"Pull one formatMoney out into src/money.ts\"\n12\t    FROM: R3 \"use it from both invoice.ts and receipt.ts\"\n13\t- [ ] G2: the receipt prints a refund the way the invoice does\n14\t    CHECK: node --test --test-reporter=tap \"test/**/*.test.ts\"\n15\t    EXPECT: /^# fail 0$/m\n16\t    FROM: R3 \"with the invoice's behaviour\"\n17\t- [x] G3: the legacy export is untouched\n18\t    CHECK: git diff --quiet HEAD -- src/legacy && echo legacy-unchanged\n19\t    EXPECT: legacy-unchanged\n20\t    FROM: R4 \"Leave src/legacy alone\"\n21\t    RED: none\n22\t    EVIDENCE: sha256:c7adf41e247f475a356844791655a7a0264278c92b20f60b6f2f076bae25a3d8\n23\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:297df256763f69e64d293019a5a2108648092e7e2e17c68c200ec1277b58c3bd","mono_ns":6000000,"prev":"sha256:d3f6d8c468d53fefa70492b5d8fbbd5eb858bfc87b2d380f9766143014f3f815","schema":"saga.trace/1","seq":6,"session":"a090851a-f788-4de2-8dec-3a8a9190203e","source":"stream-json","ts":"2026-01-01T00:00:00.006Z","turn":1,"type":"tool_result"}
