 """Money value object."""
-from dataclasses import dataclass
+from decimal import Decimal
 
 
-@dataclass(frozen=True)
 class Money:
-    amount: float
+    def __init__(self, amount):
+        # Convert to cents as integer, using Decimal for precision
+        if isinstance(amount, str):
+            amount = Decimal(amount)
+        else:
+            amount = Decimal(str(amount))
+        self._cents = int(round(amount * 100))
+
+    @property
+    def cents(self) -> int:
+        return self._cents
+
+    @property
+    def amount(self) -> float:
+        return self._cents / 100.0
 
     def __add__(self, other: "Money") -> "Money":
-        return Money(self.amount + other.amount)
+        result = Money.__new__(Money)
+        result._cents = self._cents + other._cents
+        return result
 
     def __mul__(self, qty: int) -> "Money":
-        return Money(self.amount * qty)
+        result = Money.__new__(Money)
+        result._cents = self._cents * qty
+        return result
 
     def __neg__(self) -> "Money":
-        return Money(-self.amount)
+        result = Money.__new__(Money)
+        result._cents = -self._cents
+        return result
+
+    def __eq__(self, other):
+        if not isinstance(other, Money):
+            return False
+        return self._cents == other._cents
+
+    def __hash__(self):
+        return hash(self._cents)
+
+    def __repr__(self):
+        return f"Money({self.amount})"
 
 
-ZERO = Money(0.0)
+ZERO = Money(0)
