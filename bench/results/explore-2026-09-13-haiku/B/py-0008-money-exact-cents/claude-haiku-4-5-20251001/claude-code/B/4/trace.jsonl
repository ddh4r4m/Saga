{"agent":"main","body":{"args_hash":"sha256:c228b366f76fbe5d47e3b128a1ff13d51eb90156d352033a5f56154173cfee4a","args_inline":{"file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-1445728984/py-0008-money-exact-cents/4/ws/pricing/money.py","new_string":"\"\"\"Money value object.\"\"\"\nfrom decimal import Decimal\n\n\nclass Money:\n    def __init__(self, amount):\n        # Convert to cents as integer, using Decimal for precision\n        if isinstance(amount, str):\n            amount = Decimal(amount)\n        else:\n            amount = Decimal(str(amount))\n        self._cents = int(round(amount * 100))\n\n    @property\n    def cents(self) -> int:\n        return self._cents\n\n    @property\n    def amount(self) -> float:\n        return self._cents / 100.0\n\n    def __add__(self, other: \"Money\") -> \"Money\":\n        result = Money.__new__(Money)\n        result._cents = self._cents + other._cents\n        return result\n\n    def __mul__(self, qty: int) -> \"Money\":\n        result = Money.__new__(Money)\n        result._cents = self._cents * qty\n        return result\n\n    def __neg__(self) -> \"Money\":\n        result = Money.__new__(Money)\n        result._cents = -self._cents\n        return result\n\n    def __eq__(self, other):\n        if not isinstance(other, Money):\n            return False\n        return self._cents == other._cents\n\n    def __hash__(self):\n        return hash(self._cents)\n\n    def __repr__(self):\n        return f\"Money({self.amount})\"\n\n\nZERO = Money(0)","old_string":"\"\"\"Money value object.\"\"\"\nfrom dataclasses import dataclass\n\n\n@dataclass(frozen=True)\nclass Money:\n    amount: float\n\n    def __add__(self, other: \"Money\") -> \"Money\":\n        return Money(self.amount + other.amount)\n\n    def __mul__(self, qty: int) -> \"Money\":\n        return Money(self.amount * qty)\n\n    def __neg__(self) -> \"Money\":\n        return Money(-self.amount)\n\n\nZERO = Money(0.0)","