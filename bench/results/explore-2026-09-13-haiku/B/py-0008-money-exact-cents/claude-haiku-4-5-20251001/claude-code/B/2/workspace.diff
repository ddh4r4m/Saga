+        result.cents = self.cents + other.cents
+        return result
 
     def __mul__(self, qty: int) -> "Money":
-        return Money(self.amount * qty)
+        result = Money(0)
+        result.cents = self.cents * qty
+        return result
 
     def __neg__(self) -> "Money":
-        return Money(-self.amount)
+        result = Money(0)
+        result.cents = -self.cents
+        return result
 
 
 ZERO = Money(0.0)
