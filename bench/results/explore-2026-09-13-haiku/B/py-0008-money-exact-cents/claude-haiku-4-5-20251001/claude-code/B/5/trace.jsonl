{"agent":"main","body":{"args_hash":"sha256:e7391878a1aecc5ff3675e822deaa774cb470a5872eefdd09014b66c5c767197","args_inline":{"file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-1445728984/py-0008-money-exact-cents/5/ws/pricing/money.py","new_string":"\"\"\"Money value object.\"\"\"\n\n\nclass Money:\n    def __init__(self, amount: float):\n        self.cents = round(amount * 100)\n\n    @property\n    def amount(self) -> float:\n        return self.cents / 100\n\n    def __add__(self, other: \"Money\") -> \"Money\":\n        result = Money.__new__(Money)\n        result.cents = self.cents + other.cents\n        return result\n\n    def __mul__(self, qty: int) -> \"Money\":\n        result = Money.__new__(Money)\n        result.cents = self.cents * qty\n        return result\n\n    def __neg__(self) -> \"Money\":\n        result = Money.__new__(Money)\n        result.cents = -self.cents\n        return result\n\n    def __eq__(self, other: object) -> bool:\n        if not isinstance(other, Money):\n            return NotImplemented\n        return self.cents == other.cents\n\n    def __hash__(self) -> int:\n        return hash(self.cents)\n\n    def __repr__(self) -> str:\n        return f\"Money({self.amount})\"\n\n\nZERO = Money(0.0)","old_string":"\"\"\"Money value object.\"\"\"\nfrom dataclasses import dataclass\n\n\n@dataclass(frozen=True)\nclass Money:\n    amount: float\n\n    def __add__(self, other: \"Money\") -> \"Money\":\n        return Money(self.amount + other.amount)\n\n    def __mul__(self, qty: int) -> \"Money\":\n        return Money(self.amount * qty)\n\n    def __neg__(self) -> \"Money\":\n        return Money(-self.amount)\n\n\nZERO = Money(0.0)","replace_all":false},"component":"harness","cwd_rel":".","index_version":null,"tool":"Edit","tool_use_id":"toolu_01SCvSGUAW3D9DRDerc94urn"},"hash":"sha256:1121624dff76cace2bcd3ca74608032ad07ed087e58eca82c647547bbcc7d799","mono_ns":23000000,"prev":"sha256:0cea9ae59878d8412e9c1