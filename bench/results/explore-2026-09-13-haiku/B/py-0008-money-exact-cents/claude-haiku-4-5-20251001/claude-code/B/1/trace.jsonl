{"agent":"main","body":{"args_hash":"sha256:c2d4d5ec2a1abeadb0e53ff3c6639b312a9e31a110e61ee8d8979a1ca0aa6590","args_inline":{"file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-1445728984/py-0008-money-exact-cents/1/ws/pricing/money.py","new_string":"\"\"\"Money value object.\"\"\"\n\n\nclass Money:\n    \"\"\"Stores monetary amounts as cents (integer) to avoid floating-point precision issues.\"\"\"\n\n    def __init__(self, amount: float):\n        self.cents = round(amount * 100)\n\n    @property\n    def amount(self) -> float:\n        \"\"\"Return the amount as a float for backward compatibility.\"\"\"\n        return self.cents / 100\n\n    def __add__(self, other: \"Money\") -> \"Money\":\n        result = Money.__new__(Money)\n        result.cents = self.cents + other.cents\n        return result\n\n    def __mul__(self, qty: int) -> \"Money\":\n        result = Money.__new__(Money)\n        result.cents = self.cents * qty\n        return result\n\n    def __neg__(self) -> \"Money\":\n        result = Money.__new__(Money)\n        result.cents = -self.cents\n        return result\n\n    def __eq__(self, other: object) -> bool:\n        if isinstance(other, Money):\n            return self.cents == other.cents\n        return False\n\n    def __hash__(self) -> int:\n        return hash(self.cents)\n\n    def __repr__(self) -> str:\n        return f\"Money({self.amount})\"\n\n\nZERO = Money(0.0)","old_string":"\"\"\"Money value object.\"\"\"\nfrom dataclasses import dataclass\n\n\n@dataclass(frozen=True)\nclass Money:\n    amount: float\n\n    def __add__(self, other: \"Money\") -> \"Money\":\n        return Money(self.amount + other.amount)\n\n    def __mul__(self, qty: int) -> \"Money\":\n        return Money(self.amount * qty)\n\n    def __neg__(self) -> \"Money\":\n        return Money(-self.amount)\n\n\nZERO = Money(0.0)","replace_all":false},"component":"harness","cwd_rel":".","index_version":null,"tool":"Edit","tool_use_id":"