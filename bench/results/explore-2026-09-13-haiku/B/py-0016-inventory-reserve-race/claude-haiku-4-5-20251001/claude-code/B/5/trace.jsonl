{"agent":"main","body":{"error":null,"exit":0,"for_seq":3,"result_bytes":1634,"result_hash":"sha256:78f6eb4078f560e47665a165a6b330c2197794df7ee4ab7559f2193609d8a3d7","result_inline":"1\t# Contract: thread-safe stock reservation\n2\t\n3\t<!-- canary: 604ee110bd24d46f -->\n4\tREQUEST: sha256:1396771578fab97b6652fae9ff4c4b8687d954345437662327bc7f28166d15c0\n5\tIN: inventory/reserve.py\n6\tOUT: inventory/store.py, tests/**\n7\t\n8\t- [ ] G1: the oversell reproduction passes\n9\t    CHECK: python3 -m unittest -v tests.test_reserve.ReserveTests.test_concurrent_reserves_do_not_oversell 2>&1 | tail -n 3\n10\t    EXPECT: /^OK$/m\n11\t    FROM: R1 \"has a test that reproduces it and fails\"\n12\t- [ ] G2: a release racing a reserve is not lost\n13\t    CHECK: python3 -c \"exec('import threading as th\\nfrom inventory import Inventory, MemoryStore\\ngo=th.Event(); done=th.Event()\\nclass S(MemoryStore):\\n    n=0\\n    def get(self, k):\\n        v=super().get(k); S.n+=1\\n        if S.n==1: go.set(); done.wait(0.5)\\n        return v\\ninv=Inventory(S({\\\"A\\\":5}))\\nb=th.Thread(target=lambda: (go.wait(2), inv.release(\\\"A\\\",2), done.set()))\\nb.start(); inv.reserve(\\\"A\\\",3); go.set(); b.join()\\nprint(\\\"stock\\\", inv.available(\\\"A\\\"))')\"\n14\t    EXPECT: /^stock 4$/m\n15\t    FROM: R2 \"safe to call from several threads at once\"\n16\t- [x] G3: the public methods are unchanged\n17\t    CHECK: python3 -c \"import inspect; from inventory.reserve import Inventory; print(*(f'{m}{inspect.signature(getattr(Inventory,m))}' for m in ('reserve','release','available')))\"\n18\t    EXPECT: reserve(self, sku: str, qty: int) -> int release(self, sku: str, qty: int) -> int available(self, sku: str) -> int\n19\t    FROM: R2 \"without changing its public methods\"\n20\t    RED: none\n21\t    EVIDENCE: sha256:e43d7e4638c6f7a6982b77564c13025c709e0808994bc1b74ec03c2204eb9c60\n22\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:199997b6dabb932519287e61347b5f2d3a