+def list_users(conn: sqlite3.Connection, disabled: bool = False) -> list[dict]:
+    status = "disabled" if disabled else "active"
+    rows = conn.execute("SELECT * FROM users WHERE status = ? ORDER BY id", (status,)).fetchall()
     return [dict(r) for r in rows]
 
 
 def get_user(conn: sqlite3.Connection, user_id: int) -> dict | None:
     row = conn.execute("SELECT * FROM users WHERE id = ?", (user_id,)).fetchone()
     return dict(row) if row else None
+
+
+def set_status(conn: sqlite3.Connection, user_id: int, status: str) -> None:
+    conn.execute("UPDATE users SET status = ? WHERE id = ?", (status, user_id))
+    conn.commit()
