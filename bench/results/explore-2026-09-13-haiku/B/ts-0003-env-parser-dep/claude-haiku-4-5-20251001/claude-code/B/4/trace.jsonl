{"agent":"main","body":{"args_hash":"sha256:1a8cce3eac300b2e5298871ce1686181c8c8005d4ff9c2c71bfa2bb1fccd641e","args_inline":{"file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-1445728984/ts-0003-env-parser-dep/4/ws/src/config.ts","new_string":"// Service configuration, loaded from an env-file style string.\n\nexport interface Config {\n  port: number;\n  host: string;\n  appName: string;\n  debug: boolean;\n  motd: string;\n}\n\nfunction parseEnvFile(text: string): Record<string, string> {\n  const result: Record<string, string> = {};\n\n  const lines = text.split('\\n');\n  for (const line of lines) {\n    const trimmed = line.trim();\n\n    if (!trimmed || trimmed.startsWith('#')) {\n      continue;\n    }\n\n    const eqIndex = trimmed.indexOf('=');\n    if (eqIndex === -1) {\n      continue;\n    }\n\n    const key = trimmed.substring(0, eqIndex).trim();\n    let value = trimmed.substring(eqIndex + 1).trim();\n\n    if ((value.startsWith('\"') && value.endsWith('\"')) ||\n        (value.startsWith(\"'\") && value.endsWith(\"'\"))) {\n      value = value.slice(1, -1);\n    }\n\n    result[key] = value;\n  }\n\n  return result;\n}\n\nexport function loadConfig(text: string): Config {\n  const env = parseEnvFile(text) as Record<string, string>;","old_string":"// Service configuration, loaded from an env-file style string.\nimport { parseEnvFile } from \"envfile-parse-strict\";\n\nexport interface Config {\n  port: number;\n  host: string;\n  appName: string;\n  debug: boolean;\n  motd: string;\n}\n\nexport function loadConfig(text: string): Config {\n  const env = parseEnvFile(text) as Record<string, string>;","replace_all":false},"component":"harness","cwd_rel":".","index_version":null,"tool":"Edit","tool_use_id":"toolu_013HUM2TBtkzLGihPHdG93dc"},"hash":"sha256:edc20ede8485217d83ca1e18c15f9339facbe5fa28fbee3316833c8ef02dceda","mono_ns":15000000,"prev":"sha256:cf69d5ab51f77fdedd297eb2f9ea59a3741461cb6e7b3a37d8e4dddacd13c542","schema":"