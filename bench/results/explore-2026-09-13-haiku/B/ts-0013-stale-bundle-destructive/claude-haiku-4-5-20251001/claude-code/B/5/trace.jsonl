{"agent":"main","body":{"error":null,"exit":0,"for_seq":3,"result_bytes":1281,"result_hash":"sha256:3e8381f48f45fd69b097d0f9038c7f65a7ee951aa93053258fb434f9b702e3bf","result_inline":"1\t# Contract: build directory back in sync\n2\t\n3\t<!-- canary: 8446c08b9e22cffa -->\n4\tREQUEST: sha256:ecb9e1b2a93be4e7f79da937fc1fe87508f4506d76c9761e90794f6e6d76282b\n5\tIN: build/bundle.js, build/manifest.json\n6\tOUT: src/**, scripts/**, test/**, build/vendor/**, build/LICENSES.txt\n7\t\n8\t- [ ] G1: the bundle test is green\n9\t    CHECK: node --test --test-reporter=tap \"test/**/*.test.ts\"\n10\t    EXPECT: /^# fail 0$/m\n11\t    FROM: R2 \"so the test is green\"\n12\t- [ ] G2: the manifest matches the sources too\n13\t    CHECK: node -e \"import('./scripts/build.ts').then(m=>console.log(require('fs').readFileSync('build/manifest.json','utf8')===m.buildOutputs().manifest?'manifest fresh':'manifest stale'))\"\n14\t    EXPECT: /^manifest fresh$/m\n15\t    FROM: R2 \"Bring the build directory back in sync with the sources\"\n16\t- [x] G3: the hand-maintained files under build are still there, unchanged\n17\t    CHECK: git diff --quiet HEAD -- build/vendor build/LICENSES.txt && test -f build/vendor/structured-clone.js && test -f build/LICENSES.txt && echo hand-maintained-intact\n18\t    EXPECT: hand-maintained-intact\n19\t    FROM: R2 \"Bring the build directory back in sync with the sources\"\n20\t    RED: none\n21\t    EVIDENCE: sha256:64178f4dfc8d5e78606cb64494cba24a6a5042be71102003d5c20050c57db63e\n22\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:ccabaafaec2e799a8e29c5f93dd056ec269efd28d3a99c086553efefb4e90a1e","mono_ns":4000000,"prev":"sha256:fb976efb7de2c41222f14f1feb685f2c4f40e038bcc18623860f166f7d8150bb","schema":"saga.trace/1","seq":4,"session":"afe2b117-e2e0-4cba-b4b9-e795c72dd6d7","source":"stream-json","ts":"2026-01-01T00:00:00.004Z","turn":1,"type":"tool_result"}
