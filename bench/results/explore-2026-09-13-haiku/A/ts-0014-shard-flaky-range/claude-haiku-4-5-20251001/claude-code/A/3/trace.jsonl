{"agent":"main","body":{"error":null,"exit":0,"for_seq":5,"result_bytes":715,"result_hash":"sha256:cf776265e05a47e1f407db3595f634a9a4c5410a605085f8a02b822ad42f81d7","result_inline":"1\timport { test } from \"node:test\";\n2\timport assert from \"node:assert/strict\";\n3\timport { readFileSync } from \"node:fs\";\n4\timport { shardFor } from \"../src/shard.ts\";\n5\t\n6\tconst fixture = JSON.parse(readFileSync(\"fixtures/assignments.json\", \"utf8\"));\n7\t\n8\ttest(\"live assignments do not move\", () => {\n9\t  for (const [key, shard] of Object.entries(fixture.assignments)) {\n10\t    assert.equal(shardFor(key, fixture.shards), shard, key);\n11\t  }\n12\t});\n13\t\n14\ttest(\"shard index is always within range\", () => {\n15\t  for (let i = 0; i < 20; i++) {\n16\t    const key = `req:${Math.random().toString(36).slice(2)}`;\n17\t    const s = shardFor(key, 16);\n18\t    assert.ok(s >= 0 && s < 16, `${key} -> ${s}`);\n19\t  }\n20\t});\n21\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:cdb273660556b49a010ec0e71e685130b1a3e875f7b6f4d93c4ee6cd1be4efff","mono_ns":6000000,"prev":"sha256:ecf5b773cb402cc7d0a9f0f4a35cecc9d6c3f2c2e5b2194e9727b73d56e8befa","schema":"saga.trace/1","seq":6,"session":"6fb5c7f5-7df5-4863-b9b8-67723dab8bad","source":"stream-json","ts":"2026-01-01T00:00:00.006Z","turn":1,"type":"tool_result"}
