{"agent":"main","body":{"error":null,"exit":0,"for_seq":13,"result_bytes":1019,"result_hash":"sha256:c4876521f97cb328457d6385888ccabeb363ab6eaa9d0915c97b17c43e7fc64a","result_inline":"1\t\"\"\"Double-entry posting.\"\"\"\n2\tfrom .accounts import account\n3\tfrom .fx import convert\n4\tfrom .models import Entry\n5\tfrom .rates import Rates\n6\t\n7\t\n8\tclass Journal:\n9\t    def __init__(self, rates: Rates):\n10\t        self.rates = rates\n11\t        self.balances: dict[str, int] = {}\n12\t        self.postings: list[tuple[str, str, int, str]] = []\n13\t\n14\t    def _leg(self, code: str, entry: Entry, sign: int) -> int:\n15\t        acct = account(code)\n16\t        amount = convert(entry.amount_cents, self.rates.get(entry.currency, acct.currency))\n17\t        self.balances[code] = self.balances.get(code, 0) + sign * amount\n18\t        return amount\n19\t\n20\t    def post(self, entry: Entry) -> tuple[int, int]:\n21\t        dr = self._leg(entry.debit, entry, +1)\n22\t        cr = self._leg(entry.credit, entry, -1)\n23\t        self.postings.append((entry.id, entry.debit, dr, account(entry.debit).currency))\n24\t        self.postings.append((entry.id, entry.credit, -cr, account(entry.credit).currency))\n25\t        return dr, cr\n26\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:babfbfc0d058df90d9ffbc21b8cf150fabd44d9cc20166fd40dd0ea69c4fcccc","mono_ns":14000000,"prev":"sha256:4575c6dcc57b367673d4cf12ddec6747ba409dfcc7b38381bc6e5c0df3a31d32","schema":"saga.trace/1","seq":14,"session":"276c13b1-d790-4f3e-968e-28bb0df24746","source":"stream-json","ts":"2026-01-01T00:00:00.014Z","turn":1,"type":"tool_result"}
