{"agent":"main","body":{"error":null,"exit":0,"for_seq":19,"result_bytes":796,"result_hash":"sha256:08a72e83045e6415e6de2e0302c9ab6e24deab53e131beb711528ce5614eb5e6","result_inline":"1\t// User-facing failures. See CONTRIBUTING.md, \"Errors\".\n2\t\n3\texport const ERROR_CODES = {\n4\t  E_UNKNOWN_SKU: \"unknown sku\",\n5\t  E_EMPTY_CART: \"cart is empty\",\n6\t  E_USAGE: \"usage: cartctl add <sku> <qty>\",\n7\t  E_INVALID_QUANTITY: \"quantity must be a positive whole number\",\n8\t} as const;\n9\t\n10\texport type ErrorCode = keyof typeof ERROR_CODES;\n11\t\n12\texport class CliError extends Error {\n13\t  readonly code: string;\n14\t  constructor(code: string, message: string) {\n15\t    super(message);\n16\t    this.name = \"CliError\";\n17\t    this.code = code;\n18\t  }\n19\t}\n20\t\n21\texport function fail(code: string, message?: string): never {\n22\t  if (!(code in ERROR_CODES)) throw new Error(`unregistered error code ${code}`);\n23\t  throw new CliError(code, message ?? ERROR_CODES[code as ErrorCode]);\n24\t}\n25\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:0111f64804e0067f13ade7cef25204caeba1da060ebedef2cd6f57e2aff9ed85","mono_ns":20000000,"prev":"sha256:acc2e8fadcb1408bb6d57a0393c1e054ab23e6b74c39735dd02595e37dfa705f","schema":"saga.trace/1","seq":20,"session":"4f0e7edd-1073-4587-b935-b8a749f3a266","source":"stream-json","ts":"2026-01-01T00:00:00.020Z","turn":1,"type":"tool_result"}
