{"agent":"main","body":{"error":null,"exit":0,"for_seq":21,"result_bytes":646,"result_hash":"sha256:d831b19955e28c07f6687a23f32d39ea7cb1259ecddecf2bdb77e023d9fe92e8","result_inline":"1\timport type { Cart } from \"../cart.ts\";\n2\timport { CATALOGUE } from \"../catalogue.ts\";\n3\timport { fail } from \"../errors.ts\";\n4\t\n5\t// Add qty of sku to the cart, merging with an existing line for the same sku.\n6\texport function addItem(cart: Cart, sku: string, qty: number): Cart {\n7\t  if (!(sku in CATALOGUE)) fail(\"E_UNKNOWN_SKU\", `unknown sku ${sku}`);\n8\t  if (!Number.isInteger(qty) || qty <= 0) fail(\"E_INVALID_QUANTITY\");\n9\t  const lines = cart.lines.map((l) => ({ ...l }));\n10\t  const existing = lines.find((l) => l.sku === sku);\n11\t  if (existing) existing.qty += qty;\n12\t  else lines.push({ sku, qty });\n13\t  return { lines };\n14\t}\n15\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:4f5cf4c8e434a5c799a78c3af2a5acb7f66e759fe26070cd830690f44cd5503a","mono_ns":22000000,"prev":"sha256:6c4f30e6cf3a5584164650638a096c4b98bd68512b7732dc763e79bf193a566c","schema":"saga.trace/1","seq":22,"session":"4f0e7edd-1073-4587-b935-b8a749f3a266","source":"stream-json","ts":"2026-01-01T00:00:00.022Z","turn":1,"type":"tool_result"}
