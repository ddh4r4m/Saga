{"agent":"main","body":{"error":null,"exit":0,"for_seq":7,"result_bytes":573,"result_hash":"sha256:e5e2dd27e0c028ea444f04c6285f56797b94ec4518b27fc7ae64f6d643a7cf8e","result_inline":"1\timport type { Cart } from \"../cart.ts\";\n2\timport { CATALOGUE } from \"../catalogue.ts\";\n3\timport { fail } from \"../errors.ts\";\n4\t\n5\t// Add qty of sku to the cart, merging with an existing line for the same sku.\n6\texport function addItem(cart: Cart, sku: string, qty: number): Cart {\n7\t  if (!(sku in CATALOGUE)) fail(\"E_UNKNOWN_SKU\", `unknown sku ${sku}`);\n8\t  const lines = cart.lines.map((l) => ({ ...l }));\n9\t  const existing = lines.find((l) => l.sku === sku);\n10\t  if (existing) existing.qty += qty;\n11\t  else lines.push({ sku, qty });\n12\t  return { lines };\n13\t}\n14\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:f80caff4095a86fb919b2d8701667eceeccbb4fbc595b05a8f4ee68000c6d7b5","mono_ns":8000000,"prev":"sha256:8a96a53495fb63f3a359800bc0c0903474b9f37a914dbe6dc089a60d3abeb73c","schema":"saga.trace/1","seq":8,"session":"82aee71b-b4de-4a46-8492-6783b4a950dc","source":"stream-json","ts":"2026-01-01T00:00:00.008Z","turn":1,"type":"tool_result"}
