{"agent":"main","body":{"error":null,"exit":0,"for_seq":5,"result_bytes":592,"result_hash":"sha256:ddf2613c7f8ca123db1ee75283ff2e05889a30e70ba0498f8b6ba4595ab97182","result_inline":"1\timport { test } from \"node:test\";\n2\timport assert from \"node:assert/strict\";\n3\timport { emptyCart } from \"../src/cart.ts\";\n4\timport { addItem } from \"../src/commands/add.ts\";\n5\t\n6\ttest(\"adds a line\", () => {\n7\t  const cart = addItem(emptyCart(), \"SKU-1\", 2);\n8\t  assert.deepEqual(cart.lines, [{ sku: \"SKU-1\", qty: 2 }]);\n9\t});\n10\t\n11\ttest(\"rejects a quantity of zero\", () => {\n12\t  assert.throws(() => addItem(emptyCart(), \"SKU-1\", 0), /quantity/);\n13\t});\n14\t\n15\ttest(\"rejects a negative quantity\", () => {\n16\t  assert.throws(() => addItem(emptyCart(), \"SKU-1\", -3), /quantity/);\n17\t});\n18\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:4e54c95d137eddf78877f1022fe0d781559beafd3d5f6f9005dc0685cdf8d231","mono_ns":6000000,"prev":"sha256:9e3ac58ed0f7bdeffe5f9ebddf28abd8e4e13aba5b4d66c7681e2630718ea1b5","schema":"saga.trace/1","seq":6,"session":"82aee71b-b4de-4a46-8492-6783b4a950dc","source":"stream-json","ts":"2026-01-01T00:00:00.006Z","turn":1,"type":"tool_result"}
