{"agent":"main","body":{"error":null,"exit":0,"for_seq":7,"result_bytes":552,"result_hash":"sha256:a4ebbcffdda75de3878092198cde7ba0679363af4391832ce3e1f934e43cd1b5","result_inline":"1\timport { test } from \"node:test\";\n2\timport assert from \"node:assert/strict\";\n3\timport { retry } from \"../src/retry.ts\";\n4\t\n5\ttest(\"waits grow exponentially with jitter\", async () => {\n6\t  const waits: number[] = [];\n7\t  const sleep = async (ms: number) => { waits.push(ms); };\n8\t  let calls = 0;\n9\t  const fn = async () => { calls++; throw new Error(\"nope\"); };\n10\t  await assert.rejects(retry(fn, { attempts: 4, baseMs: 100, sleep, random: () => 0.5 }), /nope/);\n11\t  assert.deepEqual(waits, [150, 300, 600]);\n12\t  assert.equal(calls, 4);\n13\t});\n14\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:efa473f21a8960a70eb5bc13c8146b5c8e90c34e0a5faff95f79b0a958904953","mono_ns":8000000,"prev":"sha256:646de433dc7454032c37bca8fd024db9195db8d99af3f63ee68583b8ee67f6e9","schema":"saga.trace/1","seq":8,"session":"dcc2d4b5-a2a0-4075-bb3b-d85149c2e3b2","source":"stream-json","ts":"2026-01-01T00:00:00.008Z","turn":1,"type":"tool_result"}
{"agent":"main","body":{"args_hash":"sha256:d091f0a490c8c93ee3d1d08e4526170ebcec8f9424d5b7c8ce40be59d59385ab","args_inline":{"file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-3187082499/ts-0005-retry-backoff/4/ws/src/retry.ts"},"component":"harness","cwd_rel":".","index_version":null,"tool":"Read","tool_use_id":"toolu_013giiBpN8FvKoHYyqEr2ijH"},"hash":"sha256:dc68df3cfbe61c7d0bf86b1c99696a71d457399d423d89e122d0b05177bafc40","mono_ns":9000000,"prev":"sha256:efa473f21a8960a70eb5bc13c8146b5c8e90c34e0a5faff95f79b0a958904953","schema":"saga.trace/1","seq":9,"session":"dcc2d4b5-a2a0-4075-bb3b-d85149c2e3b2","source":"stream-json","ts":"2026-01-01T00:00:00.009Z","turn":1,"type":"tool_call"}
{"agent":"main","body":{"error":null,"exit":0,"for_seq":9,"result_bytes":1190,"result_hash":"sha256:71e4fc12a4b4c7f93212b07496c6ede0de82cd732de48509c6a149edc015e10f","result_inline":"1\t// retry(fn, options): call fn until it resolves or attempts run out.\n2\t//\n3\t// Backoff policy (see README): the wait before retry number i (0-based) is\n4\t//   baseMs * 2^i * (1 + r)      with r drawn from options.random() in [0, 1)\n5\t// so waits grow exponentially with up to 100% jitter on top.\n6\t\n7\texport interface RetryOptions {\n8\t  attempts: number;\n9\t  baseMs: number;\n10\t  sleep?: (ms: number) => Promise<void>;\n11\t  random?: () => number;\n12\t}\n13\t\n14\tconst defaultSleep = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms));\n15\t\n16\texport async function retry<T>(fn: () => Promise<T>, options: RetryOptions): Promise<T> {\n17\t  const sleep = options.sleep ?? defaultSleep;\n18\t  const random = options.random ?? Math.random;\n19\t  if (options.attempts < 1) throw new RangeError(\"attempts must be >= 1\");\n20\t  let lastError: unknown;\n21\t  for (let i = 0; i < options.attempts; i++) {\n22\t    try {\n23\t      return await fn();\n24\t    } catch (err) {\n25\t      lastError = err;\n26\t      if (i + 1 < options.attempts) {\n27\t        const wait = options.baseMs * (i + 1) + random();\n28\t        await sleep(wait);\n29\t      }\n30\t    }\n31\t  }\n32\t  throw lastError;\n33\t}\n34\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:f5658261477a81877759cd83dd1fa56583110c6fff801956dcf83d5b881ea41d","mono_ns":10000000,"prev":"sha256:dc68df3cfbe61c7d0bf86b1c99696a71d457399d423d89e122d0b05177bafc40","schema":"saga.trace/1","seq":10,"session":"dcc2d4b5-a2a0-4075-bb3b-d85149c2e3b2","source":"stream-json","ts":"2026-01-01T00:00:00.010Z","turn":1,"type":"tool_result"}
