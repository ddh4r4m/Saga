{"agent":"main","body":{"args_hash":"sha256:1312c3c21834acc3d08633ed2369bc7bd292da12b7cb753eb8d0a57bf41b7ca3","args_inline":{"file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-3187082499/ts-0003-env-parser-dep/4/ws/src/config.ts","new_string":"// Service configuration, loaded from an env-file style string.\n\nfunction parseEnvFile(text: string): Record<string, string> {\n  const result: Record<string, string> = {};\n  const lines = text.split('\\n');\n\n  for (const line of lines) {\n    const trimmed = line.trim();\n    if (!trimmed || trimmed.startsWith('#')) continue;\n\n    const eqIdx = trimmed.indexOf('=');\n    if (eqIdx === -1) continue;\n\n    const key = trimmed.substring(0, eqIdx).trim();\n    let value = trimmed.substring(eqIdx + 1);\n\n    if (value.startsWith('\"')) {\n      const closeIdx = value.indexOf('\"', 1);\n      if (closeIdx !== -1) {\n        value = value.substring(1, closeIdx);\n      }\n    } else if (value.startsWith(\"'\")) {\n      const closeIdx = value.indexOf(\"'\", 1);\n      if (closeIdx !== -1) {\n        value = value.substring(1, closeIdx);\n      }\n    } else {\n      value = value.trim();\n    }\n\n    result[key] = value;\n  }\n\n  return result;\n}\n\nexport interface Config {\n  port: number;\n  host: string;\n  appName: string;\n  debug: boolean;\n  motd: string;\n}\n\nexport function loadConfig(text: string): Config {\n  const env = parseEnvFile(text) as Record<string, string>;\n  const port = Number(env.PORT ?? \"8080\");\n  if (!Number.isInteger(port) || port <= 0) throw new Error(`invalid PORT: ${env.PORT}`);\n  return {\n    port,\n    host: env.HOST ?? \"127.0.0.1\",\n    appName: env.APP_NAME ?? \"order-service\",\n    debug: (env.DEBUG ?? \"false\").toLowerCase() === \"true\",\n    motd: env.MOTD ?? \"\",\n  };\n}","old_string":"// Service configuration, loaded from an env-file style string.\nimport { parseEnvFile } from \"envfile-parse-strict\";\n\nexport interface Config {\n  port: