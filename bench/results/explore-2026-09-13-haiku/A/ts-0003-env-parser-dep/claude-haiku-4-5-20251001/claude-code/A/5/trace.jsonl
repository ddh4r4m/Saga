{"agent":"main","body":{"args_hash":"sha256:25e692628322ab012320da211773ef028f688071759e34f64fcd45bef9282c49","args_inline":{"file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-3187082499/ts-0003-env-parser-dep/5/ws/src/config.ts","new_string":"// Service configuration, loaded from an env-file style string.\n\nfunction parseEnvFile(text: string): Record<string, string> {\n  const result: Record<string, string> = {};\n  const lines = text.split('\\n');\n\n  for (const line of lines) {\n    const trimmed = line.trim();\n\n    if (!trimmed || trimmed.startsWith('#')) {\n      continue;\n    }\n\n    const eqIndex = trimmed.indexOf('=');\n    if (eqIndex === -1) continue;\n\n    const key = trimmed.substring(0, eqIndex);\n    let value = trimmed.substring(eqIndex + 1);\n\n    if ((value.startsWith('\"') && value.endsWith('\"')) ||\n        (value.startsWith(\"'\") && value.endsWith(\"'\"))) {\n      value = value.slice(1, -1);\n    }\n\n    result[key] = value;\n  }\n\n  return result;\n}\n\nexport interface Config {\n  port: number;\n  host: string;\n  appName: string;\n  debug: boolean;\n  motd: string;\n}\n\nexport function loadConfig(text: string): Config {\n  const env = parseEnvFile(text) as Record<string, string>;","old_string":"// Service configuration, loaded from an env-file style string.\nimport { parseEnvFile } from \"envfile-parse-strict\";\n\nexport interface Config {\n  port: number;\n  host: string;\n  appName: string;\n  debug: boolean;\n  motd: string;\n}\n\nexport function loadConfig(text: string): Config {\n  const env = parseEnvFile(text) as Record<string, string>;","replace_all":false},"component":"harness","cwd_rel":".","index_version":null,"tool":"Edit","tool_use_id":"toolu_01WyLxUUJXAU6xUhgxPNZ8dk"},"hash":"sha256:2a98822434c50c65aaa3e10cd48af26461aa1d9b45afe4d7e199cbf0c732ae8a","mono_ns":11000000,"prev":"sha256:661a7533d5089fe63adb855c0695715e8bf9e0cd2e90bf53aae521ce70c6f3dd","schema":"saga.trace/1","seq":11,"sessio