 // Service configuration, loaded from an env-file style string.
-import { parseEnvFile } from "envfile-parse-strict";
+
+function parseEnvFile(text: string): Record<string, string> {
+  const result: Record<string, string> = {};
+  const lines = text.split('\n');
+
+  for (const line of lines) {
+    const trimmed = line.trim();
+    if (!trimmed || trimmed.startsWith('#')) continue;
+
+    const eqIdx = trimmed.indexOf('=');
+    if (eqIdx === -1) continue;
+
+    const key = trimmed.substring(0, eqIdx).trim();
+    let value = trimmed.substring(eqIdx + 1);
+
+    if (value.startsWith('"')) {
+      const closeIdx = value.indexOf('"', 1);
+      if (closeIdx !== -1) {
+        value = value.substring(1, closeIdx);
+      }
+    } else if (value.startsWith("'")) {
+      const closeIdx = value.indexOf("'", 1);
+      if (closeIdx !== -1) {
+        value = value.substring(1, closeIdx);
+      }
+    } else {
+      value = value.trim();
+    }
+
+    result[key] = value;
+  }
+
+  return result;
+}
 
 export interface Config {
   port: number;
