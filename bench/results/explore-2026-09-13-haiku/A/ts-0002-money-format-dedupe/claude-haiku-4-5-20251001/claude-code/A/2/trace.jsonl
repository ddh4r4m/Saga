{"agent":"main","body":{"error":null,"exit":0,"for_seq":25,"result_bytes":473,"result_hash":"sha256:86ad256c67deb964a8dc442e38c4108013d63d1e9e18676d1abe95fa6ea9f3f9","result_inline":"// Invoice rendering for the customer portal.\n\nimport { formatMoney } from \"./money.ts\";\n\nexport interface Line {\n  description: string;\n  cents: number;\n}\n\nexport function renderInvoice(lines: Line[]): string {\n  const rows = lines.map((l) => `${l.description.padEnd(20)} ${formatMoney(l.cents).padStart(12)}`);\n  const total = lines.reduce((sum, l) => sum + l.cents, 0);\n  rows.push(`${\"TOTAL\".padEnd(20)} ${formatMoney(total).padStart(12)}`);\n  return rows.join(\"\\n\");\n}","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:e5b66f3ca640185a20ee0dec0c5c5e439e566245d5bee97e78c6a9958b240458","mono_ns":26000000,"prev":"sha256:7a0b90bf160f5b03377ae629b19fc62bbb25aa89f6f131890ea1b5fe01e98168","schema":"saga.trace/1","seq":26,"session":"a090851a-f788-4de2-8dec-3a8a9190203e","source":"stream-json","ts":"2026-01-01T00:00:00.026Z","turn":1,"type":"tool_result"}
