{"agent":"main","body":{"error":null,"exit":0,"for_seq":37,"result_bytes":513,"result_hash":"sha256:9b98e14e856d0a208cfe34815de8f6c97b957714f39fcc0d7ce20f1c5aa560be","result_inline":"1\t// Invoice rendering for the customer portal.\n2\t\n3\timport { formatMoney } from \"./money.ts\";\n4\t\n5\texport interface Line {\n6\t  description: string;\n7\t  cents: number;\n8\t}\n9\t\n10\texport function renderInvoice(lines: Line[]): string {\n11\t  const rows = lines.map((l) => `${l.description.padEnd(20)} ${formatMoney(l.cents).padStart(12)}`);\n12\t  const total = lines.reduce((sum, l) => sum + l.cents, 0);\n13\t  rows.push(`${\"TOTAL\".padEnd(20)} ${formatMoney(total).padStart(12)}`);\n14\t  return rows.join(\"\\n\");\n15\t}\n16\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:08811db71d3129c921af620f0d37b04ae6296d959e62045e9af95a4e5d2ff9a6","mono_ns":38000000,"prev":"sha256:181a20ac976a098c1cf85d0bd80f94bac24ce3e413101d787b546e696d34aa76","schema":"saga.trace/1","seq":38,"session":"b14069cf-0d52-4689-8780-12d5ba110c5a","source":"stream-json","ts":"2026-01-01T00:00:00.038Z","turn":1,"type":"tool_result"}
