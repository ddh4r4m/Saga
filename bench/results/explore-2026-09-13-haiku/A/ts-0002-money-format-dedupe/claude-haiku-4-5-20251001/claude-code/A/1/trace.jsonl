{"agent":"main","body":{"error":null,"exit":0,"for_seq":35,"result_bytes":290,"result_hash":"sha256:db2359bd2b7462c4ff87bb8aa795b80c3499f8da2a884fc687ac1bded756c12d","result_inline":"1\texport function formatMoney(cents: number): string {\n2\t  const sign = cents < 0 ? \"-\" : \"\";\n3\t  const abs = Math.abs(cents);\n4\t  const whole = Math.floor(abs / 100).toLocaleString(\"en-US\");\n5\t  const frac = String(abs % 100).padStart(2, \"0\");\n6\t  return `${sign}$${whole}.${frac}`;\n7\t}\n8\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:8c60d26c1f3a95f135774ed81c90ef958912344b5ac424074a18552d5a1938ab","mono_ns":36000000,"prev":"sha256:36450415d93fea31e5cd84bd1b22089e0aa9d7dda6464b26f5b81531c68a3d1e","schema":"saga.trace/1","seq":36,"session":"b14069cf-0d52-4689-8780-12d5ba110c5a","source":"stream-json","ts":"2026-01-01T00:00:00.036Z","turn":1,"type":"tool_result"}
