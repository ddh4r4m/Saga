{"agent":"main","body":{"error":null,"exit":0,"for_seq":21,"result_bytes":513,"result_hash":"sha256:9b98e14e856d0a208cfe34815de8f6c97b957714f39fcc0d7ce20f1c5aa560be","result_inline":"1\t// Invoice rendering for the customer portal.\n2\t\n3\timport { formatMoney } from \"./money.ts\";\n4\t\n5\texport interface Line {\n6\t  description: string;\n7\t  cents: number;\n8\t}\n9\t\n10\texport function renderInvoice(lines: Line[]): string {\n11\t  const rows = lines.map((l) => `${l.description.padEnd(20)} ${formatMoney(l.cents).padStart(12)}`);\n12\t  const total = lines.reduce((sum, l) => sum + l.cents, 0);\n13\t  rows.push(`${\"TOTAL\".padEnd(20)} ${formatMoney(total).padStart(12)}`);\n14\t  return rows.join(\"\\n\");\n15\t}\n16\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:a7d0f200abe34fc3f35da9db3071c173cec826f1d873fd69b8c5f46eb81cd367","mono_ns":22000000,"prev":"sha256:4c6237234e86a32e628583d303729801d95349e6825690fe7d8795c90bd34c6b","schema":"saga.trace/1","seq":22,"session":"a26fefda-34ec-492d-8974-c32edc378435","source":"stream-json","ts":"2026-01-01T00:00:00.022Z","turn":1,"type":"tool_result"}
