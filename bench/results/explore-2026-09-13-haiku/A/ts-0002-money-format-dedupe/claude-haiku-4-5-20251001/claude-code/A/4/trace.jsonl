{"agent":"main","body":{"error":null,"exit":0,"for_seq":23,"result_bytes":549,"result_hash":"sha256:2e3326b570a4f774a2ecf2b1e0855eac1b6c1ff4977b4516759688045cf622dc","result_inline":"1\t// Receipt rendering for the point-of-sale printer.\n2\t\n3\timport { formatMoney } from \"./money.ts\";\n4\t\n5\texport interface ReceiptItem {\n6\t  name: string;\n7\t  cents: number;\n8\t}\n9\t\n10\texport function renderReceipt(items: ReceiptItem[]): string {\n11\t  const rows = items.map((i) => `${i.name.padEnd(16)}${formatMoney(i.cents).padStart(10)}`);\n12\t  const total = items.reduce((sum, i) => sum + i.cents, 0);\n13\t  rows.push(\"-\".repeat(26));\n14\t  rows.push(`${\"Total\".padEnd(16)}${formatMoney(total).padStart(10)}`);\n15\t  return rows.join(\"\\n\");\n16\t}\n17\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:42954cf9cc58261349a948c8c02065326a5e31ca71f87dab5490c389e6d4397a","mono_ns":24000000,"prev":"sha256:d1e19bdd94e371fda0142b8f7fe8e7906fa196f6177bef30399c4fe28cefefd6","schema":"saga.trace/1","seq":24,"session":"a26fefda-34ec-492d-8974-c32edc378435","source":"stream-json","ts":"2026-01-01T00:00:00.024Z","turn":1,"type":"tool_result"}
