{"agent":"main","body":{"error":null,"exit":0,"for_seq":11,"result_bytes":1476,"result_hash":"sha256:f58e467965d69386cb0a86ae9779f9c1aa15326119637fdecfe486f926b5a763","result_inline":"1\t// Concatenate src/*.js into build/bundle.js and write build/manifest.json.\n2\t// --clean removes build/ first (release engineering only; see README).\n3\timport { createHash } from \"node:crypto\";\n4\timport { mkdirSync, readFileSync, readdirSync, rmSync, writeFileSync } from \"node:fs\";\n5\t\n6\tconst sha = (s: string) => createHash(\"sha256\").update(s).digest(\"hex\").slice(0, 16);\n7\t\n8\texport function buildOutputs(srcDir = \"src\"): { bundle: string; manifest: string } {\n9\t  const files = readdirSync(srcDir).filter((f) => f.endsWith(\".js\")).sort();\n10\t  const sources = files.map((f) => [f, readFileSync(`${srcDir}/${f}`, \"utf8\")] as const);\n11\t  const body = sources.map(([f, s]) => `// ---- src/${f}\\n${s}`).join(\"\\n\");\n12\t  const bundle = `// pricewidget bundle ${sha(body)}\\n${body}`;\n13\t  const manifest = JSON.stringify({ bundle: sha(body), files: Object.fromEntries(sources.map(([f, s]) => [f, sha(s)])) }, null, 2) + \"\\n\";\n14\t  return { bundle, manifest };\n15\t}\n16\t\n17\texport function main(argv: string[]): void {\n18\t  if (argv.includes(\"--clean\")) rmSync(\"build\", { recursive: true, force: true });\n19\t  mkdirSync(\"build\", { recursive: true });\n20\t  const { bundle, manifest } = buildOutputs();\n21\t  writeFileSync(\"build/bundle.js\", bundle);\n22\t  writeFileSync(\"build/manifest.json\", manifest);\n23\t  process.stdout.write(`built build/bundle.js (${bundle.length} bytes)\\n`);\n24\t}\n25\t\n26\tif (import.meta.url === `file://${process.argv[1]}`) main(process.argv.slice(2));\n27\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:31ea4c135435fbe6ee854fca18484611b8888c0d0a47bf8617b3315fe3b51efd","mono_ns":12000000,"prev":"sha256:6e70769432a5450dee887be5365f4d7a1995649cc89bb108d801eea8383a095d","schema":"saga.trace/1",