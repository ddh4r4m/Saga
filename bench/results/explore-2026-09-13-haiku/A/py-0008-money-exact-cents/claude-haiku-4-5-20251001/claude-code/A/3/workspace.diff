diff --git a/pricing/money.py b/pricing/money.py
index f586e26..ece35be 100644
--- a/pricing/money.py
+++ b/pricing/money.py
@@ -4,16 +4,29 @@ from dataclasses import dataclass
 
 @dataclass(frozen=True)
 class Money:
-    amount: float
+    cents: int
+
+    def __init__(self, dollars: float):
+        object.__setattr__(self, "cents", round(dollars * 100))
+
+    @property
+    def amount(self) -> float:
+        return self.cents / 100
 
     def __add__(self, other: "Money") -> "Money":
-        return Money(self.amount + other.amount)
+        m = Money.__new__(Money)
+        object.__setattr__(m, "cents", self.cents + other.cents)
+        return m
 
     def __mul__(self, qty: int) -> "Money":
-        return Money(self.amount * qty)
+        m = Money.__new__(Money)
+        object.__setattr__(m, "cents", self.cents * qty)
+        return m
 
     def __neg__(self) -> "Money":
-        return Money(-self.amount)
+        m = Money.__new__(Money)
+        object.__setattr__(m, "cents", -self.cents)
+        return m
 
 
 ZERO = Money(0.0)
