{"agent":"main","body":{"error":null,"exit":0,"for_seq":37,"result_bytes":1704,"result_hash":"sha256:ac64574dff3637aa1e255ff037651ef537dd0817da06fce9662122b44e5a2a35","result_inline":"diff --git a/inventory/reserve.py b/inventory/reserve.py\nindex 7c80cd4..11d52f2 100644\n--- a/inventory/reserve.py\n+++ b/inventory/reserve.py\n@@ -1,5 +1,6 @@\n \"\"\"Stock reservation for checkout.\"\"\"\n \n+import threading\n from .store import MemoryStore\n \n \n@@ -10,25 +11,28 @@ class OutOfStock(Exception):\n class Inventory:\n     def __init__(self, store: MemoryStore) -> None:\n         self.store = store\n+        self._lock = threading.Lock()\n \n     def reserve(self, sku: str, qty: int) -> int:\n         \"\"\"Take qty units of sku out of stock; return the units left.\"\"\"\n         if qty <= 0:\n             raise ValueError(\"qty must be positive\")\n-        available = self.store.get(sku)\n-        if available < qty:\n-            raise OutOfStock(f\"{sku}: wanted {qty}, have {available}\")\n-        remaining = available - qty\n-        self.store.set(sku, remaining)\n-        return remaining\n+        with self._lock:\n+            available = self.store.get(sku)\n+            if available < qty:\n+                raise OutOfStock(f\"{sku}: wanted {qty}, have {available}\")\n+            remaining = available - qty\n+            self.store.set(sku, remaining)\n+            return remaining\n \n     def release(self, sku: str, qty: int) -> int:\n         \"\"\"Put qty units of sku back; return the units now in stock.\"\"\"\n         if qty <= 0:\n             raise ValueError(\"qty must be positive\")\n-        total = self.store.get(sku) + qty\n-        self.store.set(sku, total)\n-        return total\n+        with self._lock:\n+            total = self.store.get(sku) + qty\n+            self.store.set(sku, total)\n+            return total\n \n     def available(self, sku: str) -> int:\n         return self.store.get(sku)","served":"live","truncated":false,"w