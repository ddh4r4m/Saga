{"agent":"main","body":{"error":null,"exit":0,"for_seq":11,"result_bytes":1114,"result_hash":"sha256:8d1f64a75c2f2160bccfca8acb5589912169783eadb101da27f38f56bbeff7e5","result_inline":"1\t\"\"\"Stock reservation for checkout.\"\"\"\n2\t\n3\tfrom .store import MemoryStore\n4\t\n5\t\n6\tclass OutOfStock(Exception):\n7\t    pass\n8\t\n9\t\n10\tclass Inventory:\n11\t    def __init__(self, store: MemoryStore) -> None:\n12\t        self.store = store\n13\t\n14\t    def reserve(self, sku: str, qty: int) -> int:\n15\t        \"\"\"Take qty units of sku out of stock; return the units left.\"\"\"\n16\t        if qty <= 0:\n17\t            raise ValueError(\"qty must be positive\")\n18\t        available = self.store.get(sku)\n19\t        if available < qty:\n20\t            raise OutOfStock(f\"{sku}: wanted {qty}, have {available}\")\n21\t        remaining = available - qty\n22\t        self.store.set(sku, remaining)\n23\t        return remaining\n24\t\n25\t    def release(self, sku: str, qty: int) -> int:\n26\t        \"\"\"Put qty units of sku back; return the units now in stock.\"\"\"\n27\t        if qty <= 0:\n28\t            raise ValueError(\"qty must be positive\")\n29\t        total = self.store.get(sku) + qty\n30\t        self.store.set(sku, total)\n31\t        return total\n32\t\n33\t    def available(self, sku: str) -> int:\n34\t        return self.store.get(sku)\n35\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:69395dfd854c4458021cc18e0a200fea9c28b20e7b4c7ce8b25778fdef59c239","mono_ns":12000000,"prev":"sha256:956c61331930edf2bf6728c85cfb61ff63471a49ac366f6dcbebf7095794de76","schema":"saga.trace/1","seq":12,"session":"4b7271d9-3902-4be7-96e1-70d8ef3631e3","source":"stream-json","ts":"2026-01-01T00:00:00.012Z","turn":1,"type":"tool_result"}
