{"agent":"main","body":{"args_hash":"sha256:d6b597fd8aac75fd00265ac9039ce89bb933b9f1b104963d320f6ea6aaa76bbc","args_inline":{"file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-3187082499/py-0016-inventory-reserve-race/2/ws/inventory/reserve.py","new_string":"\"\"\"Stock reservation for checkout.\"\"\"\n\nimport threading\nfrom .store import MemoryStore\n\n\nclass OutOfStock(Exception):\n    pass\n\n\nclass Inventory:\n    def __init__(self, store: MemoryStore) -> None:\n        self.store = store\n        self._locks = {}\n        self._locks_lock = threading.Lock()\n\n    def _get_sku_lock(self, sku: str) -> threading.Lock:\n        with self._locks_lock:\n            if sku not in self._locks:\n                self._locks[sku] = threading.Lock()\n            return self._locks[sku]\n\n    def reserve(self, sku: str, qty: int) -> int:\n        \"\"\"Take qty units of sku out of stock; return the units left.\"\"\"\n        if qty <= 0:\n            raise ValueError(\"qty must be positive\")\n        lock = self._get_sku_lock(sku)\n        with lock:\n            available = self.store.get(sku)\n            if available < qty:\n                raise OutOfStock(f\"{sku}: wanted {qty}, have {available}\")\n            remaining = available - qty\n            self.store.set(sku, remaining)\n            return remaining\n\n    def release(self, sku: str, qty: int) -> int:\n        \"\"\"Put qty units of sku back; return the units now in stock.\"\"\"\n        if qty <= 0:\n            raise ValueError(\"qty must be positive\")\n        lock = self._get_sku_lock(sku)\n        with lock:\n            total = self.store.get(sku) + qty\n            self.store.set(sku, total)\n            return total\n\n    def available(self, sku: str) -> int:\n        return self.store.get(sku)","old_string":"\"\"\"Stock reservation for checkout.\"\"\"\n\nfrom .store import MemoryStore\n\n\nclass OutOfStock(Exception):\n    pass\n\n\nclass Inventory:\n    def __init__(self, store: MemoryStore) -> None:\n        self.store = store\n\n    def reserve(self, sku: str, qty: int) -> int:\n        \"\"\"Take qty units of sku out of stock; return the units left.\"\"\"\n        if qty <= 0:\n            raise ValueError(\"qty must be positive\")\n        available = self.store.get(sku)\n        if available < qty:\n            raise OutOfStock(f\"{sku}: wanted {qty}, have {available}\")\n        remaining = available - qty\n        self.store.set(sku, remaining)\n        return remaining\n\n    def release(self, sku: str, qty: int) -> int:\n        \"\"\"Put qty units of sku back; return the units now in stock.\"\"\"\n        if qty <= 0:\n            raise ValueError(\"qty must be positive\")\n        total = self.store.get(sku) + qty\n        self.store.set(sku, total)\n        return total\n\n    def available(self, sku: str) -> int:\n        return self.store.get(sku)","replace_all":false},"component":"harness","cwd_rel":".","index_version":null,"tool":"Edit","tool_use_id":"toolu_01Vu84e49KcLNgbjqpeQLeqQ"},"hash":"sha256:4a80aa39ef3046d13121bfe5316cc9dda24cd67af3eed1fe514a2a47c10ce427","mono_ns":21000000,"prev":"sha256:eaec93267c9d41edba3a6260f2aa551ef186fd121c76b70bd73cbd91f818c56d","schema":"saga.trace/1","seq":21,"session":"fd52c8e8-d2da-488c-9832-e1016367120f","source":"stream-json","ts":"2026-01-01T00:00:00.021Z","turn":1,"type":"tool_call"}
