{"agent":"main","body":{"args_hash":"sha256:a1abb2f0b40d882420312bf380378bdc10cc967652df1aa93b1c434d18cdc260","args_inline":{"file_path":"/private/var/folders/yb/b_617z_s2ml933nmr_k7m47m0000gn/T/saga-bench-3187082499/py-0016-inventory-reserve-race/4/ws/inventory/reserve.py","new_string":"\"\"\"Stock reservation for checkout.\"\"\"\n\nimport threading\n\nfrom .store import MemoryStore\n\n\nclass OutOfStock(Exception):\n    pass\n\n\nclass Inventory:\n    def __init__(self, store: MemoryStore) -> None:\n        self.store = store\n        self._lock = threading.Lock()\n\n    def reserve(self, sku: str, qty: int) -> int:\n        \"\"\"Take qty units of sku out of stock; return the units left.\"\"\"\n        if qty <= 0:\n            raise ValueError(\"qty must be positive\")\n        with self._lock:\n            available = self.store.get(sku)\n            if available < qty:\n                raise OutOfStock(f\"{sku}: wanted {qty}, have {available}\")\n            remaining = available - qty\n            self.store.set(sku, remaining)\n            return remaining\n\n    def release(self, sku: str, qty: int) -> int:\n        \"\"\"Put qty units of sku back; return the units now in stock.\"\"\"\n        if qty <= 0:\n            raise ValueError(\"qty must be positive\")\n        with self._lock:\n            total = self.store.get(sku) + qty\n            self.store.set(sku, total)\n            return total\n\n    def available(self, sku: str) -> int:\n        with self._lock:\n            return self.store.get(sku)","old_string":"\"\"\"Stock reservation for checkout.\"\"\"\n\nfrom .store import MemoryStore\n\n\nclass OutOfStock(Exception):\n    pass\n\n\nclass Inventory:\n    def __init__(self, store: MemoryStore) -> None:\n        self.store = store\n\n    def reserve(self, sku: str, qty: int) -> int:\n        \"\"\"Take qty units of sku out of stock; return the units left.\"\"\"\n        if qty <= 0:\n            raise ValueError(\"qty must be positive\")\n        available = self.store.get(sku)\n        if available < qty:\n            raise OutOfStock(f\"{sku}: wanted {qty}, have {available}\")\n        remaining = available - qty\n        self.store.set(sku, remaining)\n        return remaining\n\n    def release(self, sku: str, qty: int) -> int:\n        \"\"\"Put qty units of sku back; return the units now in stock.\"\"\"\n        if qty <= 0:\n            raise ValueError(\"qty must be positive\")\n        total = self.store.get(sku) + qty\n        self.store.set(sku, total)\n        return total\n\n    def available(self, sku: str) -> int:\n        return self.store.get(sku)","replace_all":false},"component":"harness","cwd_rel":".","index_version":null,"tool":"Edit","tool_use_id":"toolu_0168SewFgFCm12cNR7faGZAY"},"hash":"sha256:358b9065c3450b8f083f67c07b71798fddec921ab01cb31f00ac7160eb27d32b","mono_ns":21000000,"prev":"sha256:701d1f66989102568f6096f30011ceb842c1161f44be83719fff179df29deb2a","schema":"saga.trace/1","seq":21,"session":"034051e3-1cd9-4225-8a4b-9c5726f72403","source":"stream-json","ts":"2026-01-01T00:00:00.021Z","turn":1,"type":"tool_call"}
