{"agent":"main","body":{"error":null,"exit":0,"for_seq":5,"result_bytes":1510,"result_hash":"sha256:6e1fc921db18166a082a23729754aa10c21c7cb010477b24c39be8458bdc1cb3","result_inline":"1\timport threading\n2\timport time\n3\timport unittest\n4\t\n5\tfrom inventory import Inventory, MemoryStore, OutOfStock\n6\t\n7\t\n8\tclass SlowStore(MemoryStore):\n9\t    \"\"\"A store whose reads take a while, like the network-backed one.\"\"\"\n10\t\n11\t    def get(self, sku):\n12\t        value = super().get(sku)\n13\t        time.sleep(0.05)  # the network round trip happens after the read is answered\n14\t        return value\n15\t\n16\t\n17\tclass ReserveTests(unittest.TestCase):\n18\t    def test_reserve_takes_units(self):\n19\t        inv = Inventory(MemoryStore({\"SKU-1\": 5}))\n20\t        self.assertEqual(inv.reserve(\"SKU-1\", 3), 2)\n21\t        self.assertEqual(inv.available(\"SKU-1\"), 2)\n22\t\n23\t    def test_reserve_refuses_more_than_stock(self):\n24\t        inv = Inventory(MemoryStore({\"SKU-1\": 2}))\n25\t        with self.assertRaises(OutOfStock):\n26\t            inv.reserve(\"SKU-1\", 3)\n27\t\n28\t    def test_concurrent_reserves_do_not_oversell(self):\n29\t        inv = Inventory(SlowStore({\"SKU-4471\": 5}))\n30\t        errors = []\n31\t\n32\t        def order():\n33\t            try:\n34\t                inv.reserve(\"SKU-4471\", 3)\n35\t            except OutOfStock as e:\n36\t                errors.append(e)\n37\t\n38\t        threads = [threading.Thread(target=order) for _ in range(2)]\n39\t        for t in threads:\n40\t            t.start()\n41\t        for t in threads:\n42\t            t.join()\n43\t        self.assertEqual(len(errors), 1, \"exactly one of the two orders must be refused\")\n44\t        self.assertEqual(inv.available(\"SKU-4471\"), 2)\n45\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:c7b4dafb65e317b52c4c90bfcb0f33c551f3f2d7b8ca125efa7ddad34146278a","mono_ns":6000000,"prev":"sha256:be2166118ee44b4992415454a6f274e