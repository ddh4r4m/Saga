u)\n        if available < qty:\n            raise OutOfStock(f\"{sku}: wanted {qty}, have {available}\")\n        remaining = available - qty\n        self.store.set(sku, remaining)\n        return remaining\n\n    def release(self, sku: str, qty: int) -> int:\n        \"\"\"Put qty units of sku back; return the units now in stock.\"\"\"\n        if qty <= 0:\n            raise ValueError(\"qty must be positive\")\n        total = self.store.get(sku) + qty\n        self.store.set(sku, total)\n        return total\n\n    def available(self, sku: str) -> int:\n        return self.store.get(sku)","replace_all":false},"component":"harness","cwd_rel":".","index_version":null,"tool":"Edit","tool_use_id":"toolu_01QBZtwm2CBf5ad2FfbNxdz2"},"hash":"sha256:6fd326ebbe46027150252bde4778d3993eaace20aab0456615637840bac1a0a7","mono_ns":19000000,"prev":"sha256:c0a5f24bd79c2b43bf070b5f013d6bccc4a538c19a343ed611aa6ed252538d8a","schema":"saga.trace/1","seq":19,"session":"7bad8599-7800-45a7-b41e-07054fc330d6","source":"stream-json","ts":"2026-01-01T00:00:00.019Z","turn":1,"type":"tool_call"}
