{"agent":"main","body":{"error":null,"exit":0,"for_seq":11,"result_bytes":642,"result_hash":"sha256:79aa32e1257a69134842ee78b6e61fd2746df77d35d0b2b1a5b6201b666b469f","result_inline":"1\t\"\"\"In-memory stock store for development and tests.\n2\t\n3\tProduction uses RedisStore (stockroom-redis), which exposes the same\n4\tthree methods. Keep this class a plain dict wrapper so the two stay\n5\tinterchangeable.\n6\t\"\"\"\n7\t\n8\t\n9\tclass MemoryStore:\n10\t    def __init__(self, initial: dict[str, int] | None = None) -> None:\n11\t        self._data: dict[str, int] = dict(initial or {})\n12\t\n13\t    def get(self, sku: str) -> int:\n14\t        return self._data.get(sku, 0)\n15\t\n16\t    def set(self, sku: str, qty: int) -> None:\n17\t        self._data[sku] = qty\n18\t\n19\t    def snapshot(self) -> dict[str, int]:\n20\t        return dict(self._data)\n21\t","served":"live","truncated":false,"wall_ms":0},"hash":"sha256:83d6cd041bfa71af638e53272be9c4d8afed132663f3e458d63983886453bba0","mono_ns":12000000,"prev":"sha256:f38f5a9f0aa465044d6353494c9b9746515036d4501855614546c2f57c758531","schema":"saga.trace/1","seq":12,"session":"7bad8599-7800-45a7-b41e-07054fc330d6","source":"stream-json","ts":"2026-01-01T00:00:00.012Z","turn":1,"type":"tool_result"}
